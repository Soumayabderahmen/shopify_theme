{%- comment -%}
  Page BRAND ORDINATEUR (prototype validé « Platinumshop-Brand-desktop », inspiré des pages marque de shop.com) : photo en
  plein écran aux couleurs de la marque, logo de la marque rempli par la photo, catégories en pastilles, 4 grandes cartes
  (tris), « Prodotti » avec filtres Shopify (panneau « Filtri », tri, disponibilité, prix), vraies cartes
  snippets/mshein-card.liquid, « Mostra altri prodotti » ; panneau de la marque (bouton logo ☰ : catégories, avis
  Trustpilot du site, politiques, contacts) ; recherche dans la marque avec suggestions ; « Altri brand ».
  Deux adresses (snippets/brand-url.liquid) : la collection de la marque si elle existe (templates/collection.brand.json,
  ex. /collections/nike?view=brand), sinon la recherche de la marque (templates/search.brand.json,
  /search?q=Pagani&type=product&view=brand). Couleurs et logo : snippets/brand-theme.liquid.
  Ordinateur et mobile (mise en page mobile : assets/desktop-brand.css, max-width: 760px).
  Styles : assets/desktop-brand.css ; script : assets/desktop-brand.js.
{%- endcomment -%}
{%- liquid
  assign best = collections['bestsellers']
  assign best_ids = best.products | map: 'id' | join: ','
  capture flag
    render 'country-flag-emoji'
  endcapture

  if template.name == 'search'
    # Recherche de la marque : title:"Marque" puis, pour une catégorie, title:mot … (assets/desktop-brand.js)
    assign br_terms = search.terms | replace: '&quot;', '"' | replace: '&#34;', '"' | strip
    if br_terms contains 'title:"'
      assign br_name = br_terms | split: '"' | slice: 1, 1 | first
    else
      assign br_name = br_terms | remove: 'title:'
    endif
    assign br_term = br_name
    assign br_count = search.results_count
    assign br_filters = search.filters
    assign br_sorts = search.sort_options
    assign br_sort = search.sort_by | default: search.default_sort_by
    # « Vedi tutto » : toute la marque (sans le mot de la catégorie)
    assign br_q = 'title:"' | append: br_term | append: '"' | url_encode
    assign br_base = routes.search_url | append: '?q=' | append: br_q | append: '&type=product&view=brand'
    assign br_cover = ''
  else
    assign br_name = collection.title
    assign br_term = collection.title
    assign br_count = collection.products_count
    assign br_filters = collection.filters
    assign br_sorts = collection.sort_options
    assign br_sort = collection.sort_by | default: collection.default_sort_by
    assign br_base = collection.url | append: '?view=brand'
    assign br_cover = ''
    if collection.image
      assign br_cover = collection.image | image_url: width: 1800
    endif
  endif
  capture br_theme
    render 'brand-theme', name: br_name
  endcapture
  assign br_theme = br_theme | strip | split: '|'
  assign br_logo = br_theme[3] | strip
  assign br_display = br_theme[4] | strip
  if br_display != ''
    assign br_name = br_display
  endif
  assign br_upper = br_name | upcase
  # Promesse « Livraison gratuite dès … » : même montant que la barre du haut (snippets/desktop-header.liquid)
  assign br_ship_amount = settings.free_shipping_amount | times: 100 | money_without_trailing_zeros | strip_html
  # Grande carte « Best Sellers » : la marque triée par meilleures ventes (si la page a ce tri)
  assign br_best_url = ''
  for option in br_sorts
    if option.value == 'best-selling'
      assign br_best_url = br_base | append: '&sort_by=best-selling'
    endif
  endfor
-%}

{%- comment -%} Produits de la page (40 à la fois) {%- endcomment -%}
{%- capture br_grid -%}
  {%- if template.name == 'search' -%}
    {%- paginate search.results by 40 -%}
      {%- for product in search.results -%}
        {%- if product.object_type != 'product' -%}{%- continue -%}{%- endif -%}
        {%- if br_cover == '' and product.featured_image -%}{%- assign br_cover = product.featured_image | image_url: width: 1800 -%}{%- endif -%}
        {%- render 'mshein-card', product: product, best: best, best_ids: best_ids, flag: flag -%}
      {%- endfor -%}
      {%- if paginate.next -%}<li hidden data-br-next="{{ paginate.next.url }}"></li>{%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    {%- paginate collection.products by 40 -%}
      {%- for product in collection.products -%}
        {%- if br_cover == '' and product.featured_image -%}{%- assign br_cover = product.featured_image | image_url: width: 1800 -%}{%- endif -%}
        {%- render 'mshein-card', product: product, best: best, best_ids: best_ids, flag: flag -%}
      {%- endfor -%}
      {%- if paginate.next -%}<li hidden data-br-next="{{ paginate.next.url }}"></li>{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
{%- endcapture -%}

{%- comment -%} Ordinateur et mobile : même page ; mise en page mobile dans assets/desktop-brand.css (max-width: 760px) {%- endcomment -%}
<link rel="stylesheet" href="{{ 'desktop-brand.css' | asset_url }}">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&display=swap">

<div class="br" style="--brand: {{ br_theme[0] }}; --brand-2: {{ br_theme[1] }}; --accent: {{ br_theme[2] }}; --photo: url('{{ br_cover }}');" data-br data-br-name="{{ br_name | escape }}" data-br-term="{{ br_term | escape }}"  data-br-base="{{ br_base }}" data-br-search="{{ routes.search_url }}" data-br-root="{{ routes.root_url }}" data-br-currency="{{ cart.currency.symbol }}" data-br-brands="{{ 'mobile-brands.json' | asset_url }}" data-br-best="{{ br_best_url }}" data-added="{{ 'mobile.js.added_to_wishlist' | t }}" data-removed="{{ 'mobile.js.removed_from_wishlist' | t }}">
  <div class="br-bg" aria-hidden="true"></div>

  {%- comment -%} Haut : logo ☰ (panneau) et recherche dans la marque {%- endcomment -%}
  <div class="br-top">
    <button class="br-id" type="button" data-br-open-menu aria-label="{{ br_name | escape }}">
      <span class="br-id__logo">{%- if br_logo != '' -%}<i class="br-mask" style="--logo: url('https://cdn.jsdelivr.net/npm/simple-icons@11.14.0/icons/{{ br_logo }}.svg');"></i>{%- else -%}<b>{{ br_upper | slice: 0, 2 }}</b>{%- endif -%}</span>
      <b class="br-id__name">{{ br_name | escape }}</b>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <div class="br-sw" data-br-sw>
      <form class="br-search" action="{{ routes.search_url }}" data-br-form>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" name="q" placeholder="{{ 'desktop_brand.search_in' | t: brand: br_name }}" autocomplete="off" data-br-q>
        <button class="br-clear" type="button" data-br-clear aria-label="{{ 'desktop_brand.clear' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17"/></svg></button>
      </form>
      <div class="br-sugg" data-br-sugg></div>
    </div>
  </div>

  {%- comment -%} Logo de la marque rempli par la photo {%- endcomment -%}
  <div class="br-hero">
    <div class="br-lock{% if br_logo == '' %} br-lock--text{% endif %}" role="img" aria-label="{{ br_name | escape }}">
      <span class="br-lock__name">{{ br_upper | escape }}</span>
      {%- if br_logo != '' -%}<i class="br-lock__mark" style="--logo: url('https://cdn.jsdelivr.net/npm/simple-icons@11.14.0/icons/{{ br_logo }}.svg');"></i>{%- endif -%}
    </div>
    <p class="br-hero__meta">{{ 'desktop_brand.original' | t }} · {{ 'desktop_brand.products_html' | t: count: br_count }}<span data-br-from></span>{% if settings.enable_free_shipping %} · {{ 'desktop_brand.free_shipping' | t }}{% endif %}</p>
  </div>
  <div class="br-pills" data-br-pills></div>

  <main class="br-wrap">
    {%- comment -%} « Sélections » : mosaïque de 4 grandes photos (une catégorie, « Promos », « Meilleures ventes », une autre
      catégorie), remplie par assets/desktop-brand.js {%- endcomment -%}
    <section class="br-sel">
      <div class="br-sec br-sec--x"><div><small>{{ 'desktop_brand.sel_eyebrow' | t }}</small><h2>{{ 'desktop_brand.essentials' | t: brand: br_name }}</h2></div><span>{{ 'desktop_brand.brand_products' | t: count: br_count }}</span></div>
      <div class="br-feat" data-br-feat></div>
    </section>

    {%- comment -%} Produits {%- endcomment -%}
    <section class="br-prod" id="prodotti">
      <div class="br-sec br-sec--x"><div><small>{{ 'desktop_brand.collection_eyebrow' | t }}</small><h2>{{ 'desktop_brand.products' | t }}</h2></div><span>{% if br_count == 1 %}{{ 'desktop_brand.products_one' | t }}{% else %}{{ 'desktop_brand.products_count' | t: count: br_count }}{% endif %}</span></div>
      {%- liquid
        assign br_avail = ''
        assign br_price = ''
        for filter in br_filters
          if filter.type == 'price_range'
            assign br_price = filter
          elsif filter.param_name contains 'availability'
            for value in filter.values
              if value.value == '1'
                assign br_avail = value
              endif
            endfor
          endif
        endfor
        # « Ordina per » tant qu'aucun tri n'est demandé dans l'adresse (collection.sort_by / search.sort_by : tri de l'adresse)
        assign br_sort_default = 'desktop_brand.sort_by' | t
        assign br_sort_label = br_sort_default
        if template.name == 'search'
          assign br_sort_asked = search.sort_by
        else
          assign br_sort_asked = collection.sort_by
        endif
        if br_sort_asked != blank
          for option in br_sorts
            if option.value == br_sort_asked
              assign br_sort_label = option.name
            endif
          endfor
        endif
      -%}
      <div class="br-chips">
        <button class="br-chip br-chip--icon" type="button" data-br-open-filters aria-label="{{ 'desktop_brand.filters' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg></button>
        <div class="br-chip{% if br_sort_label != br_sort_default %} on{% endif %}" data-br-menu>
          <span>{% if br_sort_label == br_sort_default %}{{ br_sort_label }}{% else %}{{ br_sort_label | escape }}{% endif %}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          <div class="br-menu">
            {%- comment -%} Tris : conseillés (tri par défaut), remise la plus forte (produits affichés, assets/desktop-brand.js), meilleures ventes (grande carte « Best Sellers »), prix croissant / décroissant {%- endcomment -%}
            <button type="button" data-br-sort=""{% if br_sort_asked == blank %} class="on"{% endif %}>{{ 'desktop_brand.recommended' | t }}</button>
            <button type="button" data-br-sort="off">{{ 'desktop_brand.biggest_discount' | t }}</button>
            {%- for option in br_sorts -%}{%- if option.value == 'best-selling' or option.value == 'price-ascending' or option.value == 'price-descending' -%}<button type="button" data-br-sort="{{ option.value }}"{% if option.value == br_sort_asked %} class="on"{% endif %}>{{ option.name | escape }}</button>{%- endif -%}{%- endfor -%}
          </div>
        </div>
        <button class="br-chip" type="button" data-br-sale>{{ 'desktop_brand.on_sale' | t }}</button>
        {%- liquid
          # Prix : curseur jusqu'à 2000 au plus (la poignée tout à droite = sans prix maximum, « 2000+ »)
          assign br_pmin = 0
          assign br_pmax = 0
          assign br_price_on = false
          assign br_range_max = 2000
          if br_price != ''
            assign br_pmin = br_price.min_value.value | default: 0 | divided_by: 100
            assign br_pmax = br_price.max_value.value | default: 0 | divided_by: 100
            if br_price.min_value.value or br_price.max_value.value
              assign br_price_on = true
            endif
            assign br_range_max = br_price.range_max | plus: 99 | divided_by: 100
            if br_range_max > 2000 or br_range_max < 1
              assign br_range_max = 2000
            endif
          endif
          if br_pmax > br_range_max
            assign br_pmax = 0
          endif
        -%}
        {%- capture br_range_attrs -%}data-br-range data-max="{{ br_range_max }}"{% if br_price != '' %} data-min-param="{{ br_price.min_value.param_name }}" data-max-param="{{ br_price.max_value.param_name }}"{% else %} data-local{% endif %}{%- endcapture -%}
        {%- capture br_range_inputs -%}<i class="br-range__fill"></i><input type="range" min="0" max="{{ br_range_max }}" step="1" value="{{ br_pmin }}" data-br-rmin><input type="range" min="0" max="{{ br_range_max }}" step="1" value="{% if br_pmax > 0 %}{{ br_pmax }}{% else %}{{ br_range_max }}{% endif %}" data-br-rmax>{%- endcapture -%}
        {%- comment -%} Pastille « Prix » : petite fenêtre (curseur, prix mini / maxi, Réinitialiser, Terminé) ; sans filtre de prix Shopify, filtre des produits affichés (assets/desktop-brand.js) {%- endcomment -%}
        <div class="br-chip br-pchip{% if br_price_on %} on{% endif %}" data-br-pchip{% if br_price == '' %} data-br-price-chip{% endif %}>
          <span>{% if br_price_on %}{{ cart.currency.symbol }}{{ br_pmin }} – {% if br_pmax > 0 %}{{ cart.currency.symbol }}{{ br_pmax }}{% else %}{{ br_range_max }}+{% endif %}{% else %}{{ 'desktop_brand.price' | t }}{% endif %}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          <div class="br-pp" data-br-pp>
            <div class="br-range" {{ br_range_attrs }}>{{ br_range_inputs }}</div>
            <div class="br-pp__prices"><input type="number" min="0" value="{{ br_pmin }}" aria-label="{{ 'desktop_brand.price' | t }} min" data-br-pmin><i>–</i><input type="number" min="0" placeholder="{{ br_range_max }}+" value="{% if br_pmax > 0 %}{{ br_pmax }}{% endif %}" aria-label="{{ 'desktop_brand.price' | t }} max" data-br-pmax></div>
            <div class="br-pp__foot"><button class="br-fd__reset" type="button" data-br-pp-reset>{{ 'desktop_brand.reset' | t }}</button><button class="br-fd__done" type="button" data-br-pp-done>{{ 'desktop_brand.done' | t }}</button></div>
          </div>
        </div>
        {%- if br_avail != '' -%}
          <button class="br-chip{% if br_avail.active %} on{% endif %}" type="button" data-br-toggle="{{ br_avail.param_name }}={{ br_avail.value }}">{{ 'desktop_brand.available' | t }}</button>
        {%- endif -%}
      </div>
      <div class="br-cards">
        <ul class="cl__grid" data-br-grid>{{ br_grid }}</ul>
      </div>
      {%- if br_count == 0 -%}
        <div class="br-none"><b>{{ 'desktop_brand.no_results' | t }}</b><p>{{ 'desktop_brand.no_results_text' | t }}</p><a href="{{ br_base }}">{{ 'desktop_brand.clear_filters' | t }}</a></div>
      {%- endif -%}
      <div class="br-none" data-br-none hidden><b>{{ 'desktop_brand.no_results' | t }}</b><p>{{ 'desktop_brand.no_results_text' | t }}</p><button type="button" data-br-reset>{{ 'desktop_brand.clear_filters' | t }}</button></div>
      <div class="br-more"><button type="button" data-br-more>{{ 'desktop_brand.show_more' | t }}</button></div>
    </section>

    {%- comment -%} Top 5 : les plus fortes remises parmi les produits de la marque chargés (assets/desktop-brand.js) {%- endcomment -%}
    <section class="br-top5" data-br-top5 hidden>
      <div class="br-sec br-sec--x"><div><small>{{ 'desktop_brand.top_eyebrow' | t }}</small><h2>{{ 'desktop_brand.top_title' | t }}</h2></div><span>{{ 'desktop_brand.top_sub' | t }}</span></div>
      <div class="br-top5__list" data-br-top5-list></div>
    </section>

    {%- comment -%} Promesses du site {%- endcomment -%}
    <div class="br-prom">
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg><span><b>{{ 'desktop_brand.pr_original' | t }}</b><small>{{ 'desktop_brand.pr_original_sub' | t }}</small></span></div>
      {%- if settings.enable_free_shipping -%}
        <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 6h11v10H2zM13 9h4l4 4v3h-8"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg><span><b>{{ 'desktop_brand.pr_ship' | t }}</b><small>{%- if settings.free_shipping_amount > 0 -%}{{ 'desktop_brand.pr_ship_sub' | t: amount: br_ship_amount }}{%- else -%}{{ 'desktop_brand.pr_ship_sub_any' | t }}{%- endif -%}</small></span></div>
      {%- endif -%}
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v13H4zM3 4h18v3H3z"/><path d="M14 13H9.5m0 0 2-2m-2 2 2 2"/></svg><span><b>{{ 'desktop_brand.pr_returns' | t }}</b><small>{{ 'desktop_brand.pr_returns_sub' | t }}</small></span></div>
      <div><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h3"/></svg><span><b>{{ 'desktop_brand.pr_pay' | t }}</b><small>{{ 'desktop_brand.pr_pay_sub' | t }}</small></span></div>
    </div>

    {%- comment -%} Autres marques : panneaux qui s'ouvrent, 8 par page (assets/desktop-brand.js, assets/mobile-brands.json) ;
      les 6 marques ci-dessous (avec logo) s'affichent tout de suite et donnent leur logo aux panneaux {%- endcomment -%}
    {%- assign br_others = 'Nike,Adidas,Pagani Design,Onemix,Jordan,Skechers,Reebok,Calvin Klein,Trendsi' | split: ',' -%}
    <section class="br-others">
      <div class="br-sec br-sec--x"><div><small>{{ 'desktop_brand.others_eyebrow' | t }}</small><h2>{{ 'desktop_brand.others_title' | t }}</h2></div>
        <div class="br-accnav" data-br-accnav hidden><span class="br-accnav__n" data-br-acc-n></span><button type="button" data-br-acc-prev aria-label="{{ 'desktop_brand.prev_brands' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button><button type="button" data-br-acc-next aria-label="{{ 'desktop_brand.next_brands' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button><button class="br-accnav__all" type="button" data-br-all-brands>{{ 'desktop_brand.all_brands' | t }} <b data-br-all-n></b></button></div>
      </div>
      <div class="br-brands" data-br-marquee>
        {%- assign br_shown = 0 -%}
        {%- for other in br_others -%}
          {%- assign other_key = other | downcase -%}
          {%- assign br_key = br_name | downcase -%}
          {%- if other_key == br_key or br_shown >= 6 -%}{%- continue -%}{%- endif -%}
          {%- assign br_shown = br_shown | plus: 1 -%}
          {%- capture other_theme -%}{%- render 'brand-theme', name: other -%}{%- endcapture -%}
          {%- assign other_theme = other_theme | strip | split: '|' -%}
          {%- assign other_logo = other_theme[3] | strip -%}
          <a class="br-bcard" href="{%- render 'brand-url', name: other -%}" style="--c: {{ other_theme[0] }};">
            <span class="br-blogo">{%- if other_logo != '' -%}<i class="br-mask" style="--logo: url('https://cdn.jsdelivr.net/npm/simple-icons@11.14.0/icons/{{ other_logo }}.svg');"></i>{%- else -%}<b class="br-wm br-wm--{{ other | handleize }}">{%- if other_key == 'pagani design' -%}PAGANI<small>DESIGN</small>{%- else -%}{{ other | upcase | escape }}{%- endif -%}</b>{%- endif -%}</span>
            <span><b>{{ other | escape }}</b><small data-br-count="{{ other | downcase | escape }}">{{ 'desktop_brand.see_products' | t }}</small></span>
          </a>
        {%- endfor -%}
      </div>
      <div class="br-acc__dots" data-br-acc-dots></div>
    </section>
  </main>

  {%- comment -%} Toutes les marques (bouton « Toutes les marques ») : liste de assets/mobile-brands.json avec recherche {%- endcomment -%}
  <div class="br-bm" data-br-bm hidden>
    <div class="br-bm__box" role="dialog" aria-modal="true" aria-label="{{ 'desktop_brand.all_brands' | t }}">
      <div class="br-bm__head"><h3>{{ 'desktop_brand.all_brands' | t }} <span data-br-bm-n></span></h3><label class="br-bm__search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input type="search" placeholder="{{ 'desktop_brand.search_brands' | t }}" autocomplete="off" data-br-bm-q></label><button type="button" data-br-bm-close aria-label="{{ 'desktop_brand.close' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
      <div class="br-bm__grid" data-br-bm-grid></div>
      <p class="br-bm__none" data-br-bm-none hidden>{{ 'desktop_brand.no_brand' | t }}</p>
    </div>
  </div>

  {%- comment -%} Barre compacte au défilement {%- endcomment -%}
  <div class="br-sticky" data-br-sticky>
    <button class="br-id" type="button" data-br-open-menu aria-label="{{ br_name | escape }}">
      <span class="br-id__logo">{%- if br_logo != '' -%}<i class="br-mask" style="--logo: url('https://cdn.jsdelivr.net/npm/simple-icons@11.14.0/icons/{{ br_logo }}.svg');"></i>{%- else -%}<b>{{ br_upper | slice: 0, 2 }}</b>{%- endif -%}</span>
      <b class="br-id__name">{{ br_name | escape }}</b>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <button class="br-sicon" type="button" data-br-goto-search aria-label="{{ 'desktop_brand.search' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
    <div class="br-pills br-pills--sticky" data-br-pills></div>
  </div>

  {%- comment -%} Panneau de la marque {%- endcomment -%}
  <div class="br-veil" data-br-close></div>
  <aside class="br-menu-panel" data-br-panel aria-hidden="true">
    <div class="br-mp__bar"><button type="button" data-br-close aria-label="{{ 'desktop_brand.close' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button><button type="button" data-br-share aria-label="{{ 'desktop_brand.share' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 14v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/></svg></button></div>
    <div class="br-mp__scroll">
      <div class="br-mp__id"><span class="br-blogo">{%- if br_logo != '' -%}<i class="br-mask" style="--logo: url('https://cdn.jsdelivr.net/npm/simple-icons@11.14.0/icons/{{ br_logo }}.svg');"></i>{%- else -%}<b>{{ br_upper | escape }}</b>{%- endif -%}</span><div><b>{{ br_name | escape }}</b><small>{{ 'desktop_brand.panel_count' | t: count: br_count }}</small></div></div>
      <div class="br-mp__card"><div class="br-mp__cats" data-br-panel-cats></div></div>
      <a class="br-mp__card" href="https://www.trustpilot.com/review/platinumshop.it" target="_blank" rel="noopener">
        <div class="br-mp__h"><h3>{{ 'desktop_brand.reviews' | t }}</h3><span class="br-mp__go"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></span></div>
        <div class="br-mp__score"><b>4,8</b><span><i>★★★★★</i><small>{{ 'desktop_brand.reviews_verified' | t: shop: shop.name }}</small></span></div>
        <p class="br-mp__note">{{ 'desktop_brand.leave_review' | t }}</p>
      </a>
      <div class="br-mp__card">
        <h3>{{ 'desktop_brand.policies' | t }}</h3>
        {%- for policy in shop.policies -%}
          {%- if policy.url == blank -%}{%- continue -%}{%- endif -%}
          <a class="br-mp__row" href="{{ policy.url }}">{{ policy.title | escape }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a>
        {%- endfor -%}
      </div>
      <div class="br-mp__card">
        <h3>{{ 'desktop_brand.contact' | t }}</h3>
        <a class="br-mp__row" href="https://wa.me/393314511142" target="_blank" rel="noopener">WhatsApp<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1 1 8 19z"/></svg></a>
        <div class="br-mp__row">{{ shop.email | escape }}<span class="br-mp__acts"><a href="mailto:{{ shop.email }}" aria-label="{{ 'desktop_brand.write' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a><button type="button" data-br-copy="{{ shop.email | escape }}" aria-label="{{ 'desktop_brand.copy' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg></button></span></div>
        <a class="br-mp__row" href="{{ routes.root_url }}pages/traccia-ordine">{{ 'desktop_brand.track_order' | t }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/></svg></a>
        <a class="br-mp__row" href="{{ routes.root_url }}pages/dati-aziendali">{{ 'desktop_brand.company_data' | t }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V5l8-2 8 2v16M9 21v-5h6v5"/></svg></a>
      </div>
      <a class="br-mp__card br-mp__visit" href="{{ routes.root_url }}">{{ 'desktop_brand.visit_shop' | t: shop: shop.name }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14 21 3M15 3h6v6M19 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5"/></svg></a>
    </div>
  </aside>

  {%- comment -%} Panneau des filtres (vrais filtres Shopify : tri, disponibilité, prix) {%- endcomment -%}
  <aside class="br-fd" data-br-filters aria-hidden="true">
    <div class="br-fd__head"><h3>{{ 'desktop_brand.filters' | t }}</h3><button type="button" data-br-close aria-label="{{ 'desktop_brand.close' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <div class="br-fd__body">
      <div class="br-fd__row"><button class="br-fpill" type="button" data-br-fd-sale>{{ 'desktop_brand.on_sale' | t }}</button>{%- if br_avail != '' -%}<button class="br-fpill{% if br_avail.active %} on{% endif %}" type="button" data-br-fd-avail="{{ br_avail.param_name }}={{ br_avail.value }}">{{ 'desktop_brand.available' | t }}</button>{%- endif -%}</div>
      <div class="br-fd__sec"><p>{{ 'desktop_brand.sort_by' | t }}</p><div class="br-fd__row">
        <button class="br-fpill{% if br_sort_asked == blank %} on{% endif %}" type="button" data-br-fd-sort="">{{ 'desktop_brand.recommended' | t }}</button>
        <button class="br-fpill" type="button" data-br-fd-sort="off">{{ 'desktop_brand.biggest_discount' | t }}</button>
        {%- for option in br_sorts -%}{%- if option.value == 'best-selling' or option.value == 'price-ascending' or option.value == 'price-descending' -%}<button class="br-fpill{% if option.value == br_sort_asked %} on{% endif %}" type="button" data-br-fd-sort="{{ option.value }}">{{ option.name | escape }}</button>{%- endif -%}{%- endfor -%}
      </div></div>
      <div class="br-fd__sec"><p>{{ 'desktop_brand.price' | t }}</p>
        <div class="br-range" {{ br_range_attrs }}>{{ br_range_inputs }}</div>
        <div class="br-fd__prices"><label>{{ cart.currency.symbol }}<input type="number" min="0" value="{{ br_pmin }}" data-br-pmin></label><span>–</span><label>{{ cart.currency.symbol }}<input type="number" min="0" placeholder="{{ br_range_max }}+" value="{% if br_pmax > 0 %}{{ br_pmax }}{% endif %}" data-br-pmax></label></div>
      </div>
    </div>
    <div class="br-fd__foot"><button class="br-fd__reset" type="button" data-br-reset data-href="{{ br_base }}">{{ 'desktop_brand.reset' | t }}</button><button class="br-fd__done" type="button" data-br-apply>{{ 'desktop_brand.done' | t }}</button></div>
  </aside>
  <div class="br-toast" data-br-toast></div>
  {%- comment -%} Textes traduits du script (assets/desktop-brand.js) {%- endcomment -%}
  <script type="application/json" data-br-i18n>
    {
      "see_all": {{ 'desktop_brand.see_all' | t | json }},
      "from_html": {{ 'desktop_brand.from_html' | t: price: '__PRICE__' | json }},
      "offers": {{ 'desktop_brand.offers' | t | json }},
      "up_to": {{ 'desktop_brand.up_to' | t: percent: '__PCT__' | json }},
      "models_one": {{ 'desktop_brand.models_one' | t: count: '__N__' | json }},
      "models_other": {{ 'desktop_brand.models_other' | t: count: '__N__' | json }},
      "products_one": {{ 'desktop_brand.products_one' | t | json }},
      "products_count": {{ 'desktop_brand.products_count' | t: count: '__N__' | json }},
      "price": {{ 'desktop_brand.price' | t | json }},
      "sort_by": {{ 'desktop_brand.sort_by' | t | json }},
      "best_sellers": {{ 'desktop_brand.best_sellers' | t | json }},
      "see_brand": {{ 'desktop_brand.see_brand' | t | json }},
      "page_n": {{ 'desktop_brand.page_n' | t: n: '__N__' | json }},
      "brands_count": {{ 'desktop_brand.brands_count' | t: count: '__N__' | json }},
      "original": {{ 'desktop_brand.original' | t | json }},
      "biggest_discount": {{ 'desktop_brand.biggest_discount' | t | json }},
      "email_copied": {{ 'desktop_brand.email_copied' | t | json }},
      "link_copied": {{ 'desktop_brand.link_copied' | t | json }},
      "retry": {{ 'desktop_brand.retry' | t | json }},
      "popular_in": {{ 'desktop_brand.popular_in' | t: brand: '__BRAND__' | json }},
      "cats": {
        "Running": {{ 'desktop_brand.cat_running' | t | json }},
        "Basket": {{ 'desktop_brand.cat_basket' | t | json }},
        "Sandali": {{ 'desktop_brand.cat_sandals' | t | json }},
        "Ciabatte": {{ 'desktop_brand.cat_slides' | t | json }},
        "Stivali": {{ 'desktop_brand.cat_boots' | t | json }},
        "Felpe": {{ 'desktop_brand.cat_hoodies' | t | json }},
        "T-shirt": {{ 'desktop_brand.cat_tshirts' | t | json }},
        "Giacche": {{ 'desktop_brand.cat_jackets' | t | json }},
        "Pantaloni": {{ 'desktop_brand.cat_pants' | t | json }},
        "Tute": {{ 'desktop_brand.cat_tracksuits' | t | json }},
        "Borse": {{ 'desktop_brand.cat_bags' | t | json }},
        "Automatici": {{ 'desktop_brand.cat_automatic' | t | json }},
        "Al quarzo": {{ 'desktop_brand.cat_quartz' | t | json }},
        "Cronografi": {{ 'desktop_brand.cat_chrono' | t | json }},
        "Subacquei": {{ 'desktop_brand.cat_diver' | t | json }},
        "Donna": {{ 'desktop_brand.cat_women' | t | json }},
        "Uomo": {{ 'desktop_brand.cat_men' | t | json }}
      }
    }
  </script>
</div>

<script src="{{ 'desktop-brand.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Pagina brand desktop",
  "class": "desktop-brand",
  "settings": [],
  "enabled_on": { "templates": ["collection", "search"] }
}
