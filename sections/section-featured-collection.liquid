    <button type="button" aria-pressed="true" data-filter-sort="">{{ 'mobile.home.recommended' | t }}</button>
    <button type="button" aria-pressed="false" data-filter-sort="price-ascending">{{ 'mobile.home.price_low' | t }}</button>
    <button type="button" aria-pressed="false" data-filter-sort="created-descending">{{ 'mobile.home.newest' | t }}</button>
    <button type="button" aria-pressed="false" data-filter-sort="" data-filter-match="sale">{{ 'mobile.home.on_sale' | t }}</button>
    <button type="button" aria-pressed="false" data-filter-sort="" data-filter-match="free-shipping">{{ 'mobile.home.free_shipping' | t }}</button>
  </div>
  <p class="featured-filters__empty mobile-only" data-featured-filters-empty hidden>{{ 'mobile.home.filter_empty' | t }}</p>
{%- endif -%}
{%- if aside %}<div>{%- endif -%}

{% paginate collection.products by section.settings.limit %}
  <ul 
    id="product-grid-{{ section.id }}" 
    class="l4cl {% if settings.enable_quick_buy and section.settings.hide_quick_buy == false %}with-quick-buy{% endif %} {{ width_class }} {% if slider %}slider{% else %}mobile-compact{% endif %}{% if section.settings.mobile_layout == 'grid' %} mobile-scroll w50-mobile{% endif %}{% unless aside %} section-width-{{ section.settings.width }}{% endunless %}"
  >
    {%- liquid
      for product in collection.products
        capture placeholder_int
          cycle 1, 2, 3, 4, 5, 6
        endcapture
        
        assign no_lazyload = false
        if section.index == 1 and forloop.index <= 4
          assign no_lazyload = true
        endif

        render 'product-item', product: product, placeholder_int: placeholder_int, enable_quick_buy_desktop: section.settings.enable_quick_buy_desktop, enable_quick_buy_mobile: section.settings.enable_quick_buy_mobile, enable_quick_buy_qty_selector: section.settings.enable_quick_buy_qty_selector, quick_buy_compact: section.settings.enable_quick_buy_compact, enable_quick_buy_drawer: section.settings.enable_quick_buy_drawer, sizes: image_sizes, enable_color_picker: section.settings.enable_color_picker, no_lazyload: no_lazyload
      endfor
      
      if collection.products == blank
        for i in (1..section.settings.number_of_items)
          capture placeholder_int
            cycle 1, 2, 3, 4, 5, 6
          endcapture
          render 'product-item', product: blank, placeholder_int: placeholder_int, enable_quick_buy_desktop: section.settings.enable_quick_buy_desktop, enable_quick_buy_mobile: section.settings.enable_quick_buy_mobile, enable_quick_buy_qty_selector: section.settings.enable_quick_buy_qty_selector, quick_buy_compact: section.settings.enable_quick_buy_compact, enable_quick_buy_drawer: section.settings.enable_quick_buy_drawer
        endfor
      endif
    -%}
  </ul>

  {%- if paginate.next -%}
    <div 
      class="infinite-scroll-trigger text-center" 
      data-next-url="{{ paginate.next.url }}" 
      data-section-id="{{ section.id }}"
      aria-hidden="true"
    >
      <div class="infinite-scroll-loader">
        <span class="spinner-dot"></span>
        <span class="spinner-dot"></span>
        <span class="spinner-dot"></span>
      </div>
    </div>
  {%- endif -%}
{% endpaginate %}

{%- if aside %}</div>{%- endif -%}
{%- if link and section.settings.text_alignment == 'center' -%}
  {{ link | replace: 'class-x', 'm0 text-center' }}
{%- elsif link -%}
  {{ link | replace: 'class-x', 'm0 mobile-only' }}
{%- endif -%}
{%- if aside %}</div>{%- endif -%}

