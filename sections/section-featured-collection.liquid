<style>
  #shopify-section-{{ section.id }} { 
    position: relative; 
    z-index: {{ section.settings.fix_zindex }}!important; 
  }

  .infinite-scroll-trigger {
    padding: 30px 0;
    margin-top: 10px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 50px;
  }

  .infinite-scroll-loader {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }

  .infinite-scroll-loader .spinner-dot {
    width: 8px;
    height: 8px;
    background-color: currentColor;
    border-radius: 50%;
    opacity: 0.3;
    animation: pulseDot 1.4s infinite ease-in-out both;
  }

  .infinite-scroll-loader .spinner-dot:nth-child(1) { animation-delay: -0.32s; }
  .infinite-scroll-loader .spinner-dot:nth-child(2) { animation-delay: -0.16s; }

  @keyframes pulseDot {
    0%, 80%, 100% { transform: scale(0.6); opacity: 0.3; }
    40% { transform: scale(1); opacity: 1; }
  }

  @media only screen and (min-width: 47.5em) {
  {% if link and section.settings.text_alignment == 'center' %}
    #shopify-section-{{ section.id }} { margin-bottom: {{ section.settings.spacing_desktop }}px; }
  {% elsif section.settings.text_alignment == 'aside' %}
    #shopify-section-{{ section.id }} .m6ac { margin-bottom: {{ section.settings.spacing_desktop | minus: 22 }}px; }
  {% else %}
    #shopify-section-{{ section.id }} .l4cl { margin-bottom: {{ section.settings.spacing_desktop | minus: 22 }}px; }
  {% endif %}
  }

  @media only screen and (max-width: 47.5em) {
  {% if link %}
    #shopify-section-{{ section.id }} { margin-bottom: {{ section.settings.spacing_mobile }}px; }
  {% else %}
    #shopify-section-{{ section.id }} .l4cl { margin-bottom: {{ section.settings.spacing_mobile | minus: 8 }}px; }
  {% endif %}
  }
</style>


<script>
  (function() {
    class LightningProductScroll {
      constructor(sectionId) {
        this.section = document.querySelector(`#shopify-section-${sectionId}`);
        if (!this.section) return;

        this.grid = this.section.querySelector(`#product-grid-${sectionId}`);
        this.trigger = this.section.querySelector('.infinite-scroll-trigger');
        if (!this.trigger || !this.grid) return;

        this.isFetching = false;
        this.cachedFragment = null;
        this.nextUrl = this.trigger.getAttribute('data-next-url');

        this.initObserver();
        
        // Start background prefetch immediately when browser is idle
        if ('requestIdleCallback' in window) {
          requestIdleCallback(() => this.prefetchNextPage());
        } else {
          setTimeout(() => this.prefetchNextPage(), 200);
        }
      }

      

      // Pre-downloads and pre-parses the HTML before the user scrolls
      async prefetchNextPage() {
        if (!this.nextUrl || this.isFetching || this.cachedFragment) return;

        this.isFetching = true;
        try {
          const response = await fetch(this.nextUrl, { priority: 'low' });
          const htmlText = await response.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(htmlText, 'text/html');

          const newItems = Array.from(doc.querySelectorAll(`#${this.grid.id} > *`));
          const nextTrigger = doc.querySelector(`#shopify-section-${this.section.id.replace('shopify-section-', '')} .infinite-scroll-trigger`);

          if (newItems.length > 0) {
            // Build DOM fragment in memory ahead of time
            const fragment = document.createDocumentFragment();
            newItems.forEach((item) => fragment.appendChild(item));
            this.cachedFragment = fragment;
          }

          this.nextUrl = nextTrigger ? nextTrigger.getAttribute('data-next-url') : null;
        } catch (err) {
          console.error('Prefetch error:', err);
        } finally {
          this.isFetching = false;
        }
      }

      initObserver() {
        // Trigger check when 300px from bottom on mobile, 600px on desktop
        const isMobile = window.innerWidth <= 768;
        const margin = isMobile ? '300px' : '600px';

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.renderNextBatch();
            }
          });
        }, {
          rootMargin: `0px 0px ${margin} 0px`,
          threshold: 0.01
        });

        this.observer.observe(this.trigger);
      }

      async renderNextBatch() {
        // If background prefetch is still in progress, wait for it
        if (!this.cachedFragment && this.nextUrl && this.isFetching) {
          let checkCount = 0;
          while (this.isFetching && checkCount < 20) {
            await new Promise((resolve) => setTimeout(resolve, 50));
            checkCount++;
          }
        }

        // If not cached yet (slow network), fetch immediately
        if (!this.cachedFragment && this.nextUrl && !this.isFetching) {
          await this.prefetchNextPage();
        }

        // Instant insertion from memory
        if (this.cachedFragment) {
          requestAnimationFrame(() => {
            this.grid.appendChild(this.cachedFragment);
            this.cachedFragment = null;

            if (this.nextUrl) {
              this.trigger.setAttribute('data-next-url', this.nextUrl);
              // Immediately prefetch the NEXT page (Page 3, 4, etc.) in background
              this.prefetchNextPage();
            } else {
              this.destroy();
            }

            // Re-bind image lazyloading and quick-buy events
            window.dispatchEvent(new Event('resize'));
            document.dispatchEvent(new CustomEvent('theme:loading:end', { bubbles: true }));
          });
        } else if (!this.nextUrl) {
          this.destroy();
        }
      }

      destroy() {
        if (this.observer) this.observer.disconnect();
        if (this.trigger) this.trigger.remove();
      }
    }

    const sectionId = '{{ section.id }}';

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => new LightningProductScroll(sectionId));
    } else {
      new LightningProductScroll(sectionId);
    }

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', (e) => {
        if (e.detail.sectionId === sectionId) {
          new LightningProductScroll(sectionId);
        }
      });
    }
  })();
</script>
