{%- comment -%}
  Page collection ORDINATEUR (prototype validé « Platinumshop-Collezione-desktop-v3 », inspiré de shop.com) : bandeau aux
  couleurs du site (fil d'Ariane, titre, avantages, photos de la collection animées comme la bannière de l'accueil),
  catégories en carrés arrondis (sous-collections du menu), 3 bannières (meilleures ventes, nouveautés, sous 20 €), rails
  « Preferiti per un motivo » / « Appena arrivati » ; puis « Tutti i prodotti » : rangée de filtres centrée (⇄ = panneau
  « Filtri » à gauche avec les vrais filtres Shopify ; chaque pastille ouvre sa fenêtre ; « Fatto » applique), tri, vraies
  cartes snippets/mshein-card.liquid 5 par ligne comme l'accueil, pages numérotées ; icône panier d'une carte : fenêtre
  « Aggiungi al carrello » du site (snippets/mobile-quick-add.liquid).
  Ordinateur uniquement : cachée jusqu'à 760px (la page collection mobile ne change pas) ; sur ordinateur les autres
  sections de la page collection sont cachées.
  part : page (toute la page ; aussi template collection.desktop-coll, sans layout, redemandé à chaque filtre / tri /
  page / collection et pour les rails par assets/desktop-collection.js) ou sale (« In offerta » : produits avec prix
  barré, 48 lus à la fois, template collection.desktop-coll-sale).
  Aussi la page de recherche ordinateur (templates search.json, search.desktop-coll, search.desktop-coll-sale) : même
  bandeau (photos des résultats) et même liste, avec les résultats, filtres et tris de la recherche Shopify.
  Styles : assets/desktop-collection.css ; script : assets/desktop-collection.js.
{%- endcomment -%}
{%- liquid
  assign best = collections['bestsellers']
  assign best_ids = best.products | map: 'id' | join: ','
  capture flag
    render 'country-flag-emoji'
  endcapture
  assign part = section.settings.part | default: 'page'
-%}

{%- if part == 'sale' -%}
  <ul data-dcl-sale>
    {%- if template.name == 'search' -%}
      {%- paginate search.results by 48 -%}
        {%- for product in search.results -%}
          {%- if product.object_type != 'product' -%}{%- continue -%}{%- endif -%}
          {%- assign sale_variant = product.selected_or_first_available_variant -%}
          {%- unless sale_variant.compare_at_price > sale_variant.price -%}{%- continue -%}{%- endunless -%}
          {%- render 'mshein-card', product: product, best: best, best_ids: best_ids, flag: flag -%}
        {%- endfor -%}
        {%- if paginate.next -%}<li hidden data-dcl-next="{{ paginate.next.url }}"></li>{%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      {%- paginate collection.products by 48 -%}
        {%- for product in collection.products -%}
          {%- assign sale_variant = product.selected_or_first_available_variant -%}
          {%- unless sale_variant.compare_at_price > sale_variant.price -%}{%- continue -%}{%- endunless -%}
          {%- render 'mshein-card', product: product, best: best, best_ids: best_ids, flag: flag -%}
        {%- endfor -%}
        {%- if paginate.next -%}<li hidden data-dcl-next="{{ paginate.next.url }}"></li>{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </ul>
{%- else -%}
{%- liquid
  assign menu = linklists[section.settings.menu]
  if menu == blank
    assign menu = linklists['main-menu']
  endif
  assign handle = collection.handle
  assign name = collection.title | remove: ' - Tutte' | remove: ' - Tutti' | remove: ' - tutte' | remove: ' - tutti'

  # Recherche : même page, avec les résultats, filtres et tris de la recherche à la place de ceux de la collection
  assign is_search = false
  if template.name == 'search'
    assign is_search = true
    assign handle = ''
    if search.performed
      # Texte de la traduction déjà échappé (guillemets, terme) : remis en texte simple, échappé une fois à l'affichage
      assign name = 'search.results_plus_term' | t: term: search.terms | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&amp;', '&'
    else
      assign name = 'search.title' | t
    endif
    assign src_filters = search.filters
    assign src_sorts = search.sort_options
    assign sort_current = search.sort_by | default: search.default_sort_by
    assign src_count = search.results_count
    assign page_url = routes.search_url
    assign page_title = name
  else
    assign src_filters = collection.filters
    assign src_sorts = collection.sort_options
    assign sort_current = collection.sort_by | default: collection.default_sort_by
    assign src_count = collection.products_count
    assign page_url = collection.url
    assign page_title = collection.title
  endif

  # Place de la collection dans le menu : rayon → sous-lien → sous-sous-lien (premier trouvé)
  assign top_title = ''
  assign top_url = ''
  assign top_handle = ''
  assign kid_title = ''
  assign kid_url = ''
  assign kid_handle = ''
  assign grand_title = ''
  for top in menu.links
    unless top.url contains '/collections/'
      continue
    endunless
    assign t_handle = top.url | split: '/collections/' | last | split: '?' | first | split: '/' | first
    if t_handle == handle
      assign top_title = top.title
      assign top_url = top.url
      assign top_handle = t_handle
      break
    endif
    for kid in top.links
      assign k_handle = kid.url | split: '/collections/' | last | split: '?' | first | split: '/' | first
      if k_handle == handle
        assign top_title = top.title
        assign top_url = top.url
        assign top_handle = t_handle
        assign kid_title = kid.title
        assign kid_url = kid.url
        assign kid_handle = k_handle
        break
      endif
      for grand in kid.links
        assign g_handle = grand.url | split: '/collections/' | last | split: '?' | first | split: '/' | first
        if g_handle == handle
          assign top_title = top.title
          assign top_url = top.url
          assign top_handle = t_handle
          assign kid_title = kid.title
          assign kid_url = kid.url
          assign kid_handle = k_handle
          assign grand_title = grand.title
          break
        endif
      endfor
      if top_title != ''
        break
      endif
    endfor
    if top_title != ''
      break
    endif
  endfor

  # Bannière : « COLLEZIONE | Donna · Scarpe », titre + petite phrase du rayon
  if top_title == ''
    assign kicker = shop.name
  elsif top_handle == handle
    assign kicker = top_title
  elsif kid_title != '' and kid_handle != handle
    assign kicker = top_title | append: ' · ' | append: kid_title
  else
    assign kicker = top_title
  endif
  assign tag_key = top_handle | default: handle | replace: '-', '_'
  assign tag_key = 'desktop_collection.tags.' | append: tag_key
  assign tagline = tag_key | t
  if tagline contains 'translation missing' or tagline contains 'Translation missing'
    assign tagline = 'desktop_collection.tag_default' | t
  endif

  assign sort_label = ''
  for option in src_sorts
    if option.value == sort_current
      assign sort_label = option.name
    endif
  endfor
  assign color_order = 'black,white,gray,red,burgundy,pink,orange,yellow,green,olive,blue,navy,lightblue,purple,brown,camel,khaki,beige,gold,silver,multicolor' | split: ','
  assign size_order = '3xs,xxs,xs,s,m,l,xl,2xl,3xl,4xl,5xl,6xl,one' | split: ','
  assign under_amount = 20
  assign active_count = 0
  for filter in src_filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor
-%}
<script src="{{ 'desktop-collection.js' | asset_url }}" defer></script>
<style>
  @media only screen and (max-width: 760px) {
    #shopify-section-{{ section.id }} { display: none !important; }
  }
  @media only screen and (min-width: 761px) {
    .template-collection #content > .shopify-section:not(#shopify-section-{{ section.id }}):not(.shopify-section-footer),
    .template-search #content > .shopify-section:not(#shopify-section-{{ section.id }}):not(.shopify-section-footer) { display: none !important; }
  }
</style>

<div class="dcl" data-dcl data-handle="{{ handle }}" data-url="{{ page_url }}" data-top="{{ top_url | split: '?' | first }}" data-title="{{ page_title | escape }} &ndash; {{ shop.name | escape }}" data-added="{{ 'mobile.js.added_to_wishlist' | t | escape }}" data-removed="{{ 'mobile.js.removed_from_wishlist' | t | escape }}" data-preview="{{ 'desktop_home_shop.preview' | t | escape }}">
  {%- comment -%} Pleine largeur dès le premier affichage (même calcul que assets/desktop-collection.js au redimensionnement). {%- endcomment -%}
  <script>
    (function (root) {
      if (!root || window.matchMedia('(max-width: 760px)').matches) return;
      root.style.setProperty('--dcl-x', root.parentElement.getBoundingClientRect().left + 'px');
      root.style.setProperty('--dcl-w', document.documentElement.clientWidth + 'px');
    })(document.currentScript.parentElement);
  </script>

  {%- liquid
    # Tuiles des catégories : sous-collections de la place de la collection dans le menu (rayon : ses catégories puis
    # leurs sous-catégories ; catégorie : ses sous-catégories ; sous-catégorie : ses voisines ; hors menu : les rayons)
    assign tiles_top = nil
    assign tiles_kid = nil
    for top in menu.links
      if top.title == top_title and top.url == top_url
        assign tiles_top = top
        for kid in top.links
          if kid.title == kid_title and kid.url == kid_url
            assign tiles_kid = kid
          endif
        endfor
        break
      endif
    endfor
    if tiles_top == nil
      assign tile_links = menu.links
    elsif tiles_kid == nil
      assign tile_links = tiles_top.links
      for kid in tiles_top.links
        assign tile_links = tile_links | concat: kid.links
      endfor
    elsif tiles_kid.links.size > 0
      assign tile_links = tiles_kid.links
    else
      assign tile_links = tiles_top.links
    endif

    # Bannières : meilleure vente (ordre de la collection), dernier arrivé, un produit sous 20 € (trois produits différents)
    assign b_best = nil
    for product in collection.products
      if product.featured_image
        assign b_best = product
        break
      endif
    endfor
    assign by_date = collection.products | sort: 'created_at' | reverse
    assign b_new = nil
    for product in by_date
      if product.featured_image and product.id != b_best.id
        assign b_new = product
        break
      endif
    endfor
    assign under_cents = under_amount | times: 100
    assign under_filter = src_filters | where: 'type', 'price_range' | first
    assign b_under = nil
    for product in collection.products
      if product.featured_image and product.id != b_best.id and product.id != b_new.id and product.price < under_cents
        assign b_under = product
        break
      endif
    endfor
    assign under_money = under_cents | money_without_trailing_zeros | strip_html
    assign shipping_amount = ''
    if settings.enable_free_shipping and settings.free_shipping_amount > 0
      assign shipping_amount = settings.free_shipping_amount | times: 100 | money_without_trailing_zeros | strip_html
    endif
  -%}
  {%- comment -%} ---------- Bandeau : fil d'Ariane, titre, nombre, avantages ; à droite photos de la collection qui
    entrent, flottent puis laissent la place aux suivantes (comme la bannière de l'accueil) ---------- {%- endcomment -%}
  <section class="cph" data-cph>
    <div class="cph__txt">
      <nav class="cph__bc" aria-label="{{ 'mobile.cart.breadcrumb' | t | escape }}">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        {%- if top_title != '' and top_handle != handle -%}<i>›</i><a href="{{ top_url }}">{{ top_title | escape }}</a>{%- endif -%}
        {%- if kid_title != '' and kid_handle != handle -%}<i>›</i><a href="{{ kid_url }}">{{ kid_title | escape }}</a>{%- endif -%}
        <i>›</i><b>{%- if is_search -%}{{ 'search.title' | t }}{%- else -%}{{ collection.title | escape }}{%- endif -%}</b>
      </nav>
      <h1 class="cph__title">{{ name | escape }}</h1>
      <p class="cph__copy">{%- if is_search -%}{{ 'desktop_collection.count' | t: count: src_count }}{%- elsif handle == 'all' -%}{{ 'desktop_collection.all_copy' | t: shop: shop.name }}{%- else -%}{{ 'desktop_collection.count_copy' | t: count: collection.all_products_count }}{%- endif -%}{%- unless is_search %} {{ 'desktop_collection.weekly' | t }}{%- endunless -%}</p>
      <div class="cph__usp">
        {%- if shipping_amount != '' -%}<span>🚚 {{ 'desktop_home.free_shipping_from_html' | t: amount: shipping_amount }}</span>{%- endif -%}
        <span>↩ {{ 'desktop_collection.usp_return' | t }}</span>
        <span>💳 {{ 'desktop_collection.usp_klarna' | t }}</span>
      </div>
      <a class="cph__cta" href="#dcl-list" data-rh-all>{{ 'desktop_collection.see_all' | t }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14m-6-6 6 6 6-6"/></svg></a>
    </div>
    <div class="cph__art" aria-hidden="true">
      {%- assign pics = '' -%}
      {%- assign pic_count = 0 -%}
      {%- if is_search -%}{%- assign pic_source = search.results -%}{%- else -%}{%- assign pic_source = collection.products -%}{%- endif -%}
      {%- for product in pic_source -%}
        {%- if product.featured_image == blank -%}{%- continue -%}{%- endif -%}
        {%- if is_search and product.object_type != 'product' -%}{%- continue -%}{%- endif -%}
        {%- capture pic -%}{{ product.featured_image | image_url: width: 400 | json }}{%- endcapture -%}
        {%- if pics != '' -%}{%- assign pics = pics | append: ',' -%}{%- endif -%}
        {%- assign pics = pics | append: pic -%}
        {%- assign pic_count = pic_count | plus: 1 -%}
        {%- if pic_count == 16 -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- for slot in (1..4) -%}<span class="cph-fl cph-fl--{{ forloop.index }}"><span class="cph-fl__in"><img alt="" width="140" height="190"></span></span>{%- endfor -%}
      <script type="application/json" data-cph-pics>[{{ pics }}]</script>
    </div>
  </section>

  {%- unless is_search -%}
  {%- comment -%} ---------- Catégories : carrés arrondis comme les tuiles de l'accueil ---------- {%- endcomment -%}
  <div class="cpt">
    <div class="cpt__row" data-cpt-row>
      {%- assign tile_count = 0 -%}
      {%- for link in tile_links -%}
        {%- unless link.url contains '/collections/' -%}{%- continue -%}{%- endunless -%}
        {%- assign l_handle = link.url | split: '/collections/' | last | split: '?' | first | split: '/' | first -%}
        {%- assign tile_image = link.object.featured_image -%}
        {%- if tile_image == blank and link.object.products -%}{%- assign tile_image = link.object.products.first.featured_image -%}{%- endif -%}
        <a class="cpt__tile{% if l_handle == handle %} is-on{% endif %}" href="{{ link.url }}"{% if l_handle == handle %} aria-current="page"{% endif %}>
          <span class="cpt__img">{%- if tile_image -%}<img src="{{ tile_image | image_url: width: 200, height: 200, crop: 'center' }}" alt="" width="100" height="100" loading="lazy">{%- endif -%}</span>
          <span class="cpt__name">{{ link.title | escape }}</span>
        </a>
        {%- assign tile_count = tile_count | plus: 1 -%}
        {%- if tile_count == 30 -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
    </div>
    <button type="button" class="cpt__next" data-cpt-next aria-label="{{ 'desktop_collection.more_categories' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
  </div>

  {%- comment -%} ---------- 3 bannières : meilleures vendite, novità, sotto 20 € (liens = même collection triée / filtrée) ---------- {%- endcomment -%}
  {%- assign go = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>' -%}
  <div class="cpb">
    {%- if b_best -%}<a class="cpb__card" href="{{ collection.url }}?sort_by=best-selling"><img src="{{ b_best.featured_image | image_url: width: 900 }}" alt="" width="900" height="600" loading="lazy"><span class="cpb__t"><b>{{ 'desktop_collection.best_title' | t }}</b><span>{{ 'desktop_collection.best_sub' | t }}</span></span><span class="cpb__go">{{ go }}</span></a>{%- endif -%}
    {%- if b_new -%}<a class="cpb__card" href="{{ collection.url }}?sort_by=created-descending"><img src="{{ b_new.featured_image | image_url: width: 900 }}" alt="" width="900" height="600" loading="lazy"><span class="cpb__t"><b>{{ 'desktop_collection.new_title' | t }}</b><span>{{ 'desktop_collection.new_sub' | t }}</span></span><span class="cpb__go">{{ go }}</span></a>{%- endif -%}
    {%- if b_under and under_filter -%}<a class="cpb__card" href="{{ collection.url }}?{{ under_filter.max_value.param_name }}={{ under_amount }}"><img src="{{ b_under.featured_image | image_url: width: 900 }}" alt="" width="900" height="600" loading="lazy"><span class="cpb__t"><b>{{ 'desktop_collection.under_title' | t: amount: under_money }}</b><span>{{ 'desktop_collection.under_sub' | t }}</span></span><span class="cpb__go">{{ go }}</span></a>{%- endif -%}
  </div>

  {%- comment -%} ---------- Deux rails : meilleures ventes et nouveautés de la collection (remplis par assets/desktop-collection.js) ---------- {%- endcomment -%}
  <div class="cpr">
    {%- assign rail_urls = 'best-selling,created-descending' | split: ',' -%}
    {%- for sort_value in rail_urls -%}
      {%- if forloop.first -%}{%- assign rail_title = 'desktop_collection.rail_best' | t -%}{%- else -%}{%- assign rail_title = 'desktop_collection.new_title' | t -%}{%- endif -%}
      <section class="cpr__panel" data-cpr="{{ collection.url }}?sort_by={{ sort_value }}">
        <div class="cpr__hd"><h2>{{ rail_title | escape }}</h2><a class="cpr__go" href="{{ collection.url }}?sort_by={{ sort_value }}" aria-label="{{ 'desktop_collection.see_all' | t | escape }}">{{ go }}</a></div>
        <div class="cpr__rail" data-cpr-rail>{%- for i in (1..6) -%}<span class="cpr__sk"></span>{%- endfor -%}</div>
        <button type="button" class="cpr__next" data-cpr-next aria-label="{{ 'mobile.pdp.next' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
      </section>
    {%- endfor -%}
  </div>
  {%- endunless -%}

  <main class="wrap cl" id="dcl-list">
    <div class="cl__layout">
      {%- comment -%}
        Panneau « Filtri » à gauche (bouton ⇄ de la rangée de filtres) : les vrais filtres Shopify (couleurs et tailles
        regroupées comme le mobile). Les choix s'appliquent avec « Fatto » ; les pastilles de la rangée ouvrent chacune une
        fenêtre avec la section correspondante (copiée par assets/desktop-collection.js).
      {%- endcomment -%}
      {%- assign pills = '' -%}
      <section class="cpd" data-dcl-filters aria-label="{{ 'desktop_collection.filters' | t | escape }}">
        <div class="cpd__bg" data-cpd-close></div>
        <div class="cpd__pane" role="dialog" aria-modal="true" aria-label="{{ 'desktop_collection.filters' | t | escape }}">
          <div class="cpd__hd"><b>{{ 'desktop_collection.filters' | t }}</b><button type="button" class="cpd__x" data-cpd-close aria-label="{{ 'mobile.pdp.close' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
          <div class="cpd__body">
          {%- for filter in src_filters -%}
            {%- liquid
              assign group_name = filter.label | downcase
              assign first_param = filter.values.first.param_name | default: '' | downcase
              assign kind = 'list'
              if filter.type == 'price_range'
                assign kind = 'price'
              elsif first_param contains 'availability'
                assign kind = 'switch'
              elsif first_param contains 'color' or first_param contains 'colour' or group_name contains 'color' or group_name contains 'colour' or group_name contains 'couleur' or group_name contains 'farbe' or group_name contains 'kleur' or group_name contains 'culoare'
                assign kind = 'color'
              elsif first_param contains 'shoe' or first_param contains 'scarpa' or group_name contains 'scarpa' or group_name contains 'shoe' or group_name contains 'pointure' or group_name contains 'schuh' or group_name contains 'zapato' or group_name contains 'schoen' or group_name contains 'pantof'
                assign kind = 'shoe'
              elsif first_param contains 'size' or first_param contains 'taglia' or first_param contains 'dimensione' or group_name contains 'taglia' or group_name contains 'size' or group_name contains 'dimensione' or group_name contains 'taille' or group_name contains 'größe' or group_name contains 'talla' or group_name contains 'maat' or group_name contains 'mărime'
                assign kind = 'size'
              endif
              assign visible = 0
              for value in filter.values
                if value.count > 0 or value.active
                  assign visible = visible | plus: 1
                endif
              endfor
              if kind == 'price'
                assign filter_on = 0
                if filter.min_value.value != nil or filter.max_value.value != nil
                  assign filter_on = 1
                endif
              else
                assign filter_on = filter.active_values.size
              endif
            -%}
            {%- if kind != 'price' and visible == 0 -%}{%- continue -%}{%- endif -%}
            {%- comment -%} Pastille de la rangée : « Disponibili » s'applique tout de suite ; les autres ouvrent leur fenêtre {%- endcomment -%}
            {%- capture pill -%}
              {%- if kind == 'switch' -%}
                {%- for value in filter.values -%}
                  {%- if value.value != '1' -%}{%- continue -%}{%- endif -%}
                  <button type="button" class="cpf__pill{% if value.active %} is-on{% endif %}" data-cpf-q="{{ value.param_name | url_encode }}={{ value.value | url_encode }}">{{ 'mobile.collection.available' | t }}</button>
                {%- endfor -%}
              {%- else -%}
                <span class="cpf__dd"><button type="button" class="cpf__pill{% if filter_on > 0 %} is-on{% endif %}" data-cpf-dd="{{ forloop.index0 }}" aria-expanded="false">{{ filter.label | escape }}<span data-cpf-n></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></button></span>
              {%- endif -%}
            {%- endcapture -%}
            {%- assign pills = pills | append: pill -%}
            <div class="flt__sec is-open" data-kind="{{ kind }}" data-fi="{{ forloop.index0 }}">
              <button type="button" class="flt__tg">{{ filter.label | escape }}<i></i></button>
              {%- case kind -%}
                {%- when 'switch' -%}
                  <div class="flt__body">
                    {%- for value in filter.values -%}
                      {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
                      {%- comment -%} Comme le prototype : seulement « Disponibile » (sauf autre valeur déjà choisie) {%- endcomment -%}
                      {%- if value.value != '1' and value.active == false -%}{%- continue -%}{%- endif -%}
                      {%- if value.value == '1' -%}{%- assign value_label = 'mobile.collection.available' | t -%}{%- else -%}{%- assign value_label = value.label -%}{%- endif -%}
                      <button type="button" class="flt__opt{% if value.active %} is-on{% endif %}" data-q="{{ value.param_name | url_encode }}={{ value.value | url_encode }}" data-label="{{ value_label | escape }}">{{ value_label | escape }}<em>{{ value.count }}</em></button>
                    {%- endfor -%}
                  </div>
                {%- when 'price' -%}
                  {%- liquid
                    assign price_max = filter.range_max | divided_by: 100.0 | ceil
                    assign price_min_value = ''
                    if filter.min_value.value != nil
                      assign price_min_value = filter.min_value.value | divided_by: 100.0
                      assign price_min_cents = filter.min_value.value | modulo: 100
                      if price_min_cents == 0
                        assign price_min_value = filter.min_value.value | divided_by: 100
                      endif
                    endif
                    assign price_max_value = ''
                    if filter.max_value.value != nil
                      assign price_max_value = filter.max_value.value | divided_by: 100.0
                      assign price_max_cents = filter.max_value.value | modulo: 100
                      if price_max_cents == 0
                        assign price_max_value = filter.max_value.value | divided_by: 100
                      endif
                    endif
                  -%}
                  <div class="flt__body">
                    <div class="flt__price" data-dcl-price data-min="{{ filter.min_value.param_name }}" data-max="{{ filter.max_value.param_name }}">
                      <label>{{ 'desktop_collection.from' | t }} {{ cart.currency.symbol }}<input type="number" min="0" step="0.01" inputmode="decimal" value="{{ price_min_value }}" placeholder="0" data-dcl-price-min></label>
                      <span>–</span>
                      <label>{{ 'desktop_collection.to' | t }} {{ cart.currency.symbol }}<input type="number" min="0" step="0.01" inputmode="decimal" value="{{ price_max_value }}" placeholder="{{ price_max }}" data-dcl-price-max></label>
                      <button type="button" data-dcl-price-ok>{{ 'desktop_collection.ok' | t }}</button>
                    </div>
                  </div>
                {%- when 'color' -%}
                  {%- liquid
                    assign value_families = ''
                    for value in filter.values
                      capture family
                        render 'mshein-color-family', label: value.label
                      endcapture
                      assign value_families = value_families | append: family | append: ','
                    endfor
                    assign value_families = value_families | split: ','
                  -%}
                  <div class="flt__body flt__colors">
                    {%- for key in color_order -%}
                      {%- assign family_q = '' -%}
                      {%- assign family_on = false -%}
                      {%- for value in filter.values -%}
                        {%- if value_families[forloop.index0] == key -%}
                          {%- if value.count > 0 or value.active -%}
                            {%- capture pair -%}{{ value.param_name | url_encode }}={{ value.value | url_encode }}{%- endcapture -%}
                            {%- if family_q != '' -%}{%- assign family_q = family_q | append: '&' -%}{%- endif -%}
                            {%- assign family_q = family_q | append: pair -%}
                            {%- if value.active -%}{%- assign family_on = true -%}{%- endif -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if family_q != '' -%}
                        {%- assign color_key = 'mobile.collection.colors.' | append: key -%}
                        {%- assign color_name = color_key | t -%}
                        <button type="button" class="flt__col{% if family_on %} is-on{% endif %}" data-q="{{ family_q | escape }}" data-label="{{ color_name | escape }}"><span class="is-{{ key }}"></span>{{ color_name | escape }}</button>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- for value in filter.values -%}
                      {%- if value_families[forloop.index0] == '-' and value.active -%}
                        <button type="button" class="flt__col is-on" data-q="{{ value.param_name | url_encode }}={{ value.value | url_encode }}" data-label="{{ value.label | escape }}"><span></span>{{ value.label | escape }}</button>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- when 'size' -%}
                  {%- liquid
                    assign value_sizes = ''
                    for value in filter.values
                      capture size_key
                        render 'mshein-size-family', label: value.label
                      endcapture
                      assign value_sizes = value_sizes | append: size_key | append: ','
                    endfor
                    assign value_sizes = value_sizes | split: ','
                  -%}
                  <div class="flt__body flt__sizes" data-dcl-more-list="24">
                    {%- for key in size_order -%}
                      {%- assign family_q = '' -%}
                      {%- assign family_on = false -%}
                      {%- assign family_count = 0 -%}
                      {%- for value in filter.values -%}
                        {%- if value_sizes[forloop.index0] == key -%}
                          {%- if value.count > 0 or value.active -%}
                            {%- capture pair -%}{{ value.param_name | url_encode }}={{ value.value | url_encode }}{%- endcapture -%}
                            {%- if family_q != '' -%}{%- assign family_q = family_q | append: '&' -%}{%- endif -%}
                            {%- assign family_q = family_q | append: pair -%}
                            {%- assign family_count = family_count | plus: value.count -%}
                            {%- if value.active -%}{%- assign family_on = true -%}{%- endif -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if family_q != '' -%}
                        {%- if key == 'one' -%}{%- assign size_name = 'mobile.collection.one_size' | t -%}{%- else -%}{%- assign size_name = key | upcase -%}{%- endif -%}
                        <button type="button" class="flt__size{% if family_on %} is-on{% endif %}" data-q="{{ family_q | escape }}" data-label="{{ filter.label | escape }} {{ size_name | escape }}">{{ size_name | escape }}</button>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- for value in filter.values -%}
                      {%- if value_sizes[forloop.index0] != '-' -%}{%- continue -%}{%- endif -%}
                      {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
                      <button type="button" class="flt__size{% if value.active %} is-on{% endif %}" data-q="{{ value.param_name | url_encode }}={{ value.value | url_encode }}" data-label="{{ filter.label | escape }} {{ value.label | escape }}" title="{{ value.count }}">{{ value.label | escape }}</button>
                    {%- endfor -%}
                  </div>
                {%- when 'shoe' -%}
                  <div class="flt__body flt__sizes" data-dcl-more-list="24" data-dcl-numeric>
                    {%- assign shoe_prefix = 'mobile.collection.shoe_prefix' | t -%}
                    {%- for value in filter.values -%}
                      {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
                      <button type="button" class="flt__size{% if value.active %} is-on{% endif %}" data-q="{{ value.param_name | url_encode }}={{ value.value | url_encode }}" data-label="{{ shoe_prefix | escape }} {{ value.label | escape }}" title="{{ value.count }}">{{ value.label | escape }}</button>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="flt__body" data-dcl-more-list="7" data-dcl-by-count>
                    {%- for value in filter.values -%}
                      {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
                      <button type="button" class="flt__opt{% if value.active %} is-on{% endif %}" data-q="{{ value.param_name | url_encode }}={{ value.value | url_encode }}" data-label="{{ value.label | escape }}">{{ value.label | escape }}<em>{{ value.count }}</em></button>
                    {%- endfor -%}
                  </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}
          </div>
          <div class="cpd__ft"><button type="button" class="cp-reset" data-dcl-clear>{{ 'desktop_collection.reset' | t }}</button><button type="button" class="cp-done" data-cp-apply>{{ 'desktop_collection.done' | t }}</button></div>
        </div>
      </section>

      <div class="cl__main" data-dcl-main
        data-more="{{ 'mobile.collection.show_others' | t: count: '__N__' | escape }}" data-less="{{ 'mobile.collection.show_less' | t | escape }}"
        data-price-label="{{ cart.currency.symbol }}" data-reset="{{ 'desktop_collection.reset' | t | escape }}" data-done="{{ 'desktop_collection.done' | t | escape }}">
        <h2 class="cl__title">{{ 'desktop_collection.all_products' | t }}</h2>
        <p class="cl__found" data-dcl-found>{{ 'desktop_collection.count' | t: count: src_count }}</p>
        {%- comment -%} Rangée de filtres centrée (comme shop.com), collée sous l'en-tête pendant le défilement {%- endcomment -%}
        <div class="cpf">
          <button type="button" class="cpf__pill cpf__pill--ico{% if active_count > 0 %} is-on{% endif %}" data-cpd-open aria-label="{{ 'desktop_collection.all_filters' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg><i data-cpf-total hidden></i></button>
          <button type="button" class="cpf__pill" data-dcl-sale-chip>{{ 'mobile.explore.on_sale' | t }}</button>
          {%- if under_filter -%}
            {%- assign under_on = false -%}
            {%- if under_filter.max_value.value == under_cents and under_filter.min_value.value == nil -%}{%- assign under_on = true -%}{%- endif -%}
            <button type="button" class="cpf__pill{% if under_on %} is-on{% endif %}" data-dcl-under="{{ under_filter.max_value.param_name }}={{ under_amount }}" data-min="{{ under_filter.min_value.param_name }}">{{ 'desktop_collection.under' | t: amount: under_money }}</button>
          {%- endif -%}
          {{ pills }}
          <div class="srt cpf__dd">
            <button type="button" class="cpf__pill srt__btn" aria-haspopup="listbox" aria-expanded="false" data-dcl-sort-btn>{{ 'desktop_collection.sort_short' | t }}: <b>{{ sort_label | escape }}</b><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></button>
            <div class="srt__menu" role="listbox" hidden data-dcl-sort-menu>
              {%- for option in src_sorts -%}
                <button type="button" data-s="{{ option.value }}"{% if option.value == sort_current %} class="is-on"{% endif %}>{{ option.name | escape }}</button>
              {%- endfor -%}
            </div>
          </div>
        </div>
        <div class="act-f" data-dcl-active></div>
        {%- comment -%} Produits de la collection ou résultats de la recherche (produits seulement) {%- endcomment -%}
        {%- if is_search -%}
        {%- paginate search.results by 40 -%}
          {%- assign grid_count = 0 -%}
          {%- capture grid_cards -%}
            {%- for product in search.results -%}
              {%- if product.object_type != 'product' -%}{%- continue -%}{%- endif -%}
              {%- assign grid_count = grid_count | plus: 1 -%}
              {%- render 'mshein-card', product: product, best: best, best_ids: best_ids, flag: flag -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- capture grid_pager -%}
          {%- if paginate.pages > 1 -%}
            <nav class="pager" data-dcl-pager aria-label="{{ 'desktop_collection.pages' | t | escape }}">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="{{ 'mobile.pdp.previous' | t | escape }}">‹</a>{%- else -%}<span class="is-off">‹</span>{%- endif -%}
              {%- assign current_page = paginate.current_page | append: '' -%}
              {%- for part in paginate.parts -%}
                {%- assign part_title = part.title | append: '' -%}
                {%- if part.is_link -%}
                  {%- if part.title == '…' or part.title == '&hellip;' -%}<span>…</span>{%- else -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- endif -%}
                {%- elsif part_title == current_page -%}
                  <b class="is-on">{{ part.title }}</b>
                {%- else -%}
                  <span>…</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="{{ 'mobile.pdp.next' | t | escape }}">›</a>{%- else -%}<span class="is-off">›</span>{%- endif -%}
            </nav>
          {%- endif -%}
          {%- endcapture -%}
        {%- endpaginate -%}
        {%- else -%}
        {%- paginate collection.products by 40 -%}
          {%- assign grid_count = 0 -%}
          {%- capture grid_cards -%}
            {%- for product in collection.products -%}
              {%- assign grid_count = grid_count | plus: 1 -%}
              {%- render 'mshein-card', product: product, best: best, best_ids: best_ids, flag: flag -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- capture grid_pager -%}
          {%- if paginate.pages > 1 -%}
            <nav class="pager" data-dcl-pager aria-label="{{ 'desktop_collection.pages' | t | escape }}">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="{{ 'mobile.pdp.previous' | t | escape }}">‹</a>{%- else -%}<span class="is-off">‹</span>{%- endif -%}
              {%- assign current_page = paginate.current_page | append: '' -%}
              {%- for part in paginate.parts -%}
                {%- assign part_title = part.title | append: '' -%}
                {%- if part.is_link -%}
                  {%- if part.title == '…' or part.title == '&hellip;' -%}<span>…</span>{%- else -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- endif -%}
                {%- elsif part_title == current_page -%}
                  <b class="is-on">{{ part.title }}</b>
                {%- else -%}
                  <span>…</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="{{ 'mobile.pdp.next' | t | escape }}">›</a>{%- else -%}<span class="is-off">›</span>{%- endif -%}
            </nav>
          {%- endif -%}
          {%- endcapture -%}
        {%- endpaginate -%}
        {%- endif -%}
        <ul class="cl__grid" data-dcl-grid>{{ grid_cards }}</ul>
        {%- if grid_count == 0 -%}
          <p class="cl__none">{{ 'desktop_collection.none' | t }} {%- if active_count > 0 -%} <button type="button" data-dcl-clear>{{ 'desktop_collection.clear' | t }}</button>{%- endif -%}</p>
        {%- endif -%}
        <div class="dcl-sale-more" data-dcl-sale-more hidden><button type="button">{{ 'desktop_home.show_more' | t }}</button></div>
        {{ grid_pager }}
      </div>
    </div>
  </main>

</div>
{%- endif -%}

{% schema %}
{
  "name": "Collezione desktop",
  "class": "desktop-collection",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu (Raccolte)", "default": "main-menu" },
    {
      "type": "select",
      "id": "part",
      "label": "Parte",
      "options": [
        { "value": "page", "label": "Pagina" },
        { "value": "sale", "label": "In offerta (pagina successiva)" }
      ],
      "default": "page"
    }
  ],
  "enabled_on": { "templates": ["collection", "search"] },
  "presets": [{ "name": "Collezione desktop" }]
}
{% endschema %}
