{%- comment -%}
  Page collection ORDINATEUR (prototype validé « Platinumshop-Collezione-desktop ») : bannière « appendiabiti » (produits
  de la collection sur une barre courbe), fil d'Ariane, colonne de gauche « Raccolte » (arbre du menu) + « Filtra » (vrais
  filtres Shopify, couleurs et tailles regroupées comme le mobile), barre (nombre, In offerta, Sotto 20, grille / liste,
  tri), vraies cartes snippets/mshein-card.liquid, pages numérotées ; clic sur une carte : vue produit + panier.
  Ordinateur uniquement : cachée jusqu'à 760px (la page collection mobile ne change pas) ; sur ordinateur les autres
  sections de la page collection sont cachées.
  part : page (toute la page ; aussi template collection.desktop-coll, sans layout, redemandé à chaque filtre / tri /
  page / collection par assets/desktop-collection.js) ou sale (« In offerta » : produits avec prix barré, 48 lus à la fois,
  template collection.desktop-coll-sale).
  Styles : assets/desktop-collection.css ; script : assets/desktop-collection.js.
{%- endcomment -%}
{%- liquid
  assign best = collections['bestsellers']
  assign best_ids = best.products | map: 'id' | join: ','
  capture flag
    render 'country-flag-emoji'
  endcapture
  assign part = section.settings.part | default: 'page'
-%}

{%- if part == 'sale' -%}
  <ul data-dcl-sale>
    {%- paginate collection.products by 48 -%}
      {%- for product in collection.products -%}
        {%- assign sale_variant = product.selected_or_first_available_variant -%}
        {%- unless sale_variant.compare_at_price > sale_variant.price -%}{%- continue -%}{%- endunless -%}
        {%- render 'mshein-card', product: product, best: best, best_ids: best_ids, flag: flag -%}
      {%- endfor -%}
      {%- if paginate.next -%}<li hidden data-dcl-next="{{ paginate.next.url }}"></li>{%- endif -%}
    {%- endpaginate -%}
  </ul>
{%- else -%}
{%- liquid
  assign menu = linklists[section.settings.menu]
  if menu == blank
    assign menu = linklists['main-menu']
  endif
  assign handle = collection.handle
  assign name = collection.title | remove: ' - Tutte' | remove: ' - Tutti' | remove: ' - tutte' | remove: ' - tutti'

  # Place de la collection dans le menu : rayon → sous-lien → sous-sous-lien (premier trouvé)
  assign top_title = ''
  assign top_url = ''
  assign top_handle = ''
  assign kid_title = ''
  assign kid_url = ''
  assign kid_handle = ''
  assign grand_title = ''
  for top in menu.links
    unless top.url contains '/collections/'
      continue
    endunless
    assign t_handle = top.url | split: '/collections/' | last | split: '?' | first | split: '/' | first
    if t_handle == handle
      assign top_title = top.title
      assign top_url = top.url
      assign top_handle = t_handle
      break
    endif
    for kid in top.links
      assign k_handle = kid.url | split: '/collections/' | last | split: '?' | first | split: '/' | first
      if k_handle == handle
        assign top_title = top.title
        assign top_url = top.url
        assign top_handle = t_handle
        assign kid_title = kid.title
        assign kid_url = kid.url
        assign kid_handle = k_handle
        break
      endif
      for grand in kid.links
        assign g_handle = grand.url | split: '/collections/' | last | split: '?' | first | split: '/' | first
        if g_handle == handle
          assign top_title = top.title
          assign top_url = top.url
          assign top_handle = t_handle
          assign kid_title = kid.title
          assign kid_url = kid.url
          assign kid_handle = k_handle
          assign grand_title = grand.title
          break
        endif
      endfor
      if top_title != ''
        break
      endif
    endfor
    if top_title != ''
      break
    endif
  endfor

  # Bannière : « COLLEZIONE | Donna · Scarpe », titre + petite phrase du rayon
  if top_title == ''
    assign kicker = shop.name
  elsif top_handle == handle
    assign kicker = top_title
  elsif kid_title != '' and kid_handle != handle
    assign kicker = top_title | append: ' · ' | append: kid_title
  else
    assign kicker = top_title
  endif
  assign tag_key = top_handle | default: handle | replace: '-', '_'
  assign tag_key = 'desktop_collection.tags.' | append: tag_key
  assign tagline = tag_key | t
  if tagline contains 'translation missing' or tagline contains 'Translation missing'
    assign tagline = 'desktop_collection.tag_default' | t
  endif

  assign sort_current = collection.sort_by | default: collection.default_sort_by
  assign sort_label = ''
  for option in collection.sort_options
    if option.value == sort_current
      assign sort_label = option.name
    endif
  endfor
  assign color_order = 'black,white,gray,red,burgundy,pink,orange,yellow,green,olive,blue,navy,lightblue,purple,brown,camel,khaki,beige,gold,silver,multicolor' | split: ','
  assign size_order = '3xs,xxs,xs,s,m,l,xl,2xl,3xl,4xl,5xl,6xl,one' | split: ','
  assign under_amount = 20
  assign active_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor
-%}
<script src="{{ 'desktop-collection.js' | asset_url }}" defer></script>
<style>
  @media only screen and (max-width: 760px) {
    #shopify-section-{{ section.id }} { display: none !important; }
  }
  @media only screen and (min-width: 761px) {
    .template-collection #content > .shopify-section:not(#shopify-section-{{ section.id }}):not(.shopify-section-footer) { display: none !important; }
  }
</style>

<div class="dcl" data-dcl data-handle="{{ handle }}" data-url="{{ collection.url }}" data-top="{{ top_url | split: '?' | first }}" data-title="{{ collection.title | escape }} &ndash; {{ shop.name | escape }}" data-added="{{ 'mobile.js.added_to_wishlist' | t | escape }}" data-removed="{{ 'mobile.js.removed_from_wishlist' | t | escape }}">
  {%- comment -%} Pleine largeur dès le premier affichage (même calcul que assets/desktop-collection.js au redimensionnement). {%- endcomment -%}
  <script>
    (function (root) {
      if (!root || window.matchMedia('(max-width: 760px)').matches) return;
      root.style.setProperty('--dcl-x', root.parentElement.getBoundingClientRect().left + 'px');
      root.style.setProperty('--dcl-w', document.documentElement.clientWidth + 'px');
    })(document.currentScript.parentElement);
  </script>

  {%- comment -%} ---------- Bannière « appendiabiti » : produits de la collection sur une barre courbe ---------- {%- endcomment -%}
  <section class="rh" data-rh aria-label="{{ 'desktop_collection.collection' | t | escape }}">
    <div class="rh__kicker">{{ 'desktop_collection.collection' | t }}<span>{{ kicker | escape }}</span></div>
    <h1 class="rh__title">{{ name | escape }} <span>{{ tagline | escape }}</span></h1>
    <div class="rh__rack" data-rh-rack>
      <svg class="rh__rail" aria-hidden="true"><defs><linearGradient id="dcl-rh-tube" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f4f4f7"/><stop offset=".45" stop-color="#b9b9c1"/><stop offset="1" stop-color="#75757e"/></linearGradient></defs><path data-rh-shadow fill="none" stroke="rgb(0 0 0 / 7%)" stroke-width="12" stroke-linecap="round" transform="translate(0 7)"/><path data-rh-path fill="none" stroke="url(#dcl-rh-tube)" stroke-width="7" stroke-linecap="round"/></svg>
    </div>
    <div class="rh__now"><b data-rh-name></b><span data-rh-price></span><small>{{ 'desktop_collection.hint' | t }}</small></div>
    <div class="rh__prog"><i data-rh-prog></i></div>
    <div class="rh__copy">
      <p>{%- if handle == 'all' -%}{{ 'desktop_collection.all_copy' | t: shop: shop.name }}{%- else -%}{{ 'desktop_collection.count_copy' | t: count: collection.all_products_count }}{%- endif -%}<br>{{ 'desktop_collection.weekly' | t }}</p>
      <a href="#dcl-list" data-rh-all>{{ 'desktop_collection.see_all' | t }} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"/></svg></a>
    </div>
    <script type="application/json" data-rh-data>[
      {%- for product in collection.products limit: 40 -%}
        {%- if product.images.size == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign rh_variant = product.selected_or_first_available_variant -%}
        {"h":{{ product.handle | json }},"t":{{ product.title | json }},"p":{{ rh_variant.price | money | strip_html | json }},"i":[
          {%- for image in product.images limit: 3 -%}{{ image | image_url: width: 700 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
        ]}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]</script>
  </section>

  <main class="wrap cl" id="dcl-list">
    <nav class="cl__bc" aria-label="{{ 'mobile.cart.breadcrumb' | t | escape }}">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
      {%- if top_title != '' and top_handle != handle -%}<span>›</span><a href="{{ top_url }}">{{ top_title | escape }}</a>{%- endif -%}
      {%- if kid_title != '' and kid_handle != handle -%}<span>›</span><a href="{{ kid_url }}">{{ kid_title | escape }}</a>{%- endif -%}
      <span>›</span><b>{{ collection.title | escape }}</b>
    </nav>
    <div class="cl__layout">
      {%- comment -%} Colonne de gauche : « Raccolte » (arbre du menu) et « Filtra » (vrais filtres Shopify) {%- endcomment -%}
      <aside class="side" aria-label="{{ 'desktop_collection.collections' | t | escape }}">
        <section class="side__card">
          <div class="side__hd"><b>{{ 'desktop_collection.collections' | t }}</b><a href="{{ routes.collections_url }}">{{ 'desktop_collection.see_all_short' | t }}</a></div>
          <nav class="tree" data-dcl-tree>
            <ul>
              {%- for top in menu.links -%}
                {%- unless top.url contains '/collections/' -%}{%- continue -%}{%- endunless -%}
                {%- assign t_handle = top.url | split: '/collections/' | last | split: '?' | first | split: '/' | first -%}
                {%- assign on_top = false -%}
                {%- if top.title == top_title and top.url == top_url -%}{%- assign on_top = true -%}{%- endif -%}
                <li class="tree__top{% if on_top %} is-open is-path{% endif %}{% if t_handle == handle %} is-current{% endif %}">
                  <div class="tree__row"><a href="{{ top.url }}"><span>{{ top.title | escape }}</span></a>
                    {%- if top.links.size > 0 -%}<button type="button" class="tree__tg" aria-label="{{ 'desktop_collection.open' | t: name: top.title | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></button>{%- endif -%}
                  </div>
                  {%- if top.links.size > 0 -%}
                    <ul class="tree__kids">
                      {%- for kid in top.links -%}
                        {%- assign k_handle = kid.url | split: '/collections/' | last | split: '?' | first | split: '/' | first -%}
                        {%- assign on_kid = false -%}
                        {%- if on_top and kid.title == kid_title and kid.url == kid_url -%}{%- assign on_kid = true -%}{%- endif -%}
                        {%- assign kid_image = kid.object.featured_image -%}
                        <li class="{% if on_kid %}is-open is-path{% endif %}{% if k_handle == handle %} is-current{% endif %}" data-tree-kid="{{ k_handle }}">
                          <div class="tree__row"><a href="{{ kid.url }}">{%- if kid_image -%}<img src="{{ kid_image | image_url: width: 80, height: 80, crop: 'center' }}" alt="" width="28" height="28" loading="lazy">{%- else -%}<i class="ph"></i>{%- endif -%}<span>{{ kid.title | escape }}</span></a>
                            {%- if kid.links.size > 0 -%}<button type="button" class="tree__tg" aria-label="{{ 'desktop_collection.open' | t: name: kid.title | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></button>{%- endif -%}
                          </div>
                          {%- if kid.links.size > 0 -%}
                            <ul class="tree__grand">
                              {%- for grand in kid.links -%}
                                {%- assign g_handle = grand.url | split: '/collections/' | last | split: '?' | first | split: '/' | first -%}
                                <li><a href="{{ grand.url }}"{% if g_handle == handle %} class="is-current"{% endif %}>{{ grand.title | escape }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </section>

        <section class="side__card" data-dcl-filters>
          <div class="side__hd"><b>{{ 'desktop_collection.filter' | t }}</b><button type="button" data-dcl-clear>{{ 'mobile.collection.clear_all' | t }}</button></div>
          {%- for filter in collection.filters -%}
            {%- liquid
              assign group_name = filter.label | downcase
              assign first_param = filter.values.first.param_name | default: '' | downcase
              assign kind = 'list'
              if filter.type == 'price_range'
                assign kind = 'price'
              elsif first_param contains 'availability'
                assign kind = 'switch'
              elsif first_param contains 'color' or first_param contains 'colour' or group_name contains 'color' or group_name contains 'colour' or group_name contains 'couleur' or group_name contains 'farbe' or group_name contains 'kleur' or group_name contains 'culoare'
                assign kind = 'color'
              elsif first_param contains 'shoe' or first_param contains 'scarpa' or group_name contains 'scarpa' or group_name contains 'shoe' or group_name contains 'pointure' or group_name contains 'schuh' or group_name contains 'zapato' or group_name contains 'schoen' or group_name contains 'pantof'
                assign kind = 'shoe'
              elsif first_param contains 'size' or first_param contains 'taglia' or first_param contains 'dimensione' or group_name contains 'taglia' or group_name contains 'size' or group_name contains 'dimensione' or group_name contains 'taille' or group_name contains 'größe' or group_name contains 'talla' or group_name contains 'maat' or group_name contains 'mărime'
                assign kind = 'size'
              endif
              assign visible = 0
              for value in filter.values
                if value.count > 0 or value.active
                  assign visible = visible | plus: 1
                endif
              endfor
            -%}
            {%- if kind != 'price' and visible == 0 -%}{%- continue -%}{%- endif -%}
            <div class="flt__sec is-open" data-kind="{{ kind }}">
              <button type="button" class="flt__tg">{{ filter.label | escape }}<i></i></button>
              {%- case kind -%}
                {%- when 'switch' -%}
                  <div class="flt__body">
                    {%- for value in filter.values -%}
                      {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
                      {%- comment -%} Comme le prototype : seulement « Disponibile » (sauf autre valeur déjà choisie) {%- endcomment -%}
                      {%- if value.value != '1' and value.active == false -%}{%- continue -%}{%- endif -%}
                      {%- if value.value == '1' -%}{%- assign value_label = 'mobile.collection.available' | t -%}{%- else -%}{%- assign value_label = value.label -%}{%- endif -%}
                      <button type="button" class="flt__opt{% if value.active %} is-on{% endif %}" data-q="{{ value.param_name | url_encode }}={{ value.value | url_encode }}" data-label="{{ value_label | escape }}">{{ value_label | escape }}<em>{{ value.count }}</em></button>
                    {%- endfor -%}
                  </div>
                {%- when 'price' -%}
                  {%- liquid
                    assign price_max = filter.range_max | divided_by: 100.0 | ceil
                    assign price_min_value = ''
                    if filter.min_value.value != nil
                      assign price_min_value = filter.min_value.value | divided_by: 100.0
                      assign price_min_cents = filter.min_value.value | modulo: 100
                      if price_min_cents == 0
                        assign price_min_value = filter.min_value.value | divided_by: 100
                      endif
                    endif
                    assign price_max_value = ''
                    if filter.max_value.value != nil
                      assign price_max_value = filter.max_value.value | divided_by: 100.0
                      assign price_max_cents = filter.max_value.value | modulo: 100
                      if price_max_cents == 0
                        assign price_max_value = filter.max_value.value | divided_by: 100
                      endif
                    endif
                  -%}
                  <div class="flt__body">
                    <div class="flt__price" data-dcl-price data-min="{{ filter.min_value.param_name }}" data-max="{{ filter.max_value.param_name }}">
                      <label>{{ 'desktop_collection.from' | t }} {{ cart.currency.symbol }}<input type="number" min="0" step="0.01" inputmode="decimal" value="{{ price_min_value }}" placeholder="0" data-dcl-price-min></label>
                      <span>–</span>
                      <label>{{ 'desktop_collection.to' | t }} {{ cart.currency.symbol }}<input type="number" min="0" step="0.01" inputmode="decimal" value="{{ price_max_value }}" placeholder="{{ price_max }}" data-dcl-price-max></label>
                      <button type="button" data-dcl-price-ok>{{ 'desktop_collection.ok' | t }}</button>
                    </div>
                  </div>
                {%- when 'color' -%}
                  {%- liquid
                    assign value_families = ''
                    for value in filter.values
                      capture family
                        render 'mshein-color-family', label: value.label
                      endcapture
                      assign value_families = value_families | append: family | append: ','
                    endfor
                    assign value_families = value_families | split: ','
                  -%}
                  <div class="flt__body flt__colors">
                    {%- for key in color_order -%}
                      {%- assign family_q = '' -%}
                      {%- assign family_on = false -%}
                      {%- for value in filter.values -%}
                        {%- if value_families[forloop.index0] == key -%}
                          {%- if value.count > 0 or value.active -%}
                            {%- capture pair -%}{{ value.param_name | url_encode }}={{ value.value | url_encode }}{%- endcapture -%}
                            {%- if family_q != '' -%}{%- assign family_q = family_q | append: '&' -%}{%- endif -%}
                            {%- assign family_q = family_q | append: pair -%}
                            {%- if value.active -%}{%- assign family_on = true -%}{%- endif -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if family_q != '' -%}
                        {%- assign color_key = 'mobile.collection.colors.' | append: key -%}
                        {%- assign color_name = color_key | t -%}
                        <button type="button" class="flt__col{% if family_on %} is-on{% endif %}" data-q="{{ family_q | escape }}" data-label="{{ color_name | escape }}"><span class="is-{{ key }}"></span>{{ color_name | escape }}</button>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- for value in filter.values -%}
                      {%- if value_families[forloop.index0] == '-' and value.active -%}
                        <button type="button" class="flt__col is-on" data-q="{{ value.param_name | url_encode }}={{ value.value | url_encode }}" data-label="{{ value.label | escape }}"><span></span>{{ value.label | escape }}</button>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- when 'size' -%}
                  {%- liquid
                    assign value_sizes = ''
                    for value in filter.values
                      capture size_key
                        render 'mshein-size-family', label: value.label
                      endcapture
                      assign value_sizes = value_sizes | append: size_key | append: ','
                    endfor
                    assign value_sizes = value_sizes | split: ','
                  -%}
                  <div class="flt__body flt__sizes" data-dcl-more-list="24">
                    {%- for key in size_order -%}
                      {%- assign family_q = '' -%}
                      {%- assign family_on = false -%}
                      {%- assign family_count = 0 -%}
                      {%- for value in filter.values -%}
                        {%- if value_sizes[forloop.index0] == key -%}
                          {%- if value.count > 0 or value.active -%}
                            {%- capture pair -%}{{ value.param_name | url_encode }}={{ value.value | url_encode }}{%- endcapture -%}
                            {%- if family_q != '' -%}{%- assign family_q = family_q | append: '&' -%}{%- endif -%}
                            {%- assign family_q = family_q | append: pair -%}
                            {%- assign family_count = family_count | plus: value.count -%}
                            {%- if value.active -%}{%- assign family_on = true -%}{%- endif -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if family_q != '' -%}
                        {%- if key == 'one' -%}{%- assign size_name = 'mobile.collection.one_size' | t -%}{%- else -%}{%- assign size_name = key | upcase -%}{%- endif -%}
                        <button type="button" class="flt__size{% if family_on %} is-on{% endif %}" data-q="{{ family_q | escape }}" data-label="{{ filter.label | escape }} {{ size_name | escape }}">{{ size_name | escape }}</button>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- for value in filter.values -%}
                      {%- if value_sizes[forloop.index0] != '-' -%}{%- continue -%}{%- endif -%}
                      {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
                      <button type="button" class="flt__size{% if value.active %} is-on{% endif %}" data-q="{{ value.param_name | url_encode }}={{ value.value | url_encode }}" data-label="{{ filter.label | escape }} {{ value.label | escape }}" title="{{ value.count }}">{{ value.label | escape }}</button>
                    {%- endfor -%}
                  </div>
                {%- when 'shoe' -%}
                  <div class="flt__body flt__sizes" data-dcl-more-list="24" data-dcl-numeric>
                    {%- assign shoe_prefix = 'mobile.collection.shoe_prefix' | t -%}
                    {%- for value in filter.values -%}
                      {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
                      <button type="button" class="flt__size{% if value.active %} is-on{% endif %}" data-q="{{ value.param_name | url_encode }}={{ value.value | url_encode }}" data-label="{{ shoe_prefix | escape }} {{ value.label | escape }}" title="{{ value.count }}">{{ value.label | escape }}</button>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="flt__body" data-dcl-more-list="7" data-dcl-by-count>
                    {%- for value in filter.values -%}
                      {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
                      <button type="button" class="flt__opt{% if value.active %} is-on{% endif %}" data-q="{{ value.param_name | url_encode }}={{ value.value | url_encode }}" data-label="{{ value.label | escape }}">{{ value.label | escape }}<em>{{ value.count }}</em></button>
                    {%- endfor -%}
                  </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </section>
      </aside>

      <div class="cl__main" data-dcl-main
        data-more="{{ 'mobile.collection.show_others' | t: count: '__N__' | escape }}" data-less="{{ 'mobile.collection.show_less' | t | escape }}"
        data-price-label="{{ cart.currency.symbol }}">
        <h2 class="cl__title">{{ collection.title | escape }}</h2>
        <div class="cl__bar">
          <span class="cl__found" data-dcl-found>{{ 'desktop_collection.count' | t: count: collection.products_count }}</span>
          <button type="button" class="qchip" data-dcl-sale-chip><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12 12 20 4 12V4h8z"/><circle cx="8.5" cy="8.5" r="1.4"/></svg>{{ 'mobile.explore.on_sale' | t }}</button>
          {%- assign under_filter = collection.filters | where: 'type', 'price_range' | first -%}
          {%- if under_filter -%}
            {%- assign under_on = false -%}
            {%- assign under_cents = under_amount | times: 100 -%}
            {%- if under_filter.max_value.value == under_cents and under_filter.min_value.value == nil -%}{%- assign under_on = true -%}{%- endif -%}
            <button type="button" class="qchip{% if under_on %} is-on{% endif %}" data-dcl-under="{{ under_filter.max_value.param_name }}={{ under_amount }}" data-min="{{ under_filter.min_value.param_name }}">{%- assign under_money = under_cents | money_without_trailing_zeros | strip_html -%}{{ 'desktop_collection.under' | t: amount: under_money }}</button>
          {%- endif -%}
          <div class="view" role="group" aria-label="{{ 'mobile.collection.view' | t | escape }}">
            <button type="button" class="is-on" data-view="grid" aria-label="{{ 'desktop_collection.grid' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/></svg></button>
            <button type="button" data-view="list" aria-label="{{ 'desktop_collection.list' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
          </div>
          <div class="srt">
            <button type="button" class="srt__btn" aria-haspopup="listbox" aria-expanded="false" data-dcl-sort-btn>{{ 'mobile.collection.sort_title' | t }} <b>{{ sort_label | escape }}</b><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></button>
            <div class="srt__menu" role="listbox" hidden data-dcl-sort-menu>
              {%- for option in collection.sort_options -%}
                <button type="button" data-s="{{ option.value }}"{% if option.value == sort_current %} class="is-on"{% endif %}>{{ option.name | escape }}</button>
              {%- endfor -%}
            </div>
          </div>
        </div>
        <div class="act-f" data-dcl-active></div>
        {%- paginate collection.products by 40 -%}
          <ul class="cl__grid" data-dcl-grid>
            {%- for product in collection.products -%}
              {%- render 'mshein-card', product: product, best: best, best_ids: best_ids, flag: flag -%}
            {%- endfor -%}
          </ul>
          {%- if collection.products.size == 0 -%}
            <p class="cl__none">{{ 'desktop_collection.none' | t }} {%- if active_count > 0 -%} <button type="button" data-dcl-clear>{{ 'desktop_collection.clear' | t }}</button>{%- endif -%}</p>
          {%- endif -%}
          <div class="dcl-sale-more" data-dcl-sale-more hidden><button type="button">{{ 'desktop_home.show_more' | t }}</button></div>
          {%- if paginate.pages > 1 -%}
            <nav class="pager" data-dcl-pager aria-label="{{ 'desktop_collection.pages' | t | escape }}">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="{{ 'mobile.pdp.previous' | t | escape }}">‹</a>{%- else -%}<span class="is-off">‹</span>{%- endif -%}
              {%- assign current_page = paginate.current_page | append: '' -%}
              {%- for part in paginate.parts -%}
                {%- assign part_title = part.title | append: '' -%}
                {%- if part.is_link -%}
                  {%- if part.title == '…' or part.title == '&hellip;' -%}<span>…</span>{%- else -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- endif -%}
                {%- elsif part_title == current_page -%}
                  <b class="is-on">{{ part.title }}</b>
                {%- else -%}
                  <span>…</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="{{ 'mobile.pdp.next' | t | escape }}">›</a>{%- else -%}<span class="is-off">›</span>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </main>

  {%- comment -%} Vue produit + panier (déplacés dans <body> par le script : au-dessus de l'en-tête) {%- endcomment -%}
  <div class="dcl-ov" data-dcl-ov
    data-front="{{ 'desktop_collection.front' | t | escape }}" data-view="{{ 'desktop_collection.view' | t: n: '__N__' | escape }}"
    data-one-size="{{ 'mobile.collection.one_size' | t | escape }}" data-sold-out="{{ 'mobile.js.sold_out' | t | escape }}"
    data-cart-title="{{ 'desktop_collection.cart_title' | t: count: '__N__' | escape }}" data-empty="{{ 'mobile.cart.empty_title' | t | escape }}"
    data-free="{{ 'desktop_collection.free_included' | t | escape }}" data-free-left="{{ 'desktop_collection.free_left' | t: amount: '__A__' | escape }}"
    data-free-cents="{% if settings.enable_free_shipping %}{{ settings.free_shipping_amount | times: 100 }}{% else %}0{% endif %}"
    data-remove="{{ 'mobile.cart.remove' | t | escape }}" data-error="{{ 'desktop_collection.add_error' | t | escape }}">
    <section class="xpv" data-xpv aria-label="{{ 'desktop_collection.product' | t | escape }}" aria-hidden="true">
      <div class="xpv__stage" data-xpv-stage><img data-xpv-img alt=""></div>
      <div class="xpv__info">
        <div class="xpv__count" data-xpv-count></div>
        <h2 data-xpv-name></h2>
        <div class="xpv__price" data-xpv-price></div>
        <div class="xpv__views" data-xpv-views></div>
        <div data-xpv-size-wrap data-choose-size="{{ 'desktop_collection.choose_size' | t | escape }}" data-choose="{{ 'mobile.pdp.choose_options' | t | escape }}"></div>
        <button class="xpv__add" type="button" data-xpv-add>{{ 'mobile.pdp.add_to_cart' | t }}</button>
        <div class="xpv__foot"><span>{{ collection.title | escape }}</span><a href="#" data-xpv-link>{{ 'desktop_collection.see_product' | t }}</a></div>
      </div>
      <button class="xpv__x" type="button" data-xpv-x aria-label="{{ 'general.accessibility.close' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
      <button class="xpv__nav xpv__nav--p" type="button" data-step="-1" aria-label="{{ 'mobile.pdp.previous' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
      <button class="xpv__nav xpv__nav--n" type="button" data-step="1" aria-label="{{ 'mobile.pdp.next' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
    </section>
    <div class="xshade" data-xshade></div>
    <aside class="xcd" data-xcd aria-label="{{ 'mobile.cart.title' | t | escape }}" aria-hidden="true">
      <div class="xcd__hd"><span data-xcd-title></span><button type="button" data-xcd-x aria-label="{{ 'general.accessibility.close' | t | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
      <div class="xcd__list" data-xcd-list></div>
      <div class="xcd__ft"><div class="xcd__row"><span>{{ 'desktop_collection.subtotal' | t }}</span><span data-xcd-sub></span></div><div class="xcd__note" data-xcd-note></div><a class="xcd__go" href="/checkout">{{ 'mobile.cart.checkout' | t }}</a></div>
    </aside>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Collezione desktop",
  "class": "desktop-collection",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu (Raccolte)", "default": "main-menu" },
    {
      "type": "select",
      "id": "part",
      "label": "Parte",
      "options": [
        { "value": "page", "label": "Pagina" },
        { "value": "sale", "label": "In offerta (pagina successiva)" }
      ],
      "default": "page"
    }
  ],
  "enabled_on": { "templates": ["collection"] },
  "presets": [{ "name": "Collezione desktop" }]
}
{% endschema %}
