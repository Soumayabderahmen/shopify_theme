{%- comment -%}
  Page Contatti ORDINATEUR (templates/page.contact.json) : bandeau aux couleurs du site comme les pages collection
  (snippets/desktop-page-hero.liquid). Les sections du thème en dessous (FAQ, formulaire, blocs d'infos) sont restylées
  en cartes : assets/desktop-contact.css. Caché sur mobile (≤ 760px) : la page mobile ne change pas.
{%- endcomment -%}
{%- comment -%} Aussi sur mobile : FAQ, formulaire et blocs d'infos en cartes comme l'ordinateur (le bandeau ordinateur y reste caché ; bannière mobile : snippets/mhh-page-hero.liquid). {%- endcomment -%}
<link rel="stylesheet" href="{{ 'desktop-contact.css' | asset_url }}">
{%- liquid
  assign dct_title = 'desktop_contact.title' | t
  assign dct_copy = 'desktop_contact.copy' | t
  render 'desktop-page-hero', title: dct_title, copy: dct_copy
-%}
<script>
  // Bandeau aligné sur les cartes du thème en dessous (FAQ à gauche, blocs d'infos à droite), quelle que soit la largeur
  (function (section) {
    if (!section || window.matchMedia('(max-width: 760px)').matches) return;
    var hero = section.querySelector('.dct-hero');
    var align = function () {
      var left = document.querySelector('[id$="__section-faq"] > article, [id$="__section-contact-form"] form');
      var right = document.querySelector('[id$="__page-service-info-blocks"]');
      if (!hero || !left || !right) return;
      hero.style.marginLeft = hero.style.marginRight = '0px';
      var box = hero.getBoundingClientRect();
      hero.style.marginLeft = Math.max(0, left.getBoundingClientRect().left - box.left) + 'px';
      hero.style.marginRight = Math.max(0, box.right - right.getBoundingClientRect().right) + 'px';
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', align); else align();
    window.addEventListener('load', align);
    window.addEventListener('resize', align);
  })(document.currentScript.closest('.shopify-section'));
</script>

{% schema %}
{
  "name": "Contatti (ordinateur)",
  "settings": []
}
{% endschema %}
