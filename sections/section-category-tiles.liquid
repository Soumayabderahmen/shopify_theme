{%- comment -%}
  Grille de catégories (prototype mobile) : carrés arrondis 4 colonnes, image de la
  collection plein cadre, libellé en gras dessous.

  Mode "auto" : toutes les collections de la boutique, sauf celles liées dans le menu du
  header (et la liste d'exclusions), avec au moins N produits et une image. Chaque jour,
  une sélection différente est tirée au hasard (même tirage pour tous les visiteurs du jour).
  Mode "manual" : une tuile par bloc.
{%- endcomment -%}
{%- liquid
  assign tiles_count = section.settings.tiles_count
  assign excluded = '|'

  assign exclude_menu = linklists[section.settings.exclude_menu]
  for level1 in exclude_menu.links
    if level1.url contains '/collections/'
      assign link_handle = level1.url | split: '/collections/' | last | split: '/' | first | split: '?' | first
      assign excluded = excluded | append: link_handle | append: '|'
    endif
    for level2 in level1.links
      if level2.url contains '/collections/'
        assign link_handle = level2.url | split: '/collections/' | last | split: '/' | first | split: '?' | first
        assign excluded = excluded | append: link_handle | append: '|'
      endif
      for level3 in level2.links
        if level3.url contains '/collections/'
          assign link_handle = level3.url | split: '/collections/' | last | split: '/' | first | split: '?' | first
          assign excluded = excluded | append: link_handle | append: '|'
        endif
      endfor
    endfor
  endfor

  # newline_to_br peut produire <br> ou <br /> : on normalise vers | avant de découper.
  assign extra_exclusions = section.settings.exclude_handles | newline_to_br | replace: '<br />', '|' | replace: '<br>', '|' | strip_newlines | replace: ',', '|' | split: '|'
  for extra in extra_exclusions
    assign extra_handle = extra | strip
    if extra_handle != blank
      assign excluded = excluded | append: extra_handle | append: '|'
    endif
  endfor

  assign label_lines = section.settings.labels | newline_to_br | replace: '<br />', '|' | replace: '<br>', '|' | strip_newlines | split: '|'
-%}

{%- capture tiles_markup -%}
  {%- if section.settings.source == 'auto' -%}
    {%- assign tile_index = 0 -%}
    {%- paginate collections by 250 -%}
      {%- for tile_collection in collections -%}
        {%- liquid
          if tile_collection.products_count < section.settings.min_products
            continue
          endif
          assign handle_key = '|' | append: tile_collection.handle | append: '|'
          if excluded contains handle_key
            continue
          endif
          assign tile_image = tile_collection.image | default: tile_collection.products.first.featured_image
          if tile_image == blank
            continue
          endif

          assign tile_label = tile_collection.title
          for label_line in label_lines
            assign label_parts = label_line | split: ':'
            if label_parts.size > 1
              assign label_handle = label_parts.first | strip
              if label_handle == tile_collection.handle
                assign tile_label = label_parts.last | strip
              endif
            endif
          endfor
          assign tile_index = tile_index | plus: 1
          assign tile_hidden = false
          if tile_index > tiles_count
            assign tile_hidden = true
          endif
        -%}
        {%- render 'category-tile',
          url: tile_collection.url,
          image: tile_image,
          label: tile_label,
          hidden: tile_hidden
        -%}
      {%- endfor -%}
    {%- endpaginate -%}
  {%- else -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign tile_collection = collections[block.settings.collection]
        assign tile_image = block.settings.image | default: tile_collection.image | default: tile_collection.products.first.featured_image
        assign tile_label = block.settings.label | default: tile_collection.title
        assign tile_url = tile_collection.url | default: routes.collections_url
      -%}
      {%- render 'category-tile', url: tile_url, image: tile_image, label: tile_label, hidden: false, attributes: block.shopify_attributes -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if tiles_markup != blank -%}
  <nav
    class="category-tiles{% if section.settings.layout == 'scroll' %} category-tiles--scroll{% endif %}"
    aria-label="{{ section.settings.label | default: 'Categorie' | escape }}"
    {% if section.settings.source == 'auto' %}data-daily-tiles="{{ tiles_count }}"{% endif %}
  >
    {{- tiles_markup -}}
  </nav>
  {%- if section.settings.layout == 'scroll' -%}
    <span class="category-tiles__bar" aria-hidden="true"><i data-tiles-bar></i></span>
  {%- endif -%}
{%- endif -%}

<style>
  {%- if section.settings.mobile_only %}
    @media only screen and (min-width: 761px) {
      #shopify-section-{{ section.id }} { display: none !important; }
    }
  {%- endif %}

  #shopify-section-{{ section.id }} .category-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px 10px;
    margin: 12px 6px 0;
    padding: 16px 12px;
    border-radius: 18px;
    background: #fff;
  }

  #root #shopify-section-{{ section.id }} .category-tiles__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    min-width: 0;
    color: #16123f;
    font-family: 'Figtree', system-ui, sans-serif;
    font-size: 11.5px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  #root #shopify-section-{{ section.id }} .category-tiles__item[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .category-tiles__media {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 16px;
    background: #eef0f5;
    box-shadow: inset 0 0 0 1px rgba(22, 18, 63, 0.06), 0 4px 12px -8px rgba(22, 18, 63, 0.45);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  #shopify-section-{{ section.id }} .category-tiles__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    transition: transform 0.35s;
  }

  #shopify-section-{{ section.id }} .category-tiles__label {
    display: block;
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  #shopify-section-{{ section.id }} .category-tiles__item:hover .category-tiles__media,
  #shopify-section-{{ section.id }} .category-tiles__item:focus-visible .category-tiles__media {
    box-shadow: inset 0 0 0 2px #3a34d2, 0 8px 18px -10px rgba(58, 52, 210, 0.6);
  }

  #shopify-section-{{ section.id }} .category-tiles__item:hover .category-tiles__media img {
    transform: scale(1.06);
  }

  #shopify-section-{{ section.id }} .category-tiles__item:active .category-tiles__media {
    transform: scale(0.96);
  }

  /* Disposition « 2 righe scorrevoli » (accueil mobile style SHEIN) : 2 lignes qui défilent sur le côté,
     5 tuiles visibles, petite barre de progression dessous. */
  #shopify-section-{{ section.id }} .category-tiles--scroll {
    grid-template-columns: none;
    grid-template-rows: repeat(2, auto);
    grid-auto-flow: column;
    /* 5 colonnes visibles exactement (4 écarts de 7px) ; les suivantes défilent. */
    grid-auto-columns: calc((100% - 28px) / 5);
    gap: 10px 7px;
    margin: 0;
    padding: 12px 10px 4px;
    overflow-x: auto;
    border-radius: 0;
    scroll-snap-type: x proximity;
    /* Sans cette marge d'accroche, la première colonne démarre coupée sous le bord gauche. */
    scroll-padding-inline: 10px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .category-tiles--scroll::-webkit-scrollbar {
    display: none;
  }

  #root #shopify-section-{{ section.id }} .category-tiles--scroll .category-tiles__item {
    gap: 5px;
    font-family: 'Sora', system-ui, sans-serif;
    font-size: 11px;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .category-tiles--scroll .category-tiles__media,
  #shopify-section-{{ section.id }} .category-tiles--scroll .category-tiles__media img {
    border-radius: 15px;
  }

  #shopify-section-{{ section.id }} .category-tiles__bar {
    position: relative;
    display: block;
    width: 36px;
    height: 3px;
    margin: 6px auto 0;
    padding: 0;
    overflow: hidden;
    background: #e3e5ee;
    border-radius: 3px;
  }

  #shopify-section-{{ section.id }} .category-tiles__bar i {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 45%;
    background: #16123f;
    border-radius: 3px;
  }

  #shopify-section-{{ section.id }}:has(.category-tiles--scroll) {
    width: 100vw;
    max-width: 100vw;
    margin-right: calc(50% - 50vw);
    margin-left: calc(50% - 50vw);
    padding-bottom: 8px;
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .category-tiles__media,
    #shopify-section-{{ section.id }} .category-tiles__media img {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    const sectionId = '{{ section.id }}';

    // Générateur pseudo-aléatoire déterministe (mulberry32) : même graine = même tirage.
    function seededRandom(seed) {
      let state = seed >>> 0;
      return function () {
        state = (state + 0x6d2b79f5) >>> 0;
        let value = state;
        value = Math.imul(value ^ (value >>> 15), value | 1);
        value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
        return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
      };
    }

    // Tirage du jour : la date locale sert de graine, la sélection change donc à minuit.
    function pickDailyTiles() {
      const section = document.getElementById('shopify-section-' + sectionId);
      const grid = section && section.querySelector('[data-daily-tiles]');
      if (!grid) return;
      const tiles = Array.from(grid.querySelectorAll('.category-tiles__item'));
      const count = Math.min(Number(grid.dataset.dailyTiles) || tiles.length, tiles.length);
      const today = new Date();
      const random = seededRandom(today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate());
      for (let index = tiles.length - 1; index > 0; index--) {
        const swap = Math.floor(random() * (index + 1));
        [tiles[index], tiles[swap]] = [tiles[swap], tiles[index]];
      }
      tiles.forEach((tile, index) => {
        tile.hidden = index >= count;
        grid.appendChild(tile);
      });
    }

    // Disposition « 2 righe scorrevoli » : la barre suit le défilement des tuiles.
    function syncTilesBar() {
      const section = document.getElementById('shopify-section-' + sectionId);
      const grid = section && section.querySelector('.category-tiles--scroll');
      const bar = section && section.querySelector('[data-tiles-bar]');
      if (!grid || !bar) return;
      const update = () => {
        const max = grid.scrollWidth - grid.clientWidth;
        const visible = grid.scrollWidth ? grid.clientWidth / grid.scrollWidth : 1;
        bar.style.width = (visible * 100) + '%';
        bar.style.left = max > 0 ? (grid.scrollLeft / max * (1 - visible) * 100) + '%' : '0';
      };
      grid.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      // Départ sur la première colonne (les tuiles du jour viennent d'être réordonnées).
      grid.scrollLeft = 0;
      update();
    }

    // Ce script suit directement les tuiles dans la page : tirage du jour tout de suite, avant le premier affichage
    // (avant : à la fin du chargement, les tuiles changeaient d'ordre sous les yeux).
    pickDailyTiles();
    syncTilesBar();

    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', (event) => {
        if (event.detail.sectionId === sectionId) pickDailyTiles();
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Categorie",
  "tag": "section",
  "class": "shopify-section-category-tiles",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Collezioni mostrate",
      "options": [
        { "value": "auto", "label": "Automatico: fuori dal menu, cambia ogni giorno" },
        { "value": "manual", "label": "Manuale: blocchi qui sotto" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposizione",
      "options": [
        { "value": "grid", "label": "Griglia 4 colonne" },
        { "value": "scroll", "label": "2 righe scorrevoli (stile SHEIN)" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "tiles_count",
      "label": "Numero di categorie",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8
    },
    {
      "type": "link_list",
      "id": "exclude_menu",
      "label": "Escludi le collezioni di questo menu",
      "info": "Automatico: le collezioni già presenti in questo menu (header) non vengono mostrate.",
      "default": "main-menu"
    },
    {
      "type": "textarea",
      "id": "exclude_handles",
      "label": "Altre collezioni da escludere",
      "info": "Un handle per riga (es. seo-pro-5-off)."
    },
    {
      "type": "range",
      "id": "min_products",
      "label": "Prodotti minimi per collezione",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 6
    },
    {
      "type": "textarea",
      "id": "labels",
      "label": "Nomi brevi",
      "info": "Un nome per riga nel formato handle: Nome (es. felpe-novita: Hoodie). Vuoto: titolo della collezione."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Etichetta accessibile",
      "default": "Categorie"
    },
    {
      "type": "checkbox",
      "id": "mobile_only",
      "label": "Solo su mobile",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collezione"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Nome",
          "info": "Vuoto: usa il titolo della collezione."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Immagine",
          "info": "Vuoto: usa l'immagine della collezione."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorie"
    }
  ]
}
{% endschema %}
