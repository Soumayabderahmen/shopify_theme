{%- comment -%}
  Page d'accueil ORDINATEUR au style SHEIN (prototype validé « Platinumshop-Accueil-desktop-SHEIN-v9 »). Ordinateur
  uniquement : la section est cachée jusqu'à 760px, l'accueil mobile (sections/mobile-home-shein.liquid) ne change pas.
  Sur ordinateur, les autres sections de l'accueil sont cachées : cette section est toute la page.
  - bannière du prototype v8 (300px, coins arrondis) : une diapositive par bloc « slide » (type Offerte / Novità /
    Collezione, couleur du dégradé, titres), 3 vrais produits avec prix et remise, flèches, points, défilement ;
  - catégories : un carré par bloc « category », pages de 3 lignes × 8 avec flèches ;
  - « Le nostre offerte » (3 plus fortes remises des « Più venduti ») et « Tendenze » (collection new-trends) ;
  - fil à onglets (Per te / In offerta / Novità) : vraies cartes snippets/mshein-card.liquid (les mêmes qu'en mobile,
    styles assets/mshein-card.css), pages suivantes des modèles collection.mshein-dept-page / mshein-sale.
  Styles : assets/desktop-home-shein.css (chargé en tête par layout/theme.liquid) ; script : assets/desktop-home-shein.js.
{%- endcomment -%}
{%- liquid
  assign best = collections['bestsellers']
  assign best_ids = best.products | map: 'id' | join: ','
  capture flag
    render 'country-flag-emoji'
  endcapture
  assign sale_collection = collections['in-offerta']
  if sale_collection != blank and sale_collection.products_count > 0
    assign sale_url = sale_collection.url
    assign sale_src = sale_collection.url | append: '?view=mshein-dept-page'
    assign sale_total = sale_collection.products_count
  else
    assign sale_url = routes.all_products_collection_url | append: '?view=offerte&sort_by=best-selling'
    assign sale_src = routes.all_products_collection_url | append: '?view=mshein-sale&sort_by=best-selling'
    assign sale_total = 0
  endif
  assign new_collection = collections['new-arrivals']
  assign trends = collections['new-trends']
  assign is_it = false
  if request.locale.iso_code == 'it'
    assign is_it = true
  endif
  # 3 plus fortes remises parmi les 50 premiers « Più venduti » : « 090|id » triés (remise sur 3 chiffres). Bannière
  # (diapositive « Offerte ») et « Le nostre offerte ».
  assign deal_keys = ''
  for candidate in best.products limit: 50
    assign candidate_variant = candidate.selected_or_first_available_variant
    if candidate_variant.compare_at_price > candidate_variant.price
      assign candidate_pct = candidate_variant.compare_at_price | minus: candidate_variant.price | times: 100 | divided_by: candidate_variant.compare_at_price
      assign candidate_key = candidate_pct | prepend: '00' | slice: -3, 3
      assign deal_keys = deal_keys | append: candidate_key | append: '|' | append: candidate.id | append: ','
    endif
  endfor
  assign deal_keys = deal_keys | split: ',' | sort | reverse
-%}
<script src="{{ 'desktop-home-shein.js' | asset_url }}" defer></script>
<style>
  @media only screen and (max-width: 760px) {
    #shopify-section-{{ section.id }} { display: none !important; }
  }
  @media only screen and (min-width: 761px) {
    .template-index #content > .shopify-section:not(#shopify-section-{{ section.id }}):not(.shopify-section-footer) { display: none !important; }
  }
</style>

<div class="dhs" data-dhs data-seen="{{ 'desktop_home.seen' | t: shown: '__SHOWN__', total: '__TOTAL__' | escape }}" data-added="{{ 'mobile.js.added_to_wishlist' | t | escape }}" data-removed="{{ 'mobile.js.removed_from_wishlist' | t | escape }}">
  {%- comment -%} Pleine largeur dès le premier affichage (même calcul que assets/desktop-home-shein.js au redimensionnement). {%- endcomment -%}
  <script>
    (function (root) {
      if (!root || window.matchMedia('(max-width: 760px)').matches) return;
      root.style.setProperty('--dhs-x', root.parentElement.getBoundingClientRect().left + 'px');
      root.style.setProperty('--dhs-w', document.documentElement.clientWidth + 'px');
    })(document.currentScript.parentElement);
  </script>
  <div class="dhs-wrap">
    {%- comment -%}
      ---------- Bannière (prototype v8) : une diapositive par bloc « slide », dégradé de couleur, petit titre, grand
      titre, bouton, 3 vrais produits (prix, remise). Type « Offerte » : les 3 plus fortes remises, « Fino al -X% » ;
      « Novità » : collection des nouveautés ; « Collezione » : titres des réglages (italien), sinon nom de la collection.
    {%- endcomment -%}
    {%- assign slides = section.blocks | where: 'type', 'slide' -%}
    {%- if slides.size > 0 -%}
      <section class="dhs-hero" data-dhs-hero aria-roledescription="carousel">
        {%- for block in slides -%}
          {%- liquid
            assign slide_kind = block.settings.kind | default: 'collection'
            assign slide_collection = block.settings.collection
            assign slide_kicker = ''
            assign slide_title = ''
            assign slide_cta = 'desktop_home.hero_cta' | t
            case slide_kind
              when 'sale'
                assign slide_url = sale_url
                assign top_pct = deal_keys.first | split: '|' | first | plus: 0
                assign slide_kicker = 'desktop_home.hero_sale_kicker' | t
                assign slide_title = 'desktop_home.hero_sale_title_html' | t: percent: top_pct
                assign slide_cta = 'desktop_home.hero_sale_cta' | t
              when 'new'
                if slide_collection == blank
                  assign slide_collection = new_collection
                endif
                assign slide_url = slide_collection.url | append: '?sort_by=created-descending'
                assign slide_kicker = 'desktop_home.hero_new_kicker' | t
                assign slide_title = 'desktop_home.hero_new_title_html' | t
                assign slide_cta = 'desktop_home.hero_new_cta' | t
              else
                if slide_collection == blank
                  continue
                endif
                assign slide_url = slide_collection.url
                if is_it and block.settings.label != blank
                  assign slide_kicker = block.settings.label | escape
                endif
                if is_it and block.settings.title != blank
                  assign slide_title = block.settings.title | escape | replace: '|', '<br>'
                else
                  assign slide_title = slide_collection.title | remove: ' - Tutte' | remove: ' - Tutti' | escape
                endif
            endcase
          -%}
          <a class="dhs-slide dhs-slide--{{ block.settings.colors | default: 'indigo' }}{% if forloop.first %} is-on{% endif %}" href="{{ slide_url }}" data-name="{{ slide_kicker | default: slide_title | strip_html | escape }}" {{ block.shopify_attributes }}>
            <span class="dhs-slide__txt">
              {%- if slide_kicker != blank -%}<small>{{ slide_kicker }}</small>{%- endif -%}
              <b>{{ slide_title }}</b>
              <em>{{ slide_cta }}</em>
            </span>
            <span class="dhs-slide__items">
              {%- if slide_kind == 'sale' -%}
                {%- assign deal_shown = 0 -%}
                {%- for deal_key in deal_keys -%}
                  {%- assign deal_id = deal_key | split: '|' | last | plus: 0 -%}
                  {%- assign deal = best.products | where: 'id', deal_id | first -%}
                  {%- if deal == blank -%}{%- continue -%}{%- endif -%}
                  {%- render 'desktop-home-hero-item', product: deal -%}
                  {%- assign deal_shown = deal_shown | plus: 1 -%}
                  {%- if deal_shown == 3 -%}{%- break -%}{%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- for pick in slide_collection.products limit: 3 -%}
                  {%- render 'desktop-home-hero-item', product: pick -%}
                {%- endfor -%}
              {%- endif -%}
            </span>
          </a>
        {%- endfor -%}
        <div class="dhs-dots" data-dhs-dots></div>
        <button class="dhs-arw dhs-arw--p" type="button" data-step="-1" aria-label="{{ 'mobile.pdp.previous' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
        <button class="dhs-arw dhs-arw--n" type="button" data-step="1" aria-label="{{ 'mobile.pdp.next' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
      </section>
    {%- endif -%}

    {%- comment -%} ---------- Catégories : carrés arrondis, pages de 3 lignes × 8 ---------- {%- endcomment -%}
    {%- assign cats = section.blocks | where: 'type', 'category' -%}
    {%- if cats.size > 0 -%}
      <section class="dhs-sc" aria-label="{{ 'mobile.category.shop_by' | t }}">
        <button class="dhs-sc__arw dhs-sc__arw--p" type="button" data-step="-1" aria-label="{{ 'mobile.pdp.previous' | t }}" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
        <div class="dhs-sc__track" data-dhs-sc>
          <div class="dhs-sc__page">
            {%- for block in cats -%}
              {%- liquid
                assign cat_collection = block.settings.collection
                if cat_collection == blank
                  continue
                endif
                assign cat_image = block.settings.image | default: cat_collection.featured_image
                assign cat_label = block.settings.label
                if cat_label == blank or is_it == false
                  assign cat_label = cat_collection.title | remove: ' - Tutte' | remove: ' - Tutti'
                endif
              -%}
              <a class="dhs-sc__item" href="{{ cat_collection.url }}" {{ block.shopify_attributes }}>
                <span class="dhs-sc__img">
                  {%- if cat_image != blank -%}<img src="{{ cat_image | image_url: width: 180, height: 180, crop: 'center' }}" alt="" width="90" height="90" loading="lazy">{%- endif -%}
                </span>
                <span class="dhs-sc__t">{{ cat_label | escape }}</span>
              </a>
              {%- assign cat_count = forloop.index | modulo: 24 -%}
              {%- if cat_count == 0 and forloop.last == false -%}</div><div class="dhs-sc__page">{%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        <button class="dhs-sc__arw dhs-sc__arw--n" type="button" data-step="1" aria-label="{{ 'mobile.pdp.next' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
      </section>
    {%- endif -%}

    {%- comment -%} ---------- « Le nostre offerte » + « Tendenze » ---------- {%- endcomment -%}
    <section class="dhs-dl">
      <a class="dhs-dl__card" href="{{ sale_url }}">
        <span class="dhs-dl__hd"><b>{{ 'desktop_home.our_deals' | t }}</b><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></span>
        <span class="dhs-dl__items">
          {%- assign deal_shown = 0 -%}
          {%- for deal_key in deal_keys -%}
            {%- assign deal_id = deal_key | split: '|' | last | plus: 0 -%}
            {%- assign deal = best.products | where: 'id', deal_id | first -%}
            {%- if deal == blank -%}{%- continue -%}{%- endif -%}
            {%- assign deal_variant = deal.selected_or_first_available_variant -%}
            {%- assign deal_pct = deal_key | split: '|' | first | plus: 0 -%}
            {%- assign deal_image = deal_variant.featured_image | default: deal.featured_image -%}
            <span class="dhs-dl__item">
              {%- if deal_image != blank -%}<img src="{{ deal_image | image_url: width: 360, height: 480, crop: 'center' }}" alt="{{ deal.title | escape }}" width="180" height="240" loading="lazy">{%- endif -%}
              <b class="is-sale">{{ deal_variant.price | money }}</b>
              <small>{{ 'mobile.home_shein.percent_off' | t: percent: deal_pct }}</small>
            </span>
            {%- assign deal_shown = deal_shown | plus: 1 -%}
            {%- if deal_shown == 3 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        </span>
      </a>
      <a class="dhs-dl__card" href="{{ trends.url }}">
        <span class="dhs-dl__hd"><b>{{ 'mobile.home_shein.trends' | t }}</b><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></span>
        <span class="dhs-dl__items">
          {%- for trend in trends.products limit: 3 -%}
            {%- assign trend_variant = trend.selected_or_first_available_variant -%}
            {%- assign trend_image = trend_variant.featured_image | default: trend.featured_image -%}
            <span class="dhs-dl__item">
              {%- if trend_image != blank -%}<img src="{{ trend_image | image_url: width: 360, height: 480, crop: 'center' }}" alt="{{ trend.title | escape }}" width="180" height="240" loading="lazy">{%- endif -%}
              <b>{{ trend_variant.price | money }}</b>
              <small class="is-tag">#{{ trend.type | default: trends.title | escape }}</small>
            </span>
          {%- endfor -%}
        </span>
      </a>
    </section>

    {%- comment -%} ---------- Fil à onglets : vraies cartes du site ---------- {%- endcomment -%}
    <section class="dhs-feed" data-dhs-feed>
      <div class="dhs-feed__tabs" role="tablist">
        <button type="button" role="tab" class="is-on" aria-selected="true" data-src="{{ best.url | append: '?view=mshein-dept-page&page=2' }}" data-total="{{ best.products_count }}">{{ 'mobile.home_shein.for_you' | t }}</button>
        <button type="button" role="tab" aria-selected="false" data-src="{{ sale_src }}" data-total="{{ sale_total }}">{{ 'mobile.explore.on_sale' | t }}</button>
        <button type="button" role="tab" aria-selected="false" data-src="{{ new_collection.url | append: '?view=mshein-dept-page&sort_by=created-descending' }}" data-total="{{ new_collection.products_count }}">{{ 'mobile.category.new' | t }}</button>
      </div>
      <ul class="dhs-feed__grid" data-dhs-grid>
        {%- for product in best.products limit: 20 -%}
          {%- render 'mshein-card', product: product, best: best, best_ids: best_ids, flag: flag -%}
        {%- endfor -%}
      </ul>
      <div class="dhs-more" data-dhs-more>
        <span data-dhs-more-txt></span>
        <div class="dhs-more__bar"><i data-dhs-more-bar></i></div>
        <button type="button" data-dhs-more-btn>{{ 'desktop_home.show_more' | t }}</button>
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Home desktop SHEIN",
  "class": "desktop-home-shein",
  "max_blocks": 80,
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        {
          "type": "select", "id": "kind", "label": "Tipo", "default": "collection",
          "options": [
            { "value": "sale", "label": "Offerte (3 sconti più forti dei Più venduti)" },
            { "value": "new", "label": "Novità (collezione nuovi arrivi)" },
            { "value": "collection", "label": "Collezione" }
          ]
        },
        { "type": "collection", "id": "collection", "label": "Collezione", "info": "Tipo Collezione (o Novità: altra collezione)" },
        {
          "type": "select", "id": "colors", "label": "Colore", "default": "indigo",
          "options": [
            { "value": "coral", "label": "Corallo" },
            { "value": "indigo", "label": "Indaco" },
            { "value": "amber", "label": "Ambra" },
            { "value": "navy", "label": "Blu notte" },
            { "value": "emerald", "label": "Smeraldo" },
            { "value": "rose", "label": "Rosa" }
          ]
        },
        { "type": "text", "id": "label", "label": "Piccolo titolo (italiano)", "info": "Tipo Collezione ; altra lingua: senza" },
        { "type": "text", "id": "title", "label": "Grande titolo (italiano)", "info": "Tipo Collezione ; | = a capo ; vuoto o altra lingua: nome della collezione" }
      ]
    },
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collezione" },
        { "type": "text", "id": "label", "label": "Nome (italiano)", "info": "Vuoto o altra lingua: nome della collezione" },
        { "type": "image_picker", "id": "image", "label": "Foto", "info": "Vuota: foto della collezione" }
      ]
    }
  ],
  "presets": [
    { "name": "Home desktop SHEIN" }
  ]
}
{% endschema %}
