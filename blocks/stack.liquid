{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'stack', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "t:blocks.stack.name",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.stack.settings.link.label"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:blocks.stack.settings.open_in_new_tab.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:blocks.stack.settings.layout.header"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:blocks.stack.settings.layout.direction.label",
      "options": [
        {
          "value": "column",
          "label": "t:blocks.stack.settings.layout.direction.options.vertical"
        },
        {
          "value": "row",
          "label": "t:blocks.stack.settings.layout.direction.options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:blocks.stack.settings.layout.vertical_on_mobile.label",
      "default": true,
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:blocks.stack.settings.layout.distribute.label",
      "options": [
        {
          "value": "flex-start",
          "label": "t:blocks.stack.settings.layout.distribute.options.left"
        },
        {
          "value": "center",
          "label": "t:blocks.stack.settings.layout.distribute.options.center"
        },
        {
          "value": "flex-end",
          "label": "t:blocks.stack.settings.layout.distribute.options.right"
        },
        {
          "value": "space-between",
          "label": "t:blocks.stack.settings.layout.distribute.options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:blocks.stack.settings.layout.align.label",
      "options": [
        {
          "value": "flex-start",
          "label": "t:blocks.stack.settings.layout.distribute.options.top"
        },
        {
          "value": "center",
          "label": "t:blocks.stack.settings.layout.distribute.options.center"
        },
        {
          "value": "flex-end",
          "label": "t:blocks.stack.settings.layout.distribute.options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "t:blocks.stack.settings.layout.align_baseline.label",
      "default": false,
      "visible_if": "{{ block.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:blocks.stack.settings.layout.align.label",
      "options": [
        {
          "value": "flex-start",
          "label": "t:blocks.stack.settings.layout.distribute.options.left"
        },
        {
          "value": "center",
          "label": "t:blocks.stack.settings.layout.distribute.options.center"
        },
        {
          "value": "flex-end",
          "label": "t:blocks.stack.settings.layout.distribute.options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:blocks.stack.settings.layout.distribute.label",
      "options": [
        {
          "value": "flex-start",
          "label": "t:blocks.stack.settings.layout.distribute.options.top"
        },
        {
          "value": "center",
          "label": "t:blocks.stack.settings.layout.distribute.options.center"
        },
        {
          "value": "flex-end",
          "label": "t:blocks.stack.settings.layout.distribute.options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:blocks.stack.settings.layout.distribute.options.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:blocks.stack.settings.layout.gap.label",
      "options": [
        {
          "value": "0",
          "label": "t:blocks.stack.settings.layout.gap.options.none"
        },
        {
          "value": "0.5",
          "label": "t:blocks.stack.settings.layout.gap.options.small"
        },
        {
          "value": "1.5",
          "label": "t:blocks.stack.settings.layout.gap.options.medium"
        },
        {
          "value": "3",
          "label": "t:blocks.stack.settings.layout.gap.options.large"
        },
        {
          "value": "4",
          "label": "t:blocks.stack.settings.layout.gap.options.extra_large"
        }
      ],
      "default": "1.5"
    },
    {
      "type": "header",
      "content": "t:blocks.stack.settings.size.header"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.stack.settings.size.width.label",
      "options": [
        {
          "value": "fit-content",
          "label": "t:blocks.stack.settings.size.width.options.fit-content"
        },
        {
          "value": "fill",
          "label": "t:blocks.stack.settings.size.width.options.fill"
        },
        {
          "value": "custom",
          "label": "t:blocks.stack.settings.size.width.options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:blocks.stack.settings.size.max_width.label",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:blocks.stack.settings.size.width_mobile.label",
      "options": [
        {
          "value": "fit-content",
          "label": "t:blocks.stack.settings.size.width.options.fit-content"
        },
        {
          "value": "fill",
          "label": "t:blocks.stack.settings.size.width.options.fill"
        },
        {
          "value": "custom",
          "label": "t:blocks.stack.settings.size.width.options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:blocks.stack.settings.size.max_width_mobile.label",
      "min": 0,
      "max": 2000,
      "step": 25,
      "unit": "px",
      "default": 2000,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:blocks.stack.settings.size.height.label",
      "options": [
        {
          "value": "fit",
          "label": "t:blocks.stack.settings.size.height.options.fit"
        },
        {
          "value": "fill",
          "label": "t:blocks.stack.settings.size.height.options.fill"
        },
        {
          "value": "custom",
          "label": "t:blocks.stack.settings.size.height.options.custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "t:blocks.stack.settings.size.custom_height.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:blocks.stack.settings.appearance.header"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:blocks.stack.settings.appearance.inherit_color_scheme.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:blocks.stack.settings.appearance.color_scheme.label",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:blocks.stack.settings.appearance.background_media.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.stack.settings.appearance.background_media.options.none"
        },
        {
          "value": "image",
          "label": "t:blocks.stack.settings.appearance.background_media.options.image"
        },
        {
          "value": "video",
          "label": "t:blocks.stack.settings.appearance.background_media.options.video"
        }
      ],
      "default": "none"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:blocks.stack.settings.appearance.video.label",
      "visible_if": "{{ block.settings.background_media == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:blocks.stack.settings.appearance.video_position.label",
      "options": [
        {
          "value": "cover",
          "label": "t:blocks.stack.settings.appearance.video_position.options.cover"
        },
        {
          "value": "contain",
          "label": "t:blocks.stack.settings.appearance.video_position.options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.background_media == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:blocks.stack.settings.appearance.background_image.label",
      "visible_if": "{{ block.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "t:blocks.stack.settings.appearance.background_image_position.label",
      "options": [
        {
          "value": "cover",
          "label": "t:blocks.stack.settings.appearance.background_image_position.options.cover"
        },
        {
          "value": "fit",
          "label": "t:blocks.stack.settings.appearance.background_image_position.options.fit"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:blocks.stack.settings.appearance.borders.label",
      "options": [
        {
          "value": "none",
          "label": "t:blocks.stack.settings.appearance.borders.options.none"
        },
        {
          "value": "solid",
          "label": "t:blocks.stack.settings.appearance.borders.options.solid"
        }
      ],
      "default": "solid"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "label": "t:blocks.stack.settings.appearance.border_width.label",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:blocks.stack.settings.appearance.border_opacity.label",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:blocks.stack.settings.appearance.border_radius.label",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:blocks.stack.settings.appearance.background_image.label",
      "visible_if": "{{ false }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:blocks.stack.settings.appearance.overlay_opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:blocks.stack.settings.padding.header"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:blocks.stack.settings.padding.label",
      "options": [
        {
          "value": "0",
          "label": "t:blocks.stack.settings.padding.options.none"
        },
        {
          "value": "0.5",
          "label": "t:blocks.stack.settings.padding.options.small"
        },
        {
          "value": "1.5",
          "label": "t:blocks.stack.settings.padding.options.medium"
        },
        {
          "value": "3",
          "label": "t:blocks.stack.settings.padding.options.large"
        },
        {
          "value": "4",
          "label": "t:blocks.stack.settings.padding.options.extra_large"
        }
      ],
      "default": "0.5"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.stack.name",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
