{% doc %}
  Renders cart disclosure information for a product in a tooltip popup.

  @param {product} product - The product object to display disclosures for
  @param {string} unique_id - Unique identifier to append to popup ID

  @example
  {% render 'cart-disclosures-tooltip',
    product: line_item.product,
    unique_id: line_item.key
  %}
{% enddoc %}

{%- liquid
  assign product = product | default: empty
  assign unique_id = unique_id | default: product.id
  assign disclosures = product.metafields.shopify.disclosure.value
  assign has_cart_disclosures = false
-%}

{%- if product != empty and disclosures != blank -%}
  {%- for disclosure in disclosures -%}
    {%- if disclosure.display_preferences.value.surfaces contains 'cart' -%}
      {%- liquid
        assign disclosure_title = disclosure.title.value | default: disclosure.title
        if disclosure_title == blank
          assign disclosure_title = disclosure.message.value | default: disclosure.message
        endif
      -%}
      {%- if disclosure.content != blank or disclosure_title != blank -%}
        {%- assign has_cart_disclosures = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if has_cart_disclosures -%}
    {%- capture disclosure_tooltip_content -%}
      {%- for disclosure in disclosures -%}
        {%- if disclosure.display_preferences.value.surfaces contains 'cart' -%}
          {%- liquid
            assign disclosure_title = disclosure.title.value | default: disclosure.title
            if disclosure_title == blank
              assign disclosure_title = disclosure.message.value | default: disclosure.message
            endif
            assign disclosure_symbol = disclosure.symbol.value
            assign render_disclosure = false
            if disclosure.content != blank or disclosure_title != blank
              assign render_disclosure = true
            endif
          -%}
          {%- if render_disclosure -%}
            <div class="m20">
              {%- if disclosure_title != blank or disclosure_symbol != blank -%}
                <p class="h5 heading-has-image cols cols-mobile text-start align-middle">
                  {%- if disclosure_symbol != blank -%}
                    <span>
                      <img
                        src="{{ disclosure_symbol | image_url: width: 40 }}"
                        srcset="{{ disclosure_symbol | image_url: width: 40 }} 1x,{{ disclosure_symbol | image_url: width: 80 }} 2x"
                        height="20"
                        width="20"
                        style="width:20px!important"
                        alt="{{ disclosure_title | escape }}"
                        loading="lazy"
                      >
                    </span>
                  {%- endif -%}
                  {%- if disclosure_title != blank -%}
                    <span>{{ disclosure_title | escape }}</span>
                  {%- endif -%}
                </p>
              {%- endif -%}
              {%- if disclosure.content != blank -%}
                {{ disclosure.content | metafield_tag }}
              {%- elsif disclosure.message.value != blank or disclosure.message != blank -%}
                <p>{{ disclosure.message.value | default: disclosure.message | escape | newline_to_br }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    &nbsp;<span
      class="s1tt s1tt-warning"
      data-icon="icon-warning"
      data-tooltip-id="cart-disclosure-{{ unique_id | escape }}"
      aria-label="{{ 'general.accessibility.view_disclosure_information' | t: product_title: product.title | escape }}"
      ><span>{{ disclosure_tooltip_content }}</span></span
    >
  {%- endif -%}
{%- endif -%}
