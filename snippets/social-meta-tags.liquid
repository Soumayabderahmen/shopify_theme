{%- comment -%}
  Balises de partage (Facebook, WhatsApp, X…). Les images sont en adresse absolue https (exigé par les réseaux) :
  image_url peut renvoyer « //domaine/… » ou « /cdn/… » selon l'environnement.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title
  assign og_url = canonical_url
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_img = blank

  if request.page_type == 'product'
    assign og_title = product.title | strip_html
    assign og_type = 'product'
    assign og_img = product.featured_image
  elsif request.page_type == 'article'
    assign og_title = article.title | strip_html
    assign og_type = 'article'
    assign og_description = article.excerpt_or_content | strip_html | truncate: 300
    assign og_img = article.image
  elsif request.page_type == 'collection'
    assign og_title = collection.title | strip_html
    assign og_type = 'product.group'
    assign og_img = collection.image | default: collection.featured_image
  elsif request.page_type == 'password'
    assign og_title = shop.name
    assign og_url = shop.url
    assign og_description = shop.description | default: shop.name
  endif
  if og_img == blank and page_image
    assign og_img = page_image
  endif

  assign og_image = blank
  if og_img != blank
    assign og_image = og_img | image_url: width: 1200
    assign og_head = og_image | slice: 0, 2
    if og_head == '//'
      assign og_image = og_image | prepend: 'https:'
    elsif og_head contains '/'
      assign og_image = og_image | prepend: shop.url
    endif
    assign og_w = 1200
    assign og_h = og_img.height | times: 1200 | divided_by: og_img.width
  endif
-%}
<meta name="msapplication-config" content="{{ 'browserconfig.xml' | asset_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">
{%- if request.page_type == 'product' %}
  {%- assign current_variant = product.selected_or_first_available_variant %}
<meta property="product:price:amount" content="{{ current_variant.price | divided_by: 100.0 }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
<meta property="og:price:amount" content="{{ current_variant.price | divided_by: 100.0 }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
<meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- endif %}
{%- if og_image != blank %}
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:secure_url" content="{{ og_image }}">
<meta property="og:image:width" content="{{ og_w }}">
<meta property="og:image:height" content="{{ og_h }}">
<meta property="og:image:alt" content="{{ og_img.alt | default: og_title | escape }}">
{%- endif %}
<meta name="twitter:card" content="{% if og_image != blank %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image != blank %}
<meta name="twitter:image" content="{{ og_image }}">
{%- endif %}
{%- comment -%}
  Données structurées communes (Organization, WebSite ; Article sur les articles). La fiche produit est dans
  snippets/product-jsonld.liquid (un seul bloc produit par page).
{%- endcomment -%}
<script type="application/ld+json">
  [
    {%- if request.page_type == 'article' -%}
      {
          "@context": "https://schema.org",
          "@type": "Article",
          "articleBody": {{ article.content | strip_html | json }},
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": {{ canonical_url | json }}
          },
          "headline": {{ article.title | json }},
          {% if article.excerpt != blank %}
            "description": {{ article.excerpt | strip_html | json }},
          {% endif %}
          {% if article.image %}
            "image": [
               {{ article | image_url: width: 1920 | prepend: "https:" | json }}
            ],
          {% endif %}
          "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
          "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
          "author": {
            "@type": "Person",
            "name": {{ article.author | json }}
          },
          "publisher": {
            "@type": "Organization",
            "name": {{ shop.name | json }}
          }
        },
    {%- endif -%}
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": {{ shop.url | append: '/#organization' | json }},
      "url": {{ shop.url | append: routes.root_url | json }},
      "name": {{ shop.name | json }},
      "legalName": {{ shop.name | json }},
      "description": {{ shop.description | default: shop.name | strip_html | json }},
      {%- if settings.logo -%}
        "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
        "image": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
      {%- endif -%}
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "telephone": {{ shop.phone | json }}
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ shop.address.street | json }},
        "addressLocality": {{ shop.address.city | json }},
        "postalCode": {{ shop.address.zip | json }},
        "addressCountry": {{ shop.address.country_code | json }}
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ shop.url | append: '/#website' | json }},
      "url": {{ shop.url | append: routes.root_url | json }},
      "name": {{ shop.name | json }},
      "inLanguage": {{ request.locale.iso_code | json }},
      "publisher": { "@id": {{ shop.url | append: '/#organization' | json }} }
    }
  ]
</script>
