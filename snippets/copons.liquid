            <div class="ve-price-box">
              <span class="ve-price-discounted">{{ final_price | money }}</span>
              <span class="ve-price-original">{{ original_price | money }}</span>
              <span class="ve-price-badge">-{{ actual_discount | money }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Coupon con Timer -->
      <div class="ve-ocard">
        <div class="ve-card-row">
          <div class="ve-icon-circle ve-bg-pink">🎟️</div>
          <div class="ve-card-text">
            <div class="ve-otag">{{ ve_coupon_title }}</div>
            <p class="ve-odesc">{{ ve_coupon_desc }}</p>

            <!-- Timer a conteggio rovesciato (2 giorni) -->
            <div class="ve-timer-wrap">
              <span class="ve-timer-label">⏱️ {{ 'vantaggi.expires_in' | t: default: 'Scade tra' }}:</span>
              <span class="ve-timer-clock" id="ve-countdown-timer">02d 00h 00m 00s</span>
            </div>

            <span class="ve-terms-link" id="ve-open-terms" role="button" tabindex="0">{{ ve_terms_link }}</span>
          </div>
        </div>
      </div>

      <!-- Card Spedizione -->
      <div class="ve-ocard">
        <div class="ve-card-row">
          <div class="ve-icon-circle ve-bg-cyan">🚚</div>
          <div class="ve-card-text">
