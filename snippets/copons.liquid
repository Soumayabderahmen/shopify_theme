{% comment %} {%- liquid
  assign ve_title = 'vantaggi.title' | t: default: "Vantaggi esclusivi per l'articolo"
  assign ve_coupon_title = 'vantaggi.coupon_title' | t: default: 'Coupon: 20% di sconto'
  assign ve_coupon_desc = 'vantaggi.coupon_desc' | t: default: 'Con una spesa min. di 40 €, avrai uno sconto max. di 12 €.'
  assign ve_coupon_validity = 'vantaggi.coupon_validity' | t: default: 'Offerta a tempo limitato'
  assign ve_terms_link = 'vantaggi.terms' | t: default: 'Termini e Condizioni'
  assign ve_ship_title = 'vantaggi.shipping_title' | t: default: 'Spedizione gratuita'
  assign ve_ship_desc = 'vantaggi.shipping_desc' | t: default: 'Spedizione gratuita su questo ordine'
  assign ve_claim_btn = 'vantaggi.claim' | t: default: 'Riscuoti'
  assign ve_close_btn = 'vantaggi.close' | t: default: 'Chiudi'
  assign ve_coupon_code = 'JCEB1XQ31X8X'

  # Calcolo dinamico dello sconto (20% max 12€)
  assign original_price = product.selected_or_first_available_variant.price
  assign discount_rate = 0.20
  assign max_discount = 1200
  assign calculated_discount = original_price | times: discount_rate

  if calculated_discount > max_discount
    assign actual_discount = max_discount
  else
    assign actual_discount = calculated_discount
  endif

  assign final_price = original_price | minus: actual_discount
-%}

<div class="ve-container" id="ve-main-wrap">
  {%- comment %} ── TRIGGER BADGE (DIV) ── {%- endcomment %}
  <div
    class="ve-pill"
    id="ve-open-trigger"
    role="button"
    tabindex="0"
    aria-expanded="false"
    aria-controls="ve-popup-card"
  >
    <span class="ve-pill-title">{{ ve_title }}</span>
    <span class="ve-pill-arrow" aria-hidden="true">›</span>
  </div>

  {%- comment %} ── CONTENUTO POPUP ── {%- endcomment %}
  <div class="ve-accordion-wrap" id="ve-popup-card" aria-hidden="true">
    <div class="ve-accordion-content">
      <div class="ve-card-header">
        <h3 class="ve-card-title">{{ ve_title }}</h3>
        <span class="ve-card-gift-icon">🎁</span>
      </div>

      <!-- Card Prezzo Scontato Calcolato -->
      <div class="ve-ocard ve-price-card">
        <div class="ve-card-row">
          <div class="ve-icon-circle ve-bg-green">🏷️</div>
          <div class="ve-card-text">
            <div class="ve-otag">{{ 'vantaggi.price_preview_title' | t: default: 'Prezzo Riservato con Coupon' }}</div>
            <div class="ve-price-box">
              <span class="ve-price-discounted">{{ final_price | money }}</span>
              <span class="ve-price-original">{{ original_price | money }}</span>
              <span class="ve-price-badge">-{{ actual_discount | money }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Coupon con Timer -->
      <div class="ve-ocard">
        <div class="ve-card-row">
          <div class="ve-icon-circle ve-bg-pink">🎟️</div>
          <div class="ve-card-text">
            <div class="ve-otag">{{ ve_coupon_title }}</div>
            <p class="ve-odesc">{{ ve_coupon_desc }}</p>

            <!-- Timer a conteggio rovesciato (2 giorni) -->
            <div class="ve-timer-wrap">
              <span class="ve-timer-label">⏱️ {{ 'vantaggi.expires_in' | t: default: 'Scade tra' }}:</span>
              <span class="ve-timer-clock" id="ve-countdown-timer">02d 00h 00m 00s</span>
            </div>

            <span class="ve-terms-link" id="ve-open-terms" role="button" tabindex="0">{{ ve_terms_link }}</span>
          </div>
        </div>
      </div>

      <!-- Card Spedizione -->
      <div class="ve-ocard">
        <div class="ve-card-row">
          <div class="ve-icon-circle ve-bg-cyan">🚚</div>
          <div class="ve-card-text">
            <div class="ve-otag ve-otag-dark">{{ ve_ship_title }}</div>
            <p class="ve-odesc ve-odesc-last">{{ ve_ship_desc }}</p>
          </div>
        </div>
      </div>

      <!-- Azioni -->
      <div class="ve-actions">
        <button type="button" class="ve-cbtn ve-btn-claim" id="ve-claim-code" data-code="{{ ve_coupon_code }}">
          {{ ve_claim_btn }}
        </button>
        <button type="button" class="ve-btn-close-action" id="ve-close-card">
          {{ ve_close_btn }}
        </button>
      </div>
    </div>
  </div>

  {%- comment %} ── DRAWER TERMINI E CONDIZIONI ── {%- endcomment %}
  <div class="ve-overlay" id="ve-terms-overlay"></div>
  <div class="ve-drawer" id="ve-terms-drawer" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="ve-dhead">
      <span class="ve-dhead-title">
        {{- 'vantaggi.terms_modal_title' | t: default: 'Termini e Condizioni Promozionali' -}}
      </span>
      <button class="ve-dclose" id="ve-close-terms-x" type="button" aria-label="Chiudi">x</button>
    </div>
    <div class="ve-dbody">
      <!-- Dettagli del Coupon -->
      <div class="ve-ocard ve-ocard-drawer">
        <div class="ve-otag">📌 {{ 'vantaggi.promo_details_title' | t: default: 'Dettagli della Promozione' }}</div>
        <p class="ve-odesc ve-odesc-last">
          • <strong>{{ 'vantaggi.term_discount_value' | t: default: 'Valore sconto' }}:</strong> 20% sul totale dei
          prodotti idonei.<br>
          • <strong>{{ 'vantaggi.term_min_spend' | t: default: 'Spesa minima' }}:</strong> Applicabile su acquisti da
          40,00 €.<br>
          • <strong>{{ 'vantaggi.term_max_discount' | t: default: 'Sconto massimo' }}:</strong> 12,00 €.<br>
          • <strong>{{ 'vantaggi.term_validity' | t: default: 'Durata offerta' }}:</strong> Valida per cicli da 48 ore
          dalla prima visita del cliente e automaticamente rinnovabile.<br>
          • <strong>{{ 'vantaggi.term_limits' | t: default: 'Limitazioni' }}:</strong> Non cumulabile con altri codici
          promozionali.
        </p>
      </div>

      <!-- Sezione Clienti UE -->
      <div class="ve-ocard ve-ocard-drawer">
        <div class="ve-otag">
          🇪🇺 {{ 'vantaggi.eu_clients_title' | t: default: "Per i Clienti dell'Unione Europea (UE)" }}
        </div>
        <p class="ve-odesc ve-odesc-last">
          • <strong>Trasparenza Prezzi (Direttiva UE 2019/2161 - Omnibus):</strong> La percentuale di sconto viene
          applicata al prezzo di vendita. Ogni prezzo precedente fa riferimento al prezzo più basso degli ultimi 30
          giorni.<br>
          • <strong>Diritto di Recesso (Direttiva UE 2011/83/UE):</strong> Diritto di recesso garantito entro 14 giorni.
          Il rimborso in caso di reso corrisponderà al valore netto effettivamente pagato.
        </p>
      </div>

      <!-- Sezione Clienti Extra-UE -->
      <div class="ve-ocard ve-ocard-drawer">
        <div class="ve-otag ve-otag-dark">
          🌐 {{ 'vantaggi.extra_eu_clients_title' | t: default: 'Per i Clienti Internazionali (Extra-UE)' }}
        </div>
        <p class="ve-odesc ve-odesc-last">
          • <strong>Calcolo Sconto:</strong> Sconto applicato unicamente sul valore netto dei prodotti, escluse spese di
          spedizione estere e sdoganamento.<br>
          • <strong>Dazi e Tasse:</strong> Imposte e dazi doganali locali rimangono a carico del cliente.
        </p>
      </div>

      <!-- Supporto e Assistenza -->
      <div class="ve-ocard ve-ocard-drawer">
        <div class="ve-otag">✉️ {{ 'vantaggi.support_title' | t: default: 'Assistenza e Supporto Clienti' }}</div>
        <p class="ve-odesc ve-odesc-last">
          In caso di domande o difficoltà con il codice sconto, il nostro team è a disposizione:<br>
          Email:
          <a href="mailto:contact@platinumshop.it" class="ve-terms-link" style="font-weight:700;"
            >contact@platinumshop.it</a
          >
        </p>
      </div>
    </div>
    <div class="ve-dfooter">
      <button class="ve-dfooter-btn" id="ve-close-terms-btn" type="button">{{ ve_close_btn }}</button>
    </div>
  </div>
</div>

