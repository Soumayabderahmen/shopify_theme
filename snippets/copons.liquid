<script>
  (function () {
    'use strict';

    var trigger = document.getElementById('ve-open-trigger');
    var popupCard = document.getElementById('ve-popup-card');
    var closeCard = document.getElementById('ve-close-card');

    var openTerms = document.getElementById('ve-open-terms');
    var termsDrawer = document.getElementById('ve-terms-drawer');
    var termsOverlay = document.getElementById('ve-terms-overlay');
    var closeTermsBtn = document.getElementById('ve-close-terms-btn');
    var closeTermsX = document.getElementById('ve-close-terms-x');
    var claimBtn = document.getElementById('ve-claim-code');
    var timerClock = document.getElementById('ve-countdown-timer');

    /* ── TELEPORT IN BODY ── */
    function teleportToBody() {
      if (termsOverlay && termsOverlay.parentElement !== document.body) {
        document.body.appendChild(termsOverlay);
      }
      if (termsDrawer && termsDrawer.parentElement !== document.body) {
        document.body.appendChild(termsDrawer);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', teleportToBody);
    } else {
      teleportToBody();
    }

    /* ── ACCORDION (Toggle Aperto/Chiuso & Peek handling) ── */
    function toggleCard() {
      var isOpen = popupCard.classList.contains('is-open');
      if (isOpen) {
        popupCard.classList.remove('is-open');
        popupCard.setAttribute('aria-hidden', 'true');
        trigger.setAttribute('aria-expanded', 'false');
      } else {
        popupCard.classList.add('is-open');
        popupCard.setAttribute('aria-hidden', 'false');
        trigger.setAttribute('aria-expanded', 'true');
      }
    }

    if (trigger) {
      trigger.addEventListener('click', function() {
        toggleCard();
      });
      trigger.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleCard();
        }
      });
    }

    if (closeCard) {
      closeCard.addEventListener('click', function() {
        popupCard.classList.remove('is-open');
        popupCard.setAttribute('aria-hidden', 'true');
        trigger.setAttribute('aria-expanded', 'false');
      });
    }

    /* ── DRAWER TERMINI ── */
    function openDrawer() {
      teleportToBody();
      termsOverlay.classList.add('on');
      termsOverlay.setAttribute('aria-hidden', 'false');
      termsDrawer.classList.add('on');
      termsDrawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      termsOverlay.classList.remove('on');
      termsOverlay.setAttribute('aria-hidden', 'true');
      termsDrawer.classList.remove('on');
      termsDrawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (openTerms) {
      openTerms.addEventListener('click', openDrawer);
      openTerms.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openDrawer();
        }
      });
    }

    if (closeTermsBtn) closeTermsBtn.addEventListener('click', closeDrawer);
    if (closeTermsX) closeTermsX.addEventListener('click', closeDrawer);
    if (termsOverlay) termsOverlay.addEventListener('click', closeDrawer);

    /* ── GESTIONE TIMER RIATTIVABILE (2 GIORNI) ── */
    var TIMER_KEY = 've_coupon_expiry';
    var TWO_DAYS_MS = 2 * 24 * 60 * 60 * 1000;

    function getExpiryTime() {
      var savedExpiry = localStorage.getItem(TIMER_KEY);
      var now = new Date().getTime();

      if (!savedExpiry || now >= parseInt(savedExpiry, 10)) {
        var newExpiry = now + TWO_DAYS_MS;
        localStorage.setItem(TIMER_KEY, newExpiry.toString());
        return newExpiry;
      }
      return parseInt(savedExpiry, 10);
    }

    function updateTimer() {
      var expiry = getExpiryTime();
      var now = new Date().getTime();
      var diff = expiry - now;

      if (diff <= 0) {
        expiry = getExpiryTime();
        diff = expiry - now;
      }

      var days = Math.floor(diff / (1000 * 60 * 60 * 24));
      var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var seconds = Math.floor((diff % (1000 * 60)) / 1000);

      var pad = function (num) {
        return num < 10 ? '0' + num : num;
      };

      if (timerClock) {
        timerClock.textContent = pad(days) + 'd ' + pad(hours) + 'h ' + pad(minutes) + 'm ' + pad(seconds) + 's';
      }
    }

    setInterval(updateTimer, 1000);
    updateTimer();

    /* ── COPIA CODICE ── */
    function copyText(textToCopy, callback) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard
          .writeText(textToCopy)
          .then(callback)
          .catch(function () {
            fallbackCopy(textToCopy, callback);
          });
      } else {
        fallbackCopy(textToCopy, callback);
      }
    }

    function fallbackCopy(text, cb) {
      var textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-9999px';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        document.execCommand('copy');
        cb();
      } catch (err) {}
      document.body.removeChild(textArea);
    }

    if (claimBtn) {
      claimBtn.addEventListener('click', function () {
        var code = claimBtn.dataset.code;
        copyText(code, function () {
          var originalText = claimBtn.textContent;
          claimBtn.textContent = 'Copiato!';
          claimBtn.classList.add('ok');
          setTimeout(function () {
            claimBtn.textContent = originalText;
            claimBtn.classList.remove('ok');
          }, 2000);
        });
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeDrawer();
    });
  })();
</script>