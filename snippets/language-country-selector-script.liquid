{%- comment -%}
  Choix automatique langue / pays (géolocalisation) des sélecteurs de snippets/language-country-selector.liquid.
  Rendu une seule fois par page dans layout/theme.liquid (avant : une copie par sélecteur, 4 par page).
{%- endcomment -%}
<script>
  (function () {
    if (window.__geoLanguageSelectorInitialized) return;
    window.__geoLanguageSelectorInitialized = true;

    var manualChoiceKey = 'shopify_manual_language_choice';
    var manualCountryChoiceKey = 'shopify_manual_country_choice';
    var autoAttemptKey = 'shopify_geo_language_attempted';
    var detectedCountryKey = 'shopify_geo_detected_country';

    // L'ancien script de theme.liquid reste présent, mais cette nouvelle logique le remplace.
    try { window.sessionStorage.setItem('geo_redirected', 'true'); } catch (error) {}

    function storageGet(storage, key) {
      try { return storage.getItem(key); } catch (error) { return null; }
    }

    function storageSet(storage, key, value) {
      try { storage.setItem(key, value); } catch (error) {}
    }

    document.addEventListener('click', function (event) {
      var button = event.target.closest('button[name="locale_code"]');
      if (!button || !event.isTrusted) return;
      storageSet(window.localStorage, manualChoiceKey, button.value.toLowerCase());
    }, true);

    document.addEventListener('click', function (event) {
      var button = event.target.closest('button[name="country_code"]');
      if (!button || !event.isTrusted) return;
      storageSet(window.localStorage, manualCountryChoiceKey, button.value.toUpperCase());
    }, true);

    async function applyAutomaticLanguage() {
      if (storageGet(window.localStorage, manualChoiceKey)) return;
      if (storageGet(window.localStorage, manualCountryChoiceKey)) return;
      if (storageGet(window.sessionStorage, autoAttemptKey)) {
        window.__geoDetectedCountry = storageGet(window.sessionStorage, detectedCountryKey);
        return;
      }

    var currentCountry = {{ localization.country.iso_code | json }}.toUpperCase();
    var country = currentCountry;
    var suggestedLanguage = null;

    // localization.country est le pays déjà sélectionné (par exemple le cookie IT).
    // Cette API Shopify détecte le pays réel conseillé à partir de l'IP et du navigateur.
    try {
      var suggestionsUrl = (window.Shopify.routes && window.Shopify.routes.root
        ? window.Shopify.routes.root
        : '/'
      ) + 'browsing_context_suggestions.json?country[enabled]=true&language[enabled]=true';
      var suggestionsResponse = await fetch(suggestionsUrl, {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      });

      if (suggestionsResponse.ok) {
        var suggestionsData = await suggestionsResponse.json();
        var detectedCountry = suggestionsData
          && suggestionsData.detected_values
          && suggestionsData.detected_values.country
          && suggestionsData.detected_values.country.handle;

        if (detectedCountry) country = detectedCountry.toUpperCase();

        var firstSuggestion = suggestionsData
          && suggestionsData.suggestions
          && suggestionsData.suggestions[0];
        suggestedLanguage = firstSuggestion
          && firstSuggestion.parts
          && firstSuggestion.parts.language
          && firstSuggestion.parts.language.handle;
        if (suggestedLanguage) suggestedLanguage = suggestedLanguage.toLowerCase();
      }
    } catch (error) {
      // En cas d'indisponibilité de l'API, Shopify conserve le pays sélectionné.
    }

    window.__geoDetectedCountry = country;
    var currentLocale = {{ localization.language.iso_code | json }}.toLowerCase();
    var availableLocales = [
      {%- for language in localization.available_languages -%}
        {{ language.iso_code | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ].map(function (locale) { return locale.toLowerCase(); });
    var availableCountries = [
      {%- for available_country in localization.available_countries -%}
        {{ available_country.iso_code | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ].map(function (countryCode) { return countryCode.toUpperCase(); });

    var browserLocales = (navigator.languages && navigator.languages.length
      ? navigator.languages
      : [navigator.language || '']
    ).map(function (locale) { return locale.toLowerCase(); });

    function browserPrefers(candidates) {
      for (var i = 0; i < browserLocales.length; i += 1) {
        var base = browserLocales[i].split('-')[0];
        if (candidates.indexOf(base) !== -1) return base;
      }
      return null;
    }

    function canadianLanguage() {
      var preferred = browserPrefers(['fr', 'en']);
      if (preferred === 'fr') return 'fr';

      var timeZone = '';
      try { timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (error) {}
      if (timeZone === 'America/Montreal') return 'fr';

      var knownEnglishZones = [
        'America/Toronto', 'America/Vancouver', 'America/Edmonton', 'America/Winnipeg',
        'America/Halifax', 'America/St_Johns', 'America/Regina', 'America/Whitehorse'
      ];
      if (knownEnglishZones.indexOf(timeZone) !== -1) return 'en';

      // Shopify ne fournit pas toujours la province : Canada utilise alors le français.
      return 'fr';
    }

    function swissLanguage() {
      return browserPrefers(['de', 'fr', 'it']) || 'de';
    }

    var countryLanguageMap = {
      IT: 'it', SM: 'it', VA: 'it',
      US: 'en', GB: 'en', UK: 'en', AU: 'en', IE: 'en', NZ: 'en',
      FR: 'fr', BE: 'fr', LU: 'fr', MC: 'fr', HT: 'fr',
      DE: 'de', AT: 'de', LI: 'de',
      ES: 'es', MX: 'es', AR: 'es', CO: 'es', CL: 'es', PE: 'es', VE: 'es',
      UY: 'es', PY: 'es', BO: 'es', EC: 'es', GT: 'es', CR: 'es', PA: 'es',
      DO: 'es', NI: 'es', HN: 'es', SV: 'es', CU: 'es',
      BR: 'pt', PT: 'pt', AO: 'pt', MZ: 'pt',
      JP: 'ja', NL: 'nl', PL: 'pl', SE: 'sv', RO: 'ro', MD: 'ro'
    };

    var targetLanguage = country === 'CA'
      ? canadianLanguage()
      : country === 'CH'
        ? swissLanguage()
        : countryLanguageMap[country] || suggestedLanguage;

    if (!targetLanguage) targetLanguage = 'en';

    var targetLocale = availableLocales.find(function (locale) {
      return locale === targetLanguage || locale.split('-')[0] === targetLanguage;
    });

    if (!targetLocale) {
      targetLocale = availableLocales.find(function (locale) {
        return locale === 'en' || locale.split('-')[0] === 'en';
      });
    }

    var targetCountry = availableCountries.indexOf(country) !== -1
      ? country
      : currentCountry;
    var needsLanguageChange = targetLocale && targetLocale !== currentLocale;
    var needsCountryChange = targetCountry !== currentCountry;

    if (!needsLanguageChange && !needsCountryChange) return;

    var forms = document.querySelectorAll('form.localization-form');
    var localizationForm = null;
    for (var formIndex = 0; formIndex < forms.length; formIndex += 1) {
      if (forms[formIndex].querySelector('[name="locale_code"], [name="country_code"]')) {
        localizationForm = forms[formIndex];
        break;
      }
    }
    if (!localizationForm) return;

    storageSet(window.sessionStorage, autoAttemptKey, targetCountry + '|' + (targetLocale || currentLocale));
    storageSet(window.sessionStorage, detectedCountryKey, country);

    var localeInput = localizationForm.querySelector('input[name="locale_code"]');
    if (!localeInput) {
      localeInput = document.createElement('input');
      localeInput.type = 'hidden';
      localeInput.name = 'locale_code';
      localizationForm.appendChild(localeInput);
    }
    localeInput.value = targetLocale || currentLocale;

    var countryInput = localizationForm.querySelector('input[name="country_code"]');
    if (!countryInput) {
      countryInput = document.createElement('input');
      countryInput.type = 'hidden';
      countryInput.name = 'country_code';
      localizationForm.appendChild(countryInput);
    }
    countryInput.value = targetCountry;

    var returnToInput = localizationForm.querySelector('input[name="return_to"]');
    if (!returnToInput) {
      returnToInput = document.createElement('input');
      returnToInput.type = 'hidden';
      returnToInput.name = 'return_to';
      localizationForm.appendChild(returnToInput);
    }
    returnToInput.value = window.location.pathname + window.location.search + window.location.hash;

      localizationForm.submit();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyAutomaticLanguage, { once: true });
    } else {
      applyAutomaticLanguage();
    }
  })();
</script>
