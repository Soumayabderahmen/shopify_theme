{%- capture price_element -%}
  {% if price_location == 'next_to_title' %}
    &nbsp;
    <span class="price s1pr alibaba-card__price-inline">
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <span class="old-price">{{ current_variant.compare_at_price | money }}</span>&nbsp;
      {% endif %}
      {{ current_variant.price | money }}
    </span>
  {% else %}
    <p class="price s1pr alibaba-card__price-main">
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <span class="old-price">{{ current_variant.compare_at_price | money }}</span>&nbsp;
      {% endif %}
      {{ current_variant.price | money }}
      {%- if current_variant.unit_price_measurement -%}
        <span class="small">
          {{- 'product.unit_price_label' | t -}}
          {{- current_variant.unit_price | unit_price_with_measurement: current_variant.unit_price_measurement -}}
        </span>
      {%- endif -%}
    </p>
  {% endif %}
{%- endcapture -%}

{%- if enable_quick_buy_desktop or enable_quick_buy_mobile -%}
  {%- liquid
    assign product_form_class = 'f8pr form-card alibaba-card__form'
    unless enable_quick_buy_mobile
      assign product_form_class = product_form_class | append: ' mobile-hide'
    endunless
    unless enable_quick_buy_desktop
      assign product_form_class = product_form_class | append: ' mobile-only'
    endunless
    assign product_form_id = 'quick-add-' | append: section.id | append: product.id | append: '-quick-add-form_x'
  -%}
  {%- capture quick_buy -%}
    {%- if layout == 'list-compact' -%}
      {%- form 'product', product, id: product_form_id, class: product_form_class, novalidate: 'novalidate' -%}
        {%- assign available_variants = product.variants | where: "available" -%}
        {%- if enable_variant_picker and available_variants.size > 1 and product.variants.size < 250 -%}
          <p>
            <select name="id">
              {%- for variant in product.variants -%}
                {%- unless variant.available -%}{% continue %}{%- endunless -%}
                {%- liquid
                  if variant.featured_image
                    assign product_image = variant.featured_image
                   else
                    assign product_image = product.featured_image
                  endif
                -%}
                <option
                  value="{{ variant.id }}"
                  data-variantinfo='{ {% if product_image %}"image":"{%- if settings.fill_product_images -%}{{ product_image | image_url: width: image_width_2, height: image_height_2, crop: 'center' }}{%- else -%}{{ product_image | image_url: width: image_width_2 }}{%- endif -%}",{% endif %}"price_old":"{%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money }}{%- endif -%}","price":"{{ variant.price | money }}"}'
                  {% unless variant.available %}disabled data-class="disabled"{% endunless %}
                  {% if variant == current_variant %}selected{% endif %}
                >{{ variant.title }}</option>
              {%- endfor -%}
            </select>
          </p>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- endif -%}
        <p class="submit">
          <button
            type="submit"
            class="alibaba-btn alibaba-btn--primary {% if cart_upsell_quick_add_only %}circle {% endif %}{% if preorder %}overlay-preorder {% elsif current_variant.available %}overlay-buy_button{% else %}overlay-unavailable-buy-button{% endif %}{% if settings.button_style == 'inv' %} inv{% endif %}"
            aria-label="{% if preorder and settings.preorder_button_text != '' %}{{ settings.preorder_button_text }}{% else %}{{ 'product.form.add_to_cart' | t }}{% endif %}"
          >
            <i aria-hidden="true" class="icon-cart"></i>
            {% if preorder and settings.preorder_button_text != '' %}
              {{ settings.preorder_button_text }}
            {% else %}
              {{ 'product.form.add_to_cart' | t }}
            {% endif %}
          </button>
        </p>
      {%- endform -%}
    {%- elsif product.variants.size == 1 and current_variant.available and enable_quick_buy_drawer == false -%}
      {%- form 'product', product, id: product_form_id, class: product_form_class, novalidate: 'novalidate' -%}
        <fieldset>
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <p class="submit{% if layout == 'hotspot' %} wide{% endif %}">
            {%- if enable_quick_buy_qty_selector -%}
              <span class="input-amount">
              <label for="quantity-{{ product_form_id }}" class="hidden">{{ 'product.form.quantity' | t }}</label>
              <input type="number" id="quantity-{{ product_form_id }}" name="quantity" value="{{ current_variant.quantity_rule.min }}"
                  min="{{ current_variant.quantity_rule.min }}"
                 {% if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny' -%}
                   max="{{ current_variant.inventory_quantity }}"
                 {% elsif current_variant.quantity_rule.max %}
                   max="{{ current_variant.quantity_rule.max }}"
                 {% endif %}
                {% if current_variant.quantity_rule.increment %}step="{{ current_variant.quantity_rule.increment }}"{% endif %}
                required>
            </span>
            {%- endif -%}
            <button type="submit" class="alibaba-btn alibaba-btn--primary {% if preorder %}overlay-preorder{% elsif current_variant.available %}overlay-buy_button{% else %}overlay-unavailable-buy-button{% endif %}{% if settings.button_style == 'inv' %} inv{% endif %}{% if quick_buy_compact %} compact{% if layout == 'list' %} w160{% endif %}{% endif %}" aria-label="{% if preorder and settings.preorder_button_text != '' %}{{ settings.preorder_button_text }}{% else %}{{ 'product.form.add_to_cart' | t }}{% endif %}">
              {%- unless quick_buy_compact -%}
                <span class="mobile-hide">
                  {% if preorder and settings.preorder_button_text != '' %}
                    {{ settings.preorder_button_text }}
                  {% else %}
                    {{ 'product.form.add_to_cart' | t }}
                  {% endif %}
                </span>
              {%- endunless -%}
              <i aria-hidden="true" class="icon-cart{% unless quick_buy_compact %} mobile-only{% endunless %}"></i>
            </button>
          </p>
        </fieldset>
      {%- endform -%}
    {%- else -%}
      <p class="link-btn wide alibaba-card__action-link {% unless enable_quick_buy_mobile %}mobile-hide{% endunless %} {% unless enable_quick_buy_desktop %}mobile-only{% endunless %} {% if quick_buy_compact and layout == 'list' %} w160{% endif %}">
        <a class="alibaba-btn alibaba-btn--secondary overlay-buy_button{% if settings.button_style == 'inv' %} inv{% endif %}" href="{{ product.url }}"{% if enable_quick_buy_drawer and product != blank %} data-quickshop{% endif %}>
          {%- if quick_buy_compact -%}
            {{ 'product.form.view' | t }}
          {%- else -%}
            {{ 'product.form.view_options' | t }}
          {%- endif -%}
        </a>
      </p>
    {%- endif -%}
  {%- endcapture %}
{%- endif -%}

<{{ container }}
  class="
    alibaba-product-card
    {% if cart_upsell_card %}
      has-form dont-move
    {% else %}
      legacy-product-card
      {% if extra_class %}{% unless extra_style contains '--vertical' %}{{ extra_class }}{% endunless %}{% endif %} product-card {{ width_class }}{% if settings.enable_quick_buy != 'none' %} has-form{% endif %}
      {% unless current_variant.available %}unavailable{% endunless %}
      {% unless layout contains 'list' %}{% if settings.productcards_text_alignment == 'center' %}text-center{% elsif settings.productcards_text_alignment == 'right' %}text-end{% endif %}{% endunless %}
      {% if settings.show_secondary_image %}second-img-hover{% endif %}
      {% if product == blank %}placeholder-product{% endif %}
      {% if upsell and index > visible_products %}hidden{% endif %}
    {% endif %}
  "
  {% if layout == 'list-compact' %}
    data-product-id="{{ product.id }}"
  {% endif %}
  {% if upsell and index > visible_products %}
    data-element="unique-more-products-class"
  {% endif %}
  {% unless extra_style contains '--vertical' %}
    {{- shopify_attributes -}}
  {% endunless %}
  style="{{ extra_style }} --anim-delay: {{ anim_delay }};"
>
  {% if extra_style contains '--vertical' %}
    <div {{ shopify_attributes }} class="{% if extra_class %}{{ extra_class }}{% endif %}">
  {% endif %}

  {%- if upsell -%}
    <span class="check alibaba-card__upsell-check">
      <input
        type="checkbox"
        {% if current_variant.available == false %}
          disabled="disable"
        {% endif %}
        data-id="{{ current_variant.id }}"
        {% if is_child_product and parent_product_id %}
          data-parent-product="{{ parent_product_id }}"
        {% endif %}
        id="{{ id }}-{{ product.id }}-id"
        name="c4a"
      >
      <label class="hidden" for="{{ id }}-{{ product.id }}-id">{{ 'product.form.choose_product' | t }}</label>
    </span>
  {%- endif -%}

  {%- if show_image -%}
    <figure
      class="
        alibaba-card__media
        {% if settings.multiply_product_images == 'multiply' %} img-multiply{% elsif settings.multiply_product_images == 'multiply-bg' %} img-multiply-bg{% endif %}
        {% if settings.fade_unavailable_products and current_variant.available == false %} unavailable-faded{% endif %}
      "
    >
      {% if show_labels %}{%- render 'product-labels', product: product, origin: 'productitem' -%}{% endif %}

      <div class="alibaba-card__media-link">
        {%- liquid
          if layout == 'list-compact' and current_variant.featured_image
            assign product_image = current_variant.featured_image
          elsif product.selected_or_first_available_variant.featured_image
            assign product_image = product.selected_or_first_available_variant.featured_image
          else
            assign product_image = product.media.first
          endif
        -%}
        {%- if product != blank and product_image -%}
          <picture class="alibaba-card__picture">
            <img
              src="{%- if settings.fill_product_images -%}{{ product_image | image_url: width: image_width_2, height: image_height_2, crop: 'center' }}{%- else -%}{{ product_image | image_url: width: image_width_2 }}{%- endif -%}"
              {%- if sizes -%}
                srcset="
                  {%- if settings.fill_product_images -%}
                    {%- render 'image-srcset', image: product_image, format: image_ratio, max_width: 640, crop: 'center' -%}
                  {%- else -%}
                    {%- render 'image-srcset', image: product_image, format: image_ratio, max_width: 640 -%}
                  {%- endif -%}
                "
                sizes="{{ sizes }}"
              {%- else -%}
                srcset="
                  {%- if settings.fill_product_images -%}
                    {{ product_image | image_url: width: image_width, height: image_height, crop: 'center' }} 1x, {{ product_image | image_url: width: image_width_2, height: image_height_2, crop: 'center' }} 2x
                  {%- else -%}
                    {{ product_image | image_url: width: image_width }} 1x, {{ product_image | image_url: width: image_width_2 }} 2x
                  {%- endif -%}
                "
              {%- endif -%}
              width="{{ image_width }}"
              height="{{ image_height }}"
              alt="{{ product_image.alt | default: product.title | escape }}"
              {% if settings.fill_product_images %}
                class="filled"
              {% endif %}
              loading="{% if section.index > 2 or no_lazyload == false or section.location == 'footer' %}lazy{% else %}eager{% endif %}"
            >
          </picture>
          {%- if product.media[1] != null and settings.show_secondary_image and layout != 'list-compact' -%}
            <picture class="alibaba-card__picture alibaba-card__picture--secondary">
              <img
                src="{%- if settings.fill_product_images -%}{{ product.media[1] | image_url: width: image_width_2, height: image_height_2, crop: 'center' }}{%- else -%}{{ product.media[1] | image_url: width: image_width_2 }}{%- endif -%}"
                {%- if sizes -%}
                  srcset="
                    {%- if settings.fill_product_images -%}
                      {%- render 'image-srcset', image: product.media[1], format: image_ratio, max_width: 640, crop: 'center' -%}
                    {%- else -%}
                      {%- render 'image-srcset', image: product.media[1], format: image_ratio, max_width: 640 -%}
                     {%- endif -%}
                  "
                  sizes="{{ sizes }}"
                {%- else -%}
                  srcset="
                    {%- if settings.fill_product_images -%}
                      {{ product.media[1] | image_url: width: image_width, height: image_height, crop: 'center' }} 1x, {{ product.media[1] | image_url: width: image_width_2, height: image_height_2, crop: 'center' }} 2x
                    {%- else -%}
                      {{ product.media[1] | image_url: width: image_width }} 1x, {{ product.media[1] | image_url: width: image_width_2 }} 2x
                    {%- endif -%}
                  "
                {%- endif -%}
                width="{{ image_width }}"
                height="{{ image_height }}"
                alt="{{ product.media[1].alt | default: product.title | escape }}"
                loading="lazy"
                {% if settings.fill_product_images %}
                  class="filled"
                {% endif %}
              >
            </picture>
          {%- endif -%}
        {%- else -%}
          <picture class="alibaba-card__picture">
            {{- 'product-' | append: placeholder_int | placeholder_svg_tag: 'placeholder-svg' -}}
          </picture>
        {%- endif -%}
      </div>

      {% comment %} {%- if bestseller_count > 50 -%}
        <div class="alibaba-top-selling-ribbon" role="status" aria-label="{{ top_selling_text }}">
          <span class="alibaba-top-selling-ribbon__star" aria-hidden="true">★</span>
          <span class="alibaba-top-selling-ribbon__text">{{ top_selling_text }}</span>
        </div>
      {%- endif -%} {% endcomment %}
{%- comment -%}
  1. Estrazione Brand dal Titolo e dal Vendor
{%- endcomment -%}
{%- assign target_brands = "nike, adidas, puma, reebok, new balance, onemix, jordan, asics" | split: ", " -%}
{%- assign product_title_lower = product.title | downcase -%}
{%- assign product_vendor_lower = product.vendor | downcase -%}
{%- assign matched_brand = "" -%}

{%- for brand in target_brands -%}
  {%- assign brand_lower = brand | downcase -%}
  {%- if product_title_lower contains brand_lower or product_vendor_lower contains brand_lower -%}
    {%- assign matched_brand = brand | capitalize -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%}
  2. Logica di Rendering
{%- endcomment -%}
{%- if bestseller_count > 50 -%}

  {%- if matched_brand != "" -%}
    <!-- bestseller_count > 50 + BRAND: Cubo 3D Animato -->
    {%- comment -%}
      Cube animé (classes apc-flip*, assets/product-card.css) : les styles mobiles des grilles figent les .alibaba-cube
      (transform / animation none !important) ; des classes propres le laissent tourner partout.
    {%- endcomment -%}
    <div class="alibaba-top-selling-ribbon alibaba-top-selling-ribbon--animated" role="status" aria-label="{{ top_selling_text }}">
      <div class="apc-flip-scene">
        <div class="apc-flip">
          <!-- Faccia Frontale: Bestseller -->
          <div class="apc-flip__face apc-flip__face--front">
            <span class="alibaba-top-selling-ribbon__star" aria-hidden="true">★</span>
            <span class="alibaba-top-selling-ribbon__text">{{ top_selling_text }}</span>
          </div>
          <!-- Faccia Posteriore: Verified Brand -->
          <div class="apc-flip__face apc-flip__face--top">
            <span class="alibaba-verified-badge__icon">✓</span>
            <span class="alibaba-verified-badge__text">Verified {{ matched_brand }}</span>
          </div>
        </div>
      </div>
    </div>
  {%- else -%}
    {%- comment -%}
      bestseller_count > 50 sans marque : même cube animé que les marques (mobile), seconde face = ventes réelles
      (métadonnée custom.bestseller_count, « 120 vendus »). Ordinateur : ruban fixe comme avant (assets/product-card.css).
    {%- endcomment -%}
    {%- assign sold_short_text = 'mobile.home.sold_count' | t: count: bestseller_count -%}
    <div class="alibaba-top-selling-ribbon alibaba-top-selling-ribbon--sold-cube" role="status" aria-label="{{ top_selling_text }}">
      <div class="apc-flip-scene">
        <div class="apc-flip">
          <div class="apc-flip__face apc-flip__face--front">
            <span class="alibaba-top-selling-ribbon__star" aria-hidden="true">★</span>
            <span class="alibaba-top-selling-ribbon__text">{{ top_selling_text }}</span>
          </div>
          <div class="apc-flip__face apc-flip__face--top apc-flip__face--sold">
            <span class="alibaba-sold-badge__icon" aria-hidden="true">🔥</span>
            <span class="alibaba-top-selling-ribbon__text">{{ sold_short_text }}</span>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

{%- elsif matched_brand != "" -%}

  {%- comment -%}
    bestseller_count <= 50 + marque : sur mobile, cube qui alterne « Verified [marque] » et les ventes réelles
    (« 12 vendus ») ou, sans ventes enregistrées, « Boutique officielle [marque] ». Ordinateur : badge Verified fixe.
  {%- endcomment -%}
  {%- if bestseller_count > 0 -%}
    {%- assign brand_second_text = 'mobile.home.sold_count' | t: count: bestseller_count -%}
    {%- assign brand_second_class = 'apc-flip__face--sold' -%}
    {%- assign brand_second_icon = '🔥' -%}
  {%- else -%}
    {%- assign brand_second_text = 'mobile.home.official_store' | t: brand: matched_brand -%}
    {%- assign brand_second_class = 'apc-flip__face--store' -%}
    {%- assign brand_second_icon = '★' -%}
  {%- endif -%}
  <div class="alibaba-top-selling-ribbon alibaba-top-selling-ribbon--verified-only alibaba-top-selling-ribbon--verified-cube" role="status" aria-label="Verified {{ matched_brand }}">
    <div class="apc-flip-scene">
      <div class="apc-flip">
        <div class="apc-flip__face apc-flip__face--front apc-flip__face--verified">
          <span class="alibaba-verified-badge__icon">✓</span>
          <span class="alibaba-verified-badge__text">Verified {{ matched_brand }}</span>
        </div>
        <div class="apc-flip__face apc-flip__face--top {{ brand_second_class }}">
          <span class="alibaba-sold-badge__icon" aria-hidden="true">{{ brand_second_icon }}</span>
          <span class="alibaba-top-selling-ribbon__text">{{ brand_second_text }}</span>
        </div>
      </div>
    </div>
  </div>

{%- endif -%}
      <button
        type="button"
        class="wishlist-productcard hidden alibaba-card__wishlist"
        title="Wishlist"
        data-product-id="{{ product.id }}"
        data-variant-id="{{ current_variant.id }}"
        data-variant-title="{{ current_variant.title | escape }}"
        data-price-cents="{{ current_variant.price }}"
        data-compare-at-price-cents="{{ current_variant.compare_at_price }}"
      >
        <svg class="alibaba-card__wishlist-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"></path>
        </svg>
        <i class="icon-heart-outline"></i>
      </button>

      {%- comment -%} Bouton panier (mobile uniquement) : ouvre la modale couleur / taille (snippets/mobile-quick-add.liquid). {%- endcomment -%}
      {%- if product.available -%}
        {%- liquid
          assign qa_card_label = 'mobile.js.choose_options_for' | t
          assign qa_card_label = qa_card_label | replace: '{title}', product.title
        -%}
        <button
          type="button"
          class="alibaba-card__qa mobile-only{% if bestseller_count > 50 or matched_brand != '' %} is-up{% endif %}"
          aria-label="{{ qa_card_label | escape }}"
          aria-haspopup="dialog"
          data-quick-add="{{ product.handle }}"
        >
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><g class="qa-cart"><path d="M6 6h15l-1.5 9h-12z"></path><path d="M6 6 5 2H2"></path><circle cx="9" cy="20" r="1.5"></circle><circle cx="18" cy="20" r="1.5"></circle></g><path class="qa-tick" d="m7.6 12.6 3 3 5.8-6.4"></path></svg>
        </button>
      {%- endif -%}

      {%- if quick_buy and layout != 'list-compact' -%}
        {{ quick_buy | replace: 'alibaba-card__form', 'alibaba-card__form alibaba-card__quickbuy' | replace: '-quick-add-form_x', '1' }}
      {%- endif -%}
    </figure>
  {%- endif -%}

  <div class="alibaba-card__body">
    {%- if show_title or show_vendor -%}
      {%- if custom_title and upsell -%}
        <label for="{{ id }}-{{ product.id }}-id" class="alibaba-card__title-label">
          {{- title -}}
          {%- if upsell and show_price and price_location == 'next_to_title' -%}
            {{- price_element -}}
          {%- endif -%}
        </label>
      {%- else -%}
        <div class="alibaba-card__header">
          <h3 class="alibaba-card__title {% unless show_vendor %}p0{% endunless %}">
            {%- if show_vendor -%}
              <span class="alibaba-card__vendor">{{ vendor }}&nbsp;·&nbsp;</span>
            {%- endif -%}
            {%- if show_title -%}
              <a
                href="{{ product.url }}"
                {% if settings.product_titles_caps %}
                  class="text-uppercase"
                {% endif %}
              >
                {{- title -}}
                {%- if upsell and show_price and price_location == 'next_to_title' -%}
                  {{- price_element -}}
                {%- endif -%}
              </a>
            {%- endif -%}
            {%- if layout == 'list-compact' and product.has_only_default_variant == false -%}
              {% if enable_variant_picker == false or enable_variant_picker and available_variants.size == 1 %}
                <span class="alibaba-card__variant small">
                  {{ current_variant.title }}
                </span>
              {%- endif -%}
            {%- endif -%}
          </h3>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} TRUST ROW — spedizione, resi, riordini (una riga sola) {%- endcomment -%}
    {%- if product != blank -%}
      <div class="alibaba-card__trust">
        {%- if qualifies_for_free_shipping -%}
          <span class="alibaba-trust-chip alibaba-trust-chip--shipping" title="{{ shipping_text }} — {{ localization.country.name }}">
            <span aria-hidden="true">{{ flag_emoji }}</span>{{ shipping_text }}
          </span>
        {%- endif -%}
        <span class="alibaba-trust-chip alibaba-trust-chip--returns">
          <i aria-hidden="true">↩️</i>{{ Reso_facile }}
        </span>
        {%- if show_reorder_badge -%}
          <span class="alibaba-trust-chip alibaba-trust-chip--reorder">
            <i aria-hidden="true">🔄</i>{{ reorder_rate }}%
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if upsell %}
      {%- if show_price and price_location == 'below_title' -%}
        <div class="alibaba-card__price-wrapper">
          {{- price_element -}}
          {%- if moq > 0 -%}
            <p class="alibaba-card__moq">
              MOQ: {{ moq }}
              {{ 't.moq.unit' | t | default: 'articoli' }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if variant_in_popup and available_variants.size > 1 -%}
        <p class="alibaba-card__variant-popup">
          <span>{{ current_variant.title }}</span>
          <a
            href="./"
            data-options="{{ product.options | json | escape }}"
            data-title="{{ title }}"
            class="overlay-{{ variant_selector_color }} strong"
            data-variant="{{ current_variant.id }}"
            data-upsell
          >
            {{- 'product.form.choose_variant' | t }}
            <i aria-hidden="true" class="icon-chevron-right"></i>
          </a>
        </p>
      {% endif %}
      <p class="{% if variant_in_popup or product == blank or available_variants.size <= 1 %}hidden{% endif %} alibaba-card__variant-select">
        <select name="upsell-id" id="upsell-{{ id }}">
          {%- for variant in product.variants -%}
            {%- unless variant.available -%}{% continue %}{%- endunless -%}
            {%- liquid
              if variant.featured_image
                assign product_image = variant.featured_image
              else
                assign product_image = product.featured_image
              endif
            -%}
            <option
              value="{{ variant.id }}"
              data-variantinfo='{"id":{{ variant.id }}, "variant":"{{ variant.title }}", "options":{{ variant.options | json | escape }},{% if product_image %}"image":"{%- if settings.fill_product_images -%}{{ product_image | image_url: width: image_width_2, height: image_height_2, crop: 'center' }}{%- else -%}{{ product_image | image_url: width: image_width_2 }}{%- endif -%}",{% endif %}"price_old":"{%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money }}{%- endif -%}","price":"{{ variant.price | money }}"}'
              {% unless variant.available %}
                disabled data-class="disabled"
              {% endunless %}
              {% if variant == current_variant %}
                selected
              {% endif %}
            >
              {{ variant.title }}
            </option>
          {%- endfor -%}
        </select>
      </p>
    {%- else -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">
    {%- endif -%}

    {%- if show_rating -%}
      {%- liquid
        assign rating_value = false
        assign rating_count = false
        if product.metafields.syncer.reviews
          assign locale_ratings = product.metafields.syncer.reviews.value.reviews[localization.language.iso_code]
          if locale_ratings
            assign rating_value = locale_ratings.rating
            assign rating_count = locale_ratings.count
          else
            assign rating_value = product.metafields.syncer.reviews.value.cumulative_rating
            assign rating_count = product.metafields.syncer.reviews.value.total_reviews
          endif
        elsif product.metafields.reviews.rating
          assign rating_value = product.metafields.reviews.rating.value
          assign rating_count = product.metafields.reviews.rating_count
        endif
      -%}
      {% render 'badge--brand-products', product: product %}

      {%- if rating_value or bestseller_count > 0 -%}
        <div class="alibaba-card__meta">
          {%- if rating_value -%}
            <span class="alibaba-card__rating-inline">
              <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
             {% render 'rating-stars', value: rating_value %}
            </span>
            {%- if rating_count -%}
              {% comment %} <span class="alibaba-card__rating-count">({{ rating_count }})</span> {% endcomment %}
            {%- endif -%}
          {%- endif -%}
          {%- if bestseller_count > 0 -%}
            {% comment %} <span class="alibaba-card__sold">+{{ bestseller_count }} {{ 't.sold_suffix' | t | default: 'venduti' }}</span> {% endcomment %}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if show_stock -%}
      <div class="alibaba-card__stock">
        {%- render 'product-deliverytime',
          product: product,
          current_variant: current_variant,
          container: 'p',
          extra_class: 'list-hide',
          origin: 'productitem'
        -%}
      </div>
    {%- endif -%}
    {%- if settings.product_short_description != 'none' and type == 'both' %}
      {%- liquid
        if settings.product_short_description == 'custom'
          assign product_short_description_namespace = settings.product_short_description_text | split: '.' | first
          assign product_short_description_key = settings.product_short_description_text | split: '.' | last
          assign short_description = product.metafields[product_short_description_namespace][product_short_description_key]
        else
          assign short_description = product.description | strip_html
        endif
      -%}
      {% if short_description != empty and short_description != blank -%}
        <div class="alibaba-card__description info">
          <p>{{ short_description }}</p>
          <p class="link-more">
            <a href="./" class="strong link-more">
              {{- 'general.read_more.read' | t }}
              <span>{{ 'general.read_more.more' | t }}</span>
              <span class="hidden">{{ 'general.read_more.less' | t }}</span>
              <i aria-hidden="true" class="icon-chevron-down"></i>
            </a>
          </p>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if type == 'both' and show_stock %}
      <div class="alibaba-card__stock-list">
        {%- render 'product-deliverytime',
          product: product,
          current_variant: current_variant,
          container: 'p',
          extra_class: 'list-only',
          origin: 'productitem'
        -%}
      </div>
    {%- endif -%}

    {% render 'badge--discount-products', product: product %}
    {%- if upsell == false and show_price -%}
      <div class="alibaba-card__price-wrapper">
        <p class="price s1pr alibaba-card__price-main">
          {%- if product.price_varies and settings.show_price_varies and layout != 'list-compact' -%}
            {%- liquid
              assign price_min = product.price_min | money
              assign price_max = product.price_max | money
            -%}
            {{ price_min -}}
            <span class="price-varies">&nbsp;- {{ price_max }}</span>
          {%- else -%}
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="old-price">{{ current_variant.compare_at_price | money }}</span><span class="alibaba-card__price-gap">&nbsp;</span>
            {%- endif -%}
            {{ price }}
            {%- if discount_percent > 0 -%}
              <span class="alibaba-card__discount-badge">-{{ discount_percent }}%</span>
            {%- endif -%}
          {%- endif -%}
          {%- if current_variant.unit_price_measurement -%}
            <span class="small">
              {{- 'product.unit_price_label' | t -}}
              {{- current_variant.unit_price | unit_price_with_measurement: current_variant.unit_price_measurement -}}
            </span>
          {%- endif -%}
        </p>
        {%- if moq > 0 -%}
          <p class="alibaba-card__moq">
            <span class="alibaba-card__moq-desktop">
              MOQ: +{{ moq }}
              {{ 't.moq.unit' | t | default: 'articoli' }}
            </span>
            <span class="alibaba-card__moq-mobile" hidden>+{{ moq }} venduti</span>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if enable_color_picker -%}
      {%- liquid
        assign triggers = settings.color_swatch_name | newline_to_br | strip_newlines | replace: '<br />', '|' | split: '|'
        if settings.enable_color_swatches
          for option in product.options_with_values
            if triggers contains option.name
              assign color_option = option
              break
            endif
          endfor
        endif
      -%}
      {% if color_option %}
        <ul class="check color alibaba-card__colors" data-limit="6">
          {% for color in color_option.values %}
            {%- liquid
              for variant in product.variants
                assign options = variant.options | map: 'name'
                if options contains color
                  assign color_variant = variant
                  break
                endif
              endfor
            -%}
            {% capture swatch %}
                {% if color_variant and color_variant.featured_media and settings.color_swatches_variant_image %}
                  <img src="{{ color_variant.featured_media | image_url: width: image_width_small, height: image_height_small, crop: 'center' }}" alt="{{ color }}" width="30" height="23" loading="lazy" class="color-variant-img filled">
                {% elsif color.swatch.image %}
                  <i aria-hidden="true" class="icon-circle" style="background-image: url('{{ color.swatch.image | image_url }}');"></i>
                {% elsif color.swatch.color %}
                  <i aria-hidden="true" class="icon-circle" style="background-color: {{ color.swatch.color }};"></i>
                {% else %}
                  <i aria-hidden="true"
                     class="icon-circle swatch-custom-color-{{ color | handleize }}"
                     style="background-color:{{ color | split: ' ' | last }}"
                  ></i>
                {% endif %}
              {% endcapture %}
            <li
              {% if color_variant and color_variant.featured_media %}
                data-img="
                  {%- if settings.fill_product_images -%}
                    {{ color_variant.featured_media | image_url: width: image_width_2, height: image_height_2, crop: 'center' }}
                  {%- else -%}
                    {{ color_variant.featured_media | image_url: width: image_width_2 }}
                  {%- endif -%}
                "
              {% endif %}
            >
              <input
                type="radio"
                id="color-{{ product.id }}-{{ color_variant.id }}-{{ forloop.index }}"
                name="color-{{ product.id }}-{{ color_variant.id }}-{{ forloop.index }}"
              >
              <label for="color-{{ product.id }}-{{ color_variant.id }}-{{ forloop.index }}">
                <a
                  href="{% if color_variant %}{{ color_variant.url }}{% else %}{{ product.url }}{% endif %}"
                  aria-label="{{ color }}"
                >
                  {{ swatch }}
                </a>
              </label>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    {% endif %}
  </div>

  {%- if quick_buy -%}
    <div class="alibaba-card__footer{% if layout != 'list-compact' and enable_quick_buy_mobile %} mobile-hide{% endif %}">
      {% if layout == 'list-compact' %}<footer>{% endif %}
      {{ quick_buy | replace: '-quick-add-form_x', '2' }}
      {% if layout == 'list-compact' %}</footer>{% endif %}
    </div>
  {%- endif -%}

  {% if extra_style contains '--vertical' %}</div>{% endif %}
</{{ container }}>

{%- comment -%} BESTSELLER POPUP MODAL {%- endcomment -%}
{%- if product != blank and bestseller_count > 0 -%}
  <div class="alibaba-bestseller-popup" id="bestseller-popup-{{ product.id }}" aria-hidden="true">
    <div class="alibaba-bestseller-popup__overlay" data-popup-close></div>
    <div class="alibaba-bestseller-popup__content">
      <button class="alibaba-bestseller-popup__close" data-popup-close aria-label="{{ view_more_text }}">
        <i class="icon-close"></i>
      </button>

      <div class="alibaba-bestseller-popup__header">
        <div class="alibaba-bestseller-popup__icon">🏆</div>
        <h4 class="alibaba-bestseller-popup__title">{{ analytics_title }}</h4>
        <p class="alibaba-bestseller-popup__subtitle">{{ title | truncate: 40 }}</p>
      </div>

      <div class="alibaba-bestseller-popup__body">
        <div class="alibaba-bestseller-popup__current">
          <span class="alibaba-bestseller-popup__label">{{ this_month_text }}</span>
          <span class="alibaba-bestseller-popup__value alibaba-bestseller-popup__value--current">
            {{- current_month_sales -}}
          </span>
          <span class="alibaba-bestseller-popup__unit">{{ items_sold_text }}</span>
        </div>

        <div class="alibaba-bestseller-popup__history">
          <div class="alibaba-bestseller-popup__bar">
            <div class="alibaba-bestseller-popup__bar-fill" style="--bar-height: 100%;"></div>
            <span class="alibaba-bestseller-popup__bar-label">{{ current_month_text }}</span>
            <span class="alibaba-bestseller-popup__bar-value">{{ current_month_sales }}</span>
          </div>
          <div class="alibaba-bestseller-popup__bar">
            <div
              class="alibaba-bestseller-popup__bar-fill"
              style="--bar-height: {% if current_month_sales > 0 %}{{ month_1_sales | times: 100 | divided_by: current_month_sales }}%{% else %}0%{% endif %};"
            ></div>
            <span class="alibaba-bestseller-popup__bar-label">{{ month_1_text }}</span>
            <span class="alibaba-bestseller-popup__bar-value">{{ month_1_sales }}</span>
          </div>
          <div class="alibaba-bestseller-popup__bar">
            <div
              class="alibaba-bestseller-popup__bar-fill"
              style="--bar-height: {% if current_month_sales > 0 %}{{ month_2_sales | times: 100 | divided_by: current_month_sales }}%{% else %}0%{% endif %};"
            ></div>
            <span class="alibaba-bestseller-popup__bar-label">{{ month_2_text }}</span>
            <span class="alibaba-bestseller-popup__bar-value">{{ month_2_sales }}</span>
          </div>
          <div class="alibaba-bestseller-popup__bar">
            <div
              class="alibaba-bestseller-popup__bar-fill"
              style="--bar-height: {% if current_month_sales > 0 %}{{ month_3_sales | times: 100 | divided_by: current_month_sales }}%{% else %}0%{% endif %};"
            ></div>
            <span class="alibaba-bestseller-popup__bar-label">{{ month_3_text }}</span>
            <span class="alibaba-bestseller-popup__bar-value">{{ month_3_sales }}</span>
          </div>
        </div>
      </div>

      <div class="alibaba-bestseller-popup__footer">
        <p class="alibaba-bestseller-popup__note">{{ data_note_text }}</p>
      </div>
    </div>
  </div>
{%- endif -%}

