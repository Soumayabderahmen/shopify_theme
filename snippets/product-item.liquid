    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
    height: 210px;
    padding: 15px 5px 0;
    border-bottom: 1px solid #ddd;
  }

  .alibaba-bestseller-popup__bar {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    flex: 1 1 0;
    height: 100%;
    min-width: 0;
  }

  .alibaba-bestseller-popup__bar-fill {
    width: min(42px, 70%);
    height: var(--bar-height, 0%);
    min-height: 3px;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(
      to top,
      var(--apc-accent),
      #ff9d52
    );
    transition: height 0.5s ease;
  }

  .alibaba-bestseller-popup__bar-label {
    position: absolute;
    bottom: -28px;
    left: 50%;
    width: 100%;
    transform: translateX(-50%);
    color: var(--apc-text-secondary);
    font-size: 9px;
    font-weight: 600;
    text-align: center;
    white-space: nowrap;
  }

  .alibaba-bestseller-popup__bar-value {
    position: absolute;
    bottom: calc(var(--bar-height, 0%) + 6px);
    left: 50%;
    transform: translateX(-50%);
    color: var(--apc-text);
    font-size: 10px;
    font-weight: 800;
  }

  .alibaba-bestseller-popup__footer {
    padding: 25px 20px 20px;
  }

  .alibaba-bestseller-popup__note {
    margin: 0;
    color: #999;
    font-size: 10px;
    line-height: 1.5;
    text-align: center;
  }

  /* Scrollbar popup */
  .alibaba-bestseller-popup__content::-webkit-scrollbar {
    width: 5px;
  }

  .alibaba-bestseller-popup__content::-webkit-scrollbar-track {
    background: transparent;
  }

  .alibaba-bestseller-popup__content::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 10px;
  }

  /* =========================================================
     CARD ANIMATIONS
     ========================================================= */

  .alibaba-product-card.anim-slide-left,
  .alibaba-product-card.anim-slide-right,
  .alibaba-product-card.anim-scale-in,
  .alibaba-product-card.anim-flip-x,
  .alibaba-product-card.anim-bounce-in {
    animation-duration: 0.55s;
    animation-timing-function: ease-out;
    animation-fill-mode: both;
    animation-delay: var(--anim-delay, 0s);
  }

  .anim-slide-left {
    animation-name: alibabaSlideLeft;
  }

  .anim-slide-right {
    animation-name: alibabaSlideRight;
  }

  .anim-scale-in {
    animation-name: alibabaScaleIn;
  }

  .anim-flip-x {
    animation-name: alibabaFlipX;
  }

  .anim-bounce-in {
    animation-name: alibabaBounceIn;
  }

  @keyframes alibabaSlideLeft {
    from {
      opacity: 0;
      transform: translateX(-18px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes alibabaSlideRight {
    from {
      opacity: 0;
      transform: translateX(18px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes alibabaScaleIn {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes alibabaFlipX {
    from {
      opacity: 0;
      transform: perspective(500px) rotateX(-8deg);
    }
    to {
      opacity: 1;
      transform: perspective(500px) rotateX(0);
    }
  }

  @keyframes alibabaBounceIn {
    0% {
      opacity: 0;
      transform: scale(0.94);
    }

    60% {
      opacity: 1;
      transform: scale(1.02);
    }

    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* =========================================================
     LIST LAYOUT
     ========================================================= */

  .alibaba-product-card.list,
  .alibaba-product-card.list-compact {
    border-radius: 6px;
  }

  .alibaba-product-card.list .alibaba-card__media,
  .alibaba-product-card.list-compact .alibaba-card__media {
    aspect-ratio: 1 / 1;
  }

  .alibaba-product-card.list .alibaba-card__body,
  .alibaba-product-card.list-compact .alibaba-card__body {
    padding: 10px 12px;
  }

  .alibaba-product-card.list .alibaba-card__footer,
  .alibaba-product-card.list-compact .alibaba-card__footer {
    padding: 0 12px 12px;
  }

  /* =========================================================
     HOTSPOT
     ========================================================= */

  .alibaba-product-card.hotspot {
    border-radius: 6px;
  }

  .alibaba-product-card.hotspot .alibaba-card__body {
    padding: 10px;
  }

  .alibaba-product-card.hotspot .alibaba-card__title {
    font-size: 13px;
  }

  /* =========================================================
     ACCESSIBILITY
     ========================================================= */

  .alibaba-product-card a:focus-visible,
  .alibaba-product-card button:focus-visible,
  .alibaba-product-card input:focus-visible,
  .alibaba-product-card select:focus-visible {
    outline: 2px solid var(--apc-accent);
    outline-offset: 2px;
  }

  .alibaba-bestseller-popup button:focus-visible {
    outline: 2px solid var(--apc-accent);
    outline-offset: 2px;
  }

  /* Prevent body scroll when popup is open if theme JS adds this class */
  body.alibaba-popup-open {
    overflow: hidden;
  }

  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .alibaba-product-card,
    .alibaba-card__picture img,
    .alibaba-card__picture--secondary,
    .alibaba-badge,
    .alibaba-card__rotator-track,
    .alibaba-bestseller-popup,
    .alibaba-bestseller-popup__content,
    .alibaba-bestseller-popup__bar-fill {
      animation: none !important;
      transition: none !important;
    }

    .alibaba-product-card:hover {
      transform: none;
    }
  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {
    .alibaba-product-card {
      border-radius: 6px;
    }

    .alibaba-product-card:hover {
      transform: none;
      box-shadow: none;
    }

    .alibaba-card__body {
      padding: 10px;
