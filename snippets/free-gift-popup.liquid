{%- comment -%}
  Popup « 3 regali gratis » (prototype) — assets/free-gift.js + assets/free-gift.css.
  - S'ouvre toute seule 7 s après l'arrivée sur chaque page ; fermée, elle se range dans la bulle.
  - Liste les produits de la collection choisie dans Personnalizza tema > Impostazioni tema > « Regali gratis (popup) »
    (pour l'instant : n'importe quelle collection ; à remplacer par la collection des produits à 0 €).
  - Le client choisit au plus 3 produits (les autres se grisent) ; l'ajout au panier n'est permis qu'à partir de 50 €
    d'achats. Les regali portent la propriété cachée _gift ; si le panier redescend sous 50 €, ils sont retirés.
  - Fermée : elle se range en bulle ronde sur le côté de la page (comme une story Instagram) qui la rouvre.
{%- endcomment -%}
{%- liquid
  assign fg_handle = 'all'
  if settings.free_gift_collection != blank
    assign fg_handle = settings.free_gift_collection.handle
  endif
  assign fg_threshold = settings.free_gift_threshold | default: 50
  assign fg_delay = settings.free_gift_delay | default: 7
  assign fg_max = settings.free_gift_max | default: 3
  assign fg_lang = request.locale.iso_code | slice: 0, 2
-%}
{%- unless settings.free_gift_enabled == false or template.name == 'cart' or template.name == 'password' or template.name == 'gift_card' -%}
  {{ 'free-gift.css' | asset_url | stylesheet_tag }}
  <script type="application/json" id="free-gift-config">
    {
      "url": {{ routes.root_url | append: '/collections/' | replace: '//collections', '/collections' | append: fg_handle | append: '/products.json?limit=24' | json }},
      "root": {{ routes.root_url | append: '/' | replace: '//', '/' | json }},
      "threshold": {{ fg_threshold | times: 100 }},
      "delay": {{ fg_delay | times: 1000 }},
      "max": {{ fg_max }},
      "currency": {{ cart.currency.iso_code | json }},
      "locale": {{ request.locale.iso_code | json }},
      "t": {%- case fg_lang -%}
        {%- when 'fr' -%}
          {"title":"<em>{{ fg_max }} cadeaux</em> choisis par toi","sub":"Offerts dès {{ fg_threshold }} € d'achat.","value":"Valeur jusqu'à %s.","free":"GRATUIT","missing":"Encore <b>%s</b> pour débloquer tes cadeaux","unlocked":"Cadeaux débloqués. Ajoute-les à ton panier.","locked":"Débloqué à {{ fg_threshold }} € d'achat","choose":"Choisis jusqu'à {{ fg_max }} cadeaux","add":"Ajouter mes cadeaux au panier","done":"Cadeaux ajoutés au panier ✓","added":"%n cadeaux ajoutés au panier","removed":"Panier sous {{ fg_threshold }} € : cadeaux retirés du panier","full":"Tu as choisi {{ fg_max }} cadeaux. Pour en changer un, touche-le à nouveau ou retire-le du plateau en haut.","already":"Cadeaux déjà dans le panier","later":"Continuer mes achats","all":"Tous","bubble":"Cadeaux","tip":"Tes cadeaux t'attendent ici","slot":"Place libre","remove":"Retirer","close":"Fermer et garder les cadeaux sur le côté","error":"Ajout impossible, réessaie"}
        {%- when 'en' -%}
          {"title":"<em>{{ fg_max }} gifts</em> picked by you","sub":"Free with orders over €{{ fg_threshold }}.","value":"Worth up to %s.","free":"FREE","missing":"<b>%s</b> more to unlock your gifts","unlocked":"Gifts unlocked. Add them to your cart.","locked":"Unlocks at €{{ fg_threshold }}","choose":"Pick up to {{ fg_max }} gifts","add":"Add my gifts to cart","done":"Gifts added to your cart ✓","added":"%n gifts added to your cart","removed":"Cart under €{{ fg_threshold }}: gifts removed","full":"You picked {{ fg_max }} gifts. To swap one, tap it again or remove it from the tray above.","already":"Gifts already in your cart","later":"Keep shopping","all":"All","bubble":"Gifts","tip":"Your gifts are waiting here","slot":"Empty slot","remove":"Remove","close":"Close and keep gifts at the side","error":"Could not add, please retry"}
        {%- else -%}
          {"title":"<em>{{ fg_max }} regali</em> scelti da te","sub":"Gratis con un ordine da {{ fg_threshold }} €.","value":"Valore fino a %s.","free":"GRATIS","missing":"Ti mancano <b>%s</b> per sbloccare i regali","unlocked":"Regali sbloccati. Aggiungili al carrello.","locked":"Si sblocca a {{ fg_threshold }} € di spesa","choose":"Scegli fino a {{ fg_max }} regali","add":"Aggiungi i regali al carrello","done":"Regali aggiunti al carrello ✓","added":"%n regali aggiunti al carrello","removed":"Carrello sotto {{ fg_threshold }} €: regali tolti dal carrello","full":"Hai scelto {{ fg_max }} regali. Per cambiarne uno, toccalo di nuovo o toglilo dal vassoio in alto.","already":"Regali già nel carrello","later":"Continua lo shopping","all":"Tutti","bubble":"Regali","tip":"I tuoi regali ti aspettano qui","slot":"Posto libero","remove":"Togli","close":"Chiudi e tieni i regali a lato","error":"Impossibile aggiungere, riprova"}
      {%- endcase -%}
    }
  </script>
  <script src="{{ 'free-gift.js' | asset_url }}" defer></script>
{%- endunless -%}
