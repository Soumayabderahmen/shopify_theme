      </div>
    </div>
  </div>

  <style>
    .sc-wrapper *, .sc-wrapper *::before, .sc-wrapper *::after { box-sizing: border-box; }
    .sc-wrapper {
      --sc-accent: #111;
      --sc-bg: #fff;
      --sc-border: #e2e2e2;
      --sc-radius: 12px;
      --sc-shadow: 0 10px 30px rgba(0,0,0,0.12);
      --sc-transition: cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      display: inline-block;
      margin: 10px 0;
    }
    .sc-trigger {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      background: #f8f8f8 !important;
      border: 1px solid var(--sc-border) !important;
      border-radius: var(--sc-radius);
      box-shadow: none !important;
      font-size: 13.5px;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--sc-accent);
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
      -webkit-tap-highlight-color: transparent;
    }
    .sc-trigger:hover, .sc-trigger:focus-visible {
      background: #f0f0f0 !important;
      border-color: #cccccc !important;
      outline: none;
    }
    .sc-trigger__ruler {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
      color: currentColor;
    }
    .sc-trigger__chevron {
      transition: transform 0.25s var(--sc-transition);
    }
    .sc-trigger[aria-expanded="true"] .sc-trigger__chevron {
      transform: rotate(180deg);
    }

    /* DROPDOWN DESKTOP */
    .sc-dropdown {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      z-index: 99999;
      width: 440px;
      max-width: 90vw;
      background: var(--sc-bg);
      border: 1px solid var(--sc-border);
      border-radius: var(--sc-radius);
      box-shadow: var(--sc-shadow);
      overflow: hidden;
    }
    .sc-dropdown.is-open {
      display: block;
      animation: scFadeIn 0.2s var(--sc-transition);
    }
    @keyframes scFadeIn {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .sc-dropdown__inner {
      display: flex;
      flex-direction: column;
      max-height: 420px;
    }
    .sc-dropdown__topbar, .sc-drawer__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      border-bottom: 1px solid var(--sc-border);
      background: #fff;
    }
    .sc-dropdown__title, .sc-drawer__title {
      font-size: 15px;
      font-weight: 700;
      color: var(--sc-accent);
    }

    /* CONTENUTO TABELLA */
    .sc-content {
      font-size: 13px;
      color: #333;
      line-height: 1.5;
      width: 100%;
      overflow-x: auto;
    }
    .sc-dropdown__inner .sc-content {
      overflow-y: auto;
      padding: 16px;
    }
    .sc-content table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      margin: 0;
    }
    .sc-content th, .sc-content td {
      border: 1px solid #e0e0e0;
      padding: 8px 10px;
      text-align: center;
      white-space: nowrap;
    }
    .sc-content th {
      background: #f5f5f5;
      font-weight: 600;
      color: #111;
    }
    .sc-content tr:nth-child(even) td {
      background: #fafafa;
    }

    /* OVERLAY & DRAWER MOBILE (Teleportati su BODY) */
    body > .sc-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 2147483646 !important;
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
      opacity: 0;
      transition: opacity 0.3s ease;
      -webkit-tap-highlight-color: transparent;
    }
    body > .sc-overlay.is-open {
      display: block;
      opacity: 1;
    }
    body > .sc-drawer {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 2147483647 !important;
      background: var(--sc-bg);
      border-radius: 20px 20px 0 0;
      box-shadow: 0 -10px 40px rgba(0,0,0,0.3);
      transform: translateY(100%);
      transition: transform 0.35s var(--sc-transition);
      max-height: 80vh;
      overflow: hidden;
      flex-direction: column;
      -webkit-tap-highlight-color: transparent;
    }
    body > .sc-drawer.is-visible {
      display: flex;
    }
    body > .sc-drawer.is-open {
      transform: translateY(0);
    }
    .sc-drawer__handle {
      width: 40px;
      height: 4px;
      background: #d0d0d0;
      border-radius: 2px;
      margin: 10px auto 2px;
    }
    .sc-drawer__body {
      overflow-y: auto;
      padding: 16px;
      padding-bottom: 40px;
      -webkit-overflow-scrolling: touch;
    }

    /* BOTTONE CHIUDI */
    .sc-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      background: #f1f1f1;
      border: 0;
      border-radius: 50%;
      cursor: pointer;
      color: #333;
      font-size: 20px;
      line-height: 1;
      transition: background 0.2s, color 0.2s;
      -webkit-tap-highlight-color: transparent;
    }
    .sc-close:hover, .sc-close:focus-visible {
      background: var(--sc-accent);
      color: #fff;
      outline: none;
    }

    @media(max-width: 749px) {
      .sc-dropdown { display: none !important; }
    }
    @media(min-width: 750px) {
      body > .sc-drawer, body > .sc-overlay { display: none !important; }
    }
  </style>

  <script>
    (function() {
      'use strict';
      const MOBILE_BP = 750;
      const trigger = document.getElementById('scTrigger');
      const panel = document.getElementById('scPanel');
      const closeBtn = document.getElementById('scClose');
      const overlay = document.getElementById('scOverlay');
      const drawer = document.getElementById('scDrawer');
      const drawerClose = document.getElementById('scDrawerClose');

      if (!trigger || !overlay || !drawer) return;

      // Sposta Overlay e Drawer direttamente sotto <body> per evitare problemi di Z-Index/ stacking context
      document.body.appendChild(overlay);
      document.body.appendChild(drawer);

      function isMobile() {
        return window.innerWidth < MOBILE_BP;
      }

      function lockBody() {
        document.body.style.overflow = 'hidden';
      }

      function unlockBody() {
        document.body.style.overflow = '';
      }

      function isOpen() {
        return isMobile() ? drawer.classList.contains('is-open') : panel.classList.contains('is-open');
      }

      function openPanel() {
        if (isMobile()) {
          overlay.classList.add('is-open');
          overlay.setAttribute('aria-hidden', 'false');
          drawer.classList.add('is-visible');
          drawer.setAttribute('aria-hidden', 'false');
          trigger.setAttribute('aria-expanded', 'true');
          lockBody();
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              drawer.classList.add('is-open');
            });
          });
        } else {
          panel.classList.add('is-open');
          panel.setAttribute('aria-hidden', 'false');
          trigger.setAttribute('aria-expanded', 'true');
        }
      }

      function closePanel() {
        if (isMobile()) {
          drawer.classList.remove('is-open');
          overlay.classList.remove('is-open');
          overlay.setAttribute('aria-hidden', 'true');
          drawer.setAttribute('aria-hidden', 'true');
          trigger.setAttribute('aria-expanded', 'false');
          unlockBody();
          setTimeout(() => {
            drawer.classList.remove('is-visible');
          }, 350);
        } else {
          panel.classList.remove('is-open');
          panel.setAttribute('aria-hidden', 'true');
          trigger.setAttribute('aria-expanded', 'false');
        }
      }

      trigger.addEventListener('click', function(e) {
        e.stopPropagation();
        isOpen() ? closePanel() : openPanel();
      });

      if (closeBtn) closeBtn.addEventListener('click', closePanel);
      if (drawerClose) drawerClose.addEventListener('click', closePanel);
      if (overlay) overlay.addEventListener('click', closePanel);

      document.addEventListener('click', function(e) {
        if (!isMobile() && panel.classList.contains('is-open') && !panel.contains(e.target) && e.target !== trigger && !trigger.contains(e.target)) {
          closePanel();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && isOpen()) {
          closePanel();
        }
      });
    })();
  </script>
