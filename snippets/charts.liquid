      <div class="sc-drawer__header">
        <span class="sc-drawer__title">{{ sc_drawer_title }}</span>
        <button class="sc-close sc-drawer__close" id="scDrawerClose" aria-label="{{ sc_close_label }}" type="button">×</button>
      </div>
      <div class="sc-drawer__body">
