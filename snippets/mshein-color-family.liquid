{%- comment -%}
  Couleur claire d'une valeur de filtre « Color » de la boutique (black, Black thick, black1 → black ; army green → green…),
  pour la fenêtre Filtri mobile (snippets/mshein-results.liquid). Écrit la clé (black, white… voir mobile.collection.colors)
  ou « - » quand le nom n'a pas de couleur reconnaissable (« 1 », « 2 »…). Premier groupe trouvé dans cet ordre.
  Params : label
{%- endcomment -%}
{%- liquid
  assign color_label = label | downcase
  # Nuances que le client reconnaît (Bordeaux, Blu navy, Azzurro, Verde militare, Kaki, Cammello) avant leur couleur
  # de base : « wine red » → Bordeaux et non Rosso, « light blue » → Azzurro et non Blu…
  assign color_rules = 'multicolor:multicolor,multi-color,multi color,multi,colorful,rainbow|burgundy:burgundy,bordeaux,bordò,wine,marsala|navy:navy,blu navy,dark blue,blu scuro,marine|lightblue:light blue,sky blue,azzurro,baby blue,celeste,bleu ciel|olive:army,olive,militare,khaki green|khaki:khaki,kaki,cachi|camel:camel,cammello|black:black,nero,noir,schwarz,negro,zwart,negru|white:white,bianco,blanc,weiss,weiß,blanco,ivory|gold:gold,dorato,golden,oro|silver:silver,argento,argent|gray:gray,grey,grigio,gris,grau,grijs,charcoal|red:red,rosso,rouge,rojo,ruby|pink:pink,rosa,rose,fuchsia,magenta,roze,blush|orange:orange,arancio,naranja,coral,rust,sherbet,tangerine,fox|yellow:yellow,giallo,jaune,gelb,amarillo,mustard|green:green,verde,vert,grün,mint,sage|blue:blue,blu,bleu,azul,blau,denim,cyan,turquoise,teal,cerulean|purple:purple,viola,violet,lila,lilac,lavender,mauve|brown:brown,marrone,marron,braun,coffee,chocolate,caramel,mocha,taupe|beige:beige,apricot,cream,nude,champagne,sand,tan' | split: '|'
  assign family = '-'
  for rule in color_rules
    assign rule_parts = rule | split: ':'
    assign rule_words = rule_parts[1] | split: ','
    for word in rule_words
      if color_label contains word
        assign family = rule_parts[0]
        break
      endif
    endfor
    if family != '-'
      break
    endif
  endfor
  echo family
-%}
