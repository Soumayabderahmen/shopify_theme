<section class="wishlist-page" data-wishlist-page>
  <header class="wishlist-page__heading">
    <div>
      <h1>{{ page.title | default: 'La mia Wishlist' | escape }}</h1>
      <p data-wishlist-count>0 articoli salvati</p>
    </div>
    <button type="button" data-wishlist-share hidden>
      <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path></svg>
      <span>Condividi</span>
    </button>
  </header>

  {%- unless customer -%}
    <aside class="wishlist-page__guest">
      <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg>
      <p><b>Salva la tua wishlist</b>Accedi per ritrovarla su tutti i dispositivi</p>
      <a href="{{ routes.account_login_url }}">Accedi</a>
    </aside>
  {%- endunless -%}

  <button class="wishlist-page__price-drop" type="button" data-wishlist-price-drop hidden>
    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 7l6 6 4-4 8 8"></path><path d="M15 17h6v-6"></path></svg>
    <span data-wishlist-price-drop-text></span><b aria-hidden="true">›</b>
  </button>

  <div class="wishlist-page__filters" role="group" aria-label="Filtra la wishlist" data-wishlist-filters hidden></div>
  <div class="wishlist-page__tools" data-wishlist-tools hidden>
    <label>Ordina:
      <select data-wishlist-sort>
        <option value="recent">Aggiunti di recente</option>
        <option value="asc">Prezzo crescente</option>
        <option value="desc">Prezzo decrescente</option>
      </select>
    </label>
    <button type="button" class="wishlist-page__edit" data-wishlist-edit>Modifica</button>
  </div>

  <div class="wishlist-page__editbar" data-wishlist-editbar hidden>
    <label><input type="checkbox" data-wishlist-select-all> <span>Seleziona tutto</span></label>
    <button type="button" data-wishlist-remove-selected disabled>Rimuovi (0)</button>
  </div>

  <section class="wishlist-page__empty" data-wishlist-empty hidden>
    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"></path></svg>
    <h2>La tua wishlist è vuota</h2>
    <p>Tocca il cuore sui prodotti che ti piacciono per ritrovarli qui.</p>
    <a href="{{ routes.all_products_collection_url }}">Scopri i più venduti</a>
  </section>

  <div id="section_featured_collection-wishlist">
    <ul class="wishlist-page__list" data-wishlist-list></ul>
  </div>
  <p class="wishlist-page__error" data-wishlist-error role="status" hidden>Non è stato possibile caricare tutti i prodotti salvati. Riprova tra poco.</p>

  {%- assign wishlist_recommendations = collections.all.products -%}
  {%- if wishlist_recommendations != blank -%}
    <section class="wishlist-page__recommendations" data-wishlist-recommendations>
      <h2>Potrebbe piacerti anche</h2>
      <ul>
        {%- for recommendation in wishlist_recommendations limit: 16 -%}
          {%- assign recommendation_variant = recommendation.selected_or_first_available_variant -%}
          <li class="alibaba-product-card wishlist-recommendation-card">
            <figure class="alibaba-card__media">
              <a class="alibaba-card__media-link" href="{{ recommendation.url }}">
                <picture class="alibaba-card__picture">
                  {%- if recommendation.featured_image -%}
                    {{ recommendation.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180,270,360', sizes: '40vw', alt: recommendation.featured_image.alt | default: recommendation.title }}
                  {%- endif -%}
                </picture>
              </a>
              <button
                type="button"
                class="wishlist-productcard alibaba-card__wishlist"
                data-product-id="{{ recommendation.id }}"
                data-variant-id="{{ recommendation_variant.id }}"
                data-variant-title="{{ recommendation_variant.title | escape }}"
                data-price-cents="{{ recommendation_variant.price }}"
                data-compare-at-price-cents="{{ recommendation_variant.compare_at_price }}"
                aria-label="Wishlist"
              >
                <svg class="alibaba-card__wishlist-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"></path></svg>
              </button>
            </figure>
            <div class="alibaba-card__body">
              <h3 class="alibaba-card__title"><a href="{{ recommendation.url }}">{{ recommendation.title | escape }}</a></h3>
              <p class="alibaba-card__price-main">{{ recommendation_variant.price | money }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}

  <div class="wishlist-page__summary" data-wishlist-summary hidden>
    <p>Totale <b data-wishlist-total>€0,00</b></p>
    <button type="button" data-wishlist-add-all>Aggiungi tutto al carrello</button>
  </div>
</section>

<style>
