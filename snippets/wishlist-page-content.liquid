  [data-wishlist-page] .wishlist-page__guest p{display:grid;flex:1;gap:2px;margin:0;color:#656780;font-size:12px}
  [data-wishlist-page] .wishlist-page__guest b{color:#16123f}
  [data-wishlist-page] .wishlist-page__filters{display:flex;gap:8px;margin-bottom:10px;overflow-x:auto}
  [data-wishlist-page] .wishlist-page__filters button{flex:none;padding:8px 12px;border:1px solid #e4e6ee;border-radius:999px;background:#fff;color:#4e526b;font-weight:700}
  [data-wishlist-page] .wishlist-page__filters button[aria-pressed=true]{border-color:#3a34d2;background:#3a34d2;color:#fff}
  [data-wishlist-page] .wishlist-page__tools{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
  [data-wishlist-page] .wishlist-page__tools label{display:flex;align-items:center;gap:6px}
  [data-wishlist-page] .wishlist-page__tools select{border:0;background:transparent}
  [data-wishlist-page] .wishlist-page__list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;padding:0;list-style:none}
  [data-wishlist-page] .wishlist-page__empty{margin:24px 0;padding:28px 18px;border:1px solid #e4e6ee;border-radius:14px;background:#fff;text-align:center}
  [data-wishlist-page] .wishlist-page__empty>svg{width:56px;height:56px;margin:0 auto 12px;color:#3a34d2;fill:none;stroke:currentColor;stroke-width:1.5}
  [data-wishlist-page] .wishlist-page__empty h2{margin:12px 0 5px}
  [data-wishlist-page] .wishlist-page__empty p{color:#71758c}
  [data-wishlist-page] .wishlist-page__empty a{display:inline-block;padding:10px 15px;border-radius:8px;background:#3a34d2;color:#fff;text-decoration:none}
  [data-wishlist-page] .wishlist-page__error{color:#b3261e}
  [data-wishlist-page] [hidden]{display:none!important}
  [data-wishlist-page] .wishlist-page__side,[data-wishlist-page] .wishlist-page__main{display:contents}
  /* Cartes des pages collection (assets/mshein-card.css) : grille, étiquette de statut et infos de la wishlist */
  [data-wishlist-page] .wishlist-page__list>.mshein-card,[data-wishlist-page] .wishlist-page__recommendations>ul>.mshein-card{position:relative;min-width:0;margin:0}
  [data-wishlist-page] .mshein-card .mshein-card__link img{--height:100%}
  [data-wishlist-page] .mshein-card .wishlist-page-card__tag{position:absolute;z-index:3;bottom:8px;left:8px}
  [data-wishlist-page] .mshein-card .wishlist-page-card__variant{margin:2px 0 0;padding:0 8px;overflow:hidden;color:#4a4f6b;font-size:11.5px;line-height:1.3;white-space:nowrap;text-overflow:ellipsis}
  [data-wishlist-page] .mshein-card .wishlist-page-card__was{margin:2px 0 0;padding:0 8px;color:#1f8a4c;font-size:11px;font-weight:700}
  [data-wishlist-page] .mshein-card.is-sold-out .mshein-card__link img{filter:grayscale(1);opacity:.55}
  [data-wishlist-page] .wishlist-page__recommendations>ul>.mshein-card[hidden]{display:none!important}
  [data-wishlist-page] .wishlist-page__side-title{display:none}

  @media only screen and (max-width:760px){
    html.wishlist-page-active #root #nav-top,
    html.wishlist-page-active #root .shopify-section-breadcrumbs{display:none!important}
    html.wishlist-page-active #content{padding-top:0!important;margin-top:0!important}
    html.wishlist-page-active #content>.shopify-section:first-child{margin-top:0!important;padding-top:0!important}
  }

  /* Design de la page (prototype mobile), aussi sur ordinateur ; mise en page ordinateur juste après. */
  @media all{
    [data-wishlist-page]{--wl-ink:#16123f;--wl-muted:#4a4f6b;--wl-blue:#16123f;box-sizing:border-box;width:100%;max-width:none;margin:0 0 88px;padding:18px 12px 28px;background:#f4f5f9;color:var(--wl-ink);font-family:'Figtree',system-ui,sans-serif}
    [data-wishlist-page] .wishlist-page__heading{align-items:flex-end;gap:10px;margin:0;padding:0 2px 12px}
    [data-wishlist-page] .wishlist-page__heading h1{font-family:'Figtree',system-ui,sans-serif;font-size:24px;font-weight:800;line-height:1.1;letter-spacing:-.4px}
    [data-wishlist-page] .wishlist-page__heading p{margin-top:3px;color:var(--wl-muted)}
    [data-wishlist-page] [data-wishlist-share]{display:flex!important;flex:0 0 auto!important;width:auto!important;min-width:0!important;max-width:none!important;height:36px!important;padding:0 14px!important;border:1.5px solid var(--wl-ink)!important;border-radius:999px!important;background:transparent!important;color:var(--wl-ink)!important;font-size:13px!important;line-height:1!important}
    [data-wishlist-page] .wishlist-page__guest{gap:12px;margin:0 0 14px;padding:12px 14px;border:0;border-radius:14px;background:radial-gradient(130% 160% at 0 0,#2f2a5c 0%,#16123f 62%);color:#fff}
    [data-wishlist-page] .wishlist-page__guest p{gap:0;color:#fff;font-size:12.5px;line-height:1.35}
    [data-wishlist-page] .wishlist-page__guest b{color:#fff;font-size:14px}
    [data-wishlist-page] .wishlist-page__guest>a{flex:none;padding:8px 14px;border-radius:999px;background:#fff;color:var(--wl-blue);font-size:13px;font-weight:800;text-decoration:none}
    [data-wishlist-page] .wishlist-page__price-drop{display:flex;align-items:center;gap:10px;width:100%;margin-top:10px;padding:10px 12px;border:1px solid #cbe9d6;border-radius:12px;background:#eaf7ef;color:#15603a;font-size:13px;text-align:left}
    [data-wishlist-page] .wishlist-page__price-drop svg{width:20px;height:20px;flex:none;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
    [data-wishlist-page] .wishlist-page__price-drop span{flex:1}
    [data-wishlist-page] .wishlist-page__price-drop b{font-size:18px}
    [data-wishlist-page] .wishlist-page__filters{gap:6px;margin:14px 0 0;padding-bottom:2px;scrollbar-width:none}
    [data-wishlist-page] .wishlist-page__filters::-webkit-scrollbar{display:none}
    [data-wishlist-page] .wishlist-page__filters button{display:block!important;flex:0 0 auto!important;width:auto!important;min-width:0!important;max-width:none!important;height:34px!important;min-height:34px!important;padding:0 13px!important;border:1px solid #e4e6ee!important;border-radius:999px!important;background:#fff!important;color:var(--wl-ink)!important;font-size:13px!important;line-height:32px!important;white-space:nowrap}
    [data-wishlist-page] .wishlist-page__filters button small{margin-left:3px;opacity:.7;font-size:inherit;font-weight:600}
    [data-wishlist-page] .wishlist-page__filters button[aria-pressed=true]{border-color:var(--wl-blue)!important;background:var(--wl-blue)!important;color:#fff!important}
    [data-wishlist-page] .wishlist-page__tools{margin:12px 2px 10px;color:var(--wl-ink);font-size:13px}
    [data-wishlist-page] .wishlist-page__tools select{max-width:190px;padding:0 4px 0 0;color:var(--wl-ink);font:inherit;font-weight:700}
    [data-wishlist-page] .wishlist-page__edit{width:auto!important;min-width:0!important;height:auto!important;padding:0!important;border:0!important;background:none!important;color:var(--wl-blue)!important;font-weight:800!important}
    [data-wishlist-page] .wishlist-page__list{margin:0;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 10px}
    [data-wishlist-page] .wishlist-page__list>.alibaba-product-card{min-width:0!important;margin:0!important;border:0!important;border-radius:12px!important;background:#fff!important;box-shadow:0 1px 3px rgba(20,20,40,.06),0 6px 18px -10px rgba(20,20,40,.18)!important;overflow:hidden!important}
    [data-wishlist-page] .wishlist-page__list .alibaba-product-card .alibaba-card__media{width:100%!important;margin:0!important;aspect-ratio:1/1!important;border-radius:0!important;background:#f4f4f4!important;overflow:hidden!important}
    [data-wishlist-page] .wishlist-page__list .alibaba-product-card .alibaba-card__picture,[data-wishlist-page] .wishlist-page__list .alibaba-product-card .alibaba-card__picture img{width:100%!important;height:100%!important}
    [data-wishlist-page] .wishlist-page__list .alibaba-product-card .alibaba-card__picture img{object-fit:cover!important}
