    [data-wishlist-page] .wishlist-page__list .alibaba-product-card .alibaba-card__wishlist-icon{display:block!important;position:static!important;width:17px!important;height:17px!important;fill:currentColor!important;stroke:currentColor!important;stroke-width:2!important}
    [data-wishlist-page] .wishlist-page__list .alibaba-product-card .alibaba-card__body{min-width:0!important;padding:9px 9px 10px!important;gap:5px!important}
    [data-wishlist-page] .wishlist-page__list .alibaba-product-card .alibaba-card__title,[data-wishlist-page] .wishlist-page__list .alibaba-product-card .alibaba-card__title a{margin:0!important;color:var(--wl-ink)!important;font-size:13.5px!important;font-weight:700!important;line-height:1.3!important}
    [data-wishlist-page] .wishlist-page__list .alibaba-product-card .alibaba-card__price-main{margin:0!important;color:var(--wl-ink)!important;font-size:17px!important;font-weight:800!important}
    [data-wishlist-page] .wishlist-page__list .old-price{color:#8a8a8a!important;font-size:11.5px!important}
    [data-wishlist-page] .wishlist-page__list .alibaba-product-card :is(.alibaba-card__rotator,.alibaba-card__badges-row,.alibaba-card__rating,.alibaba-card__stock,.alibaba-card__stock-list,.alibaba-card__description,.alibaba-card__colors,.alibaba-card__moq){display:none!important}
    [data-wishlist-page] .wishlist-page__empty{margin:12px 0 0;padding:36px 20px;border:0;border-radius:16px}
    [data-wishlist-page] .wishlist-page__empty h2{margin:0;color:var(--wl-ink);font-family:'Sora','Figtree',system-ui,sans-serif;font-size:19px}
    [data-wishlist-page] .wishlist-page__empty p{max-width:30ch;margin:6px auto 16px;color:var(--wl-muted);font-size:13.5px}
    [data-wishlist-page] .wishlist-page__empty a{display:inline-flex;align-items:center;min-height:44px;padding:0 22px;border-radius:999px;background:var(--wl-blue);font-weight:800}
    [data-wishlist-page] .wishlist-page__error{margin:12px 0 0;font-size:13px}
    [data-wishlist-page] .wishlist-page__summary{position:fixed;z-index:45;right:0;bottom:calc(64px + env(safe-area-inset-bottom,0px));left:0;display:flex;align-items:center;gap:12px;width:100%;padding:10px 12px;border-top:1px solid #e4e6ee;background:#fff;box-shadow:0 -8px 20px -14px rgba(22,18,63,.4)}
