<section class="wishlist-page" data-wishlist-page>
  <header class="wishlist-page__heading">
    <div>
      <nav class="wl-bc" aria-label="{{ 'mobile.cart.breadcrumb' | t | escape }}"><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a><i>›</i><b>{{ page.title | default: 'Wishlist' | escape }}</b></nav>
      <h1>{{ page.title | default: 'La mia Wishlist' | escape }}</h1>
      <p data-wishlist-count>{{ 'mobile.wishlist.zero_saved' | t }}</p>
      {%- liquid
        assign wl_shipping = ''
        if settings.enable_free_shipping and settings.free_shipping_amount > 0
          assign wl_shipping = settings.free_shipping_amount | times: 100 | money_without_trailing_zeros | strip_html
        endif
      -%}
      <div class="wl-usp">
        {%- if wl_shipping != '' -%}<span>🚚 {{ 'desktop_home.free_shipping_from_html' | t: amount: wl_shipping }}</span>{%- endif -%}
        <span>↩ {{ 'desktop_collection.usp_return' | t }}</span>
        <span>💳 {{ 'desktop_collection.usp_klarna' | t }}</span>
      </div>
    </div>
    {%- comment -%} Ordinateur : photos des produits enregistrés (sinon des suggestions) qui entrent, flottent puis
        laissent la place aux suivantes, comme le bandeau des pages collection {%- endcomment -%}
    <div class="wl-art" data-wl-art aria-hidden="true">
      {%- for slot in (1..4) -%}<span class="wl-fl wl-fl--{{ forloop.index }}"><span class="wl-fl__in"><img alt="" width="140" height="190"></span></span>{%- endfor -%}
      <script type="application/json" data-wl-pics>[
        {%- for product in collections.all.products limit: 16 -%}{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 400 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endif -%}{%- endfor -%}
      ]</script>
    </div>
    <button type="button" data-wishlist-share hidden>
      <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path></svg>
      <span>{{ 'mobile.wishlist.share' | t }}</span>
    </button>
  </header>

  {%- comment -%} Ordinateur : colonne de gauche (filtres, total, connexion) et contenu à droite ; sur mobile ces
      enveloppes ne changent rien (display: contents). {%- endcomment -%}
  <div class="wishlist-page__side">
  <p class="wishlist-page__side-title">{{ 'mobile.wishlist.filter' | t }}</p>
  {%- unless customer -%}
    <aside class="wishlist-page__guest">
      <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg>
      <p><b>{{ 'mobile.wishlist.save_title' | t }}</b>{{ 'mobile.wishlist.save_text' | t }}</p>
      <a href="{{ routes.account_login_url }}">{{ 'mobile.wishlist.login' | t }}</a>
    </aside>
  {%- endunless -%}

  <button class="wishlist-page__price-drop" type="button" data-wishlist-price-drop hidden>
    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 7l6 6 4-4 8 8"></path><path d="M15 17h6v-6"></path></svg>
    <span data-wishlist-price-drop-text></span><b aria-hidden="true">›</b>
  </button>

  <div class="wishlist-page__filters" role="group" aria-label="{{ 'mobile.wishlist.filter' | t }}" data-wishlist-filters hidden></div>
  <div class="wishlist-page__summary" data-wishlist-summary hidden>
    <p>{{ 'mobile.wishlist.total' | t }} <b data-wishlist-total>€0,00</b></p>
    <button type="button" data-wishlist-add-all>{{ 'mobile.wishlist.add_all' | t }}</button>
  </div>
  </div>

  <div class="wishlist-page__main">
  <div class="wishlist-page__tools" data-wishlist-tools hidden>
    <label>Ordina:
      <select data-wishlist-sort>
        <option value="recent">{{ 'mobile.wishlist.sort_recent' | t }}</option>
        <option value="asc">{{ 'mobile.wishlist.sort_asc' | t }}</option>
        <option value="desc">{{ 'mobile.wishlist.sort_desc' | t }}</option>
      </select>
    </label>
    <button type="button" class="wishlist-page__edit" data-wishlist-edit>{{ 'mobile.wishlist.edit' | t }}</button>
  </div>

  <div class="wishlist-page__editbar" data-wishlist-editbar hidden>
    <label><input type="checkbox" data-wishlist-select-all> <span>{{ 'mobile.wishlist.select_all' | t }}</span></label>
    <button type="button" data-wishlist-remove-selected disabled>{{ 'mobile.wishlist.remove_zero' | t }}</button>
  </div>

  <section class="wishlist-page__empty" data-wishlist-empty hidden>
    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"></path></svg>
    <h2>{{ 'mobile.wishlist.empty' | t }}</h2>
    <p>{{ 'mobile.wishlist.empty_text' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}">{{ 'mobile.wishlist.discover' | t }}</a>
  </section>

  <div id="section_featured_collection-wishlist">
    <ul class="wishlist-page__list" data-wishlist-list></ul>
  </div>
  <p class="wishlist-page__error" data-wishlist-error role="status" hidden>{{ 'mobile.wishlist.load_error' | t }}</p>
  </div>

  {%- assign wishlist_recommendations = collections.all.products -%}
  {%- if wishlist_recommendations != blank -%}
    <section class="wishlist-page__recommendations" data-wishlist-recommendations>
      <h2>{{ 'mobile.common.you_may_like' | t }}</h2>
      <ul>
        {%- comment -%} Mêmes cartes que les pages collection (snippets/mshein-card.liquid) {%- endcomment -%}
        {%- liquid
          assign best = collections['bestsellers']
          assign best_ids = best.products | map: 'id' | join: ','
          capture flag
            render 'country-flag-emoji'
          endcapture
        -%}
        {%- for recommendation in wishlist_recommendations limit: 16 -%}
          {%- render 'mshein-card', product: recommendation, best: best, best_ids: best_ids, flag: flag -%}
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}

</section>

<script>
  // Ordinateur : bandeau animé (photos des produits enregistrés) et bouton « Anteprima » des cartes, comme les pages collection
  (function () {
    if (window.matchMedia('(max-width: 760px)').matches) return;
    var page = document.querySelector('[data-wishlist-page]');
    var art = page && page.querySelector('[data-wl-art]');
    if (!art) return;
    var pics = [];
    try {
      var saved = JSON.parse(window.localStorage.getItem('platinumshop:wishlist:v1') || '[]');
      if (Array.isArray(saved)) saved.forEach(function (item) { if (item && item.image) pics.push(String(item.image).replace(/([?&])width=\d+/, '$1width=400')); });
    } catch (error) { /* stockage indisponible : suggestions */ }
    if (pics.length < 4) {
      try { pics = pics.concat(JSON.parse(art.querySelector('[data-wl-pics]').textContent)); } catch (error) { /* rien */ }
    }
    var floats = [].slice.call(art.querySelectorAll('.wl-fl'));
    if (!pics.length) return;
    var set = 0;
    var show = function () {
      floats.forEach(function (node, i) {
        node.querySelector('img').src = pics[(set * floats.length + i) % pics.length];
        node.classList.remove('off');
        node.classList.add('on');
      });
    };
    requestAnimationFrame(function () { requestAnimationFrame(show); });
    if (pics.length > floats.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(function () {
        if (document.hidden || art.getBoundingClientRect().bottom < 0) return;
        floats.forEach(function (node) { node.classList.remove('on'); node.classList.add('off'); });
        setTimeout(function () {
          set += 1;
          floats.forEach(function (node) { node.classList.remove('off'); });
          requestAnimationFrame(function () { requestAnimationFrame(show); });
        }, 900);
      }, 5200);
    }
    var eye = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>';
    var preview = {{ 'desktop_home_shop.preview' | t | json }};
    page.addEventListener('mouseover', function (event) {
      var card = event.target.closest && event.target.closest('.mshein-card');
      if (!card || card.querySelector('.wl-qv')) return;
      var media = card.querySelector('.mshein-card__img');
      var link = card.querySelector('.mshein-card__link');
      if (media && link) media.insertAdjacentHTML('beforeend', '<a class="wl-qv" href="' + link.getAttribute('href').replace(/"/g, '&quot;') + '">' + eye + preview + '</a>');
    });
  })();
  document.addEventListener('click', function (event) {
    var add = event.target.closest && event.target.closest('[data-wishlist-page] .mshein-card__add');
    if (!add || window.matchMedia('(max-width: 760px)').matches) return;
    var api = window.mobileQuickAdd;
    if (!api || typeof api.openCard !== 'function' || !api.openCard(add, { desktop: true })) return;
    event.preventDefault();
    event.stopPropagation();
  }, true);
</script>

<style>
  [data-wishlist-page]{max-width:1200px;margin:0 auto 40px;padding:24px 16px}
  [data-wishlist-page] .wishlist-page__heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}
  [data-wishlist-page] .wishlist-page__heading h1,[data-wishlist-page] .wishlist-page__heading p{margin:0}
  [data-wishlist-page] .wishlist-page__heading p{margin-top:5px;color:#71758c;font-size:13px}
  [data-wishlist-page] [data-wishlist-share]{display:flex;align-items:center;gap:6px;padding:9px 12px;border:1px solid #d9dbea;border-radius:9px;background:#fff;color:#3a34d2;font-weight:700}
  [data-wishlist-page] [data-wishlist-share] svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  [data-wishlist-page] .wishlist-page__guest{display:flex;align-items:center;gap:11px;margin-bottom:16px;padding:12px;border:1px solid #e2e1fa;border-radius:12px;background:#f0efff}
