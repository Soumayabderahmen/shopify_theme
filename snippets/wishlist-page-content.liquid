  [data-wishlist-page] .wishlist-page__guest b{color:#16123f}
  [data-wishlist-page] .wishlist-page__filters{display:flex;gap:8px;margin-bottom:10px;overflow-x:auto}
  [data-wishlist-page] .wishlist-page__filters button{flex:none;padding:8px 12px;border:1px solid #e4e6ee;border-radius:999px;background:#fff;color:#4e526b;font-weight:700}
