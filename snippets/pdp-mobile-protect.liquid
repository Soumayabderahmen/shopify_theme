{%- comment -%}
  Feuille « Protections platinumshop » de la fiche produit mobile (inspirée de « Protezioni TikTok Shop ») :
  en-tête bleu clair (logo PL, titre, accroche, bouclier), puis une carte par engagement ; chaque bouton de la fiche
  (data-pdp-pt-open="ret|pay|ship|help|priv|price") fait défiler la feuille jusqu'à sa carte (assets/pdp-mobile.js).
  Contenu : uniquement les engagements des politiques de la boutique et des textes existants (protezioni.*,
  mobile_protect.*, policy_shipping.*, price_guarantee_page.*).
{%- endcomment -%}
{%- liquid
  assign pt_email = 'contact@platinumshop.it'
  assign pt_phone = '+39 370 372 3588'
  assign pt_email_link = '<a href="mailto:' | append: pt_email | append: '">' | append: pt_email | append: '</a>'
  assign pt_phone_link = '<a href="tel:+393703723588">' | append: pt_phone | append: '</a>'
  assign pt_arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>'
  assign pt_learn = 'mobile.pdp.learn_more' | t

  assign pt_price_page = pages['garanzia-sul-prezzo']
  assign pt_price = false
  assign pt_price_original = false
  if pt_price_page != empty and pt_price_page.content != blank
    assign pt_price = true
    if pt_price_page.content contains 'Shop with Confidence with Our Price Guarantee' and pt_price_page.content contains 'within <strong>14 days</strong>'
      assign pt_price_original = true
    endif
  endif
-%}
<dialog class="pdp-m__pt" data-pdp-pt aria-labelledby="pdp-pt-title">
  <div class="pdp-m__pt-in">
    <div class="pdp-m__pt-bar">
      <p class="pdp-m__pt-bar-title" aria-hidden="true">{{ 'protezioni.header_title' | t: shop_name: shop.name }}</p>
      <button class="pdp-m__pt-x" type="button" data-pdp-pt-close aria-label="{{ 'mobile.pdp.close' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    </div>

    <div class="pdp-m__pt-body" data-pdp-pt-body>
      <header class="pdp-m__pt-hero">
        <div class="pdp-m__pt-hero-txt">
          <span class="pdp-m__pt-brand">{% render 'pl-logo', size: 26 %}<b>{{ shop.name }}</b></span>
          <h2 id="pdp-pt-title">{{ 'protezioni.header_title' | t: shop_name: shop.name }}</h2>
          <p>{{ 'protezioni.overview.intro' | t: shop_name: shop.name }}</p>
        </div>
        <span class="pdp-m__pt-shield" aria-hidden="true">
          <svg viewBox="0 0 96 110"><path d="M48 4 10 18v32c0 26 16.4 46 38 56 21.6-10 38-30 38-56V18z" fill="#dfe9fb" stroke="#c8d8f6" stroke-width="3"/></svg>
          {% render 'pl-logo', size: 40 %}
        </span>
      </header>

      {%- comment -%} Garantie de remboursement (politique de retour) {%- endcomment -%}
      <section class="pdp-m__pt-card" data-pdp-pt-card="ret">
        <h3><span>{{ 'protezioni.overview.card_title' | t }}</span></h3>
        <p>{{ 'protezioni.overview.card_desc' | t }}</p>
        <ul>
          <li>{{ 'mobile_protect.ret_step1_html' | t: email: pt_email_link }}</li>
          <li>{{ 'protezioni.overview.item_1' | t: shop_name: shop.name }}</li>
          <li>{{ 'mobile_protect.ret_step4' | t }}</li>
          <li>{{ 'mobile_protect.ret_eu' | t }}</li>
          <li>{{ 'protezioni.overview.item_4' | t }}</li>
        </ul>
        {%- if shop.refund_policy.url != blank -%}
          <a class="pdp-m__pt-more" href="{{ shop.refund_policy.url }}">{{ pt_learn }}{{ pt_arrow }}</a>
        {%- endif -%}
      </section>

      {%- comment -%} Paiements sécurisés {%- endcomment -%}
      <section class="pdp-m__pt-card" data-pdp-pt-card="pay">
        <h3><span>{{ 'protezioni.pagamenti.title' | t }}</span></h3>
        <ul>
          <li>{{ 'protezioni.pagamenti.intro_html' | t: shop_name: shop.name }}</li>
          <li>{{ 'mobile_protect.pay_card' | t }}</li>
          <li>{{ 'protezioni.pagamenti.item_2' | t }}</li>
        </ul>
        {%- if shop.enabled_payment_types.size > 0 -%}
          <p class="pdp-m__pt-sub">{{ 'mobile_protect.pay_methods' | t }}</p>
          <ul class="pdp-m__pt-pay">
            {%- for payment_method in shop.enabled_payment_types -%}
              <li>{{ payment_method | payment_type_svg_tag }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </section>

      {%- comment -%} Protection de la livraison (politique d'expédition) {%- endcomment -%}
      <section class="pdp-m__pt-card" data-pdp-pt-card="ship">
        <h3><span>{{ 'protezioni.consegna.title' | t }}</span></h3>
        <p>{{ 'protezioni.consegna.intro_html' | t }}</p>
        <ul>
          <li>{{ 'mobile_protect.chip_prep' | t }}</li>
          <li>{{ 'policy_shipping.zone_italy' | t }} — {{ 'policy_shipping.days' | t: range: '3–7' }}</li>
          <li>{{ 'policy_shipping.zone_eu' | t }} — {{ 'policy_shipping.days' | t: range: '7–15' }}</li>
          <li>{{ 'policy_shipping.zone_world' | t }} — {{ 'policy_shipping.days' | t: range: '15–30' }}</li>
          <li>{{ 'mobile_protect.chip_tracking' | t }}</li>
          <li>{{ 'mobile_protect.chip_report' | t }}</li>
          <li>{{ 'mobile_protect.ship_customs' | t }}</li>
        </ul>
        {%- if shop.shipping_policy.url != blank -%}
          <a class="pdp-m__pt-more" href="{{ shop.shipping_policy.url }}">{{ pt_learn }}{{ pt_arrow }}</a>
        {%- endif -%}
      </section>

      {%- comment -%} Assistance client (contacts de la politique d'expédition) {%- endcomment -%}
      <section class="pdp-m__pt-card" data-pdp-pt-card="help">
        <h3><span>{{ 'mobile_protect.support_title' | t }}</span></h3>
        <p>{{ 'mobile_protect.support_text_html' | t: email: pt_email_link, phone: pt_phone_link }}</p>
      </section>

      {%- comment -%} Confidentialité des données {%- endcomment -%}
      <section class="pdp-m__pt-card" data-pdp-pt-card="priv">
        <h3><span>{{ 'protezioni.privacy.title' | t }}</span></h3>
        <p>{{ 'protezioni.privacy.intro_html' | t }}</p>
        <ul>
          <li>{{ 'protezioni.privacy.item_3' | t }}</li>
          <li>{{ 'mobile_protect.priv_cookies' | t }}</li>
        </ul>
        {%- if shop.privacy_policy.url != blank -%}
          <a class="pdp-m__pt-more" href="{{ shop.privacy_policy.url }}">{{ pt_learn }}{{ pt_arrow }}</a>
        {%- endif -%}
      </section>

      {%- comment -%} Garantie de prix (page « garanzia-sul-prezzo ») {%- endcomment -%}
      {%- if pt_price -%}
        <section class="pdp-m__pt-card" data-pdp-pt-card="price">
          {%- if pt_price_original -%}
            <h3><span>{{ 'mobile.pdp.price_guarantee' | t }}</span></h3>
            <p>{{ 'price_guarantee_page.intro_html' | t }}</p>
            <ul>
              <li>{{ 'price_guarantee_page.step2' | t }}</li>
              <li>{{ 'price_guarantee_page.step4' | t }}</li>
              <li>{{ 'price_guarantee_page.cond4' | t }}</li>
            </ul>
          {%- else -%}
            <h3><span>{{ pt_price_page.title | escape }}</span></h3>
            <div class="pdp-m__pt-rte">{{ pt_price_page.content }}</div>
          {%- endif -%}
          <a class="pdp-m__pt-more" href="{{ pt_price_page.url }}">{{ pt_learn }}{{ pt_arrow }}</a>
        </section>
      {%- endif -%}
    </div>

    <div class="pdp-m__pt-foot"><button type="button" data-pdp-pt-close>{{ 'protezioni.ok' | t }}</button></div>
  </div>
</dialog>
