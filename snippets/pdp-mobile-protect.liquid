{%- comment -%}
  Feuille « Protections platinumshop » de la fiche produit mobile, design du prototype v4.2 (« version luxe ») :
  en-tête à halo bleu (marque PL, sur-titre, titre sur deux lignes, écusson, pastilles de navigation), cartes numérotées,
  signature et bouton « Ok ». Chaque bouton de la fiche (data-pdp-pt-open="ret|pay|ship|help|priv|price") ou pastille
  fait défiler la feuille jusqu'à sa carte et la met en évidence (assets/pdp-mobile.js).
  Contenu : uniquement les engagements des politiques de la boutique et des textes existants (protezioni.*,
  mobile_protect.*, policy_shipping.*, price_guarantee_page.*).
{%- endcomment -%}
{%- liquid
  assign pt_email = 'contact@platinumshop.it'
  assign pt_phone = '+39 370 372 3588'
  assign pt_email_link = '<a href="mailto:' | append: pt_email | append: '">' | append: pt_email | append: '</a>'
  assign pt_phone_link = '<a href="tel:+393703723588">' | append: pt_phone | append: '</a>'
  assign pt_arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M14 7l5 5-5 5"/></svg>'
  assign pt_learn = 'mobile.pdp.learn_more' | t

  assign pt_name = shop.name | escape
  assign pt_title = 'protezioni.header_title' | t: shop_name: shop.name
  assign pt_em = '<em>' | append: pt_name | append: '</em>'
  assign pt_title_from = ' ' | append: pt_name
  assign pt_title_to = '<br>' | append: pt_em
  assign pt_title_html = pt_title | replace: pt_title_from, pt_title_to
  unless pt_title_html contains '<br>'
    assign pt_title_from = pt_name | append: ' '
    assign pt_title_to = pt_em | append: '<br>'
    assign pt_title_html = pt_title | replace: pt_title_from, pt_title_to
  endunless
  assign pt_bar_html = pt_title | replace: pt_name, pt_em
  # Mot composé (de « platinumshop-Schutz », nl « platinumshop-bescherming ») : nom en bleu, coupure naturelle au tiret.
  unless pt_title_html contains '<em>'
    assign pt_title_html = pt_bar_html
  endunless

  # Marque « platinum<b>shop</b> » du prototype : la fin « shop » du nom en gras.
  assign pt_name_head = pt_name
  assign pt_name_tail = ''
  assign pt_name_end = shop.name | slice: -4, 4 | downcase
  if pt_name_end == 'shop' and shop.name.size > 4
    assign pt_name_cut = shop.name.size | minus: 4
    assign pt_name_head = shop.name | slice: 0, pt_name_cut
    assign pt_name_tail = shop.name | slice: -4, 4
  endif

  assign pt_price_page = pages['garanzia-sul-prezzo']
  assign pt_price = false
  assign pt_price_original = false
  if pt_price_page != empty and pt_price_page.content != blank
    assign pt_price = true
    if pt_price_page.content contains 'Shop with Confidence with Our Price Guarantee' and pt_price_page.content contains 'within <strong>14 days</strong>'
      assign pt_price_original = true
    endif
  endif
-%}
<dialog class="pdp-m__pt" data-pdp-pt aria-labelledby="pdp-pt-title">
  <div class="pdp-m__pt-in">
    <button class="pdp-m__pt-x" type="button" data-pdp-pt-close aria-label="{{ 'mobile.pdp.close' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    <p class="pdp-m__pt-top" aria-hidden="true">{{ pt_bar_html }}</p>

    <div class="pdp-m__pt-body" data-pdp-pt-body>
      <header class="pdp-m__pt-hd">
        <span class="pdp-m__pt-brand">{% render 'pl-logo', size: 28, class: 'pdp-m__pt-plx' %}<span>{% if pt_name_tail != '' %}{{ pt_name_head | escape }}<b>{{ pt_name_tail | escape }}</b>{% else %}{{ pt_name_head }}{% endif %}</span></span>
        <p class="pdp-m__pt-eb">{{ 'mobile_protect.eyebrow' | t }}</p>
        <h2 id="pdp-pt-title">{{ pt_title_html }}</h2>
        <p class="pdp-m__pt-ds">{{ 'protezioni.overview.intro' | t: shop_name: shop.name }}</p>
        <svg class="pdp-m__pt-cr" viewBox="0 0 120 140" aria-hidden="true">
          <defs>
            <linearGradient id="pdp-pt-shb" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff"/><stop offset="1" stop-color="#d9e1ff"/></linearGradient>
            <linearGradient id="pdp-pt-shs" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#b9b4fa"/><stop offset="1" stop-color="#5a4bf0"/></linearGradient>
          </defs>
          <path d="M60 5 110 23v41c0 35-22 60-50 72C32 124 10 99 10 64V23z" fill="url(#pdp-pt-shb)" stroke="url(#pdp-pt-shs)" stroke-width="1.6"/>
          <path d="M60 14 101 29v35c0 29-18 50-41 61C37 114 19 93 19 64V29z" fill="none" stroke="#5a4bf0" stroke-width=".7" opacity=".3"/>
          <g transform="translate(37 44) scale(.72)">
            <rect width="64" height="64" rx="16" fill="url(#pl-logo-g)"/>
            <path fill="#fff" fill-rule="evenodd" d="M12 15h12.5a10 10 0 0 1 0 20H20v14h-8zM20 22v6h4.2a3 3 0 0 0 0-6z"/>
            <path fill="#fff" d="M36.5 15h8v26H54v8H36.5z"/>
            <circle cx="51" cy="18.5" r="3.6" fill="#ffb020"/>
          </g>
        </svg>
        <nav class="pdp-m__pt-nav" aria-label="{{ 'protezioni.header_title' | t: shop_name: shop.name }}">
          <button type="button" data-pdp-pt-go="ret">{{ 'protezioni.cards.rimborso' | t }}</button>
          <button type="button" data-pdp-pt-go="pay">{{ 'protezioni.cards.pagamenti' | t }}</button>
          <button type="button" data-pdp-pt-go="ship">{{ 'protezioni.cards.consegna' | t }}</button>
          <button type="button" data-pdp-pt-go="priv">{{ 'protezioni.cards.privacy' | t }}</button>
        </nav>
      </header>

      <div class="pdp-m__pt-list">
        {%- comment -%} 01 Garantie de remboursement (politique de retour) {%- endcomment -%}
        <section class="pdp-m__pt-card" data-pdp-pt-card="ret">
          <header>
            <span class="pdp-m__pt-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg></span>
            <span><small>01</small><h3>{{ 'protezioni.overview.card_title' | t }}</h3></span>
          </header>
          <p class="pdp-m__pt-lead">{{ 'protezioni.overview.card_desc' | t }}</p>
          <ul>
            <li>{{ 'mobile_protect.ret_step1_html' | t: email: pt_email_link }}</li>
            <li>{{ 'protezioni.overview.item_1' | t: shop_name: shop.name }}</li>
            <li>{{ 'mobile_protect.ret_step4' | t }}</li>
            <li>{{ 'mobile_protect.ret_eu' | t }}</li>
          </ul>
          <p class="pdp-m__pt-fine">{{ 'protezioni.overview.item_4' | t }}</p>
          {%- if shop.refund_policy.url != blank -%}
            <a class="pdp-m__pt-more" href="{{ shop.refund_policy.url }}"><span>{{ pt_learn }}</span>{{ pt_arrow }}</a>
          {%- endif -%}
        </section>

        {%- comment -%} 02 Paiements sécurisés {%- endcomment -%}
        <section class="pdp-m__pt-card" data-pdp-pt-card="pay">
          <header>
            <span class="pdp-m__pt-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10.5h18M7 15h4"/></svg></span>
            <span><small>02</small><h3>{{ 'protezioni.pagamenti.title' | t }}</h3></span>
          </header>
          <ul>
            <li>{{ 'protezioni.pagamenti.intro_html' | t: shop_name: shop.name }}</li>
            <li>{{ 'mobile_protect.pay_card' | t }}</li>
            <li>{{ 'protezioni.pagamenti.item_2' | t }}</li>
          </ul>
          {%- if shop.enabled_payment_types.size > 0 -%}
            <p class="pdp-m__pt-cap">{{ 'mobile_protect.pay_methods' | t }}</p>
            <ul class="pdp-m__pt-pay">
              {%- for payment_method in shop.enabled_payment_types -%}
                <li>{{ payment_method | payment_type_svg_tag }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </section>

        {%- comment -%} 03 Protection de la livraison (politique d'expédition) {%- endcomment -%}
        <section class="pdp-m__pt-card" data-pdp-pt-card="ship">
          <header>
            <span class="pdp-m__pt-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg></span>
            <span><small>03</small><h3>{{ 'protezioni.consegna.title' | t }}</h3></span>
          </header>
          <p class="pdp-m__pt-lead">{{ 'protezioni.consegna.intro_html' | t }}</p>
          <ul>
            <li>{{ 'mobile_protect.chip_prep' | t }}</li>
            <li>{{ 'policy_shipping.zone_italy' | t }} — {{ 'policy_shipping.days' | t: range: '3–7' }}</li>
            <li>{{ 'policy_shipping.zone_eu' | t }} — {{ 'policy_shipping.days' | t: range: '7–15' }}</li>
            <li>{{ 'policy_shipping.zone_world' | t }} — {{ 'policy_shipping.days' | t: range: '15–30' }}</li>
            <li>{{ 'mobile_protect.chip_tracking' | t }}</li>
            <li>{{ 'mobile_protect.chip_report' | t }}</li>
          </ul>
          <p class="pdp-m__pt-fine">{{ 'mobile_protect.ship_customs' | t }}</p>
          {%- if shop.shipping_policy.url != blank -%}
            <a class="pdp-m__pt-more" href="{{ shop.shipping_policy.url }}"><span>{{ pt_learn }}</span>{{ pt_arrow }}</a>
          {%- endif -%}
        </section>

        {%- comment -%} 04 Assistance client (contacts de la politique d'expédition) {%- endcomment -%}
        <section class="pdp-m__pt-card" data-pdp-pt-card="help">
          <header>
            <span class="pdp-m__pt-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/><path d="M19 20a3 3 0 0 1-3 2h-2"/></svg></span>
            <span><small>04</small><h3>{{ 'mobile_protect.support_title' | t }}</h3></span>
          </header>
          <p>{{ 'mobile_protect.support_text_html' | t: email: pt_email_link, phone: pt_phone_link }}</p>
        </section>

        {%- comment -%} 05 Confidentialité des données {%- endcomment -%}
        <section class="pdp-m__pt-card" data-pdp-pt-card="priv">
          <header>
            <span class="pdp-m__pt-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg></span>
            <span><small>05</small><h3>{{ 'protezioni.privacy.title' | t }}</h3></span>
          </header>
          <p class="pdp-m__pt-lead">{{ 'protezioni.privacy.intro_html' | t }}</p>
          <ul>
            <li>{{ 'protezioni.privacy.item_3' | t }}</li>
            <li>{{ 'mobile_protect.priv_cookies' | t }}</li>
          </ul>
          {%- if shop.privacy_policy.url != blank -%}
            <a class="pdp-m__pt-more" href="{{ shop.privacy_policy.url }}"><span>{{ pt_learn }}</span>{{ pt_arrow }}</a>
          {%- endif -%}
        </section>

        {%- comment -%} 06 Garantie de prix (page « garanzia-sul-prezzo ») {%- endcomment -%}
        {%- if pt_price -%}
          <section class="pdp-m__pt-card" data-pdp-pt-card="price">
            <header>
              <span class="pdp-m__pt-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg></span>
              <span><small>06</small><h3>{% if pt_price_original %}{{ 'mobile.pdp.price_guarantee' | t }}{% else %}{{ pt_price_page.title | escape }}{% endif %}</h3></span>
            </header>
            {%- if pt_price_original -%}
              <p class="pdp-m__pt-lead">{{ 'price_guarantee_page.intro_html' | t }}</p>
              <ul>
                <li>{{ 'price_guarantee_page.step2' | t }}</li>
                <li>{{ 'price_guarantee_page.step4' | t }}</li>
                <li>{{ 'price_guarantee_page.cond4' | t }}</li>
              </ul>
            {%- else -%}
              <div class="pdp-m__pt-rte">{{ pt_price_page.content }}</div>
            {%- endif -%}
            <a class="pdp-m__pt-more" href="{{ pt_price_page.url }}"><span>{{ pt_learn }}</span>{{ pt_arrow }}</a>
          </section>
        {%- endif -%}

        <p class="pdp-m__pt-sig">{% render 'pl-logo', size: 18, class: 'pdp-m__pt-plx is-sm' %}<span>{{ 'mobile_protect.sign' | t: shop_name: shop.name }}</span></p>
      </div>
    </div>

    <div class="pdp-m__pt-foot"><button type="button" data-pdp-pt-close>{{ 'protezioni.ok' | t }}</button></div>
  </div>
</dialog>
