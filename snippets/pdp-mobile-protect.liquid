{%- comment -%}
  Feuille « Protections » de la fiche produit mobile (inspirée de Temu / AliExpress / Shein) : un onglet par engagement,
  ouverte sur l'onglet touché (assets/pdp-mobile.js : data-pdp-pt-open="pay|ship|ret|priv|price").
  Contenu : vraies politiques de la boutique (retour, expédition), textes existants protezioni.* et page
  « garanzia-sul-prezzo » ; traductions mobile_protect.*, policy_shipping.*, price_guarantee_page.*.
{%- endcomment -%}
{%- liquid
  assign pt_email = 'contact@platinumshop.it'
  assign pt_email_link = '<a href="mailto:' | append: pt_email | append: '">' | append: pt_email | append: '</a>'
  assign pt_check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>'
  assign pt_arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>'
  assign pt_icon_pay = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10.5h18M7 15h4"/></svg>'
  assign pt_icon_ship = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 5h13v11H1zM14 9h4l3 3v4h-7"/><circle cx="5.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/></svg>'
  assign pt_icon_ret = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg>'
  assign pt_icon_priv = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>'
  assign pt_icon_price = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6c0 4.5 3.2 7.6 7.5 9 4.3-1.4 7.5-4.5 7.5-9V6z"/><path d="m9 12 2.2 2.2L15.5 10"/></svg>'

  assign pt_price_page = pages['garanzia-sul-prezzo']
  assign pt_price = false
  assign pt_price_original = false
  if pt_price_page != empty and pt_price_page.content != blank
    assign pt_price = true
    if pt_price_page.content contains 'Shop with Confidence with Our Price Guarantee' and pt_price_page.content contains 'within <strong>14 days</strong>'
      assign pt_price_original = true
    endif
  endif
-%}
<dialog class="pdp-m__pt" data-pdp-pt aria-labelledby="pdp-pt-title">
  <div class="pdp-m__pt-in">
    <span class="pdp-m__pt-grip" aria-hidden="true"></span>
    <button class="pdp-m__pt-x" type="button" data-pdp-pt-close aria-label="{{ 'mobile.pdp.close' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>

    <div class="pdp-m__pt-top">
      <span class="pdp-m__pt-shield" aria-hidden="true">{{ pt_icon_price }}</span>
      <h2 id="pdp-pt-title">{{ 'protezioni.header_title' | t: shop_name: shop.name }}</h2>
    </div>

    <div class="pdp-m__pt-tabs" role="tablist">
      <button type="button" role="tab" data-pdp-pt-tab="pay" aria-selected="true">{{ pt_icon_pay }}<span>{{ 'protezioni.cards.pagamenti' | t }}</span></button>
      <button type="button" role="tab" data-pdp-pt-tab="ship" aria-selected="false">{{ pt_icon_ship }}<span>{{ 'protezioni.cards.consegna' | t }}</span></button>
      <button type="button" role="tab" data-pdp-pt-tab="ret" aria-selected="false">{{ pt_icon_ret }}<span>{{ 'protezioni.cards.rimborso' | t }}</span></button>
      <button type="button" role="tab" data-pdp-pt-tab="priv" aria-selected="false">{{ pt_icon_priv }}<span>{{ 'protezioni.cards.privacy' | t }}</span></button>
      {%- if pt_price -%}
        <button type="button" role="tab" data-pdp-pt-tab="price" aria-selected="false">{{ pt_icon_price }}<span>{{ 'mobile.pdp.price_guarantee' | t }}</span></button>
      {%- endif -%}
    </div>

    <div class="pdp-m__pt-body" data-pdp-pt-body>
      {%- comment -%} Paiements {%- endcomment -%}
      <section class="pdp-m__pt-panel" role="tabpanel" data-pdp-pt-panel="pay">
        <div class="pdp-m__pt-hero"><span>{{ pt_icon_pay }}</span><div><h3>{{ 'protezioni.pagamenti.title' | t }}</h3><p>{{ 'mobile_protect.pay_summary' | t }}</p></div></div>
        <ul class="pdp-m__pt-hl">
          <li><b>{{ 'mobile_protect.pay_h1_v' | t }}</b><span>{{ 'mobile_protect.pay_h1_l' | t }}</span></li>
          <li><b>{{ 'mobile_protect.pay_h2_v' | t }}</b><span>{{ 'mobile_protect.pay_h2_l' | t }}</span></li>
          <li><b>{{ 'mobile_protect.pay_h3_v' | t }}</b><span>{{ 'mobile_protect.pay_h3_l' | t }}</span></li>
        </ul>
        <p class="pdp-m__pt-box">{{ 'protezioni.pagamenti.intro_html' | t: shop_name: shop.name }}</p>
        <ul class="pdp-m__pt-list">
          <li>{{ pt_check }}<span>{{ 'mobile_protect.pay_card' | t }}</span></li>
          <li>{{ pt_check }}<span>{{ 'protezioni.pagamenti.item_2' | t }}</span></li>
          <li>{{ pt_check }}<span>{{ 'protezioni.pagamenti.item_4' | t }}</span></li>
        </ul>
        {%- if shop.enabled_payment_types.size > 0 -%}
          <h4>{{ 'mobile_protect.pay_methods' | t }}</h4>
          <ul class="pdp-m__pt-pay">
            {%- for payment_method in shop.enabled_payment_types -%}
              <li>{{ payment_method | payment_type_svg_tag }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </section>

      {%- comment -%} Livraison (politique d'expédition) {%- endcomment -%}
      <section class="pdp-m__pt-panel" role="tabpanel" data-pdp-pt-panel="ship" hidden>
        <div class="pdp-m__pt-hero"><span>{{ pt_icon_ship }}</span><div><h3>{{ 'protezioni.consegna.title' | t }}</h3><p>{{ 'protezioni.consegna.intro_html' | t }}</p></div></div>
        <ul class="pdp-m__pt-hl">
          <li><b>{{ 'mobile_protect.ship_h1_v' | t }}</b><span>{{ 'mobile_protect.ship_h1_l' | t }}</span></li>
          <li><b>{{ 'mobile_protect.ship_h2_v' | t }}</b><span>{{ 'mobile_protect.ship_h2_l' | t }}</span></li>
          <li><b>{{ 'mobile_protect.ship_h3_v' | t }}</b><span>{{ 'mobile_protect.ship_h3_l' | t }}</span></li>
        </ul>
        <h4>{{ 'policy_shipping.s2_title' | t }}</h4>
        <ul class="pdp-m__pt-zones">
          <li><span>{{ 'policy_shipping.zone_italy' | t }}</span><b>{{ 'policy_shipping.days' | t: range: '3–7' }}</b></li>
          <li><span>{{ 'policy_shipping.zone_eu' | t }}</span><b>{{ 'policy_shipping.days' | t: range: '7–15' }}</b></li>
          <li><span>{{ 'policy_shipping.zone_world' | t }}</span><b>{{ 'policy_shipping.days' | t: range: '15–30' }}</b></li>
        </ul>
        <p class="pdp-m__pt-note">{{ 'policy_shipping.s2_note' | t }}</p>
        <ul class="pdp-m__pt-list">
          <li>{{ pt_check }}<span>{{ 'mobile_protect.ship_carriers' | t }}</span></li>
          <li>{{ pt_check }}<span>{{ 'mobile_protect.ship_customs' | t }}</span></li>
        </ul>
        {%- if shop.shipping_policy.url != blank -%}
          <a class="pdp-m__pt-more" href="{{ shop.shipping_policy.url }}">{{ 'mobile_protect.full_policy' | t }}{{ pt_arrow }}</a>
        {%- endif -%}
      </section>

      {%- comment -%} Retours (politique de retour) {%- endcomment -%}
      <section class="pdp-m__pt-panel" role="tabpanel" data-pdp-pt-panel="ret" hidden>
        <div class="pdp-m__pt-hero"><span>{{ pt_icon_ret }}</span><div><h3>{{ 'protezioni.rimborso.title' | t }}</h3><p>{{ 'mobile_protect.ret_summary' | t }}</p></div></div>
        <ul class="pdp-m__pt-hl">
          <li><b>{{ 'mobile_protect.ret_h1_v' | t }}</b><span>{{ 'mobile_protect.ret_h1_l' | t }}</span></li>
          <li><b>{{ 'mobile_protect.ret_h2_v' | t }}</b><span>{{ 'mobile_protect.ret_h2_l' | t }}</span></li>
          <li><b>{{ 'mobile_protect.ret_h3_v' | t }}</b><span>{{ 'mobile_protect.ret_h3_l' | t }}</span></li>
        </ul>
        <h4>{{ 'mobile_protect.ret_steps_title' | t }}</h4>
        <ol class="pdp-m__pt-steps">
          <li>{{ 'mobile_protect.ret_step1_html' | t: email: pt_email_link }}</li>
          <li>{{ 'mobile_protect.ret_step2' | t }}</li>
          <li>{{ 'mobile_protect.ret_step3' | t }}</li>
          <li>{{ 'mobile_protect.ret_step4' | t }}</li>
        </ol>
        <ul class="pdp-m__pt-list">
          <li>{{ pt_check }}<span>{{ 'mobile_protect.ret_eu' | t }}</span></li>
          <li>{{ pt_check }}<span>{{ 'mobile_protect.ret_damage' | t }}</span></li>
        </ul>
        <div class="pdp-m__pt-warn"><b>{{ 'mobile_protect.ret_excl_title' | t }}</b><span>{{ 'mobile_protect.ret_excl' | t }}</span></div>
        {%- if shop.refund_policy.url != blank -%}
          <a class="pdp-m__pt-more" href="{{ shop.refund_policy.url }}">{{ 'mobile_protect.full_policy' | t }}{{ pt_arrow }}</a>
        {%- endif -%}
      </section>

      {%- comment -%} Confidentialité {%- endcomment -%}
      <section class="pdp-m__pt-panel" role="tabpanel" data-pdp-pt-panel="priv" hidden>
        <div class="pdp-m__pt-hero"><span>{{ pt_icon_priv }}</span><div><h3>{{ 'protezioni.privacy.title' | t }}</h3><p>{{ 'protezioni.privacy.intro_html' | t }}</p></div></div>
        <ul class="pdp-m__pt-hl">
          <li><b>{{ 'mobile_protect.priv_h1_v' | t }}</b><span>{{ 'mobile_protect.priv_h1_l' | t }}</span></li>
          <li><b>{{ 'mobile_protect.priv_h2_v' | t }}</b><span>{{ 'mobile_protect.priv_h2_l' | t }}</span></li>
          <li><b>{{ 'mobile_protect.priv_h3_v' | t }}</b><span>{{ 'mobile_protect.priv_h3_l' | t }}</span></li>
        </ul>
        <ul class="pdp-m__pt-list">
          <li>{{ pt_check }}<span>{{ 'protezioni.privacy.item_1_html' | t }}</span></li>
          <li>{{ pt_check }}<span>{{ 'protezioni.privacy.item_2' | t }}</span></li>
          <li>{{ pt_check }}<span>{{ 'protezioni.privacy.item_3' | t }}</span></li>
          <li>{{ pt_check }}<span>{{ 'protezioni.privacy.item_4' | t }}</span></li>
          <li>{{ pt_check }}<span>{{ 'mobile_protect.priv_cookies' | t }}</span></li>
        </ul>
        {%- if shop.privacy_policy.url != blank -%}
          <a class="pdp-m__pt-more" href="{{ shop.privacy_policy.url }}">{{ 'mobile_protect.full_policy' | t }}{{ pt_arrow }}</a>
        {%- endif -%}
      </section>

      {%- comment -%} Garantie de prix (page « garanzia-sul-prezzo » : traduite tant que son texte est celui d'origine) {%- endcomment -%}
      {%- if pt_price -%}
        <section class="pdp-m__pt-panel" role="tabpanel" data-pdp-pt-panel="price" hidden>
          {%- if pt_price_original -%}
            <div class="pdp-m__pt-hero"><span>{{ pt_icon_price }}</span><div><h3>{{ 'price_guarantee_page.title' | t }}</h3><p>{{ 'price_guarantee_page.intro_html' | t }}</p></div></div>
            <ul class="pdp-m__pt-hl pdp-m__pt-hl--one">
              <li><b>{{ 'price_guarantee_page.badge' | t }}</b><span>{{ 'mobile.pdp.price_guarantee' | t }}</span></li>
            </ul>
            <h4>{{ 'price_guarantee_page.how_title' | t }}</h4>
            <ol class="pdp-m__pt-steps">
              <li>{{ 'price_guarantee_page.step1' | t }}</li>
              <li>{{ 'price_guarantee_page.step2' | t }}</li>
              <li>{{ 'price_guarantee_page.step3' | t }}</li>
              <li>{{ 'price_guarantee_page.step4' | t }}</li>
            </ol>
            <h4>{{ 'price_guarantee_page.cond_title' | t }}</h4>
            <ul class="pdp-m__pt-list">
              <li>{{ pt_check }}<span>{{ 'price_guarantee_page.cond1' | t }}</span></li>
              <li>{{ pt_check }}<span>{{ 'price_guarantee_page.cond2' | t }}</span></li>
              <li>{{ pt_check }}<span>{{ 'price_guarantee_page.cond3' | t }}</span></li>
              <li>{{ pt_check }}<span>{{ 'price_guarantee_page.cond4' | t }}</span></li>
            </ul>
            <div class="pdp-m__pt-contact">
              <b>{{ 'price_guarantee_page.contact_title' | t }}</b>
              <p>{{ 'price_guarantee_page.contact_html' | t: email: pt_email_link }}</p>
              <a href="mailto:{{ pt_email }}">{{ 'price_guarantee_page.cta' | t }}</a>
            </div>
          {%- else -%}
            <div class="pdp-m__pt-hero"><span>{{ pt_icon_price }}</span><div><h3>{{ pt_price_page.title | escape }}</h3></div></div>
            <div class="pdp-m__pt-rte">{{ pt_price_page.content }}</div>
          {%- endif -%}
        </section>
      {%- endif -%}
    </div>

    <div class="pdp-m__pt-foot"><button type="button" data-pdp-pt-close>{{ 'protezioni.ok' | t }}</button></div>
  </div>
</dialog>
