{%- comment -%}
  Page « Traccia il tuo ordine » ORDINATEUR (sections/main-page.liquid) : le contenu écrit dans l'admin utilise des émojis
  comme icônes ; ils sont remplacés ici par des icônes au trait du site (même dessin que l'en-tête et le pied de page).
  Styles : assets/desktop-track.css (.dtr-ic). La version mobile de la page (snippets/policy-page.liquid) ne change pas.
  - content : page.content
{%- endcomment -%}
{%- liquid
  assign o = '<i class="dtr-ic" aria-hidden="true"><svg viewBox="0 0 24 24">'
  assign c = '</svg></i>'
  assign ic_box = o | append: '<path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="m3 8 9 5 9-5M12 13v8"/>' | append: c
  assign ic_search = o | append: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>' | append: c
  assign ic_mail = o | append: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>' | append: c
  assign ic_inbox = o | append: '<path d="M4 13h4l2 3h4l2-3h4"/><path d="M5.5 5h13L21 13v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-5Z"/>' | append: c
  assign ic_pin = o | append: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>' | append: c
  assign ic_bolt = o | append: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>' | append: c
  assign ic_lock = o | append: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14.5v2.5"/>' | append: c
  assign ic_badge = o | append: '<path d="M12 2.5 14.6 5l3.5-.4.6 3.5 3 1.9-1.4 3.2 1.4 3.2-3 1.9-.6 3.5-3.5-.4L12 21.5 9.4 19l-3.5.4-.6-3.5-3-1.9 1.4-3.2-1.4-3.2 3-1.9.6-3.5 3.5.4L12 2.5Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>' | append: c
  assign ic_globe = o | append: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>' | append: c
  assign ic_shield = o | append: '<path d="M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6l-8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>' | append: c
  assign ic_check = o | append: '<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>' | append: c
  assign ic_truck = o | append: '<path d="M1 5h13v11H1zM14 9h4l3 3v4h-7"/><circle cx="5.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/>' | append: c
  assign ic_plane = o | append: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2Z"/>' | append: c
  assign ic_help = o | append: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6M12 17h.01"/>' | append: c
  assign ic_clock = o | append: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>' | append: c
  assign ic_refresh = o | append: '<path d="M20 11a8 8 0 0 0-14.9-3M4 13a8 8 0 0 0 14.9 3"/><path d="M5 3v5h5M19 21v-5h-5"/>' | append: c
  assign ic_x = o | append: '<circle cx="12" cy="12" r="9"/><path d="m15 9-6 6M9 9l6 6"/>' | append: c
  assign ic_chat = o | append: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.6A8 8 0 1 1 21 12Z"/>' | append: c
  assign ic_user = o | append: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>' | append: c
  assign ic_return = o | append: '<path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/>' | append: c

  assign html = content
  assign html = html | replace: '✉️ ', ic_mail | replace: '✉️', ic_mail | replace: '✉ ', ic_mail
  assign html = html | replace: '🛡️ ', ic_shield | replace: '🛡️', ic_shield
  assign html = html | replace: '⏱️ ', ic_clock | replace: '⏱️', ic_clock
  assign html = html | replace: '🇨🇳 ', ic_plane | replace: '🇨🇳', ic_plane
  assign html = html | replace: '📦 ', ic_box | replace: '📦', ic_box
  assign html = html | replace: '🔍 ', ic_search | replace: '🔍', ic_search
  assign html = html | replace: '📧 ', ic_mail | replace: '📧', ic_mail
  assign html = html | replace: '📮 ', ic_inbox | replace: '📮', ic_inbox
  assign html = html | replace: '📍 ', ic_pin | replace: '📍', ic_pin
  assign html = html | replace: '⚡ ', ic_bolt | replace: '⚡', ic_bolt
  assign html = html | replace: '🔒 ', ic_lock | replace: '🔒', ic_lock
  assign html = html | replace: '🔐 ', ic_lock | replace: '🔐', ic_lock
  assign html = html | replace: '💯 ', ic_badge | replace: '💯', ic_badge
  assign html = html | replace: '🌍 ', ic_globe | replace: '🌍', ic_globe
  assign html = html | replace: '✅ ', ic_check | replace: '✅', ic_check
  assign html = html | replace: '🚚 ', ic_truck | replace: '🚚', ic_truck
  assign html = html | replace: '❓ ', ic_help | replace: '❓', ic_help
  assign html = html | replace: '🔄 ', ic_refresh | replace: '🔄', ic_refresh
  assign html = html | replace: '❌ ', ic_x | replace: '❌', ic_x
  assign html = html | replace: '💬 ', ic_chat | replace: '💬', ic_chat
  assign html = html | replace: '👤 ', ic_user | replace: '👤', ic_user
  assign html = html | replace: '💰 ', ic_return | replace: '💰', ic_return
-%}
{{- html -}}
