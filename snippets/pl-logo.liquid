{%- comment -%}
  Monogramme « PL » de platinumshop (SVG, sans image) : carré arrondi en dégradé bleu de la marque, lettres blanches.
  Params : size (px, défaut 28), class (optionnel)
{%- endcomment -%}
{%- assign pl_size = size | default: 28 -%}
<svg class="pl-logo{% if class != blank %} {{ class }}{% endif %}" width="{{ pl_size }}" height="{{ pl_size }}" viewBox="0 0 48 48" role="img" aria-label="platinumshop">
  <defs>
    <linearGradient id="pl-logo-g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5a55e6"/>
      <stop offset="1" stop-color="#2a2390"/>
    </linearGradient>
  </defs>
  <rect width="48" height="48" rx="13" fill="url(#pl-logo-g)"/>
  <path d="M10 34V14h8.2c4.6 0 7.5 2.6 7.5 6.6s-2.9 6.6-7.5 6.6h-3.6V34zm4.6-10.7h3.3c2 0 3.2-1 3.2-2.7s-1.2-2.7-3.2-2.7h-3.3z" fill="#fff"/>
  <path d="M28.4 34V14H33v16h8.2v4z" fill="#fff"/>
  <circle cx="40.6" cy="15.8" r="2.6" fill="#ffd36b"/>
</svg>
