{%- comment -%}
  Monogramme « PL » de platinumshop (dessin du prototype v4.2) : carré arrondi en dégradé #5A4BF0 -> #2A22B8,
  « PL » blanc géométrique, point ambre #FFB020. SVG sans image.
  Params : size (px, défaut 28), class (optionnel)
{%- endcomment -%}
{%- assign pl_size = size | default: 28 -%}
<svg class="pl-logo{% if class != blank %} {{ class }}{% endif %}" width="{{ pl_size }}" height="{{ pl_size }}" viewBox="0 0 64 64" role="img" aria-label="platinumshop">
  <defs>
    <linearGradient id="pl-logo-g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5a4bf0"/>
      <stop offset="1" stop-color="#2a22b8"/>
    </linearGradient>
  </defs>
  <rect width="64" height="64" rx="16" fill="url(#pl-logo-g)"/>
  <path fill="#fff" fill-rule="evenodd" d="M12 15h12.5a10 10 0 0 1 0 20H20v14h-8zM20 22v6h4.2a3 3 0 0 0 0-6z"/>
  <path fill="#fff" d="M36.5 15h8v26H54v8H36.5z"/>
  <circle cx="51" cy="18.5" r="3.6" fill="#ffb020"/>
</svg>
