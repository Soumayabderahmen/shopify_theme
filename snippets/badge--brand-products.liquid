{% comment %}
  List of target brands (lowercase)
  {% assign target_brands = "jordan, nike, adidas, puma, reebok, new balance, onemix, asics" | split: ", " %}
  {% assign product_title_lower = product.title | downcase %}
  {% assign matched_brand = "" %}

  {% comment %} Loop through brands to see if any exist in the product title {% endcomment %}
  {% for brand in target_brands %}
    {% if product_title_lower contains brand %}
      {% assign matched_brand = brand | capitalize %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% comment %} Show badges only if a brand was found in the title {% endcomment %}
  {% if matched_brand != "" %}
    <div class="brand-badges-container">

      <!-- 1. Official Store Badge -->
      <span class="badge badge-store">
        Official Store: {{ matched_brand }}
      </span>

      <!-- 2. Star Seller Badge -->
      <span class="badge badge-star">
        <svg class="badge-icon star-icon" viewBox="0 0 24 24" width="13" height="13">
          <path fill="#FFD700" d="M12 2l2.4 7.4H22l-6 4.5 2.3 7.1-6.3-4.6-6.3 4.6 2.3-7.1-6-4.5h7.6z"/>
        </svg>
        Star seller
      </span>

      <!-- 3. Brand Official Badge -->
      <span class="badge badge-brand-check">
        <svg class="badge-icon check-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Brand Official
      </span>

    </div>
  {% endif %}

  <style>
      .brand-badges-container {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 12px 0;
    flex-wrap: wrap;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* Badge 1: Store Name (Dark Brown) */
  .badge-store {
    background-color: #3b2314;
    color: #f2e3d5;
  }

  /* Badge 2: Star Seller (Purple) */
  .badge-star {
    background-color: #581c87;
    color: #ffffff;
  }

  /* Badge 3: Brand Official (Bronze Checkmark) */
  .badge-brand-check {
    background-color: #4a2c11;
    color: #fce7f3;
  }

  .badge-icon {
    flex-shrink: 0;
  }
  </style>
{% endcomment %}

