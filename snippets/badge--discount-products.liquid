-%}

<div
  class="badge-wrap-3d{% unless has_discount %} badge-wrap-3d--hidden{% endunless %}"
  id="disc-badge-wrap"
  data-is-high-price="{{ is_high_price }}"
  data-has-new-arrival="{{ is_new_arrival }}"
  aria-hidden="{% if has_discount %}false{% else %}true{% endif %}"
>
  {%- if enable_360_flip -%}
    {%- comment -%} === BADGE 3D ANIMATO 360° (Sconto + Risparmi + Novità) === {%- endcomment -%}
    <div class="cube-3d-scene">
      <div class="cube-3d-flipper">
        
        <!-- FACCIA 1 (0°): SCONTO + RISPARMI -->
        <div class="cube-3d-face cube-3d-face--front">
          <div class="discount-combined-group">
            {%- if is_high_price -%}
              <span class="pill-badge pill-badge--discount">
                <svg class="pill-badge__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4.09 12.11a1.5 1.5 0 0 0 1.14 2.45h4.77l-2.09 7.54a1.5 1.5 0 0 0 2.63 1.28l8.91-10.11a1.5 1.5 0 0 0-1.14-2.45h-4.77l2.09-7.54A1.5 1.5 0 0 0 13 2Z"/></svg>
                {{ text_savings }} <strong id="disc-badge-eur-amount">{{ savings_amount | money }}</strong>
              </span>
            {%- else -%}
              <span class="pill-badge pill-badge--discount">
                −<span id="disc-badge-pct">{{ discount_pct }}</span>%
              </span>
              <span class="pill-badge-savings" id="disc-badge-savings">
                <span class="disc-badge-savings__text">{{ text_savings }}</span> <strong id="disc-badge-savings-amount">{{ savings_amount | money }}</strong>
              </span>
            {%- endif -%}
          </div>
        </div>

        <!-- FACCIA 2 (180°): NOVITÀ / NEW ARRIVAL -->
        <div class="cube-3d-face cube-3d-face--back">
          <span class="pill-badge pill-badge--new">
            <span class="pill-badge__sparkle">✨</span>
            {{ text_new }}
          </span>
        </div>

      </div>
    </div>

  {%- else -%}
    {%- comment -%} === BADGE STATICO (Solo Sconto) === {%- endcomment -%}
    <div class="discount-combined-group">
      {%- if is_high_price -%}
        <span class="pill-badge pill-badge--discount">
          <svg class="pill-badge__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4.09 12.11a1.5 1.5 0 0 0 1.14 2.45h4.77l-2.09 7.54a1.5 1.5 0 0 0 2.63 1.28l8.91-10.11a1.5 1.5 0 0 0-1.14-2.45h-4.77l2.09-7.54A1.5 1.5 0 0 0 13 2Z"/></svg>
          {{ text_savings }} <strong>{{ savings_amount | money }}</strong>
        </span>
      {%- else -%}
        <span class="pill-badge pill-badge--discount">
          −{{ discount_pct }}%
        </span>
        <span class="pill-badge-savings">
          {{ text_savings }} <strong>{{ savings_amount | money }}</strong>
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<style>
  /* === WRAPPER PRINCIPALE RESPONSIVE === */
  .badge-wrap-3d {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    vertical-align: middle;
    position: relative;
    z-index: 5;
  }

  .badge-wrap-3d--hidden {
    display: none !important;
  }

  /* GRAFICA GRUPPO SCONTO + RISPARMI */
  .discount-combined-group {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  /* === STILE BADGE === */
  .pill-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    height: 1.875rem; /* 30px */
    padding: 0 0.65rem;
    border-radius: 0.35rem;
    font-size: 0.8125rem; /* 13px per evitare overflow */
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .pill-badge--discount {
    background: linear-gradient(135deg, #e11d48, #be123c);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(225, 29, 72, 0.25);
  }

  .pill-badge--new {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    letter-spacing: 0.03em;
    padding: 0 0.75rem;
    border-radius: 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 2px 8px rgba(2, 132, 199, 0.3);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .pill-badge__sparkle {
    font-size: 0.85rem;
    margin-right: 0.15rem;
    display: inline-block;
    animation: pulseSparkle 2s infinite ease-in-out;
  }

  @keyframes pulseSparkle {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50% { transform: scale(1.2); opacity: 1; }
  }

  .pill-badge__icon {
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
  }

  /* TESTO RISPARMI */
  .pill-badge-savings {
    font-size: 0.8125rem;
    color: #1f2937;
    white-space: nowrap;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.9);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
  }

  .pill-badge-savings strong {
    color: #be123c;
    font-weight: 800;
  }

  /* === ROTAZIONE 360 GRADI 3D === */
  .cube-3d-scene {
    perspective: 1000px;
    height: 2rem;
    min-width: 140px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .cube-3d-flipper {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    animation: rotate360Cube 8s cubic-bezier(0.68, -0.15, 0.265, 1.15) infinite;
  }

  .cube-3d-face {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Posizionamento Facce 3D */
  .cube-3d-face--front {
    transform: rotateX(0deg) translateZ(1rem);
  }

  .cube-3d-face--back {
    transform: rotateX(180deg) translateZ(1rem);
  }

  @keyframes rotate360Cube {
    0%, 40% {
      transform: rotateX(0deg);
    }
    50%, 90% {
      transform: rotateX(180deg);
    }
    100% {
      transform: rotateX(360deg);
    }
  }

  /* === MEDIA QUERIES (MOBILE RESPONSIVE) === */
  @media (max-width: 480px) {
    .pill-badge {
      height: 1.625rem;
      padding: 0 0.45rem;
      font-size: 0.725rem;
    }
    .pill-badge-savings {
      font-size: 0.725rem;
      padding: 0.1rem 0.3rem;
    }
    .cube-3d-scene {
      height: 1.625rem;
      min-width: 110px;
    }
    .cube-3d-face--front {
      transform: rotateX(0deg) translateZ(0.8125rem);
    }
    .cube-3d-face--back {
      transform: rotateX(180deg) translateZ(0.8125rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cube-3d-flipper {
      animation: none !important;
    }
  }
</style>

<script>
  (function () {
    function formatMoney(cents) {
      return (cents / 100).toLocaleString('{{ localization.language.iso_code }}' || 'en-US', {
        style: 'currency',
        currency:
          (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) ||
          '{{ cart.currency.iso_code }}',
      });
    }

    document.addEventListener('variant:changed', function (e) {
      var v = e.detail && e.detail.variant;
      if (!v) return;

      var wrap = document.getElementById('disc-badge-wrap');
      var pctEl = document.getElementById('disc-badge-pct');
      var savAmtEl = document.getElementById('disc-badge-savings-amount');
      var eurAmt = document.getElementById('disc-badge-eur-amount');
      if (!wrap) return;

      var hasDiscount = v.compare_at_price && v.compare_at_price > v.price;

      if (hasDiscount) {
        var pct = Math.floor(((v.compare_at_price - v.price) * 100) / v.compare_at_price);
        var savings = v.compare_at_price - v.price;

        wrap.classList.remove('badge-wrap-3d--hidden');
        wrap.setAttribute('aria-hidden', 'false');

        if (pctEl) pctEl.textContent = pct;
        if (eurAmt) eurAmt.textContent = formatMoney(savings);
        if (savAmtEl) savAmtEl.textContent = formatMoney(savings);
      } else {
        wrap.classList.add('badge-wrap-3d--hidden');
        wrap.setAttribute('aria-hidden', 'true');
      }
    });
  })();
</script>