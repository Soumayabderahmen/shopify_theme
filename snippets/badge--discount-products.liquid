                <svg class="pill-badge__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4.09 12.11a1.5 1.5 0 0 0 1.14 2.45h4.77l-2.09 7.54a1.5 1.5 0 0 0 2.63 1.28l8.91-10.11a1.5 1.5 0 0 0-1.14-2.45h-4.77l2.09-7.54A1.5 1.5 0 0 0 13 2Z"/></svg>
                {{ text_savings }} <strong id="disc-badge-eur-amount">{{ savings_amount | money }}</strong>
              </span>
            {%- else -%}
              <span class="pill-badge pill-badge--discount">
                −<span id="disc-badge-pct">{{ discount_pct }}</span>%
              </span>
              <span class="pill-badge-savings" id="disc-badge-savings">
                <span class="disc-badge-savings__text">{{ text_savings }}</span> <strong id="disc-badge-savings-amount">{{ savings_amount | money }}</strong>
              </span>
            {%- endif -%}
          </div>
        </div>

        <!-- FACCIA 2 (180°): NOVITÀ / NEW ARRIVAL -->
        {% comment %} <div class="cube-3d-face cube-3d-face--back">
          <span class="pill-badge pill-badge--new">
            <span class="pill-badge__fire">🔥</span>
            {{ text_new }}
          </span>
        </div> {% endcomment %}
        <!-- FACCIA 2 (180°): NOVITÀ / NEW ARRIVAL -->
<div class="cube-3d-face cube-3d-face--back">
  <span class="pill-badge pill-badge--new">
    <span class="pill-badge__sparkle">✨</span>
    {{ text_new }}
  </span>
</div>

      </div>
    </div>

  {%- else -%}
    {%- comment -%} === BADGE STATICO (Solo Sconto) === {%- endcomment -%}
    <div class="discount-combined-group">
      {%- if is_high_price -%}
        <span class="pill-badge pill-badge--discount">
          <svg class="pill-badge__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4.09 12.11a1.5 1.5 0 0 0 1.14 2.45h4.77l-2.09 7.54a1.5 1.5 0 0 0 2.63 1.28l8.91-10.11a1.5 1.5 0 0 0-1.14-2.45h-4.77l2.09-7.54A1.5 1.5 0 0 0 13 2Z"/></svg>
          {{ text_savings }} <strong>{{ savings_amount | money }}</strong>
        </span>
      {%- else -%}
        <span class="pill-badge pill-badge--discount">
          −{{ discount_pct }}%
        </span>
        <span class="pill-badge-savings">
          {{ text_savings }} <strong>{{ savings_amount | money }}</strong>
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<style>
  /* === WRAPPER PRINCIPALE RESPONSIVE === */
  .badge-wrap-3d {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    vertical-align: middle;
  }

  .badge-wrap-3d--hidden {
    display: none !important;
  }

  /* GRAFICA GRUPPO SCONTO + RISPARMI */
  .discount-combined-group {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  /* === STILE BADGE === */
  .pill-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    height: 1.875rem; /* 30px */
    padding: 0 0.75rem;
    border-radius: 0.35rem;
    font-size: 0.875rem; /* 14px */
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .pill-badge--discount {
    background: linear-gradient(135deg, #e11d48, #be123c);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(225, 29, 72, 0.25);
  }

.pill-badge--new {
  background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
  color: #ffffff;
  letter-spacing: 0.05em;
  padding: 0 0.85rem; /* Padding maggiorato */
  border-radius: 0.4rem;
  border: 1px solid rgba(255, 255, 255, 0.3); /* Bordino di luce */
  box-shadow: 0 4px 12px rgba(56, 189, 248, 0.35); /* Glow azzurro */
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
}


.pill-badge__sparkle {
  font-size: 0.85rem;
  margin-right: 0.2rem;
  display: inline-block;
  animation: pulseSparkle 2s infinite ease-in-out;
}

/* Effetto di pulsazione sulla stella */
@keyframes pulseSparkle {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.2); opacity: 1; }
}



  .pill-badge__icon {
    width: 1rem;
    height: 1rem;
  }

  .pill-badge__fire {
    font-size: 0.9rem;
  }

  /* TESTO RISPARMI */
  .pill-badge-savings {
    font-size: 0.875rem; /* 14px */
    color: #374151;
    white-space: nowrap;
    font-weight: 500;
  }

  .pill-badge-savings strong {
    color: #e11d48;
    font-weight: 800;
  }

  /* === ROTAZIONE 360 GRADI 3D === */
.cube-3d-scene {
  perspective: 800px;
  height: 2rem; /* Altezza sufficiente per non tagliare il badge */
  display: inline-flex;
  align-items: center;
}

.cube-3d-flipper {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  animation: rotate360Cube 8s cubic-bezier(0.68, -0.15, 0.265, 1.15) infinite;
}

  .cube-3d-face {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Posizionamento Facce 3D */
  .cube-3d-face--front {
    transform: rotateX(0deg) translateZ(0.9375rem);
  }

  .cube-3d-face--back {
    transform: rotateX(180deg) translateZ(0.9375rem);
  }

  /* Keyframe Animazione 0° -> 180° -> 360° */
  @keyframes rotate360Cube {
    0%, 35% {
      transform: rotateX(0deg);
    }
    50%, 85% {
      transform: rotateX(180deg);
    }
    100% {
      transform: rotateX(360deg);
    }
  }

  /* === MEDIA QUERIES (MOBILE RESPONSIVE) === */
  @media (max-width: 480px) {
    .pill-badge {
      height: 1.625rem; /* 26px su mobile */
      padding: 0 0.55rem;
      font-size: 0.775rem;
    }
    .pill-badge-savings {
      font-size: 0.775rem;
    }
    .cube-3d-scene {
      height: 1.625rem;
    }
    .cube-3d-face--front {
      transform: rotateX(0deg) translateZ(0.8125rem);
    }
    .cube-3d-face--back {
      transform: rotateX(180deg) translateZ(0.8125rem);
    }
  }

  /* Accessibilità Riduzione Movimento */
  @media (prefers-reduced-motion: reduce) {
    .cube-3d-flipper {
      animation: none !important;
    }
  }
</style>

