        calc((100vw * 0.6) * 0.2)
      {% else %}
        calc((100vw * 0.6) * 0.{{ img_width }})
      {% endif %}
    {% else %}
      {%- if img_width == 100 -%}
        calc(100vw * 0.2)
      {% else %}
        calc(100vw * 0.{{ img_width }})
      {% endif %}
    {% endif %}
  ,
  (min-width: 760px)
    {% if slider %}
      calc(100vw * 0.3)
    {% else %}
      320px
    {% endif %}
  ,
  170px
{%- endcapture -%}

{% if matched_brand != "" %}
