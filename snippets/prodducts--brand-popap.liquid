 

{% comment %} 
{% assign target_brands = "nike, adidas, puma, reebok, new balance, onemix, jordan, asics" | split: ", " %}
{% assign product_title_lower = product.title | downcase %}
{% assign matched_brand = "" %}

{% for brand in target_brands %}
  {% if product_title_lower contains brand %}
    {% assign matched_brand = brand | capitalize %}
    {% break %}
  {% endif %}
{% endfor %}

{% case request.locale.iso_code %}
  {% when 'it' %}
    {% capture badge_text %}Negozio Ufficiale del Marchio: {{ matched_brand }} · Garanzia di qualità{% endcapture %}
    {% assign title_text = "Negozio Ufficiale del Marchio" %}
    {% assign review_text = "Revisione qualifiche" %}
    {% assign auth_text = "Certificazione autorizzata" %}
    {% assign quality_text = "Dichiarazione di qualità" %}
    {% assign delivery_title = "Marchio con spedizione veloce" %}
    {% assign delivery_sub = "Spedizione più veloce della media." %}
    {% assign more_from_text = "Altri prodotti da" %}
  {% when 'es' %}
    {% capture badge_text %}Tienda Oficial de la Marca: {{ matched_brand }} · Garantía de calidad{% endcapture %}
    {% assign title_text = "Tienda Oficial de la Marca" %}
    {% assign review_text = "Revisión de cualificación" %}
    {% assign auth_text = "Certificación de autorización" %}
    {% assign quality_text = "Declaración de calidad" %}
    {% assign delivery_title = "Marca con envío rápido" %}
    {% assign delivery_sub = "Envío más rápido que la media." %}
    {% assign more_from_text = "Más de" %}
  {% when 'fr' %}
    {% capture badge_text %}Boutique Officielle de la Marque : {{ matched_brand }} · Assurance qualité{% endcapture %}
    {% assign title_text = "Boutique Officielle de la Marque" %}
    {% assign review_text = "Examen des qualifications" %}
    {% assign auth_text = "Certification d'autorisation" %}
    {% assign quality_text = "Déclaration de qualité" %}
    {% assign delivery_title = "Marque à livraison rapide" %}
    {% assign delivery_sub = "Livraison plus rapide que la moyenne." %}
    {% assign more_from_text = "Plus de" %}
  {% when 'de' %}
    {% capture badge_text %}Offizieller Marken-Store: {{ matched_brand }} · Qualitätssicherung{% endcapture %}
    {% assign title_text = "Offizieller Marken-Store" %}
    {% assign review_text = "Qualifikationsprüfung" %}
    {% assign auth_text = "Autorisierungszertifikat" %}
    {% assign quality_text = "Qualitätserklärung" %}
    {% assign delivery_title = "Schnelle Lieferung Marke" %}
    {% assign delivery_sub = "Schnellere Lieferung als der Durchschnitt." %}
    {% assign more_from_text = "Mehr von" %}
  {% else %}
    {% capture badge_text %}Brand Official Store: {{ matched_brand }} · Quality assurance{% endcapture %}
    {% assign title_text = "Brand Official Store" %}
    {% assign review_text = "Qualification Review" %}
    {% assign auth_text = "Authorization Certification" %}
    {% assign quality_text = "Quality Statement" %}
    {% assign delivery_title = "Fast Delivery Brand" %}
    {% assign delivery_sub = "Faster delivery than average." %}
    {% assign more_from_text = "More from" %}
{% endcase %}

{% if matched_brand != "" %}
  <!-- Trigger Banner -->
  <div class="brand-badges-container">
    <div class="badge badge-store" id="brandPopupTrigger" role="button" tabindex="0">
      <div class="badge-content">
        <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="badge-text">{{ badge_text }}</span>
      </div>
      <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  </div>

  <!-- Drawer Fullscreen Overlay -->
  <div class="brand-drawer-overlay" id="brandDrawerOverlay" aria-hidden="true">
    <div class="brand-drawer-container">
      
      <div class="drawer-drag-handle"></div>

      <!-- Header Drawer -->
      <div class="brand-drawer-header">
        <h3>{{ title_text }}: {{ matched_brand }}</h3>
        <div class="brand-drawer-close" id="brandDrawerClose" role="button" tabindex="0">&times;</div>
      </div>

      <div class="brand-drawer-body">
        <!-- Feature Cards -->
        <div class="brand-features-grid">
          <div class="feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>{{ review_text }}</span>
          </div>
          <div class="feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            <span>{{ auth_text }}</span>
          </div>
          <div class="feature-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            <span>{{ quality_text }}</span>
          </div>
        </div>

        <!-- Banner Spedizione -->
        <div class="brand-delivery-card">
          <div class="delivery-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <strong>{{ delivery_title }}</strong>
          </div>
          <p>{{ delivery_sub }}</p>
        </div>

        <!-- Sezione Prodotti -->
        <div class="brand-products-section">
          <h4>{{ more_from_text }} {{ matched_brand }}</h4>
          
          <ul class="brand-products-grid">
            {% assign brand_lower = matched_brand | downcase %}
            {% assign current_product_id = product.id %}
            {% assign product_count = 0 %}

            {% assign source_collection = product.collections.first | default: collections.all %}

            {% for brand_product in source_collection.products %}
              {% assign b_title = brand_product.title | downcase %}
              
              {% if b_title contains brand_lower and brand_product.id != current_product_id %}
                {% assign product_count = product_count | plus: 1 %}
                {% capture placeholder_int %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}

                <li class="brand-product-card">
                  {% render 'product-item', 
                    product: brand_product, 
                    placeholder_int: placeholder_int, 
                    enable_quick_buy_desktop: section.settings.enable_quick_buy_desktop, 
                    enable_quick_buy_mobile: section.settings.enable_quick_buy_mobile, 
                    enable_quick_buy_qty_selector: section.settings.enable_quick_buy_qty_selector, 
                    quick_buy_compact: section.settings.enable_quick_buy_compact, 
                    enable_quick_buy_drawer: section.settings.enable_quick_buy_drawer, 
                    sizes: '150px', 
                    enable_color_picker: section.settings.enable_color_picker, 
                    no_lazyload: false 
                  %}
                </li>

                {% if product_count >= 8 %}
                  {% break %}
                {% endif %}
              {% endif %}
            {% endfor %}
          </ul>
        </div>

      </div>
    </div>
  </div>
{% endif %}

<style>
  .brand-badges-container {
    margin: 12px 0;
    width: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .badge-store {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 10px 14px;
    border-radius: 6px;
    background-color: #382418;
    color: #e5c3a6;
    cursor: pointer;
    user-select: none;
    box-sizing: border-box;
    transition: background-color 0.2s ease;
  }

  .badge-store:hover {
    background-color: #2e1d13;
  }

  .badge-content {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .badge-text {
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .badge-icon, .arrow-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: #e5c3a6;
  }

  /* Fixed Overlay Fullscreen */
  .brand-drawer-overlay {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(0, 0, 0, 0.65) !important;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 2147483647 !important;
    display: flex !important;
    justify-content: center;
    align-items: flex-end;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .brand-drawer-overlay.is-active {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .drawer-drag-handle {
    width: 40px;
    height: 4px;
    background: #5a3c28;
    border-radius: 2px;
    margin: 8px auto 4px auto;
    flex-shrink: 0;
  }

  .brand-drawer-container {
    background: #2b1a10;
    color: #f2e3d5;
    width: 100%;
    max-width: 900px;
    max-height: 85vh;
    border-radius: 18px 18px 0 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.8);
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }

  .brand-drawer-overlay.is-active .brand-drawer-container {
    transform: translateY(0) !important;
  }

  .brand-drawer-header {
    padding: 12px 20px 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #4a3222;
  }

  .brand-drawer-header h3 {
    margin: 0;
    font-size: 15px;
    color: #ffffff;
    font-weight: 600;
  }

  .brand-drawer-close {
    color: #e5c3a6;
    font-size: 26px;
    cursor: pointer;
    line-height: 1;
    user-select: none;
  }

  .brand-drawer-body {
    padding: 16px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .brand-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    margin-bottom: 14px;
  }

  .feature-item {
    background: #3d2719;
    padding: 10px 12px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    border: 1px solid #4a3222;
  }

  .feature-item svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: #e5c3a6;
  }

  .brand-delivery-card {
    background: #3d2719;
    padding: 10px 12px;
    border-radius: 6px;
    margin-bottom: 20px;
    border: 1px solid #4a3222;
  }

  .delivery-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    margin-bottom: 2px;
  }

  .delivery-title svg {
    width: 15px;
    height: 15px;
    color: #e5c3a6;
  }

  .brand-delivery-card p {
    margin: 0;
    font-size: 11px;
    color: #bfa895;
  }

  .brand-products-section h4 {
    margin: 0 0 12px 0;
    font-size: 14px;
    color: #ffffff;
  }

  /* Griglia Responsive: 2 colonne Mobile, 4 colonne Desktop */
  .brand-products-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 12px !important;
    padding: 0 !important;
    margin: 0 !important;
    list-style: none !important;
  }

  @media (min-width: 768px) {
    .brand-products-grid {
      grid-template-columns: repeat(4, 1fr) !important;
    }
  }

  /* Styling Schede Prodotto Professionali con Border-Radius 90px */
  .brand-product-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  /* Raggio del bordo a 90px per le immagini */
  .brand-product-card img,
  .brand-product-card .product-item-image,
  .brand-product-card picture {
    border-radius: 90px !important;
    overflow: hidden !important;
    object-fit: cover !important;
    max-width: 100% !important;
  }

  .brand-product-card * {
    max-width: 100%;
    box-sizing: border-box;
  }
</style>

<script>
  (function() {
    function initBrandDrawer() {
      const trigger = document.getElementById('brandPopupTrigger');
      const overlay = document.getElementById('brandDrawerOverlay');
      const closeBtn = document.getElementById('brandDrawerClose');

      if (!trigger || !overlay) return;

      if (overlay.parentNode !== document.body) {
        document.body.appendChild(overlay);
      }

      function openDrawer() {
        overlay.classList.add('is-active');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        overlay.classList.remove('is-active');
        document.body.style.overflow = '';
      }

      trigger.addEventListener('click', openDrawer);

      if (closeBtn) {
        closeBtn.addEventListener('click', closeDrawer);
      }

      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) {
          closeDrawer();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBrandDrawer);
    } else {
      initBrandDrawer();
    }
  })();
</script> 


