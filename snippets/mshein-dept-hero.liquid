{%- comment -%}
  Bannière d'un rayon (mobile) au design de la bannière de l'accueil (sections/mobile-home-hero.liquid, prototype
  « Home-mobile-B ») : accrochée à l'en-tête, nombre d'articles, nom du rayon, sa description, « Vedi tutto » et 3 photos de
  ses produits (une grande en haut, une à côté, une petite en bas) qui entrent, flottent et changent toutes les 5 s ;
  puis la carte « Pagamenti sicuri » et les avantages qui défilent (snippets/mhh-pay-ann.liquid).
  Photos : ses meilleures ventes (ordre de « Più venduti »), complétées par ses produits.
  Utilisée par la page du rayon (snippets/mshein-dept.liquid) et, à l'avance, par l'accueil et les pages collection
  (snippets/mshein-tab-heroes.liquid) : la bannière s'affiche dès le toucher d'un onglet, identique à l'arrivée du rayon.
  Styles et script : assets/mobile-home-hero.css / .js.
  Params : collection, best (collection « Più venduti »), title (nom du rayon dans le menu), is_all (Tutti i Prodotti)
  sale (true : rayon « In offerta » : produits en promotion, sans nombre d'articles, lien vers la page « offerte »)
{%- endcomment -%}
{%- liquid
  assign hero_title = title | default: collection.title
  assign hero_url = collection.url
  if sale
    assign hero_url = routes.all_products_collection_url | append: '?view=offerte&sort_by=best-selling'
  endif

  # Jusqu'à 9 photos (3 jeux de 3) : « Più venduti » présentes dans le rayon (toutes pour Tutti i Prodotti), puis ses produits
  assign seen_ids = ','
  assign photo_count = 0
  assign photos_json = ''
  assign first_images = ''
  for best_product in best.products limit: 120
    if photo_count >= 9
      break
    endif
    if is_all == false
      assign best_handles = best_product.collections | map: 'handle'
      unless best_handles contains collection.handle
        continue
      endunless
    endif
    assign hero_variant = best_product.selected_or_first_available_variant
    if sale
      unless hero_variant.compare_at_price > hero_variant.price
        continue
      endunless
    endif
    assign hero_image = hero_variant.featured_image | default: best_product.featured_image
    if hero_image == blank
      continue
    endif
    assign seen_ids = seen_ids | append: best_product.id | append: ','
    assign hero_src = hero_image | image_url: width: 320
    if photos_json != ''
      assign photos_json = photos_json | append: ','
    endif
    assign u_json = best_product.url | json
    assign i_json = hero_src | json
    assign photos_json = photos_json | append: '{"u":' | append: u_json | append: ',"i":' | append: i_json | append: '}'
    if photo_count < 3
      assign first_images = first_images | append: hero_src | append: '|' | append: best_product.url | append: '||'
    endif
    assign photo_count = photo_count | plus: 1
  endfor
  if photo_count < 9
    for hero_product in collection.products limit: 40
      if photo_count >= 9
        break
      endif
      assign hero_key = ',' | append: hero_product.id | append: ','
      if seen_ids contains hero_key
        continue
      endif
      assign hero_variant = hero_product.selected_or_first_available_variant
      if sale
        unless hero_variant.compare_at_price > hero_variant.price
          continue
        endunless
      endif
      assign hero_image = hero_variant.featured_image | default: hero_product.featured_image
      if hero_image == blank
        continue
      endif
      assign hero_src = hero_image | image_url: width: 320
      if photos_json != ''
        assign photos_json = photos_json | append: ','
      endif
      assign u_json = hero_product.url | json
      assign i_json = hero_src | json
      assign photos_json = photos_json | append: '{"u":' | append: u_json | append: ',"i":' | append: i_json | append: '}'
      if photo_count < 3
        assign first_images = first_images | append: hero_src | append: '|' | append: hero_product.url | append: '||'
      endif
      assign photo_count = photo_count | plus: 1
    endfor
  endif
  assign first_list = first_images | split: '||'

  # Textes : nombre d'articles (ou « Offerte della settimana »), nom du rayon (dernier mot en lavande), sa description
  if sale
    assign hero_eb = 'mobile_home_hero.eb2' | t
  else
    assign hero_eb = 'mobile.cart.items_other' | t: count: collection.all_products_count
  endif
  assign title_words = hero_title | escape | split: ' '
  if title_words.size > 1
    assign title_rest_size = title_words.size | minus: 1
    assign hero_title_html = title_words | slice: 0, title_rest_size | join: ' ' | append: ' <span>' | append: title_words.last | append: '</span>'
  else
    assign hero_title_html = '<span>' | append: title_words.first | append: '</span>'
  endif
  assign hero_text = collection.description | strip_html | strip | truncatewords: 10, '…'
  if hero_text == '' or is_all
    assign hero_text = 'mobile_home_hero.text1' | t
  endif
  assign hero_cta = 'mobile.category.view_all' | t
  assign shipping_amount = ''
  if settings.enable_free_shipping and settings.free_shipping_amount > 0
    assign shipping_amount = settings.free_shipping_amount | times: 100 | money_without_trailing_zeros | strip_html
  endif
-%}
<div class="mhh mhh--dept" data-mhh>
  <div class="mhh__dots" aria-hidden="true"><i class="on"></i><i></i><i></i></div>
  <div class="mhh__txt" data-mhh-txt>
    <span class="mhh__eb"><i></i><span data-mhh-eb>{{ hero_eb }}</span></span>
    <h2 data-mhh-title>{{ hero_title_html }}</h2>
    <p data-mhh-text>{{ hero_text | escape }}</p>
    <a class="mhh__btn" href="{{ hero_url }}" data-mhh-btn><span data-mhh-cta>{{ hero_cta }}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a>
  </div>
  <div class="mhh__art" aria-hidden="true">
    {%- for slot in (1..3) -%}
      {%- assign first = first_list[forloop.index0] | split: '|' -%}
      <a class="mhh-fl mhh-fl--{{ slot }}" href="{{ first[1] | default: hero_url }}" tabindex="-1"><span class="mhh-fl__in">{%- if first[0] != blank -%}<img src="{{ first[0] }}" alt="" width="200" height="260" loading="eager">{%- endif -%}</span></a>
    {%- endfor -%}
  </div>
  <div class="mhh__usp">
    {%- if shipping_amount != '' -%}<span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M1 5h13v11H1zM14 9h4l3 3v4h-7"/><circle cx="5.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/></svg>{{ 'desktop_home_shop.usp_shipping_html' | t: amount: shipping_amount }}</span>{%- endif -%}
    <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg>{{ 'desktop_home_shop.usp_return_html' | t }}</span>
    <span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>{{ 'desktop_home_shop.usp_klarna_html' | t }}</span>
  </div>
  <script type="application/json" data-mhh-data>
    {
      "slides": [{ "eb": {{ hero_eb | json }}, "title": {{ hero_title_html | json }}, "text": {{ hero_text | json }}, "cta": {{ hero_cta | json }}, "url": {{ hero_url | json }} }],
      "products": [{{ photos_json }}]
    }
  </script>
</div>
{%- render 'mhh-pay-ann' -%}
