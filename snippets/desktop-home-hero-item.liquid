{%- comment -%}
  Produit d'une diapositive de la bannière de l'accueil ordinateur (sections/desktop-home-shein.liquid, prototype v8) :
  photo, prix en pastille, remise en haut à gauche. Clic : sa fiche produit (assets/desktop-home-shein.js).
  Params : product
{%- endcomment -%}
{%- liquid
  assign item_variant = product.selected_or_first_available_variant
  assign item_image = item_variant.featured_image | default: product.featured_image
  assign item_pct = 0
  if item_variant.compare_at_price > item_variant.price
    assign item_pct = item_variant.compare_at_price | minus: item_variant.price | times: 100 | divided_by: item_variant.compare_at_price
  endif
-%}
<span class="dhs-slide__item" data-href="{{ product.url }}" title="{{ product.title | escape }}">
  {%- if item_image != blank -%}<img src="{{ item_image | image_url: width: 300, height: 360, crop: 'center' }}" alt="{{ product.title | escape }}" width="150" height="180" loading="lazy">{%- endif -%}
  <span class="dhs-slide__price">{{ item_variant.price | money }}</span>
  {%- if item_pct > 0 -%}<span class="dhs-slide__off">-{{ item_pct }}%</span>{%- endif -%}
</span>
