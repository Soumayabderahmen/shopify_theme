<!-- Hidden element for React to hook onto -->
<!-- Hidden element for React behavior -->
<div id="react-nav-behavior" style="display: none;"></div>

<!-- React via CDN + react-router-dom with useNavigate -->
<script type="module">
  import React, { useEffect } from 'https://esm.sh/react@18';
  import { createRoot } from 'https://esm.sh/react-dom@18/client';
  import { BrowserRouter, useNavigate } from 'https://esm.sh/react-router-dom@6';

  function NavigationBehavior() {
    const navigate = useNavigate();

    useEffect(() => {
      // Find all links generated by Liquid inside your navigation
      const navLinks = document.querySelectorAll('.mobile-bottom-navigation a');

      const handleLinkClick = (event) => {
        event.preventDefault(); // Stop default browser action
        const targetUrl = event.currentTarget.getAttribute('href');
        
        if (targetUrl) {
          // Execute navigation using the hook
          navigate(targetUrl);
        }
      };

      // Attach event listeners
      navLinks.forEach((link) => {
        link.addEventListener('click', handleLinkClick);
      });

      // Cleanup listeners on unmount
      return () => {
        navLinks.forEach((link) => {
          link.removeEventListener('click', handleLinkClick);
        });
      };
    }, [navigate]);

    // Returns no HTML
    return null;
  }

  // Wrapper component with BrowserRouter to provide the routing context
  function App() {
    return React.createElement(
      BrowserRouter,
      null,
      React.createElement(NavigationBehavior)
    );
  }

  // Mount directly in the browser
  const container = document.getElementById('react-nav-behavior');
  if (container) {
    const root = createRoot(container);
    root.render(React.createElement(App));
  }
</script>