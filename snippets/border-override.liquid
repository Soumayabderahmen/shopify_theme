{%- comment -%}
  Renders border override CSS
{%- endcomment -%}

--border-width: {{ settings.border_width }}px; --border-style: {{ settings.border }}; --border-color: var(--custom_bd);
--border-opacity: {{ settings.border_opacity | default: 100 | divided_by: 100.0 }};
--border-radius: {{ settings.border_radius }}px; {% if settings.border_radius > 0 %} overflow: hidden; {% endif %}
