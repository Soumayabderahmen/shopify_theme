{%- comment -%}
  Panneau "My Wishlist" (mobile) : s'ouvre depuis la droite au tap sur le cœur du header mobile.
  Contenu rendu par assets/mobile-temu-header.js à partir de la wishlist stockée en localStorage.
{%- endcomment -%}
{%- assign wishlist_page_url = pages['wishlist'].url | default: '/pages/wishlist' -%}
<link rel="stylesheet" href="{{ 'mobile-wishlist-drawer.css' | asset_url }}" media="(max-width: 760px)">
{%- comment -%} Le thème force dialog { display: block } : on masque le panneau hors mobile. {%- endcomment -%}
<style>@media (min-width: 761px) { #mobile-wishlist-drawer { display: none !important; } }</style>
<dialog
  id="mobile-wishlist-drawer"
  class="mobile-wishlist-drawer"
  aria-labelledby="mobile-wishlist-drawer-title"
  data-mobile-wishlist-drawer
>
  <div class="mobile-wishlist-drawer__head">
    <div>
      <h2 id="mobile-wishlist-drawer-title">{{ 'mobile.wishlist.my_wishlist' | t }} <span data-wishlist-drawer-count>0</span></h2>
      <p data-wishlist-drawer-subtitle></p>
    </div>
    <button class="mobile-wishlist-drawer__close" type="button" aria-label="{{ 'mobile.common.close' | t }}" data-wishlist-drawer-close>
      <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
  </div>

  <div class="mobile-wishlist-drawer__body" data-wishlist-drawer-body>
    <p class="mobile-wishlist-drawer__drop" data-wishlist-drawer-drop hidden>
      <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M3 7l6 6 4-4 8 8"></path><path d="M15 17h6v-6"></path></svg>
      <span data-wishlist-drawer-drop-text></span>
    </p>
    <ul class="mobile-wishlist-drawer__list" data-wishlist-drawer-list></ul>
    <div class="mobile-wishlist-drawer__empty" data-wishlist-drawer-empty hidden>
      <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"></path></svg>
      <h3>{{ 'mobile.wishlist.empty' | t }}</h3>
      <p>{{ 'mobile.wishlist.empty_text' | t }}</p>
      <a class="mobile-wishlist-drawer__cta" href="{{ routes.all_products_collection_url }}">{{ 'mobile.wishlist.discover' | t }}</a>
    </div>
    <section class="mobile-wishlist-drawer__reco" data-wishlist-drawer-reco hidden>
      <h4>{{ 'mobile.common.you_may_like' | t }}</h4>
      <div class="mobile-wishlist-drawer__rail" data-wishlist-drawer-reco-list></div>
    </section>
  </div>

  <div class="mobile-wishlist-drawer__foot" data-wishlist-drawer-foot hidden>
    <div class="mobile-wishlist-drawer__total">
      <span data-wishlist-drawer-total-label>{{ 'mobile.wishlist.total' | t }}</span>
      <b data-wishlist-drawer-total></b>
    </div>
    <button class="mobile-wishlist-drawer__add-all" type="button" data-wishlist-drawer-add-all>{{ 'mobile.wishlist.add_all' | t }}</button>
  </div>
  <a class="mobile-wishlist-drawer__more" href="{{ wishlist_page_url }}">{{ 'mobile.wishlist.see_full' | t }}</a>

  <div class="mobile-wishlist-drawer__toast" role="status" aria-live="polite" data-wishlist-drawer-toast>
    <span data-wishlist-drawer-toast-text></span>
    <button type="button" data-wishlist-drawer-undo hidden>{{ 'mobile.common.undo' | t }}</button>
  </div>
</dialog>
