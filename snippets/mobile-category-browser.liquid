{%- liquid
  # Libellés dans la langue du visiteur (clés mobile.category.* des fichiers locales).
  assign featured_label = 'mobile.category.featured' | t
  assign shop_label = 'mobile.category.shop_by' | t
  assign view_all_label = 'mobile.category.view_all' | t
  assign new_label = 'mobile.category.new' | t

-%}
{%- comment -%} Code de la devise après les prix quand « $ » est ambigu (« $94.00 CAD »). {%- endcomment -%}
{%- capture mm_cur -%}{% render 'mobile-money-suffix' %}{%- endcapture -%}

{%- if menu != blank -%}
  {%- assign hot_collection = collections['bestsellers'] -%}
  {%- assign new_collection = collections['new-arrivals'] -%}
  {%- for menu_link in menu.links -%}
    {%- assign menu_link_title = menu_link.title | strip | downcase -%}
    {%- if menu_link_title == 'più venduti' or menu_link_title == 'piu venduti' -%}
      {%- if menu_link.object.products != blank -%}
        {%- assign hot_collection = menu_link.object -%}
      {%- endif -%}
    {%- elsif menu_link_title == 'nuovi arrivi' or menu_link_title == 'novità' or menu_link_title == 'novita' -%}
      {%- if menu_link.object.products != blank -%}
        {%- assign new_collection = menu_link.object -%}
      {%- endif -%}
    {%- endif -%}
    {%- for child_link in menu_link.links -%}
      {%- assign child_link_title = child_link.title | strip | downcase -%}
      {%- if child_link_title == 'più venduti' or child_link_title == 'piu venduti' -%}
        {%- if child_link.object.products != blank -%}
          {%- assign hot_collection = child_link.object -%}
        {%- endif -%}
      {%- elsif child_link_title == 'nuovi arrivi' or child_link_title == 'novità' or child_link_title == 'novita' -%}
        {%- if child_link.object.products != blank -%}
          {%- assign new_collection = child_link.object -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- comment -%}
    Panneau Categoria (prototype « chiara-liens ») : il s'ouvre juste sous le vrai header du site (☰, logo, ♡,
    panier, recherche, liens du menu), qui reste visible au-dessus ; le panneau n'a donc pas son propre en-tête.
    Liste des rayons à gauche, produits réels à droite. Mobile uniquement (assets/mobile-temu-header.css/.js).
  {%- endcomment -%}
  <section class="mobile-category-browser" data-mobile-category-browser hidden aria-hidden="true" data-category-loaded="true" role="dialog" aria-modal="true" aria-label="{{ 'mobile.category.dialog' | t }}" tabindex="-1">
    <svg class="mobile-category-browser__defs" aria-hidden="true" focusable="false" width="0" height="0">
      <defs>
        <linearGradient id="mobile-category-view-all-gradient" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#7c76ff"></stop>
          <stop offset="1" stop-color="#3a34d2"></stop>
        </linearGradient>
      </defs>
    </svg>
    <div class="mobile-category-browser__body">
    <aside class="mobile-category-browser__sidebar">
      <div class="mobile-category-browser__tabs" role="tablist" aria-label="{{ featured_label }}">
        <a href="#mobile-category-panel-featured" role="tab" class="mobile-category-browser__tab mobile-category-browser__featured is-active" aria-selected="true" aria-controls="mobile-category-panel-featured" data-category-tab="mobile-category-panel-featured">{{ featured_label }}</a>
        {%- assign category_index = 0 -%}
        {%- for main_link in menu.links -%}
          {%- for category_link in main_link.links -%}
            {%- unless category_link.title contains 'Novità' or category_link.title contains 'Novita' -%}
              {%- assign category_index = category_index | plus: 1 -%}
              {%- liquid
                assign category_title = category_link.title
                unless category_link.title contains main_link.title
                  if main_link.title == 'Donna' or main_link.title == 'Uomo' or main_link.title == 'Casa & Giardino' or main_link.title == 'Trendsi'
                    assign category_title = category_link.title | append: ' ' | append: main_link.title
                  endif
                  endunless
              -%}
              <a href="#mobile-category-panel-{{ category_index }}" role="tab" class="mobile-category-browser__tab" aria-selected="false" aria-controls="mobile-category-panel-{{ category_index }}" data-category-tab="mobile-category-panel-{{ category_index }}">{{ category_title | strip }}</a>
            {%- endunless -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- for main_link in menu.links -%}
          {%- assign main_link_title_normalized = main_link.title | strip | downcase -%}
          {%- if main_link.title == 'Abbigliamento Cinese' or main_link.title == 'Animal Print & Pet' or main_link.title == 'Bici/Monopattini' -%}
            {%- unless main_link_title_normalized contains 'novità' or main_link_title_normalized contains 'novita' or main_link_title_normalized contains 'new arrival' -%}
            {%- assign category_index = category_index | plus: 1 -%}
            <a href="#mobile-category-panel-{{ category_index }}" role="tab" class="mobile-category-browser__tab" aria-selected="false" aria-controls="mobile-category-panel-{{ category_index }}" data-category-tab="mobile-category-panel-{{ category_index }}">{{ main_link.title | escape }}</a>
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </aside>

    <div class="mobile-category-browser__main">
      <div class="mobile-category-browser__heading">
        <h2>{{ shop_label }}</h2>
        {%- comment -%}
          « Novità › » : dans le panneau, affiche les nouveautés du rayon choisi (In evidenza : collection « Nuovi
          arrivi » ; autres rayons : leur collection triée par date d'ajout). Nouveau toucher = retour à la liste du
          rayon. L'adresse sert seulement si le script n'est pas chargé.
        {%- endcomment -%}
        <a href="{% if new_collection != blank %}{{ new_collection.url }}{% else %}{{ routes.all_products_collection_url }}?sort_by=created-descending{% endif %}" class="mobile-category-browser__deferred-note" aria-pressed="false" data-category-new-toggle>{{ new_label }} ›</a>
      </div>
      {%- capture view_all_icon -%}<span class="mobile-category-card__image"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect class="q q1" x="3.4" y="3.4" width="7.4" height="7.4" rx="2.5" fill="url(#mobile-category-view-all-gradient)"></rect><rect class="q q2" x="13.2" y="3.4" width="7.4" height="7.4" rx="2.5" fill="#3a34d2" fill-opacity=".26"></rect><rect class="q q3" x="3.4" y="13.2" width="7.4" height="7.4" rx="2.5" fill="#3a34d2" fill-opacity=".26"></rect><rect class="q q4" x="13.2" y="13.2" width="7.4" height="7.4" rx="2.5" fill="url(#mobile-category-view-all-gradient)"></rect></svg></span>{%- endcapture -%}
      {%- comment -%}
        « In evidenza » : les 12 premiers produits sont écrits directement ici (affichage immédiat à l'ouverture,
        sans « Caricamento… ») ; la suite (page 2, 3…) est chargée par le bouton « Vedi più » / au défilement.
        Images en data-src : téléchargées seulement à l'ouverture du panneau.
      {%- endcomment -%}
      <div id="mobile-category-panel-featured" class="mobile-category-browser__panel mobile-category-browser__panel--featured is-active" role="tabpanel" data-products-loaded="true">
        <a href="{% if hot_collection != blank %}{{ hot_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="mobile-category-card mobile-category-card--view-all">
          {{ view_all_icon }}
          <span class="mobile-category-card__title">{{ view_all_label }}</span>
        </a>
        {%- if hot_collection != blank -%}
          {%- comment -%} Sans l'attribut data-mobile-category-products : il doit rester unique dans les pages
            « ?view=mobile-category » (le script y cherche la liste des produits de la collection demandée). {%- endcomment -%}
          <div class="mobile-category-products">
            {%- for hot_product in hot_collection.products limit: 12 -%}
              <a href="{{ hot_product.url }}" class="mobile-category-card">
                <span class="mobile-category-card__image">
                  {%- if hot_product.featured_image != blank -%}
                    <img data-src="{{ hot_product.featured_image | image_url: width: 184, height: 184, crop: 'center' }}" alt="{{ hot_product.featured_image.alt | default: hot_product.title | escape }}" width="120" height="120">
                  {%- else -%}
                    <span aria-hidden="true">{{ hot_product.title | slice: 0, 1 | upcase }}</span>
                  {%- endif -%}
                  <em>HOT</em>
                </span>
                <span class="mobile-category-card__title">{{ hot_product.title | escape }}</span>
              </a>
            {%- endfor -%}
            {%- if hot_collection.products_count > 12 -%}
              <a href="{{ hot_collection.url }}?page=2&view=mobile-category" class="mobile-category-products__more" data-category-products-more>{{ 'mobile.category.see_more' | t }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      <div id="mobile-category-panel-new" class="mobile-category-browser__panel mobile-category-browser__panel--animated" role="tabpanel" data-deferred-products{% if new_collection != blank %} data-category-products-endpoint="{{ new_collection.url }}?view=mobile-category"{% endif %} hidden>
        {%- if new_collection != blank -%}
          <a href="{{ new_collection.url }}" class="mobile-category-card mobile-category-card--view-all">
            {{ view_all_icon }}
            <span class="mobile-category-card__title">{{ view_all_label }}</span>
          </a>
        {%- endif -%}
      </div>

      {%- assign category_index = 0 -%}
      {%- for main_link in menu.links -%}
        {%- for category_link in main_link.links -%}
          {%- unless category_link.title contains 'Novità' or category_link.title contains 'Novita' -%}
            {%- assign category_index = category_index | plus: 1 -%}
            <div id="mobile-category-panel-{{ category_index }}" class="mobile-category-browser__panel" role="tabpanel"{% if category_link.links.size > 0 %} data-category-products-endpoint="{{ category_link.url }}?view=mobile-category"{% else %} data-products-loaded="true"{% endif %} hidden>
            <a href="{{ category_link.url }}" class="mobile-category-card mobile-category-card--view-all">
              <span class="mobile-category-card__image"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect class="q q1" x="3.4" y="3.4" width="7.4" height="7.4" rx="2.5" fill="url(#mobile-category-view-all-gradient)"></rect><rect class="q q2" x="13.2" y="3.4" width="7.4" height="7.4" rx="2.5" fill="#3a34d2" fill-opacity=".26"></rect><rect class="q q3" x="3.4" y="13.2" width="7.4" height="7.4" rx="2.5" fill="#3a34d2" fill-opacity=".26"></rect><rect class="q q4" x="13.2" y="13.2" width="7.4" height="7.4" rx="2.5" fill="url(#mobile-category-view-all-gradient)"></rect></svg></span>
              <span class="mobile-category-card__title">{{ view_all_label }}</span>
            </a>
            {%- if category_link.links.size > 0 -%}
              {%- for subcategory_link in category_link.links -%}
                {%- assign subcategory_title_normalized = subcategory_link.title | strip | downcase -%}
                {%- unless subcategory_title_normalized contains 'novità' or subcategory_title_normalized contains 'novita' or subcategory_title_normalized contains 'new arrival' -%}
                  {%- liquid
                    assign category_image = subcategory_link.object.featured_image
                    if category_image == blank
                      assign category_image = subcategory_link.object.image
                    endif
                    if category_image == blank
                      assign category_image = subcategory_link.object.products.first.featured_image
                    endif
                  -%}
                  <a href="{{ subcategory_link.url }}" class="mobile-category-card">
                    <span class="mobile-category-card__image">
                      {%- if category_image != blank -%}
                          <img data-src="{{ category_image | image_url: width: 184, height: 184, crop: 'center' }}" alt="{{ category_image.alt | default: subcategory_link.title | escape }}" width="120" height="120">
                        {%- else -%}
                          <span aria-hidden="true">{{ subcategory_link.title | slice: 0, 1 | upcase }}</span>
                        {%- endif -%}
                    </span>
                    <span class="mobile-category-card__title">{{ subcategory_link.title | escape }}</span>
                  </a>
                {%- endunless -%}
              {%- endfor -%}
            {%- else -%}
              {%- for category_product in category_link.object.products limit: 12 -%}
                <a href="{{ category_product.url }}" class="mobile-category-card">
                  <span class="mobile-category-card__image">
                    {%- if category_product.featured_image != blank -%}
                      <img data-src="{{ category_product.featured_image | image_url: width: 184, height: 184, crop: 'center' }}" alt="{{ category_product.featured_image.alt | default: category_product.title | escape }}" width="120" height="120">
                    {%- else -%}
                      <span aria-hidden="true">{{ category_product.title | slice: 0, 1 | upcase }}</span>
                    {%- endif -%}
                  </span>
                  <span class="mobile-category-card__title">{{ category_product.title | escape }}</span>
                </a>
              {%- endfor -%}
              {%- if category_link.object.products_count > 12 -%}
                <a href="{{ category_link.url }}?page=2&view=mobile-category" class="mobile-category-products__more" data-category-products-more>{{ 'mobile.category.see_more' | t }}</a>
              {%- endif -%}
            {%- endif -%}
            </div>
          {%- endunless -%}
        {%- endfor -%}
      {%- endfor -%}

      {%- for main_link in menu.links -%}
        {%- if main_link.title == 'Abbigliamento Cinese' or main_link.title == 'Animal Print & Pet' or main_link.title == 'Bici/Monopattini' -%}
          {%- assign category_index = category_index | plus: 1 -%}
          <div id="mobile-category-panel-{{ category_index }}" class="mobile-category-browser__panel" role="tabpanel" data-products-loaded="true" hidden>
            <a href="{{ main_link.url }}" class="mobile-category-card mobile-category-card--view-all">
              <span class="mobile-category-card__image"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect class="q q1" x="3.4" y="3.4" width="7.4" height="7.4" rx="2.5" fill="url(#mobile-category-view-all-gradient)"></rect><rect class="q q2" x="13.2" y="3.4" width="7.4" height="7.4" rx="2.5" fill="#3a34d2" fill-opacity=".26"></rect><rect class="q q3" x="3.4" y="13.2" width="7.4" height="7.4" rx="2.5" fill="#3a34d2" fill-opacity=".26"></rect><rect class="q q4" x="13.2" y="13.2" width="7.4" height="7.4" rx="2.5" fill="url(#mobile-category-view-all-gradient)"></rect></svg></span>
              <span class="mobile-category-card__title">{{ view_all_label }}</span>
            </a>
            {%- for category_product in main_link.object.products limit: 12 -%}
              <a href="{{ category_product.url }}" class="mobile-category-card">
                <span class="mobile-category-card__image">
                  {%- if category_product.featured_image != blank -%}
                    <img data-src="{{ category_product.featured_image | image_url: width: 184, height: 184, crop: 'center' }}" alt="{{ category_product.featured_image.alt | default: category_product.title | escape }}" width="120" height="120">
                  {%- else -%}
                    <span aria-hidden="true">{{ category_product.title | slice: 0, 1 | upcase }}</span>
                  {%- endif -%}
                </span>
                <span class="mobile-category-card__title">{{ category_product.title | escape }}</span>
              </a>
            {%- endfor -%}
            {%- if main_link.object.products_count > 12 -%}
              <a href="{{ main_link.url }}?page=2&view=mobile-category" class="mobile-category-products__more" data-category-products-more>{{ 'mobile.category.see_more' | t }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    </div>
  </section>

  <dialog
    id="mobile-explore-drawer"
    class="mobile-explore-drawer"
    aria-modal="true"
    aria-label="{{ 'mobile.explore.title' | t }}"
    data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
    aria-hidden="true"
    inert
    data-mobile-explore-drawer
  >
    <button class="mobile-explore-drawer__close" type="button" aria-label="{{ 'mobile.explore.close' | t }}" data-mobile-explore-close>
      <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="m6 6 12 12M18 6 6 18"></path></svg>
    </button>
    <div class="mobile-explore-drawer__scroll">
      <div class="mobile-explore-drawer__heading">
        <strong>{{ 'mobile.explore.title' | t }}</strong>
        <span>{{ 'mobile.explore.subtitle' | t }}</span>
      </div>

      <section class="mobile-explore-section mobile-explore-section--recent" data-mobile-explore-recent hidden>
        <div class="mobile-explore-section__title">
          <h2>👀 {{ 'mobile.explore.recently_viewed' | t }}</h2>
          <button type="button" data-mobile-explore-recent-clear>{{ 'mobile.explore.clear' | t }}</button>
        </div>
        <div class="mobile-explore-rail mobile-explore-rail--products" data-mobile-explore-recent-products></div>
      </section>

      {%- assign current_month = 'now' | date: '%m' | plus: 0 -%}
      {%- liquid
        if current_month == 12 or current_month <= 2
          assign current_season = 'mobile.explore.winter' | t
          assign season_class = 'inverno'
          assign seasonal_handles = 'piumini,sweatshirt,casa-giardino' | split: ','
          assign season_sheet_handles = 'piumini,sweatshirt,casa-giardino,pelle-e-pellicce,womens-boots,felpe_donna,felpe-novita,giacche_donna,giacche_smart,giacche-ragazza-luxury,jogger-pantaloni-donna,leggings_donna,leggings-uomo,calze' | split: ','
        elsif current_month <= 5
          assign current_season = 'mobile.explore.spring' | t
          assign season_class = 'primavera'
          assign seasonal_handles = 'new-trends,mocassini,abbigliamento-cinese-2026' | split: ','
          assign season_sheet_handles = 'new-trends,mocassini,abbigliamento-cinese-2026,giacche_smart,gonne,abiti-corti,magliette,t-shirt-carino,casual-sneakers-sneakers-casual,platform-sneakers-sneakers-con-zeppa,borse-tote,crossbody-bags-borse-a-tracolla,sport,bici-monopattini' | split: ','
        elsif current_month <= 8
          assign current_season = 'mobile.explore.summer' | t
          assign season_class = 'estate'
          assign seasonal_handles = 'mare-spiaggia,set-uomo-estate,borse-da-spiaggia,casa-giardino' | split: ','
          assign season_sheet_handles = 'mare-spiaggia,set-uomo-estate,borse-da-spiaggia,casa-giardino,abbigliamento-estate-2025-bikini-costumi,abbigliamento-mare-donna-elegante,ciabatte-summer,sandali-premium,tacco-a-zeppa,pantaloncini_donna,abiti-corti,asciugamani-summer,ombrelloni-mare,accessori-spiaggia-bambini,ventilatori' | split: ','
        else
          assign current_season = 'mobile.explore.autumn' | t
          assign season_class = 'autunno'
          assign seasonal_handles = 'piumini,sweatshirt,new-trends,casa-giardino' | split: ','
          assign season_sheet_handles = 'piumini,sweatshirt,new-trends,casa-giardino,felpe_donna,felpe-novita,giacche_donna,giacche_smart,giacche-ragazza-luxury,pelle-e-pellicce,womens-boots,mocassini,jogger-pantaloni-donna,leggings_donna,leggings-uomo,calze' | split: ','
        endif
        assign seasonal_collection_count = 0
        for seasonal_handle in seasonal_handles
          assign seasonal_collection = collections[seasonal_handle]
          if seasonal_collection != blank and seasonal_collection.products_count > 0
            assign seasonal_collection_count = seasonal_collection_count | plus: 1
          endif
        endfor
      -%}
      {%- if seasonal_collection_count > 0 -%}
        <section class="mobile-explore-section">
          <div class="mobile-explore-section__title">
            <h2>{{ 'mobile.explore.collections' | t }} <span class="mobile-explore-tag mobile-explore-tag--season mobile-explore-tag--season-{{ season_class }}">{{ current_season | escape }}</span></h2>
            <button type="button" class="mobile-explore-section__more" aria-haspopup="dialog" data-mobile-season-open>{{ 'mobile.explore.see_all_f' | t }}</button>
          </div>
          <div class="mobile-explore-rail mobile-explore-rail--collections">
            {%- for seasonal_handle in seasonal_handles -%}
              {%- liquid
                assign seasonal_collection = collections[seasonal_handle]
                assign explore_image = seasonal_collection.featured_image
                if explore_image == blank
                  assign explore_image = seasonal_collection.image
                endif
              -%}
              {%- if seasonal_collection != blank and seasonal_collection.products_count > 0 -%}
                <a class="mobile-explore-collection" href="{{ seasonal_collection.url }}">
                  {%- if explore_image != blank -%}
                    <img
                      src="{{ explore_image | image_url: width: 560, height: 747, crop: 'center' }}"
                      alt="{{ explore_image.alt | default: seasonal_collection.title | escape }}"
                      width="280"
                      height="374"
                      loading="lazy"
                    >
                  {%- else -%}
                    <span class="mobile-explore-collection__placeholder" aria-hidden="true">{{ seasonal_collection.title | slice: 0, 1 | upcase }}</span>
                  {%- endif -%}
                  <span class="mobile-explore-collection__caption"><strong>{{ seasonal_collection.title | escape }}</strong></span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}

      {%- assign sale_collection = collections['in-offerta'] -%}
      {%- if sale_collection == blank -%}
        {%- assign sale_collection = collections['all'] -%}
      {%- endif -%}
      {%- assign sale_product_count = 0 -%}
      {%- if sale_collection != blank -%}
        {%- for sale_product in sale_collection.products -%}
          {%- assign sale_variant = sale_product.selected_or_first_available_variant -%}
          {%- if sale_variant.compare_at_price > sale_variant.price and sale_product_count < 8 -%}
            {%- assign sale_product_count = sale_product_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      <section class="mobile-explore-section">
        <div class="mobile-explore-section__title">
          <h2>🔥 {{ 'mobile.explore.on_sale' | t }}</h2>
          <a href="{% if sale_collection.handle == 'in-offerta' %}{{ sale_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ 'mobile.explore.see_all_f' | t }}</a>
        </div>
        {%- if sale_product_count > 0 -%}
          <div class="mobile-explore-rail mobile-explore-rail--products">
            {%- assign displayed_sale_products = 0 -%}
            {%- for explore_product in sale_collection.products -%}
              {%- assign sale_variant = explore_product.selected_or_first_available_variant -%}
              {%- if sale_variant.compare_at_price > sale_variant.price and displayed_sale_products < 8 -%}
                {%- assign displayed_sale_products = displayed_sale_products | plus: 1 -%}
                {%- assign discount_amount = sale_variant.compare_at_price | minus: sale_variant.price | times: 100.0 | divided_by: sale_variant.compare_at_price | floor -%}
                <a class="mobile-explore-product mobile-explore-product--sale" href="{{ explore_product.url }}">
                  <span class="mobile-explore-product__image">
                    {%- if explore_product.featured_image != blank -%}
                      <img
                        src="{{ explore_product.featured_image | image_url: width: 320, height: 320, crop: 'center' }}"
                        alt="{{ explore_product.featured_image.alt | default: explore_product.title | escape }}"
                        width="160"
                        height="160"
                        loading="lazy"
                      >
                    {%- endif -%}
                    <span>-{{ discount_amount }}%</span>
                  </span>
                  <span>{{ explore_product.title | escape }}</span>
                  <strong>{{ sale_variant.price | money }}{{ mm_cur }} <s>{{ sale_variant.compare_at_price | money }}{{ mm_cur }}</s></strong>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </section>

      {%- comment -%}
        Marques de la boutique (rangée défilante à gauche / à droite) : toutes celles citées dans le titre d'au moins un
        produit (relevé sur les ~10 000 produits du catalogue, 424 marques), triées par nombre de produits.
        Les 20 premières sont dans la rangée ; « Voir plus » ouvre la fenêtre de toutes les marques, remplie par
        assets/mobile-temu-header.js depuis assets/mobile-brands.json à sa première ouverture (page plus légère).
        Format : Nom|recherche|collection(s)|photo d'un vrai produit de la marque (image du CDN Shopify).
        Avec une collection (nike, adidas, reebok/rebok, trendsi) : lien et photo de la collection ;
        sinon : recherche limitée au titre / fabricant / type (pas aux descriptions) et la photo du produit.
        La photo est donnée par son adresse : Liquid ne peut charger que 20 produits par page avec all_products.
      {%- endcomment -%}
      {%- capture brand_list -%}
        Nike|Nike|nike|https://cdn.shopify.com/s/files/1/0942/1570/0821/files/S8ae372f4eb054239af3a39d4ab0519c9c.webp?v=1789041250;
        Adidas|Adidas|adidas|https://cdn.shopify.com/s/files/1/0942/1570/0821/files/Sb2a7e163022348678537978674dc3b70O.webp?v=1787106256;
        Pagani Design|Pagani||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/S494ed60da18945f6bb26fa6fec9215a0h.webp?v=1786155997;
        Trendsi|Trendsi|trendsi|https://cdn.shopify.com/s/files/1/0942/1570/0821/files/b8948d205ec24624946946ea202d0cdd-Max-Origin.webp?v=1788908801;
        Onemix|Onemix||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/S8c461582ea554035af236b0384985f7ca.webp?v=1787106240;
        Zadorin|Zadorin||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/S6992ddc59d5d4c4cb796da09b202c7cfE.webp?v=1789457559;
        Jordan|Jordan||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/S3593772eb42c40448289dde1bdc0be8fw.webp?v=1786839410;
        Skechers|Skechers||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/E13183651770342249d0781f12861a4ddq.webp?v=1790629864;
        Reebok|Reebok|reebok,rebok|https://cdn.shopify.com/s/files/1/0942/1570/0821/files/S30566c6a807047c2a5ab2e9484c887bc0.webp?v=1788907538;
        Misako|Misako||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/Ecc50eb0b55954a2baa82c709411fe2f5B.webp?v=1786849291;
        Olevs|Olevs||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/Sb90a3a8249024123b43ad4e7985c9050F.webp?v=1779607883;
        Poedagar|Poedagar||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/S33c965aa1b0348f1a470f476e74c34e4L.webp?v=1790623750;
        Xti|Xti||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/E5873467178854783a86ec3a9017fd10bn.webp?v=1790629831;
        Joma|Joma||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/E84f5c97d947440888060bd6251d31237t.webp?v=1790629474;
        Addiesdive|Addiesdive||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/Sf406106133044cf6b0a1b8d54ed05457t.webp?v=1790623677;
        Mustang|Mustang||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/Eaf21cc09fc7c48ca8de4ff148a1ebd80R.webp?v=1790629686;
        AddiesKin|AddiesKin||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/Sd4a0e061117341aaa58b55f18da4aacb9.webp?v=1790623676;
        Xtep|Xtep||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/Sfb6b6f82cd2149398ec16f0d84729e37P.webp?v=1787106229;
        Liyke|Liyke||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/Sb448ffb35ef64938aaa2fcd0f7f3521dK.webp?v=1778891350;
        Tous|Tous||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/E84fa3a6652534ff8a638cd4c4023f5d19.webp?v=1786930592;
        Lige|Lige||https://cdn.shopify.com/s/files/1/0942/1570/0821/files/S8738fe98c50142dd8c1dd35ab4d74fe9u.webp?v=1779602758
      {%- endcapture -%}
      {%- assign brand_entries = brand_list | split: ';' -%}
      <section class="mobile-explore-section">
        <div class="mobile-explore-section__title">
          <h2>{{ 'mobile.explore.brands' | t }}</h2>
          <button type="button" class="mobile-explore-section__more" aria-haspopup="dialog" data-mobile-brands-open>{{ 'mobile.explore.see_more_brands' | t }}</button>
        </div>
        <div class="mobile-explore-brands" aria-label="{{ 'mobile.explore.scroll_brands' | t }}">
          {%- for brand_entry in brand_entries -%}
            {%- liquid
                assign brand_parts = brand_entry | strip | split: '|'
                assign brand_label = brand_parts[0]
                assign brand_query = brand_parts[1]
                assign brand_collection = blank
                assign brand_collection_handles = brand_parts[2] | split: ','
                for brand_collection_handle in brand_collection_handles
                  if brand_collection == blank and collections[brand_collection_handle].products_count > 0
                    assign brand_collection = collections[brand_collection_handle]
                  endif
                endfor
                assign brand_image = blank
                if brand_collection != blank
                  assign brand_image = brand_collection.featured_image
                  if brand_image == blank
                    assign brand_image = brand_collection.image
                  endif
                  if brand_image == blank and brand_collection.products.first != blank
                    assign brand_image = brand_collection.products.first.featured_image
                  endif
                endif
                assign brand_image_url = blank
                if brand_image == blank and brand_parts[3] != blank
                  assign brand_image_url = brand_parts[3] | strip | append: '&width=240&height=148&crop=center'
                endif
                assign brand_query = brand_query | url_encode
                assign brand_url = routes.search_url | append: '?q=' | append: brand_query | append: '&type=product&options%5Bfields%5D=title%2Cvendor%2Cproduct_type'
                if brand_collection != blank
                  assign brand_url = brand_collection.url
                endif
            -%}
            <a href="{{ brand_url }}" class="mobile-explore-brand">
              {%- if brand_image != blank -%}
                <img
                  src="{{ brand_image | image_url: width: 240, height: 148, crop: 'center' }}"
                  alt=""
                  width="120"
                  height="74"
                  loading="lazy"
                >
              {%- elsif brand_image_url != blank -%}
                <img src="{{ brand_image_url }}" alt="" width="120" height="74" loading="lazy" onerror="this.remove()">
              {%- endif -%}
              <strong>{{ brand_label | escape }}</strong>
            </a>
          {%- endfor -%}
          <button type="button" class="mobile-explore-brand mobile-explore-brand--more" aria-haspopup="dialog" data-mobile-brands-open>
            <strong>{{ 'mobile.explore.see_more_brands' | t }}</strong>
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="m9 6 6 6-6 6"></path></svg>
          </button>
        </div>
      </section>

      {%- assign occasion_handles = 'scarpe-sport-uomo,borse-da-spiaggia,tacco-alto' | split: ',' -%}
      {%- assign occasion_labels = 'mobile.explore.occasion_labels' | t | split: ',' -%}
      {%- assign occasion_collection_count = 0 -%}
      {%- for occasion_handle in occasion_handles -%}
        {%- assign occasion_collection = collections[occasion_handle] -%}
        {%- if occasion_collection != blank and occasion_collection.products_count > 0 -%}
          {%- assign occasion_collection_count = occasion_collection_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign halloween_collection = collections['anime-cosplay'] -%}
      {%- assign current_month = 'now' | date: '%m' | plus: 0 -%}
      {%- if current_month == 10 or occasion_collection_count > 0 -%}
        <section class="mobile-explore-section">
          <div class="mobile-explore-section__title"><h2>{{ 'mobile.explore.occasions' | t }}</h2></div>
          {%- if current_month == 10 and halloween_collection != blank and halloween_collection.products_count > 0 -%}
            <a class="mobile-explore-halloween" href="{{ halloween_collection.url }}">
              <span><small>🎃 {{ 'mobile.explore.halloween_date' | t }}</small><strong>Anime &amp; Cosplay</strong><em>{{ 'mobile.explore.halloween_text' | t }}</em></span>
              <span class="mobile-explore-halloween__images">
                {%- for halloween_product in halloween_collection.products limit: 2 -%}
                  {%- if halloween_product.featured_image != blank -%}
                    <img
                      src="{{ halloween_product.featured_image | image_url: width: 108, height: 144, crop: 'center' }}"
                      alt="{{ halloween_product.title | escape }}"
                      width="54"
                      height="72"
                      loading="lazy"
                    >
                  {%- endif -%}
                {%- endfor -%}
              </span>
            </a>
          {%- endif -%}
          {%- if occasion_collection_count > 0 -%}
            <div class="mobile-explore-occasions">
              {%- for occasion_handle in occasion_handles -%}
                {%- assign occasion_collection = collections[occasion_handle] -%}
                {%- if occasion_collection != blank and occasion_collection.products_count > 0 -%}
                  {%- liquid
                    assign occasion_image = occasion_collection.featured_image
                    if occasion_image == blank
                      assign occasion_image = occasion_collection.image
                    endif
                    if occasion_image == blank
                      assign occasion_image = occasion_collection.products.first.featured_image
                    endif
                  -%}
                  <a class="mobile-explore-occasion" href="{{ occasion_collection.url }}">
                    <span class="mobile-explore-occasion__image-wrap">
                      {%- if occasion_image != blank -%}
                        <img
                          src="{{ occasion_image | image_url: width: 360, height: 360, crop: 'center' }}"
                          alt="{{ occasion_image.alt | default: occasion_collection.title | escape }}"
                          width="180"
                          height="180"
                          loading="lazy"
                        >
                      {%- endif -%}
                    </span>
                    <b>{{ occasion_labels[forloop.index0] | escape }}</b>
                    {%- assign occasion_label = occasion_labels[forloop.index0] -%}
                    {%- unless occasion_collection.title == occasion_label -%}
                      <small>{{ occasion_collection.title | escape }}</small>
                    {%- endunless -%}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </section>
      {%- endif -%}

      {%- assign gifts_for_him = collections['regali-per-lui'] -%}
      {%- assign gifts_for_her = collections['regali-per-lei'] -%}
      {%- assign gift_month = 'now' | date: '%m' | plus: 0 -%}
      {%- if gift_month >= 11 and gift_month <= 12 -%}
        <section class="mobile-explore-section">
          <div class="mobile-explore-section__title">
            <h2>🎁 {{ 'mobile.explore.gift_ideas' | t }} <span class="mobile-explore-tag mobile-explore-tag--gift">{{ 'mobile.explore.christmas' | t }}</span></h2>
          </div>
          <div class="mobile-explore-gifts">
            {%- comment -%} Le filtre de prix compte dans la devise du client (20 CHF, 20 CA$…) : même montant, au format de sa devise. {%- endcomment -%}
            {%- assign gift_under_amount = 2000 | money_without_trailing_zeros -%}
            <a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=20">
              <i aria-hidden="true">💝</i><strong>{{ 'mobile.explore.under_20' | t: amount: gift_under_amount }}</strong><small>{{ 'mobile.explore.small_gifts' | t }}</small>
            </a>
            {%- if gifts_for_him != blank and gifts_for_him.products_count > 0 -%}
              <a href="{{ gifts_for_him.url }}"><i aria-hidden="true">🧔</i><strong>{{ 'mobile.explore.for_him' | t }}</strong><small>{{ gifts_for_him.title | escape }}</small></a>
            {%- endif -%}
            {%- if gifts_for_her != blank and gifts_for_her.products_count > 0 -%}
              <a href="{{ gifts_for_her.url }}"><i aria-hidden="true">💃</i><strong>{{ 'mobile.explore.for_her' | t }}</strong><small>{{ gifts_for_her.title | escape }}</small></a>
            {%- endif -%}
          </div>
        </section>
      {%- endif -%}

      {%- if new_collection != blank and new_collection.products_count > 0 -%}
        <section class="mobile-explore-section">
          <div class="mobile-explore-section__title">
            <h2>{{ 'mobile.explore.new_arrivals' | t }} <span class="mobile-explore-tag">NEW</span></h2>
            <a href="{{ new_collection.url }}?sort_by=created-descending">{{ 'mobile.explore.see_all' | t }}</a>
          </div>
          <div class="mobile-explore-rail mobile-explore-rail--products" data-mobile-explore-new>
            {%- for explore_product in new_collection.products limit: 8 -%}
              {%- assign new_variant = explore_product.selected_or_first_available_variant -%}
              <a class="mobile-explore-product{% if new_variant.compare_at_price > new_variant.price %} mobile-explore-product--sale{% endif %}" href="{{ explore_product.url }}">
                <span class="mobile-explore-product__image">
                  {%- if explore_product.featured_image != blank -%}
                    <img
                      src="{{ explore_product.featured_image | image_url: width: 320, height: 320, crop: 'center' }}"
                      alt="{{ explore_product.featured_image.alt | default: explore_product.title | escape }}"
                      width="160"
                      height="160"
                      loading="lazy"
                    >
                  {%- endif -%}
                  {%- if new_variant.compare_at_price > new_variant.price -%}
                    {%- assign new_discount_amount = new_variant.compare_at_price | minus: new_variant.price | times: 100.0 | divided_by: new_variant.compare_at_price | floor -%}
                    <span>-{{ new_discount_amount }}%</span>
                  {%- endif -%}
                </span>
                <span>{{ explore_product.title | escape }}</span>
                <strong>
                  {{ new_variant.price | money }}{{ mm_cur }}
                  {%- if new_variant.compare_at_price > new_variant.price %} <s>{{ new_variant.compare_at_price | money }}{{ mm_cur }}</s>{% endif -%}
                </strong>
              </a>
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}

      {%- if hot_collection != blank and hot_collection.products_count > 0 -%}
        <section class="mobile-explore-section mobile-explore-section--top">
          <div class="mobile-explore-section__title">
            <h2>🏆 {{ 'mobile.explore.best_sellers' | t }}</h2>
            <a href="{{ hot_collection.url }}?sort_by=best-selling">{{ 'mobile.explore.see_all' | t }}</a>
          </div>
          <ol class="mobile-explore-top-products">
            {%- for explore_product in hot_collection.products limit: 3 -%}
              {%- assign top_variant = explore_product.selected_or_first_available_variant -%}
              <li>
                <a href="{{ explore_product.url }}">
                  <span class="mobile-explore-top-products__rank">{{ forloop.index }}</span>
                  {%- if explore_product.featured_image != blank -%}
                    <img
                      src="{{ explore_product.featured_image | image_url: width: 144, height: 144, crop: 'center' }}"
                      alt="{{ explore_product.featured_image.alt | default: explore_product.title | escape }}"
                      width="72"
                      height="72"
                      loading="lazy"
                    >
                  {%- endif -%}
                  <span class="mobile-explore-top-products__details">
                    <span>{{ explore_product.title | escape }}</span>
                    <strong>
                      {{ top_variant.price | money }}{{ mm_cur }}
                      {%- if top_variant.compare_at_price > top_variant.price %} <s>{{ top_variant.compare_at_price | money }}{{ mm_cur }}</s>{% endif -%}
                    </strong>
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ol>
        </section>
      {%- endif -%}

      <a class="mobile-explore-all-products" href="{{ routes.all_products_collection_url }}">{{ 'mobile.explore.all_products' | t }} <span aria-hidden="true">→</span></a>
    </div>

    <dialog
      class="mobile-brands-sheet"
      aria-labelledby="mobile-brands-sheet-title"
      data-mobile-explore-sheet
      data-mobile-brands-sheet
      data-brands-url="{{ 'mobile-brands.json' | asset_url }}"
    >
      <div class="mobile-brands-sheet__head">
        <h2 id="mobile-brands-sheet-title">{{ 'mobile.explore.all_brands' | t }} <span data-mobile-brands-count></span></h2>
        <button type="button" class="mobile-brands-sheet__close" aria-label="{{ 'mobile.common.close' | t }}" data-mobile-brands-close>
          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="m6 6 12 12M18 6 6 18"></path></svg>
        </button>
      </div>
      <label class="mobile-brands-sheet__search">
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input type="search" placeholder="{{ 'mobile.explore.search_brands' | t }}" aria-label="{{ 'mobile.explore.search_brands' | t }}" autocomplete="off" enterkeyhint="search" data-mobile-brands-filter>
      </label>
      <div class="mobile-brands-sheet__grid" data-mobile-brands-grid></div>
      <p class="mobile-brands-sheet__empty" data-mobile-brands-empty hidden>{{ 'mobile.explore.no_brands' | t }}</p>
    </dialog>

    {%- comment -%}
      « Vedi tutte » des collections de saison : toutes les vraies collections de la saison en cours
      (season_sheet_handles, choisies plus haut avec la saison), avec la photo de la collection ou de son premier produit.
    {%- endcomment -%}
    {%- if seasonal_collection_count > 0 -%}
      <dialog
        class="mobile-brands-sheet mobile-season-sheet"
        aria-labelledby="mobile-season-sheet-title"
        data-mobile-explore-sheet
        data-mobile-season-sheet
      >
        <div class="mobile-brands-sheet__head">
          <h2 id="mobile-season-sheet-title">{{ 'mobile.explore.collections' | t }} <span class="mobile-explore-tag mobile-explore-tag--season mobile-explore-tag--season-{{ season_class }}">{{ current_season | escape }}</span></h2>
          <button type="button" class="mobile-brands-sheet__close" aria-label="{{ 'mobile.common.close' | t }}" data-mobile-brands-close>
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="m6 6 12 12M18 6 6 18"></path></svg>
          </button>
        </div>
        <div class="mobile-brands-sheet__grid mobile-season-sheet__grid">
          {%- for season_handle in season_sheet_handles -%}
            {%- liquid
              assign season_collection = collections[season_handle]
              assign season_image = blank
              if season_collection != blank and season_collection.products_count > 0
                assign season_image = season_collection.featured_image
                if season_image == blank
                  assign season_image = season_collection.image
                endif
                if season_image == blank
                  assign season_image = season_collection.products.first.featured_image
                endif
              endif
            -%}
            {%- if season_collection != blank and season_collection.products_count > 0 -%}
              <a class="mobile-explore-collection" href="{{ season_collection.url }}">
                {%- if season_image != blank -%}
                  <img
                    src="{{ season_image | image_url: width: 400, height: 534, crop: 'center' }}"
                    alt="{{ season_image.alt | default: season_collection.title | escape }}"
                    width="200"
                    height="267"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="mobile-explore-collection__placeholder" aria-hidden="true">{{ season_collection.title | slice: 0, 1 | upcase }}</span>
                {%- endif -%}
                <span class="mobile-explore-collection__caption"><strong>{{ season_collection.title | escape }}</strong></span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </dialog>
    {%- endif -%}
  </dialog>
{%- endif -%}
