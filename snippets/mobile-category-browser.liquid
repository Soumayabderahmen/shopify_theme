      {%- assign brand_entries = brand_list | split: ';' -%}
      <section class="mobile-explore-section">
        <div class="mobile-explore-section__title"><h2>{{ 'mobile.explore.brands' | t }}</h2></div>
        <div class="mobile-explore-brands" aria-label="{{ 'mobile.explore.scroll_brands' | t }}">
          {%- for brand_entry in brand_entries -%}
            {%- liquid
                assign brand_parts = brand_entry | strip | split: '|'
                assign brand_label = brand_parts[0]
                assign brand_query = brand_parts[1]
                assign brand_collection = blank
                assign brand_collection_handles = brand_parts[2] | split: ','
                for brand_collection_handle in brand_collection_handles
                  if brand_collection == blank and collections[brand_collection_handle].products_count > 0
                    assign brand_collection = collections[brand_collection_handle]
                  endif
                endfor
                assign brand_image = blank
                if brand_collection != blank
                  assign brand_image = brand_collection.featured_image
                  if brand_image == blank
                    assign brand_image = brand_collection.image
                  endif
                  if brand_image == blank and brand_collection.products.first != blank
                    assign brand_image = brand_collection.products.first.featured_image
                  endif
                endif
                assign brand_image_url = blank
                if brand_image == blank and brand_parts[3] != blank
                  assign brand_image_url = brand_parts[3] | strip | append: '&width=240&height=148&crop=center'
                endif
                assign brand_query = brand_query | url_encode
                assign brand_url = routes.search_url | append: '?q=' | append: brand_query | append: '&type=product&options%5Bfields%5D=title%2Cvendor%2Cproduct_type'
                if brand_collection != blank
                  assign brand_url = brand_collection.url
                endif
            -%}
            <a href="{{ brand_url }}" class="mobile-explore-brand">
              {%- if brand_image != blank -%}
                <img
                  src="{{ brand_image | image_url: width: 240, height: 148, crop: 'center' }}"
                  alt=""
                  width="120"
                  height="74"
                  loading="lazy"
                >
              {%- elsif brand_image_url != blank -%}
                <img src="{{ brand_image_url }}" alt="" width="120" height="74" loading="lazy" onerror="this.remove()">
              {%- endif -%}
              <strong>{{ brand_label | escape }}</strong>
            </a>
          {%- endfor -%}
        </div>
      </section>

      {%- assign occasion_handles = 'scarpe-sport-uomo,borse-da-spiaggia,tacco-alto' | split: ',' -%}
      {%- assign occasion_labels = 'mobile.explore.occasion_labels' | t | split: ',' -%}
      {%- assign occasion_collection_count = 0 -%}
      {%- for occasion_handle in occasion_handles -%}
        {%- assign occasion_collection = collections[occasion_handle] -%}
        {%- if occasion_collection != blank and occasion_collection.products_count > 0 -%}
          {%- assign occasion_collection_count = occasion_collection_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign halloween_collection = collections['anime-cosplay'] -%}
      {%- assign current_month = 'now' | date: '%m' | plus: 0 -%}
      {%- if current_month == 10 or occasion_collection_count > 0 -%}
        <section class="mobile-explore-section">
          <div class="mobile-explore-section__title"><h2>{{ 'mobile.explore.occasions' | t }}</h2></div>
          {%- if current_month == 10 and halloween_collection != blank and halloween_collection.products_count > 0 -%}
            <a class="mobile-explore-halloween" href="{{ halloween_collection.url }}">
              <span><small>🎃 {{ 'mobile.explore.halloween_date' | t }}</small><strong>Anime &amp; Cosplay</strong><em>{{ 'mobile.explore.halloween_text' | t }}</em></span>
              <span class="mobile-explore-halloween__images">
                {%- for halloween_product in halloween_collection.products limit: 2 -%}
                  {%- if halloween_product.featured_image != blank -%}
                    <img
                      src="{{ halloween_product.featured_image | image_url: width: 108, height: 144, crop: 'center' }}"
                      alt="{{ halloween_product.title | escape }}"
                      width="54"
                      height="72"
                      loading="lazy"
                    >
                  {%- endif -%}
                {%- endfor -%}
              </span>
            </a>
          {%- endif -%}
          {%- if occasion_collection_count > 0 -%}
            <div class="mobile-explore-occasions">
              {%- for occasion_handle in occasion_handles -%}
                {%- assign occasion_collection = collections[occasion_handle] -%}
                {%- if occasion_collection != blank and occasion_collection.products_count > 0 -%}
                  {%- liquid
                    assign occasion_image = occasion_collection.featured_image
                    if occasion_image == blank
                      assign occasion_image = occasion_collection.image
                    endif
                    if occasion_image == blank
                      assign occasion_image = occasion_collection.products.first.featured_image
                    endif
                  -%}
                  <a class="mobile-explore-occasion" href="{{ occasion_collection.url }}">
                    <span class="mobile-explore-occasion__image-wrap">
                      {%- if occasion_image != blank -%}
                        <img
                          src="{{ occasion_image | image_url: width: 360, height: 360, crop: 'center' }}"
                          alt="{{ occasion_image.alt | default: occasion_collection.title | escape }}"
                          width="180"
                          height="180"
                          loading="lazy"
                        >
                      {%- endif -%}
                    </span>
                    <b>{{ occasion_labels[forloop.index0] | escape }}</b>
                    {%- assign occasion_label = occasion_labels[forloop.index0] -%}
                    {%- unless occasion_collection.title == occasion_label -%}
                      <small>{{ occasion_collection.title | escape }}</small>
                    {%- endunless -%}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </section>
      {%- endif -%}

      {%- assign gifts_for_him = collections['regali-per-lui'] -%}
      {%- assign gifts_for_her = collections['regali-per-lei'] -%}
      {%- assign gift_month = 'now' | date: '%m' | plus: 0 -%}
      {%- if gift_month >= 11 and gift_month <= 12 -%}
        <section class="mobile-explore-section">
          <div class="mobile-explore-section__title">
            <h2>🎁 {{ 'mobile.explore.gift_ideas' | t }} <span class="mobile-explore-tag mobile-explore-tag--gift">{{ 'mobile.explore.christmas' | t }}</span></h2>
          </div>
          <div class="mobile-explore-gifts">
            {%- comment -%} Le filtre de prix compte dans la devise du client (20 CHF, 20 CA$…) : même montant, au format de sa devise. {%- endcomment -%}
            {%- assign gift_under_amount = 2000 | money_without_trailing_zeros -%}
            <a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=20">
              <i aria-hidden="true">💝</i><strong>{{ 'mobile.explore.under_20' | t: amount: gift_under_amount }}</strong><small>{{ 'mobile.explore.small_gifts' | t }}</small>
            </a>
            {%- if gifts_for_him != blank and gifts_for_him.products_count > 0 -%}
              <a href="{{ gifts_for_him.url }}"><i aria-hidden="true">🧔</i><strong>{{ 'mobile.explore.for_him' | t }}</strong><small>{{ gifts_for_him.title | escape }}</small></a>
            {%- endif -%}
            {%- if gifts_for_her != blank and gifts_for_her.products_count > 0 -%}
              <a href="{{ gifts_for_her.url }}"><i aria-hidden="true">💃</i><strong>{{ 'mobile.explore.for_her' | t }}</strong><small>{{ gifts_for_her.title | escape }}</small></a>
            {%- endif -%}
          </div>
        </section>
      {%- endif -%}

      {%- if new_collection != blank and new_collection.products_count > 0 -%}
        <section class="mobile-explore-section">
          <div class="mobile-explore-section__title">
            <h2>{{ 'mobile.explore.new_arrivals' | t }} <span class="mobile-explore-tag">NEW</span></h2>
            <a href="{{ new_collection.url }}">{{ 'mobile.explore.see_all' | t }}</a>
          </div>
          <div class="mobile-explore-rail mobile-explore-rail--products">
            {%- for explore_product in new_collection.products limit: 8 -%}
              {%- assign new_variant = explore_product.selected_or_first_available_variant -%}
              <a class="mobile-explore-product{% if new_variant.compare_at_price > new_variant.price %} mobile-explore-product--sale{% endif %}" href="{{ explore_product.url }}">
                <span class="mobile-explore-product__image">
                  {%- if explore_product.featured_image != blank -%}
                    <img
                      src="{{ explore_product.featured_image | image_url: width: 320, height: 320, crop: 'center' }}"
                      alt="{{ explore_product.featured_image.alt | default: explore_product.title | escape }}"
                      width="160"
                      height="160"
                      loading="lazy"
                    >
                  {%- endif -%}
                  {%- if new_variant.compare_at_price > new_variant.price -%}
                    {%- assign new_discount_amount = new_variant.compare_at_price | minus: new_variant.price | times: 100.0 | divided_by: new_variant.compare_at_price | floor -%}
                    <span>-{{ new_discount_amount }}%</span>
                  {%- endif -%}
                </span>
                <span>{{ explore_product.title | escape }}</span>
                <strong>
                  {{ new_variant.price | money }}{{ mm_cur }}
                  {%- if new_variant.compare_at_price > new_variant.price %} <s>{{ new_variant.compare_at_price | money }}{{ mm_cur }}</s>{% endif -%}
                </strong>
              </a>
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}

      {%- if hot_collection != blank and hot_collection.products_count > 0 -%}
        <section class="mobile-explore-section mobile-explore-section--top">
          <div class="mobile-explore-section__title">
            <h2>🏆 {{ 'mobile.explore.best_sellers' | t }}</h2>
            <a href="{{ hot_collection.url }}">{{ 'mobile.explore.see_all' | t }}</a>
          </div>
          <ol class="mobile-explore-top-products">
            {%- for explore_product in hot_collection.products limit: 3 -%}
              {%- assign top_variant = explore_product.selected_or_first_available_variant -%}
              <li>
                <a href="{{ explore_product.url }}">
                  <span class="mobile-explore-top-products__rank">{{ forloop.index }}</span>
                  {%- if explore_product.featured_image != blank -%}
                    <img
                      src="{{ explore_product.featured_image | image_url: width: 144, height: 144, crop: 'center' }}"
                      alt="{{ explore_product.featured_image.alt | default: explore_product.title | escape }}"
                      width="72"
                      height="72"
                      loading="lazy"
                    >
                  {%- endif -%}
                  <span class="mobile-explore-top-products__details">
                    <span>{{ explore_product.title | escape }}</span>
                    <strong>
                      {{ top_variant.price | money }}{{ mm_cur }}
                      {%- if top_variant.compare_at_price > top_variant.price %} <s>{{ top_variant.compare_at_price | money }}{{ mm_cur }}</s>{% endif -%}
                    </strong>
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ol>
        </section>
      {%- endif -%}

      <a class="mobile-explore-all-products" href="{{ routes.all_products_collection_url }}">{{ 'mobile.explore.all_products' | t }} <span aria-hidden="true">→</span></a>
    </div>
  </dialog>
{%- endif -%}
