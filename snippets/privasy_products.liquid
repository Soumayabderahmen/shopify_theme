        border-color 0.2s ease,
        box-shadow 0.2s ease;
      text-align: center;
      -webkit-tap-highlight-color: transparent;
    }

    .ps-card:hover {
      background: #ffffff;
      border-color: #d1d5db;
      transform: translateY(-2px);
      box-shadow: 0 5px 14px rgba(15, 23, 42, 0.07);
    }

    .ps-card:active {
      background: #f3f4f6;
      transform: scale(0.96);
    }

    .ps-card svg {
      width: 22px;
      height: 22px;
      color: #059669;
      flex-shrink: 0;
    }

    .ps-card-label {
      font-size: 11px;
      font-weight: 600;
      color: #374151;
      line-height: 1.2;
    }


    /* =========================================================
       POPUP OVERLAY
       ========================================================= */

    .ps-overlay {
      display: none;
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;

      background: rgba(15, 23, 42, 0.55);

      z-index: 2147483646 !important;

      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);

      opacity: 0;

      transition:
        opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);

      pointer-events: none;
    }

    .ps-overlay.ps-active {
      display: block;
      opacity: 1;
      pointer-events: auto;
    }


    /* =========================================================
       PREMIUM DRAWER
       ========================================================= */

    .ps-drawer {
      position: fixed;

      left: 0;
      right: 0;
      bottom: 0;

      width: 100%;
      box-sizing: border-box;

      background: #f8fafc;

      border-radius: 26px 26px 0 0;

      z-index: 2147483647 !important;

      transform: translate3d(0, 100%, 0);

      transition:
        transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);

      max-height: 88vh;

      overflow-y: auto;

      -webkit-overflow-scrolling: touch;

      box-shadow:
        0 -12px 40px rgba(15, 23, 42, 0.18);

      will-change: transform;

      isolation: isolate;
    }

    .ps-drawer.ps-active {
      transform: translate3d(0, 0, 0);
    }


    /* =========================================================
       HANDLE
       ========================================================= */

    .ps-handle-wrap {
      display: flex;
      justify-content: center;

      padding: 12px 0 7px;

      position: sticky;
      top: 0;

      background: #f8fafc;

      z-index: 20;
    }

    .ps-handle {
      width: 38px;
      height: 4px;

      background: #cbd5e1;

      border-radius: 100px;
    }


    .ps-drawer-inner {
      padding: 4px 16px 0;
    }


    /* =========================================================
       PREMIUM HERO
       ========================================================= */

    .ps-drawer-hero {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 18px;

      padding: 12px 4px 20px;
    }

    .ps-drawer-hero-text {
      flex: 1;
      min-width: 0;
    }

    .ps-drawer-hero-text h2 {
      font-size: 20px;
      font-weight: 800;

      color: #0f172a;

      margin: 0 0 6px;

      line-height: 1.2;

      letter-spacing: -0.025em;
    }

    .ps-drawer-hero-text p {
      font-size: 13px;

      color: #64748b;

      margin: 0;

      line-height: 1.5;

      max-width: 280px;
    }


    /* =========================================================
       PREMIUM ICON
       ========================================================= */

    .ps-premium-icon {
      position: relative;

      width: 64px;
      height: 64px;

      min-width: 64px;

      display: flex;
      align-items: center;
      justify-content: center;

      background: linear-gradient(
        145deg,
        #ffffff 0%,
        #f1f5f9 100%
      );

      border: 1px solid #e2e8f0;

      border-radius: 18px;

      box-shadow:
        0 8px 20px rgba(15, 23, 42, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }

    .ps-premium-icon::after {
      content: "";

      position: absolute;

      width: 34px;
      height: 34px;

      border-radius: 50%;

      background: rgba(5, 150, 105, 0.08);
    }

    .ps-premium-icon svg {
      position: relative;

      z-index: 2;

      width: 29px;
      height: 29px;

      color: #059669;

      stroke-width: 1.8;
