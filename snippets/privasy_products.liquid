<!--
  =========================================================
  DATA
  =========================================================
-->

<script>
  var PS_DATA = {
    overview: {{ ps_body_overview | strip_newlines | json }},
    pagamenti: {{ ps_body_pagamenti | strip_newlines | json }},
    consegna: {{ ps_body_consegna | strip_newlines | json }},
    rimborso: {{ ps_body_rimborso | strip_newlines | json }},
    privacy: {{ ps_body_privacy | strip_newlines | json }}
  };


  /* =========================================================
     ORIGINAL DOM LOCATIONS
     ========================================================= */

  var PS_ORIGINAL_PARENT = {
    overlay: null,
    drawer: null
  };

  var PS_ORIGINAL_NEXT = {
    overlay: null,
    drawer: null
  };


  /* =========================================================
     MOVE POPUP DIRECTLY UNDER BODY
     ========================================================= */

  function psMoveToBody() {

    var overlay = document.getElementById('psOverlay');
    var drawer = document.getElementById('psDrawer');

    if (!overlay || !drawer) return;


    /*
     * Save original locations once.
     */

    if (!PS_ORIGINAL_PARENT.overlay) {

      PS_ORIGINAL_PARENT.overlay = overlay.parentNode;
      PS_ORIGINAL_NEXT.overlay = overlay.nextSibling;

    }

    if (!PS_ORIGINAL_PARENT.drawer) {

      PS_ORIGINAL_PARENT.drawer = drawer.parentNode;
      PS_ORIGINAL_NEXT.drawer = drawer.nextSibling;

    }


    /*
     * IMPORTANT:
     *
     * Moving the popup directly under BODY prevents Shopify
     * sections, theme wrappers, transforms and stacking contexts
     * from placing other elements above the popup.
     */

    if (overlay.parentNode !== document.body) {
      document.body.appendChild(overlay);
    }

    if (drawer.parentNode !== document.body) {
      document.body.appendChild(drawer);
    }
  }


  /* =========================================================
     OPEN
     ========================================================= */

  function psOpen(key) {

    var content = PS_DATA[key];

    if (!content) return;


    var overlay = document.getElementById('psOverlay');
    var drawer = document.getElementById('psDrawer');
    var drawerInner = document.getElementById('psDrawerInner');

    if (!overlay || !drawer || !drawerInner) return;


    /*
     * Move popup to BODY first.
     */

    psMoveToBody();


    /*
     * Insert selected content.
     */

    drawerInner.innerHTML = content;


    /*
     * Accessibility.
     */

    drawer.setAttribute('aria-hidden', 'false');


    /*
     * Show overlay.
     */

    overlay.style.display = 'block';


    /*
     * Force reflow for animation.
     */

    void overlay.offsetHeight;
    void drawer.offsetHeight;


    /*
     * Activate.
     */

    overlay.classList.add('ps-active');
    drawer.classList.add('ps-active');


    /*
     * Lock page scrolling.
     */

    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    document.documentElement.style.touchAction = 'none';
    document.body.style.touchAction = 'none';
  }


  /* =========================================================
     CLOSE
     ========================================================= */

  function psClose() {

    var overlay = document.getElementById('psOverlay');
    var drawer = document.getElementById('psDrawer');

    if (!overlay || !drawer) return;


    /*
     * Close animation.
     */

    overlay.classList.remove('ps-active');
    drawer.classList.remove('ps-active');

    drawer.setAttribute('aria-hidden', 'true');


    /*
     * Wait for animation.
     */

    setTimeout(function() {

      overlay.style.display = 'none';

      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';

      document.documentElement.style.touchAction = '';
      document.body.style.touchAction = '';

    }, 400);
  }


  /* =========================================================
     ESC KEY
     ========================================================= */

  document.addEventListener('keydown', function(e) {

    if (e.key === 'Escape') {
      psClose();
    }

  });


  /* =========================================================
     KEYBOARD ACCESS
     ========================================================= */

  document.addEventListener('keydown', function(e) {

    if (e.key !== 'Enter' && e.key !== ' ') return;

    var target = e.target;

    if (
      target.classList.contains('ps-card') ||
      target.classList.contains('ps-header')
    ) {

      e.preventDefault();

      var onclick = target.getAttribute('onclick');

      if (!onclick) return;

      var match = onclick.match(/psOpen\(['"]([^'"]+)['"]\)/);

      if (match && match[1]) {
        psOpen(match[1]);
      }
    }

  });


  /* =========================================================
     STOP DRAWER CLICKS
     ========================================================= */

  document.addEventListener(
    'click',
    function(e) {

      var drawer = document.getElementById('psDrawer');

      if (!drawer) return;

      if (drawer.contains(e.target)) {
        e.stopPropagation();
      }

    },
    true
  );


  /* =========================================================
     SHOPIFY SECTION LOAD
     ========================================================= */

  document.addEventListener(
    'shopify:section:load',
    function() {

      /*
       * Nothing needs to be moved while closed.
       *
       * psOpen() will move the popup to BODY when required.
       */

    }
  );
</script>
