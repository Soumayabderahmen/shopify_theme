{%- comment -%}
  Pages d'inscription aux e-mails de Shopify (lien de confirmation « /account/subscribe?token=… » et désinscription
  « /account/unsubscribe… ») en vraie page du site : bandeau pleine largeur, avantages, puis cartes produits « Più venduti »
  (snippets/mshein-card.liquid, les mêmes que partout). Shopify fournit le contenu (content) sans modèle de thème : on le
  garde tel quel en bas (le lien « Annulla l'iscrizione » porte le jeton du client).
  Rendu depuis layout/theme.liquid à la place de content_for_layout sur ces adresses.
  Les boutons sont des liens <a> : les <button> du thème reçoivent un ::before indigo qui couvrait le texte.
{%- endcomment -%}
{%- liquid
  assign sp_unsub = false
  if request.path contains 'unsubscribe'
    assign sp_unsub = true
  endif
  assign sp_lang = request.locale.iso_code | slice: 0, 2
  case sp_lang
    when 'fr'
      assign sp_eyebrow = 'Newsletter platinumshop'
      assign sp_title = 'Inscription confirmée !'
      assign sp_title_un = 'Désinscription effectuée'
      assign sp_text = 'Merci, ton adresse est bien enregistrée. Tu recevras en premier nos offres et nos nouveautés.'
      assign sp_text_un = 'Tu ne recevras plus nos e-mails. Tu peux te réinscrire quand tu veux.'
      assign sp_b1 = 'Offres réservées aux abonnés'
      assign sp_b2 = 'Nouveautés en avant-première'
      assign sp_b3 = 'Livraison gratuite dès 50 €'
      assign sp_cta = 'Continuer mes achats'
      assign sp_gifts = 'Choisir mes 3 cadeaux'
      assign sp_best = 'Les plus vendus'
      assign sp_all = 'Tout voir'
    when 'en'
      assign sp_eyebrow = 'platinumshop newsletter'
      assign sp_title = 'You are subscribed!'
      assign sp_title_un = 'You have unsubscribed'
      assign sp_text = 'Thanks, your email is saved. You will be the first to get our offers and new arrivals.'
      assign sp_text_un = 'You will no longer receive our emails. You can sign up again anytime.'
      assign sp_b1 = 'Subscriber-only offers'
      assign sp_b2 = 'Early access to new arrivals'
      assign sp_b3 = 'Free shipping over €50'
      assign sp_cta = 'Continue shopping'
      assign sp_gifts = 'Pick my 3 gifts'
      assign sp_best = 'Best sellers'
      assign sp_all = 'See all'
    else
      assign sp_eyebrow = 'Newsletter platinumshop'
      assign sp_title = 'Iscrizione confermata!'
      assign sp_title_un = 'Iscrizione annullata'
      assign sp_text = 'Grazie, la tua email è registrata. Riceverai per primo le nostre offerte e le novità.'
      assign sp_text_un = 'Non riceverai più le nostre email. Puoi iscriverti di nuovo quando vuoi.'
      assign sp_b1 = 'Offerte riservate agli iscritti'
      assign sp_b2 = 'Novità in anteprima'
      assign sp_b3 = 'Spedizione gratuita da 100 €'
      assign sp_cta = 'Continua lo shopping'
      assign sp_gifts = 'Scegli i tuoi 3 regali'
      assign sp_best = 'I più venduti'
      assign sp_all = 'Vedi tutti'
  endcase

  assign best = collections['bestsellers']
  assign best_ids = best.products | map: 'id' | join: ','
  assign sp_list = best
  if sp_list.products_count == 0
    assign sp_list = collections['all']
  endif
-%}
{%- capture flag -%}{%- render 'country-flag-emoji' -%}{%- endcapture -%}
{{ 'mshein-card.css' | asset_url | stylesheet_tag }}
<style>
  .sp { --sp-ink: #16123f; --sp-mute: #7a7f95; --sp-line: #e6e8f2; --sp-accent: #3a34d2; --sp-soft: #eceafd; --sp-bg: #f4f5f9; background: var(--sp-bg); font-family: 'Figtree', system-ui, sans-serif; color: var(--sp-ink); padding-bottom: 56px; }
  .sp [hidden] { display: none !important; }
  .sp__wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  /* Bandeau pleine largeur */
  .sp__hero { position: relative; overflow: hidden; color: #fff; text-align: center; padding: 56px 0 96px; background: radial-gradient(90% 140% at 50% 0%, #4b44e0 0%, #2a2391 48%, #16123f 100%); }
  .sp--un .sp__hero { background: radial-gradient(90% 140% at 50% 0%, #5b5f78 0%, #34374f 50%, #16123f 100%); }
  .sp__hero::before, .sp__hero::after { content: ''; position: absolute; border-radius: 50%; background: rgb(255 255 255 / 6%); pointer-events: none; }
  .sp__hero::before { width: 420px; height: 420px; left: -120px; top: -180px; }
  .sp__hero::after { width: 320px; height: 320px; right: -90px; bottom: -160px; }
  .sp__ico { position: relative; z-index: 1; width: 84px; height: 84px; margin: 0 auto 18px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--sp-accent); box-shadow: 0 12px 34px rgb(0 0 0 / 28%); animation: sp-pop .6s cubic-bezier(.2, .9, .3, 1.4) both; }
  .sp__ico svg { width: 40px; height: 40px; }
  .sp__ico .sp__check { stroke-dasharray: 24; stroke-dashoffset: 24; animation: sp-draw .5s ease .45s forwards; }
  .sp__eyebrow { position: relative; z-index: 1; margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: rgb(255 255 255 / 72%); }
  .sp__title { position: relative; z-index: 1; margin: 0; font-family: 'Sora', 'Figtree', system-ui, sans-serif; font-size: clamp(30px, 5vw, 46px); font-weight: 700; line-height: 1.08; letter-spacing: -.015em; color: #fff; }
  .sp__text { position: relative; z-index: 1; max-width: 52ch; margin: 14px auto 0; font-size: 16px; line-height: 1.5; color: rgb(255 255 255 / 84%); }
  .sp__actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 28px; }
  .sp .sp__btn { min-height: 52px; min-width: 230px; padding: 0 24px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; border-radius: 14px; font-size: 15px; font-weight: 700; text-decoration: none; transition: transform .15s ease, background .2s ease; }
  .sp .sp__btn::before, .sp .sp__btn::after { content: none; display: none; }
  .sp .sp__btn:active { transform: scale(.98); }
  .sp .sp__btn svg { width: 18px; height: 18px; flex: none; }
  .sp .sp__btn--main { background: #fff; color: var(--sp-ink); box-shadow: 0 10px 26px rgb(0 0 0 / 22%); }
  .sp .sp__btn--main:hover { background: #f0efff; }
  .sp .sp__btn--ghost { background: rgb(255 255 255 / 12%); color: #fff; border: 1.5px solid rgb(255 255 255 / 45%); }
  .sp .sp__btn--ghost:hover { background: rgb(255 255 255 / 20%); }
  /* Avantages, posés à cheval sur le bas du bandeau */
  .sp__perks { position: relative; z-index: 2; list-style: none; margin: -56px auto 0; padding: 0; max-width: 960px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .sp__perks li { display: flex; align-items: center; gap: 14px; padding: 18px 20px; border-radius: 18px; background: #fff; box-shadow: 0 14px 34px rgb(22 18 63 / 10%); font-size: 14px; font-weight: 600; line-height: 1.3; }
  .sp__perks i { flex: none; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--sp-soft); color: var(--sp-accent); }
  .sp__perks svg { width: 22px; height: 22px; }
  /* Cartes produits */
  .sp__shop { margin-top: 48px; }
  .sp__head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
  .sp__h2 { margin: 0; font-family: 'Sora', 'Figtree', system-ui, sans-serif; font-size: clamp(22px, 2.6vw, 28px); font-weight: 700; color: var(--sp-ink); }
  .sp__all { font-size: 14px; font-weight: 700; color: var(--sp-accent); text-decoration: none; }
  .sp__all:hover { text-decoration: underline; }
  .sp__grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 24px 16px; margin: 0; padding: 0; list-style: none; }
  /* Contenu de Shopify (message et lien de désinscription) gardé tel quel */
  .sp__shopify { margin-top: 40px; padding-top: 18px; border-top: 1px solid var(--sp-line); font-size: 13px; color: var(--sp-mute); text-align: center; }
  .sp__shopify h1, .sp__shopify h2 { display: none; }
  .sp__shopify p { margin: 4px 0; }
  .sp__shopify a { color: var(--sp-mute); text-decoration: underline; text-underline-offset: 3px; }
  .sp__shopify a:hover { color: var(--sp-ink); }
  .sp__shopify > *, .sp__shopify .page-width, .sp__shopify [class*="container"] { max-width: none; margin-left: 0; margin-right: 0; padding-left: 0; padding-right: 0; }
  @keyframes sp-pop { from { transform: scale(.4); opacity: 0; } }
  @keyframes sp-draw { to { stroke-dashoffset: 0; } }
  @media (max-width: 1200px) { .sp__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .sp__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  /* Tablette : bandeau un peu resserré, avantages en 3 cases, 3 à 4 cartes par ligne */
  @media (min-width: 601px) and (max-width: 1024px) {
    .sp__wrap { padding: 0 20px; }
    .sp__hero { padding: 44px 0 84px; }
    .sp__ico { width: 72px; height: 72px; margin-bottom: 14px; }
    .sp__ico svg { width: 34px; height: 34px; }
    .sp__title { font-size: 38px; }
    .sp__text { font-size: 15px; }
    .sp__actions { margin-top: 22px; }
    .sp .sp__btn { min-width: 210px; min-height: 50px; }
    .sp__perks { margin-top: -48px; gap: 12px; }
    .sp__perks li { gap: 12px; padding: 14px 16px; font-size: 13px; }
    .sp__perks i { width: 40px; height: 40px; }
    .sp__shop { margin-top: 36px; }
    .sp__grid { gap: 20px 12px; }
  }
  /* Téléphone : bandeau compact, avantages en une ligne qui défile au doigt, cartes produits plus vite à l'écran */
  @media (max-width: 600px) {
    .sp { padding-bottom: 40px; }
    .sp__wrap { padding: 0 12px; }
    .sp__hero { padding: 28px 0 64px; }
    .sp__hero::before { width: 260px; height: 260px; left: -110px; top: -130px; }
    .sp__hero::after { width: 200px; height: 200px; right: -80px; bottom: -110px; }
    .sp__ico { width: 62px; height: 62px; margin-bottom: 12px; }
    .sp__ico svg { width: 30px; height: 30px; }
    .sp__eyebrow { font-size: 10px; margin-bottom: 6px; }
    .sp__title { font-size: 26px; }
    .sp__text { font-size: 14px; margin-top: 8px; }
    .sp__actions { gap: 8px; margin-top: 18px; }
    .sp .sp__btn { min-width: 0; width: 100%; min-height: 46px; font-size: 14px; border-radius: 12px; }
    .sp__perks { display: flex; max-width: none; margin: -40px -12px 0; padding: 0 12px 8px; gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .sp__perks::-webkit-scrollbar { display: none; }
    .sp__perks li { flex: 0 0 auto; scroll-snap-align: start; gap: 10px; padding: 10px 14px 10px 10px; border-radius: 14px; font-size: 13px; white-space: nowrap; box-shadow: 0 8px 20px rgb(22 18 63 / 10%); }
    .sp__perks i { width: 34px; height: 34px; border-radius: 10px; }
    .sp__perks svg { width: 18px; height: 18px; }
    .sp__shop { margin-top: 26px; }
    .sp__head { margin-bottom: 12px; }
    .sp__h2 { font-size: 20px; }
    .sp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 8px; }
    .sp__shopify { margin-top: 28px; font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .sp__ico, .sp__ico .sp__check { animation: none; stroke-dashoffset: 0; } }
</style>
<section class="sp{% if sp_unsub %} sp--un{% endif %}">
  <div class="sp__hero">
    <div class="sp__wrap">
      <div class="sp__ico" aria-hidden="true">
        {%- if sp_unsub -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg>
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6" opacity=".35"/><path class="sp__check" d="m8.5 12.5 2.5 2.5 4.5-5" stroke-width="2.2"/></svg>
        {%- endif -%}
      </div>
      <p class="sp__eyebrow">{{ sp_eyebrow }}</p>
      <h1 class="sp__title">{% if sp_unsub %}{{ sp_title_un }}{% else %}{{ sp_title }}{% endif %}</h1>
      <p class="sp__text">{% if sp_unsub %}{{ sp_text_un }}{% else %}{{ sp_text }}{% endif %}</p>
      <div class="sp__actions">
        <a class="sp__btn sp__btn--main" href="{{ routes.all_products_collection_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h12l-1 12H7z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>{{ sp_cta }}</a>
        {%- unless sp_unsub -%}
          {%- comment -%} Rouvre la popup « 3 regali gratis » (assets/free-gift.js) ; caché si elle n'est pas sur la page {%- endcomment -%}
          <a class="sp__btn sp__btn--ghost" href="#" role="button" data-sp-gifts hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7c-2-4-7-4-7-1s5 1 7 1zm0 0c2-4 7-4 7-1s-5 1-7 1z"/></svg>{{ sp_gifts }}</a>
        {%- endunless -%}
      </div>
    </div>
  </div>

  <div class="sp__wrap">
    {%- unless sp_unsub -%}
      <ul class="sp__perks">
        <li><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7c-2-4-7-4-7-1s5 1 7 1zm0 0c2-4 7-4 7-1s-5 1-7 1z"/></svg></i>{{ sp_b1 }}</li>
        <li><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z"/></svg></i>{{ sp_b2 }}</li>
        <li><i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg></i>{{ sp_b3 }}</li>
      </ul>
    {%- endunless -%}

    {%- if sp_list.products_count > 0 -%}
      <div class="sp__shop">
        <div class="sp__head">
          <h2 class="sp__h2">{{ sp_best }}</h2>
          <a class="sp__all" href="{{ sp_list.url }}">{{ sp_all }} ›</a>
        </div>
        <ul class="sp__grid">
          {%- for product in sp_list.products limit: 12 -%}
            {%- render 'mshein-card', product: product, best: best, best_ids: best_ids, flag: flag, uniform: true -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="sp__shopify">{{ content }}</div>
  </div>
</section>
<script>
  (function () {
    var btn = document.querySelector('[data-sp-gifts]');
    if (!btn) return;
    var tries = 0;
    var wait = setInterval(function () {
      var bubble = document.querySelector('.fg-root .fg-bubble');
      if (bubble || ++tries > 40) {
        clearInterval(wait);
        if (!bubble) return;
        btn.hidden = false;
        btn.addEventListener('click', function (e) { e.preventDefault(); bubble.click(); });
      }
    }, 250);
  })();
</script>
