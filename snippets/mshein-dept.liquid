{%- comment -%}
  Page d'un onglet de rayon de l'accueil mobile (prototype validé « étape 2 »), demandée sans recharger la page par
  assets/mobile-home-tabs.js (/collections/<rayon>?view=mshein-dept, sans layout). 4 blocs, placés par le script à la
  place de ceux de l'accueil (la bande avantages et le coupon restent) :
  - hero : photo de la collection (sinon ses 3 meilleures ventes en mosaïque), nom du rayon, nombre d'articles ;
  - cats : sous-catégories du menu en vignettes photo (niveau 2) et icônes (niveau 3), ou ses meilleures ventes
    numérotées quand le rayon n'a pas de sous-menu ;
  - mods : ses 4 cartes (Più venduti, Saldi Top, Nuovi arrivi, Sotto 50) ;
  - products : bloc de recherche des pages collection (puces des sous-catégories, Filtri = vrais filtres Shopify,
    tri, 2 colonnes / 1 colonna, filtres rapides, « Mostrando X di Y ») et les produits.
  « Tutti i Prodotti » (/collections/all) : vignettes = les rayons du menu, bloc de recherche de la page « Prodotti »
  (tri et colonnes seulement). Données réelles uniquement.
  Params : collection, best (collection « Più venduti »), flag, menu (menu des rayons), cards (cartes de la 1re page),
  next_url (page suivante des produits)
{%- endcomment -%}
{%- liquid
  assign dept_menu = menu
  if dept_menu == blank
    assign dept_menu = linklists['main-menu']
  endif
  assign is_all = false
  if collection.handle == 'all'
    assign is_all = true
  endif

  # Lien du rayon dans le menu (même adresse que la collection).
  assign dept_link = nil
  for top_link in dept_menu.links
    if top_link.url == collection.url or top_link.object.handle == collection.handle
      assign dept_link = top_link
      break
    endif
  endfor
  assign dept_title = dept_link.title | default: collection.title

  # Meilleures ventes du rayon : ordre de « Più venduti » (produits de « Più venduti » présents dans le rayon).
  assign dept_best = ''
  assign dept_best_count = 0
  for best_product in best.products limit: 120
    if is_all == false
      assign best_handles = best_product.collections | map: 'handle'
      unless best_handles contains collection.handle
        continue
      endunless
    endif
    assign dept_best = dept_best | append: best_product.id | append: ','
    assign dept_best_count = dept_best_count | plus: 1
    if dept_best_count >= 10
      break
    endif
  endfor
  assign dept_best_ids = dept_best | split: ','

  # Les 10 « meilleures ventes » du rayon : ses produits de « Più venduti », complétés par ses produits (sans pagination,
  # Shopify ne donne que les 50 premiers « Più venduti »). Servent à la mosaïque, au carrousel « TOP » et à « Più venduti ».
  assign top_list = dept_best
  for dept_product in collection.products
    assign top_ids = top_list | split: ','
    if top_ids.size >= 10
      break
    endif
    assign dept_id = dept_product.id | append: ''
    unless top_ids contains dept_id
      assign top_list = top_list | append: dept_id | append: ','
    endunless
  endfor
  assign top_ids = top_list | split: ','
  assign collage_html = ''
  assign top_html = ''
  assign collage_count = 0
  assign collage_bg = ''
-%}

{%- comment -%} Une seule passe sur les 10 produits : mosaïque de la bannière (3 premiers avec photo) et carrousel « TOP 1… ». {%- endcomment -%}
{%- for top_id in top_ids -%}
  {%- assign top_product = nil -%}
  {%- for candidate in best.products -%}
    {%- assign candidate_id = candidate.id | append: '' -%}
    {%- if candidate_id == top_id -%}{%- assign top_product = candidate -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
  {%- if top_product == nil -%}
    {%- for candidate in collection.products -%}
      {%- assign candidate_id = candidate.id | append: '' -%}
      {%- if candidate_id == top_id -%}{%- assign top_product = candidate -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if top_product == nil -%}{%- continue -%}{%- endif -%}
  {%- assign top_variant = top_product.selected_or_first_available_variant -%}
  {%- assign top_image = top_variant.featured_image | default: top_product.featured_image -%}
  {%- if top_image != blank and collage_count < 3 -%}
    {%- if collage_bg == '' -%}{%- assign collage_bg = top_image | image_url: width: 400 -%}{%- endif -%}
    {%- capture collage_item -%}<span>{{ top_image | image_url: width: 400 | image_tag: loading: 'eager', alt: top_product.title }}<b>{{ top_variant.price | money }}</b></span>{%- endcapture -%}
    {%- assign collage_html = collage_html | append: collage_item -%}
    {%- assign collage_count = collage_count | plus: 1 -%}
  {%- endif -%}
  {%- assign top_sold = top_product.metafields.custom.bestseller_current_month.value | default: top_product.metafields.custom.bestseller_count.value | default: 0 | plus: 0 -%}
  {%- capture top_item -%}
    <a class="mshein-dtop__item reveal" href="{{ top_product.url }}">
      <span class="mshein-dtop__img">
        {%- if top_image != blank -%}{{ top_image | image_url: width: 240, height: 320, crop: 'center' | image_tag: loading: 'lazy', alt: top_product.title }}{%- endif -%}
        <span class="mshein-dtop__rk">TOP {{ forloop.index }}</span>
      </span>
      <b{% if top_variant.compare_at_price > top_variant.price %} class="is-sale"{% endif %}>{{ top_variant.price | money }}</b>
      {%- if top_sold > 0 -%}<small>{{ 'mobile.home_shein.sold_recent' | t: count: top_sold }}</small>{%- endif -%}
    </a>
  {%- endcapture -%}
  {%- assign top_html = top_html | append: top_item -%}
{%- endfor -%}

{%- capture chev -%}<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></svg>{%- endcapture -%}

<div class="mshein-dept" data-mshein-dept data-title="{{ dept_title | escape }}" data-handle="{{ collection.handle }}"{% if is_all %} data-all{% endif %}>

  {%- comment -%} Bannière {%- endcomment -%}
  <div data-dept-part="hero">
    {%- liquid
      assign hero_bg = ''
      if collection.image
        assign hero_bg = collection.image | image_url: width: 600
      else
        assign hero_bg = collage_bg
      endif
    -%}
    <section class="mshein-dhero">
      <a class="mshein-dhero__media" href="{{ collection.url }}">
        {%- if collection.image -%}
          {{ collection.image | image_url: width: 750 | image_tag: loading: 'eager', fetchpriority: 'high', alt: dept_title, sizes: '100vw', widths: '375,560,750' }}
        {%- else -%}
          <span class="mshein-dhero__collage">{{ collage_html }}</span>
        {%- endif -%}
        <span class="mshein-dhero__shade"></span>
        <span class="mshein-dhero__txt">
          <b class="mshein-dhero__title">{{ dept_title | escape }}</b>
          <span class="mshein-dhero__meta">
            <span>{{ 'mobile.cart.items_other' | t: count: collection.all_products_count }}</span>
            <span class="mshein-dhero__cta">{{ 'mobile.category.view_all' | t }}{{ chev }}</span>
          </span>
        </span>
      </a>
      {%- if hero_bg != '' -%}<i class="mshein-dhero__bg" style="background-image: url('{{ hero_bg }}');" aria-hidden="true"></i>{%- endif -%}
    </section>
  </div>

  {%- comment -%} Sous-catégories {%- endcomment -%}
  <div data-dept-part="cats">
    {%- liquid
      if is_all
        assign group_links = dept_menu.links
      else
        assign group_links = dept_link.links
      endif
      assign group_count = 0
    -%}
    {%- capture groups_html -%}
      {%- for group in group_links -%}
        {%- if group.type != 'collection_link' or group.object == blank -%}{%- continue -%}{%- endif -%}
        {%- if is_all and group.object.handle == collection.handle -%}{%- continue -%}{%- endif -%}
        {%- assign group_image = group.object.image | default: group.object.products.first.featured_image -%}
        {%- if group_image == blank -%}{%- continue -%}{%- endif -%}
        {%- assign group_count = group_count | plus: 1 -%}
        <a class="mshein-dgroup reveal" href="{{ group.url }}">
          {{ group_image | image_url: width: 240, height: 300, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
          <span>{{ group.title | escape }}</span>
        </a>
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign icon_count = 0 -%}
    {%- capture icons_html -%}
      {%- unless is_all -%}
        {%- assign seen_icons = ',' -%}
        {%- for group in dept_link.links -%}
          {%- for sub in group.links -%}
            {%- assign sub_key = ',' | append: sub.url | append: ',' -%}
            {%- if seen_icons contains sub_key or sub.type != 'collection_link' or sub.object == blank -%}{%- continue -%}{%- endif -%}
            {%- assign seen_icons = seen_icons | append: sub.url | append: ',' -%}
            {%- assign sub_image = sub.object.image | default: sub.object.products.first.featured_image -%}
            {%- if sub_image == blank -%}{%- continue -%}{%- endif -%}
            {%- assign icon_count = icon_count | plus: 1 -%}
            <a class="mshein-dicon reveal" href="{{ sub.url }}">
              <span class="mshein-dicon__img">{{ sub_image | image_url: width: 160, height: 160, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}</span>
              <span>{{ sub.title | escape }}</span>
            </a>
          {%- endfor -%}
        {%- endfor -%}
      {%- endunless -%}
    {%- endcapture -%}
    <section class="mshein-dcats">
      {%- if group_count >= 2 -%}
        <div class="mshein-drow mshein-dgroups">{{ groups_html }}</div>
      {%- endif -%}
      {%- if icon_count >= 3 -%}
        <div class="mshein-drow mshein-dicons" style="--rows: {% if icon_count >= 12 %}3{% else %}2{% endif %};">{{ icons_html }}</div>
      {%- endif -%}
      {%- comment -%} Rayon sans sous-menu : ses vraies meilleures ventes, numérotées dans l'ordre de « Più venduti ». {%- endcomment -%}
      {%- if group_count < 2 and is_all == false -%}
        <div class="mshein-dsec__hd"><b>{{ 'mobile.explore.best_sellers' | t }}</b><a href="{{ collection.url }}?sort_by=best-selling">{{ 'mobile.category.view_all' | t }} ›</a></div>
        <div class="mshein-drow mshein-dtop">{{ top_html }}        </div>
      {%- endif -%}
    </section>
  </div>

  {%- comment -%} 4 cartes du rayon {%- endcomment -%}
  <div data-dept-part="mods">
    {%- liquid
      # Saldi Top : les 2 plus fortes remises parmi les produits chargés du rayon (50 premiers).
      assign sale_a = nil
      assign sale_a_pct = 0
      assign sale_b = nil
      assign sale_b_pct = 0
      for candidate in collection.products
        assign candidate_variant = candidate.selected_or_first_available_variant
        if candidate_variant.compare_at_price > candidate_variant.price
          assign candidate_pct = candidate_variant.compare_at_price | minus: candidate_variant.price | times: 100.0 | divided_by: candidate_variant.compare_at_price | floor
          if candidate_pct > sale_a_pct
            assign sale_b = sale_a
            assign sale_b_pct = sale_a_pct
            assign sale_a = candidate
            assign sale_a_pct = candidate_pct
          elsif candidate_pct > sale_b_pct
            assign sale_b = candidate
            assign sale_b_pct = candidate_pct
          endif
        endif
      endfor
      assign sale_ids = sale_a.id | append: ',' | append: sale_b.id | split: ','
      assign newest = collection.products | sort: 'published_at' | reverse
      assign under_amount = 5000 | money_without_trailing_zeros | strip_html
    -%}
    <div class="mshein-mods">
      {%- for module_index in (1..4) -%}
        {%- liquid
          assign module_list = collection.products
          assign module_limit = 50
          case module_index
            when 1
              assign module_class = 'best'
              assign module_title = 'mobile.explore.best_sellers' | t
              assign module_url = collection.url | append: '?sort_by=best-selling'
              # Rayon : ses 2 premières meilleures ventes (liste top_ids) ; « Tutti i Prodotti » : les 2 premiers de « Più venduti ».
              if is_all
                assign module_list = best.products
              else
                assign module_list = best.products | concat: collection.products
              endif
              assign module_limit = 100
            when 2
              assign module_class = 'sale'
              assign module_title = 'mobile.home_shein.top_sales' | t
              assign module_url = collection.url | append: '?sort_by=best-selling'
            when 3
              assign module_class = 'new'
              assign module_title = 'mobile.explore.new_arrivals' | t
              assign module_url = collection.url | append: '?sort_by=created-descending'
              assign module_list = newest
            when 4
              assign module_class = 'under'
              assign module_title = 'mobile.explore.under_20' | t: amount: under_amount
              assign module_url = collection.url | append: '?filter.v.price.lte=50'
          endcase
          assign title_rest = module_title
          assign title_last = ''
          if module_class != 'best'
            assign title_words = module_title | split: ' '
            if title_words.size > 1
              assign title_last = title_words | last
              assign title_rest_size = title_words.size | minus: 1
              assign title_rest = title_words | slice: 0, title_rest_size | join: ' '
            endif
          endif
        -%}
        {%- capture module_items -%}
          {%- assign module_shown = 0 -%}
          {%- for module_product in module_list limit: module_limit -%}
            {%- liquid
              assign module_id = module_product.id | append: ''
              if module_class == 'best' and is_all == false
                unless top_ids contains module_id
                  continue
                endunless
              endif
              if module_class == 'sale'
                unless sale_ids contains module_id
                  continue
                endunless
              endif
              assign module_variant = module_product.selected_or_first_available_variant
              if module_class == 'under' and module_variant.price > 5000
                continue
              endif
              assign module_image = module_variant.featured_image | default: module_product.featured_image
              assign module_pct = 0
              if module_variant.compare_at_price > module_variant.price
                assign module_pct = module_variant.compare_at_price | minus: module_variant.price | times: 100.0 | divided_by: module_variant.compare_at_price | floor
              endif
              assign module_shown = module_shown | plus: 1
            -%}
            <span class="mshein-mod__item">
              {%- if module_image != blank -%}
                <img src="{{ module_image | image_url: width: 240, height: 320, crop: 'center' }}" alt="{{ module_product.title | escape }}" width="120" height="160" loading="lazy">
              {%- endif -%}
              <span class="mshein-mod__price{% if module_pct > 0 %} is-sale{% endif %}">{{ module_variant.price | money }}</span>
              {%- if module_pct > 0 -%}
                <span class="mshein-mod__off">{{ 'mobile.home_shein.percent_off' | t: percent: module_pct }}</span>
              {%- elsif module_class == 'new' -%}
                <span class="mshein-mod__tag">NEW</span>
              {%- endif -%}
            </span>
            {%- if module_shown >= 2 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if module_shown == 2 -%}
          <a class="mshein-mod mshein-mod--{{ module_class }} reveal" href="{{ module_url }}">
            <span class="mshein-mod__hd"><b>{{ title_rest | escape }}{% if title_last != '' %} <em>{{ title_last | escape }}</em>{% endif %}</b>{{ chev }}</span>
            <span class="mshein-mod__items">{{ module_items }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Bloc de recherche des pages collection + produits {%- endcomment -%}
  <div data-dept-part="products">
    <div class="mshein-cblock{% if is_all %} mshein-cblock--simple{% endif %}" data-dept-block>
      {%- unless is_all -%}
        {%- comment -%} Puces : sous-catégories du menu (niveau 3, sinon niveau 2), comme les pages collection du site. {%- endcomment -%}
        {%- capture chips_html -%}
          {%- assign seen_chips = ',' -%}
          {%- for group in dept_link.links -%}
            {%- if group.links.size > 0 -%}
              {%- assign chip_links = group.links -%}
            {%- else -%}
              {%- assign chip_links = dept_link.links | where: 'url', group.url -%}
            {%- endif -%}
            {%- for chip in chip_links -%}
              {%- assign chip_key = ',' | append: chip.url | append: ',' -%}
              {%- if seen_chips contains chip_key or chip.type != 'collection_link' or chip.object == blank or chip.object.handle == collection.handle -%}{%- continue -%}{%- endif -%}
              {%- assign seen_chips = seen_chips | append: chip.url | append: ',' -%}
              <button type="button" data-dept-chip="{{ chip.object.url }}">{{ chip.title | escape }}</button>
            {%- endfor -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if chips_html != blank -%}
          <div class="mshein-cchips" data-dept-chips>
            <button type="button" class="is-on" data-dept-chip="{{ collection.url }}">{{ 'mobile.explore.see_all' | t }}</button>
            {{- chips_html -}}
          </div>
        {%- endif -%}
      {%- endunless -%}

      {%- comment -%} Partie remplacée à chaque tri / filtre / puce (mêmes vrais filtres Shopify que la page collection). {%- endcomment -%}
      <div class="mshein-cresults" data-dept-results>
        {%- liquid
          assign current_sort = collection.sort_by | default: collection.default_sort_by
          assign current_sort_label = ''
          for option in collection.sort_options
            if option.value == current_sort
              assign current_sort_label = option.name
            endif
          endfor
          assign active_filters = 0
          for filter in collection.filters
            if filter.type == 'price_range'
              if filter.min_value.value != nil or filter.max_value.value != nil
                assign active_filters = active_filters | plus: 1
              endif
            else
              assign active_filters = active_filters | plus: filter.active_values.size
            endif
          endfor
        -%}
        <div class="mshein-ctool">
          {%- unless is_all -%}
            {%- if collection.filters.size > 0 -%}
              <button type="button" class="mshein-cfilter" data-dept-open="">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
                {{ 'mobile.collection.filters' | t }}
                {%- if active_filters > 0 -%}<i>{{ active_filters }}</i>{%- endif -%}
              </button>
            {%- endif -%}
          {%- endunless -%}
          <label class="mshein-csort">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 4v16M3 8l4-4 4 4M17 20V4M13 16l4 4 4-4"/></svg>
            <span>{{ current_sort_label | escape }}</span>
            <svg class="mshein-csort__chev" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            <select aria-label="{{ 'mobile.collection.sort_title' | t }}" data-dept-sort>
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value | escape }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
          </label>
          <div class="mshein-cview">
            <button type="button" class="is-on" data-dept-view="2" aria-label="{{ 'mobile.collection.two_cols' | t }}"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="2"/><rect x="13" y="4" width="7" height="7" rx="2"/><rect x="4" y="13" width="7" height="7" rx="2"/><rect x="13" y="13" width="7" height="7" rx="2"/></svg></button>
            <button type="button" data-dept-view="1" aria-label="{{ 'mobile.collection.one_col' | t }}"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="6" rx="2"/><rect x="4" y="13" width="16" height="6" rx="2"/></svg></button>
          </div>
        </div>

        {%- unless is_all -%}
          {%- if collection.filters.size > 0 -%}
            {%- comment -%} Filtres rapides : « Disponibili » d'un toucher, les autres ouvrent la fenêtre à leur section. {%- endcomment -%}
            <div class="mshein-cfchips">
              {%- for filter in collection.filters -%}
                {%- assign first_param = filter.values.first.param_name | default: '' -%}
                {%- if first_param contains 'availability' -%}
                  {%- assign in_stock = filter.values | where: 'value', '1' | first -%}
                  {%- if in_stock -%}
                    <button type="button" class="mshein-cfchip-av{% if in_stock.active %} is-on{% endif %}" data-dept-quick="{{ in_stock.param_name }}" data-dept-quick-value="1"><i></i>{{ 'mobile.collection.available' | t }}</button>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- for filter in collection.filters -%}
                {%- assign first_param = filter.values.first.param_name | default: '' -%}
                {%- if first_param contains 'availability' -%}{%- continue -%}{%- endif -%}
                {%- assign filter_active = filter.active_values.size -%}
                {%- if filter.type == 'price_range' -%}
                  {%- assign filter_active = 0 -%}
                  {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}{%- assign filter_active = 1 -%}{%- endif -%}
                {%- endif -%}
                <button type="button"{% if filter_active > 0 %} class="is-on"{% endif %} data-dept-open="{{ forloop.index }}">
                  {{- filter.label | escape }}{% if filter_active > 0 and filter.type != 'price_range' %} ({{ filter_active }}){% endif -%}
                  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endunless -%}

        {%- liquid
          # « Mostrando <b>{count}</b> di <b>{total}</b> prodotti » (même texte que la page collection) ; {count} mis à jour par le script.
          assign results_text = 'mobile.js.collection_results_html' | t
          assign count_token = '{' | append: 'count' | append: '}'
          assign total_token = '{' | append: 'total' | append: '}'
          assign results_line = results_text | replace: count_token, '0' | replace: total_token, collection.products_count
        -%}
        <p class="mshein-ccount" data-dept-count data-template="{{ results_text | escape }}" data-total="{{ collection.products_count }}">{{ results_line }}</p>

        {%- unless is_all -%}
          {%- comment -%} Fenêtre « Filtri » : vrais filtres de la collection (disponibilità, prezzo, opzioni, tipo…). {%- endcomment -%}
          <div class="mshein-fsheet" data-dept-sheet hidden>
            <form class="mshein-fsheet__panel" role="dialog" aria-label="{{ 'mobile.collection.filters' | t }}" data-dept-form>
              <div class="mshein-fsheet__hd"><b>{{ 'mobile.collection.filters' | t }}</b><button type="button" data-dept-close aria-label="{{ 'general.accessibility.close' | t }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
              <div class="mshein-fsheet__body" data-dept-sheet-body>
                {%- for filter in collection.filters -%}
                  <section data-dept-section="{{ forloop.index }}">
                    <h4>{{ filter.label | escape }}</h4>
                    {%- case filter.type -%}
                      {%- when 'price_range' -%}
                        <div class="mshein-fprice">
                          <label><span>Min</span><input type="number" inputmode="decimal" min="0" step="0.01" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value != nil %}{{ filter.min_value.value | divided_by: 100.0 }}{% endif %}" placeholder="0"></label>
                          <label><span>Max</span><input type="number" inputmode="decimal" min="0" step="0.01" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value != nil %}{{ filter.max_value.value | divided_by: 100.0 }}{% endif %}" placeholder="{{ filter.range_max | divided_by: 100.0 | ceil }}"></label>
                        </div>
                      {%- else -%}
                        <div class="mshein-fpills">
                          {%- for value in filter.values -%}
                            <label class="mshein-fpill">
                              <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                              <span>{{ value.label | escape }} <em>{{ value.count }}</em></span>
                            </label>
                          {%- endfor -%}
                        </div>
                    {%- endcase -%}
                  </section>
                {%- endfor -%}
              </div>
              <div class="mshein-fsheet__ft">
                <button type="button" class="mshein-fsheet__reset" data-dept-reset>{{ 'mobile.collection.reset' | t }}</button>
                <button type="submit" class="mshein-fsheet__go">{{ 'mobile.collection.show_results' | t }}</button>
              </div>
            </form>
          </div>
        {%- endunless -%}

        <ul class="mshein-feed__grid" data-mshein-grid>{{ cards }}</ul>
        <div class="mshein-feed__sentinel" data-mshein-sentinel data-next="{{ next_url | escape }}"></div>
        <div class="mshein-loader" data-mshein-loader hidden aria-label="{{ 'mobile.js.loading' | t }}"><i></i><i></i><i></i></div>
      </div>
    </div>
  </div>
</div>
