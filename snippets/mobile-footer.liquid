{%- comment -%}
  Footer mobile (prototype) — rendu par sections/footer.liquid, masqué sur desktop.
  Toutes les données viennent de la boutique et des réglages du footer :
  - liens : menu du footer (tous conservés). Si le menu a des sous-menus, chaque entrée devient
    un accordéon ; sinon les liens sont rangés par adresse (Assistenza / Informazioni legali /
    Platinumshop), et tout lien non reconnu va dans "Platinumshop".
  - contacts : e-mail de la boutique, WhatsApp (réglage du thème), suivi de commande (menu principal).
  - newsletter, pays/devise, langue, moyens de paiement, "Segui su Shop" : fonctionnalités Shopify.
  Params : menu (linklist), customer_block, newsletter_block, section_settings, rating, trustpilot_url
{%- endcomment -%}
{%- liquid
  # Secours si le menu n'a pas de lien de suivi : la page « Traccia il tuo Ordine » (URL dans la langue du visiteur).
  # /pages/tracking-order n'existe pas (404).
  assign tracking_url = pages['traccia-ordine'].url | default: '/apps/17TRACK'
  assign tracking_title = 'Tracking_order'
  for main_link in linklists['main-menu'].links
    assign main_title = main_link.title | downcase
    if main_title contains 'tracking' or main_link.url contains '17TRACK'
      assign tracking_url = main_link.url
      assign tracking_title = main_link.title
      break
    endif
  endfor

  # Lien du menu en adresse complète vers la boutique : on garde seulement le chemin (/apps/17TRACK)
  # pour rester sur le site affiché (aperçu ou boutique en ligne).
  assign own_prefixes = shop.secure_url | append: '|https://www.' | append: shop.domain | append: '|http://' | append: shop.domain | split: '|'
  for own_prefix in own_prefixes
    if tracking_url contains own_prefix
      assign tracking_url = tracking_url | remove_first: own_prefix
      break
    endif
  endfor
  # App de suivi (/apps/…) : dans la langue du visiteur (/de/apps/17TRACK).
  assign tracking_start = tracking_url | slice: 0, 6
  if tracking_start == '/apps/' and routes.root_url != '/'
    assign tracking_url = routes.root_url | append: tracking_url
  endif

  assign wishlist_url = pages['wishlist'].url | default: '/pages/wishlist'
  if customer
    assign account_url = routes.account_url
  else
    assign account_url = routes.account_login_url
  endif

  assign has_submenus = false
  for link in menu.links
    if link.links != blank
      assign has_submenus = true
      break
    endif
  endfor
-%}

{%- capture chevron -%}<svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="m6 9 6 6 6-6"></path></svg>{%- endcapture -%}

{%- capture help_links -%}
  {%- unless has_submenus -%}
    {%- for link in menu.links -%}
      {%- if link.url contains 'contact-information' or link.url contains 'shipping-policy' or link.url contains 'refund-policy' or link.url contains '/search' or link.url contains '/pages/contact' -%}
        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
      {%- endif -%}
    {%- endfor -%}
  {%- endunless -%}
  <li><a href="{{ tracking_url }}">{{ tracking_title | escape }}</a></li>
{%- endcapture -%}

{%- capture legal_links -%}
  {%- unless has_submenus -%}
    {%- for link in menu.links -%}
      {%- if link.url contains 'privacy-policy' or link.url contains 'terms-of-service' or link.url contains 'legal-notice' or link.url contains 'subscription-policy' -%}
        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
      {%- endif -%}
    {%- endfor -%}
  {%- endunless -%}
{%- endcapture -%}

{%- capture brand_links -%}
  {%- unless has_submenus -%}
    {%- for link in menu.links -%}
      {%- unless link.url contains 'contact-information' or link.url contains 'shipping-policy' or link.url contains 'refund-policy' or link.url contains '/search' or link.url contains '/pages/contact' or link.url contains 'privacy-policy' or link.url contains 'terms-of-service' or link.url contains 'legal-notice' or link.url contains 'subscription-policy' -%}
        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
      {%- endunless -%}
    {%- endfor -%}
  {%- endunless -%}
  <li><a href="{{ wishlist_url }}">{{ 'mobile.wishlist.my_wishlist' | t }}</a></li>
  <li><a href="{{ account_url }}">{{ 'mobile.footer.account' | t }}</a></li>
{%- endcapture -%}

<div class="nf" data-mobile-footer>
  {%- if newsletter_block and newsletter_block.settings.show_newsletter -%}
    <section class="nf-news">
      <p class="nf-news__title" role="heading" aria-level="2">{{ 'mobile.footer.newsletter_title' | t }}</p>
      <p>{{ 'mobile.footer.newsletter_text' | t }}</p>
      {%- form 'customer', id: 'newsletter-footer-mobile' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="nf-news__field">
          <label class="nf-sr" for="newsletter-footer-mobile-email">{{ 'newsletter.form.email_placeholder' | t }}</label>
          <input
            type="email"
            name="contact[email]"
            id="newsletter-footer-mobile-email"
            placeholder="{{ 'newsletter.form.email_placeholder' | t }}"
            autocomplete="email"
            required
          >
          <button type="submit" aria-label="{{ 'newsletter.form.submit_button' | t }}">
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <small class="nf-news__status" role="status">{{ 'newsletter.form.success' | t }}</small>
        {%- elsif form.errors -%}
          <small class="nf-news__status is-error" role="alert">{{ form.errors.messages['email'] }}</small>
        {%- else -%}
          <small>{{ 'mobile.footer.unsubscribe' | t }}</small>
        {%- endif -%}
        {%- if newsletter_block.settings.enable_newsletter_terms_checkbox and newsletter_block.settings.newsletter_terms_text != empty -%}
          <p class="nf-news__terms">
            <input type="checkbox" id="newsletter-footer-mobile-terms" required>
            <label for="newsletter-footer-mobile-terms">{{ newsletter_block.settings.newsletter_terms_text | remove: '<p>' | remove: '</p>' }}</label>
          </p>
        {%- endif -%}
      {%- endform -%}
    </section>
  {%- endif -%}

  <section class="nf-help">
    <p class="nf-help__title" role="heading" aria-level="3">{{ customer_block.settings.title | default: 'Customer service' | strip_html }}</p>
    <div class="nf-contact">
      {%- if customer_block.settings.show_whatsapp_link -%}
        {%- assign whatsapp_number = settings.whatsapp | default: section_settings.mobile_whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' -%}
        <a href="https://wa.me/{{ whatsapp_number }}" class="nf-contact__wa" rel="noopener" target="_blank">
          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"></path><path class="nf-fill" d="M8.5 8.8c.2 2.8 3 5.8 6.4 6.5l1.4-1.5-2-1-1 .8c-1-.4-2.4-1.8-2.8-2.8l.8-1-1-2z"></path></svg>
          <span><b>WhatsApp</b><small>{{ 'mobile.footer.ask' | t }}</small></span>
        </a>
      {%- endif -%}
      {%- if customer_block.settings.show_mail_link and shop.email != blank -%}
        <a href="mailto:{{ shop.email }}">
          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><rect x="2.5" y="5" width="19" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          <span><b>Email</b><small>{{ shop.email }}</small></span>
        </a>
      {%- endif -%}
      {%- if customer_block.settings.show_phone_link and shop.phone != blank -%}
        <a href="tel:{{ shop.phone }}">
          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg>
          <span><b>{{ 'mobile.footer.phone' | t }}</b><small>{{ shop.phone }}</small></span>
        </a>
      {%- endif -%}
      <a href="{{ tracking_url }}">
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M1 5h13v11H1zM14 9h4l3 3v4h-7"></path><circle cx="5.5" cy="18" r="2"></circle><circle cx="17.5" cy="18" r="2"></circle></svg>
        <span><b>{{ tracking_title | escape }}</b><small>{{ 'mobile.footer.track_order' | t }}</small></span>
      </a>
    </div>
  </section>

  {%- if trustpilot_url != blank -%}
    <a class="nf-rate" href="{{ trustpilot_url }}" rel="noopener" target="_blank" data-mobile-footer-rating="{{ rating }}">
      <b data-mobile-footer-rating-value>{{ rating }}</b>
      <span>
        {%- assign rating_percent = rating | times: 20 -%}
        <i class="nf-stars" aria-label="{{ 'mobile.footer.rating_out_of' | t: rating: rating }}"><em style="width: {{ rating_percent }}%;"></em></i>
        <small>{{ 'mobile.footer.trustpilot' | t }}</small>
      </span>
      <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="m9 6 6 6-6 6"></path></svg>
      <span class="nf-rate__source" data-mobile-footer-rating-source aria-hidden="true"></span>
    </a>
  {%- endif -%}

  <nav class="nf-links" aria-label="{{ 'mobile.footer.information' | t }}">
    {%- if has_submenus -%}
      {%- for link in menu.links -%}
        {%- if link.links != blank -%}
          <details class="nf-acc">
            <summary>{{ link.title | escape }}{{ chevron }}</summary>
            <ul>
              {%- for sub in link.links -%}
                <li><a href="{{ sub.url }}">{{ sub.title | escape }}</a></li>
                {%- for subsub in sub.links -%}
                  <li><a href="{{ subsub.url }}">{{ subsub.title | escape }}</a></li>
                {%- endfor -%}
              {%- endfor -%}
            </ul>
          </details>
        {%- else -%}
          <a class="nf-acc nf-acc--link" href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
      <details class="nf-acc">
        <summary>Platinumshop{{ chevron }}</summary>
        <ul>
          <li><a href="{{ tracking_url }}">{{ tracking_title | escape }}</a></li>
          <li><a href="{{ wishlist_url }}">{{ 'mobile.wishlist.my_wishlist' | t }}</a></li>
          <li><a href="{{ account_url }}">{{ 'mobile.footer.account' | t }}</a></li>
        </ul>
      </details>
    {%- else -%}
      <details class="nf-acc">
        <summary>Assistenza{{ chevron }}</summary>
        <ul>{{ help_links }}</ul>
      </details>
      {%- if legal_links != blank -%}
        <details class="nf-acc">
          <summary>Informazioni legali{{ chevron }}</summary>
          <ul>{{ legal_links }}</ul>
        </details>
      {%- endif -%}
      <details class="nf-acc">
        <summary>{{ shop.name | capitalize }}{{ chevron }}</summary>
        <ul>{{ brand_links }}</ul>
      </details>
    {%- endif -%}
  </nav>

  <div class="nf-bottom">
    <div class="nf-brand">
      {%- assign shop_name_lower = shop.name | downcase -%}
      <span class="nf-logo">
        {%- if shop_name_lower == 'platinumshop' -%}Platinum<span>shop</span>{%- else -%}{{ shop.name | escape }}{%- endif -%}
      </span>
      {%- if shop.features.follow_on_shop? and section_settings.enable_follow_on_shop -%}
        <span class="nf-social">
        <span class="nf-follow">{{ newsletter_block.settings.title | default: 'Follow us' | escape }}</span>
        <button type="button" class="nf-shop" data-mobile-footer-follow>
          <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z"></path></svg>
          <span>{{ 'mobile.footer.follow_on' | t }} <b>shop</b></span>
        </button>
        </span>
        <span class="nf-shop-real" data-mobile-footer-follow-real aria-hidden="true">
          {% # theme-check-disable %}
          {{ shop | login_button: action: 'follow' }}
          {% # theme-check-enable %}
        </span>
      {%- endif -%}
    </div>

    {%- assign show_country = false -%}
    {%- if section_settings.enable_country_selector and localization.available_countries.size > 1 -%}{%- assign show_country = true -%}{%- endif -%}
    {%- assign show_language = false -%}
    {%- if section_settings.enable_language_selector and localization.available_languages.size > 1 -%}{%- assign show_language = true -%}{%- endif -%}
    {%- if show_country or show_language -%}
      {%- form 'localization', id: 'mobile-footer-localization', class: 'nf-sel' -%}
        {%- if show_country -%}
          <label class="nf-sel__item nf-sel__item--country">
            <span class="nf-sr">{{ 'mobile.footer.country_currency' | t }}</span>
            {{ localization.country | image_url: width: 36 | image_tag: class: 'nf-flag', alt: '', loading: 'lazy', width: 18, height: 12 }}
            <select name="country_code" data-mobile-footer-autosubmit>
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                  {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {%- endfor -%}
            </select>
          </label>
        {%- endif -%}
        {%- if show_language -%}
          <label class="nf-sel__item">
            <span class="nf-sr">{{ 'mobile.footer.language' | t }}</span>
            <select name="language_code" data-mobile-footer-autosubmit>
              {%- for language in localization.available_languages -%}
                <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                  {{- language.endonym_name | capitalize -}}
                </option>
              {%- endfor -%}
            </select>
          </label>
        {%- endif -%}
        <noscript><button type="submit">OK</button></noscript>
      {%- endform -%}
    {%- endif -%}

    {%- if section_settings.show_payment_methods and shop.enabled_payment_types.size > 0 -%}
      <ul class="nf-pay" aria-label="{{ 'mobile.footer.payment_methods' | t }}">
        {%- for payment_method in shop.enabled_payment_types -%}
          {%- comment -%} IDs préfixés : les mêmes SVG existent dans l'ancien footer (masqué), sinon les dégradés ne s'affichent pas. {%- endcomment -%}
          {%- capture payment_svg -%}{{ payment_method | payment_type_svg_tag }}{%- endcapture -%}
          <li>{{ payment_svg | replace: 'id="', 'id="nf-' | replace: 'url(#', 'url(#nf-' | replace: 'aria-labelledby="', 'aria-labelledby="nf-' | replace: 'href="#', 'href="#nf-' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="nf-end">
      <p class="nf-copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      <button type="button" class="nf-top" data-mobile-footer-top>
        Torna in cima
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M12 19V5M6 11l6-6 6 6"></path></svg>
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    const footer = document.querySelector('[data-mobile-footer]');
    if (!footer) return;

    footer.querySelectorAll('[data-mobile-footer-autosubmit]').forEach((select) => {
      select.addEventListener('change', () => select.form.submit());
    });

    const top = footer.querySelector('[data-mobile-footer-top]');
    if (top) {
      top.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    }

    // Note réelle : reprise du badge Ali Reviews du footer (app, rendu après chargement), sinon valeur des réglages.
    const rating = footer.querySelector('[data-mobile-footer-rating]');
    let ratingTries = 0;
    function syncRating() {
      if (!rating) return;
      const summary = document.querySelector('.alr-rv-badge-highlight-summary');
      const badge = summary || Array.from(document.querySelectorAll('.shopify-app-block')).find((block) => /verified reviews/i.test(block.textContent));
      const match = badge && badge.textContent.match(/(\d(?:[.,]\d)?)/);
      const value = match ? parseFloat(match[1].replace(',', '.')) : 0;
      if (!(value > 0 && value <= 5)) {
        if (ratingTries++ < 20) window.setTimeout(syncRating, 500);
        return;
      }
      rating.querySelector('[data-mobile-footer-rating-value]').textContent = String(value);
      rating.querySelector('.nf-stars').setAttribute('aria-label', value + ' su 5');
      rating.querySelector('.nf-stars em').style.width = (value * 20) + '%';
    }
    syncRating();

    // Le badge Ali Reviews ne se rend que visible : sur mobile il est placé, invisible, sous la carte de note.
    const ratingSource = footer.querySelector('[data-mobile-footer-rating-source]');
    const aliBadge = document.querySelector('.shopify-section-footer .alireview-review-badge-wrap');
    if (ratingSource && aliBadge && !footer.contains(aliBadge)) {
      const mobile = window.matchMedia('(max-width: 760px)');
      const marker = document.createComment('mobile-footer-ali-badge');
      aliBadge.before(marker);
      const placeBadge = () => {
        if (mobile.matches) ratingSource.appendChild(aliBadge);
        else marker.after(aliBadge);
      };
      placeBadge();
      mobile.addEventListener('change', placeBadge);
      new MutationObserver(() => {
        ratingTries = 0;
        syncRating();
      }).observe(aliBadge, { childList: true, subtree: true, characterData: true });
    }

    // "Segui su shop" : pilule du prototype qui déclenche le vrai bouton Shopify (lien de suivi officiel).
    const follow = footer.querySelector('[data-mobile-footer-follow]');
    if (follow) {
      follow.addEventListener('click', () => {
        const real = footer.querySelector('[data-mobile-footer-follow-real] shop-follow-button');
        const realButton = real && real.shadowRoot && real.shadowRoot.querySelector('button');
        if (realButton) realButton.click();
        else if (real) real.click();
      });
    }
  })();
</script>
