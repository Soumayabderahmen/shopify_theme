{%- comment -%}
  Feuille « Vantaggi esclusivi per l'articolo » de la fiche produit mobile (prototype v8), ouverte par la bande sous les
  photos (data-pdp-pt-sheet="vant", même mécanique que « Protezioni » et « Termini » : assets/pdp-mobile.js).
  Données réelles : coupon des réglages du thème « Coupon (mobile) » (code, %, toute la commande, sans minimum) et ses
  « Termini » (snippets/pdp-mobile-terms.liquid) ; livraison gratuite au seuil des réglages du thème (texte mis à jour par
  assets/pdp-mobile.js selon la variante et la devise) ; cambio 30 giorni et CashBack 10 % de la bande avantages du site.
  Params : code, percent, ship_base, ship_text
{%- endcomment -%}
{%- liquid
  assign vt_title = 'mobile.pdp.benefits_title' | t
  assign vt_words = vt_title | split: ' '
  assign vt_half = vt_words.size | divided_by: 2
  assign vt_first = vt_words | slice: 0, vt_half | join: ' '
  assign vt_rest_count = vt_words.size | minus: vt_half
  assign vt_rest = vt_words | slice: vt_half, vt_rest_count | join: ' '
  assign vt_ship_text = ship_text
  if vt_ship_text == blank
    assign vt_ship_text = 'mobile.pdp.free_shipping_order' | t
  endif
-%}
<dialog class="pdp-m__pt pdp-m__vs" data-pdp-pt="vant" aria-labelledby="pdp-vs-title">
  <div class="pdp-m__pt-in">
    <div class="pdp-m__pt-body" data-pdp-pt-body tabindex="-1" autofocus>
      <div class="pdp-m__vs-hd" data-pdp-pt-card="top">
        {%- comment -%} Textes des traductions déjà échappés par Shopify (apostrophe en &#39;) : pas d'escape en plus. {%- endcomment -%}
        <h2 id="pdp-vs-title">{% if vt_half > 0 %}{{ vt_first }}<br>{{ vt_rest }}{% else %}{{ vt_title }}{% endif %}</h2>
        {%- comment -%}
          Cadeau ouvert (couvercle basculé à gauche) d'où sort le logo « PL » de la boutique (snippets/pl-logo.liquid,
          lettres jaunes), incliné, le bas caché derrière le bord de la boîte ; ruban jaune assorti aux lettres.
          transform-origin 0 0 : le thème centre l'origine des transformations des éléments SVG, ce qui décalait le dessin.
        {%- endcomment -%}
        <svg viewBox="0 0 96 78" fill="none" aria-hidden="true"><defs><linearGradient id="pdp-vs-pl-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5a4bf0"/><stop offset="1" stop-color="#2a22b8"/></linearGradient></defs><g transform="rotate(12 50 22)" style="transform-origin: 0 0"><rect x="33" y="5" width="34" height="34" rx="9" fill="url(#pdp-vs-pl-g)" stroke="#16123f" stroke-width="2"/><g transform="translate(33 5) scale(.53125)" style="transform-origin: 0 0"><path fill="#ffd23f" fill-rule="evenodd" d="M12 15h12.5a10 10 0 0 1 0 20H20v14h-8zM20 22v6h4.2a3 3 0 0 0 0-6z"/><path fill="#ffd23f" d="M36.5 15h8v26H54v8H36.5z"/><circle cx="51" cy="18.5" r="3.6" fill="#fff"/></g></g><g stroke="#16123f" stroke-width="2.2" stroke-linejoin="round"><rect x="16" y="42" width="52" height="32" rx="2" fill="#d9d6ff"/><rect x="38" y="42" width="8" height="32" fill="#ffd23f"/><rect x="12" y="35" width="60" height="9" rx="2" fill="#d9d6ff"/><rect x="38" y="35" width="8" height="9" fill="#ffd23f"/><g transform="rotate(-24 14 35)" style="transform-origin: 0 0"><rect x="5" y="25" width="28" height="8" rx="2" fill="#c9c4ff"/></g></g><path d="M80 12l3 3m0-3l-3 3" stroke="#3a34d2" stroke-width="2" stroke-linecap="round"/><path d="M78 46c4-6 10-4 8 1" stroke="#3a34d2" stroke-width="2" stroke-linecap="round"/><path d="M24 12l2 2m0-2l-2 2" stroke="#3a34d2" stroke-width="1.8" stroke-linecap="round"/></svg>
      </div>

      {%- if code != blank -%}
        <div class="pdp-m__vcard">
          <span class="pdp-m__vi pdp-m__vi--cpn" aria-hidden="true"><svg viewBox="0 0 26 26"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h17A1.5 1.5 0 0 1 23 6.5V10a3 3 0 0 0 0 6v3.5a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 3 19.5V16a3 3 0 0 0 0-6z" fill="#f02d4b"/><path d="M13 7v2.2M13 11.9v2.2M13 16.8V19" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg></span>
          <div>
            <b>{{ 'mobile.pdp.coupon_title' | t: percent: percent }}</b>
            <p>{{ 'mobile.pdp.coupon_long' | t: percent: percent, code: code }}
              <button type="button" class="pdp-m__vlink" data-pdp-pt-sheet="terms" data-pdp-pt-open="coupon">{{ 'mobile.pdp.terms' | t }}</button></p>
          </div>
        </div>
      {%- endif -%}

      {%- if ship_base > 0 -%}
        <div class="pdp-m__vcard">
          <span class="pdp-m__vi pdp-m__vi--ship" aria-hidden="true"><svg viewBox="0 0 28 26"><path d="M2 7a1.5 1.5 0 0 1 1.5-1.5h12A1.5 1.5 0 0 1 17 7v11H2z" fill="#128c4a"/><path d="M17 10h5l4 4.5V18H17z" fill="#128c4a"/><path d="M19 11.5h2.6l2.2 2.6H19z" fill="#c9efd8"/><circle cx="7.5" cy="19" r="2.8" fill="#128c4a" stroke="#fff" stroke-width="1.6"/><circle cx="21" cy="19" r="2.8" fill="#128c4a" stroke="#fff" stroke-width="1.6"/></svg></span>
          <div>
            <b>{{ 'mobile.pdp.free_shipping' | t }}</b>
            <p data-pdp-ship-text>{{ vt_ship_text }}</p>
          </div>
        </div>
      {%- endif -%}

      <div class="pdp-m__vcard">
        <span class="pdp-m__vi pdp-m__vi--ex" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#3a34d2" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg></span>
        <div>
          <b>{{ 'mobile.home_shein.perk_exchange' | t }}</b>
          <p>{{ 'mobile.pdp.returns_text' | t }}</p>
        </div>
      </div>

      <div class="pdp-m__vcard">
        <span class="pdp-m__vi pdp-m__vi--cb" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#b07a00" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M15 9.5c-.5-1-1.6-1.5-3-1.5-1.7 0-3 .8-3 2s1.2 1.7 3 2 3 .8 3 2-1.3 2-3 2c-1.4 0-2.6-.6-3-1.6M12 6.5v11"/></svg></span>
        <div>
          <b>{{ 'mobile.home_shein.perk_cashback' | t }}</b>
          <p>{{ 'mobile.home_shein.perk_cashback_text' | t }}</p>
        </div>
      </div>

      <button class="pdp-m__vclose" type="button" data-pdp-pt-close>{{ 'mobile.pdp.close' | t }}</button>
    </div>
  </div>
</dialog>
