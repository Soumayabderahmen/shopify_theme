{%- comment -%}
  Shopify MAX Performance Engine
  Version: 6.0

  Goal:
  - Maximum practical storefront speed
  - Mobile-first / adaptive networking
  - IndexedDB + memory cache
  - Stale-while-revalidate
  - Product JSON cache
  - Shopify Section Rendering API
  - Predictive prefetch
  - IntersectionObserver
  - Speculation Rules
  - Request deduplication
  - Priority queues
  - Offline fallback
  - Cache quota protection
  - Cart/collection/product section refresh helpers

  IMPORTANT:
  - This script intentionally does NOT run on checkout/admin.
  - Shopify Checkout/Admin are separate Shopify surfaces and cannot be
    optimized by a normal theme script.
{%- endcomment -%}

{%- liquid
  assign excluded_templates = 'cart,checkout,password,customers' | split: ','
  assign is_excluded = false

  for tmpl in excluded_templates
    if template.name == tmpl
      assign is_excluded = true
      break
    endif
  endfor

  if request.path contains '/checkout'
    assign is_excluded = true
  endif

  if request.path contains '/account'
    assign is_excluded = true
  endif

  if request.path contains '/admin'
    assign is_excluded = true
  endif
-%}

{%- unless is_excluded -%}

<script>
  /* Desktop uniquement : sur mobile (≤ 760 px) le script s'arrêtait dès sa 1re ligne ; il n'est plus téléchargé du tout. */
  if (!window.matchMedia('(max-width: 760px)').matches) {
    (function () {
      var script = document.createElement('script');
      script.src = {{ 'max-performance.js' | asset_url | json }};
      document.head.appendChild(script);
    })();
  }
</script>

{%- endunless -%}
