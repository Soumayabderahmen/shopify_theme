{% comment %} {%- comment -%}
  IndexedDB Cache Manager - Professional Parallel Caching
  Excluded: checkout, cart, and admin paths
{%- endcomment -%}

{%- liquid
  assign excluded_templates = 'cart,checkout,password' | split: ','
  assign is_excluded = false
  for tmpl in excluded_templates
    if template.name == tmpl
      assign is_excluded = true
      break
    endif
  endfor
  if request.path contains '/checkout' or request.path contains '/account' or request.path contains '/admin'
    assign is_excluded = true
  endif
-%}

{%- unless is_excluded -%}
<script type="module">
  /**
   * ShopifyCacheManager
   * Version: 2.0 - Parallel & Non-blocking
   */
  class ShopifyCacheManager {
    constructor() {
      this.DB_NAME = 'ShopifyThemeCache_v1';
      this.DB_VERSION = 1;
      this.STORES = {
        products: 'products',
        paths: 'paths',
        pages: 'pages',
        metadata: 'metadata'
      };
      this.db = null;
      this.isReady = false;
      this.queue = [];
      this.maxParallel = 6; // Limite HTTP parallèle
    }

    async init() {
      if (!window.indexedDB) return;
      try {
        this.db = await this._openDB();
        this.isReady = true;
        this._processQueue();
        this._bootstrap();
      } catch (err) {
        console.warn('[Cache] Init failed:', err);
      }
    }

    _openDB() {
      return new Promise((resolve, reject) => {
        const request = indexedDB.open(this.DB_NAME, this.DB_VERSION);
        request.onerror = () => reject(request.error);
        request.onsuccess = () => resolve(request.result);
        request.onupgradeneeded = (event) => {
          const db = event.target.result;
          if (!db.objectStoreNames.contains(this.STORES.products)) {
            const productStore = db.createObjectStore(this.STORES.products, { keyPath: 'handle' });
            productStore.createIndex('id', 'id', { unique: false });
            productStore.createIndex('updatedAt', 'updatedAt', { unique: false });
          }
          if (!db.objectStoreNames.contains(this.STORES.paths)) {
            const pathStore = db.createObjectStore(this.STORES.paths, { keyPath: 'path' });
            pathStore.createIndex('lastVisited', 'lastVisited', { unique: false });
            pathStore.createIndex('template', 'template', { unique: false });
          }
          if (!db.objectStoreNames.contains(this.STORES.pages)) {
            db.createObjectStore(this.STORES.pages, { keyPath: 'path' });
          }
          if (!db.objectStoreNames.contains(this.STORES.metadata)) {
            db.createObjectStore(this.STORES.metadata, { keyPath: 'key' });
          }
        };
      });
    }

    async _bootstrap() {
      // Attendre que le navigateur soit idle ou après 2s max
      const idleFn = window.requestIdleCallback || ((cb) => setTimeout(cb, 2000));
      idleFn(() => {
        this._cacheCurrentPath();
        this._preloadVisibleProducts();
        this._prefetchLinkedPaths();
      }, { timeout: 2500 });
    }

    // --- Public API ---

    async getProduct(handle) {
      return this._get(this.STORES.products, handle);
    }

    async setProduct(handle, data) {
      const payload = {
        handle,
        id: data.id,
        title: data.title,
        price: data.price,
        compareAtPrice: data.compare_at_price,
        available: data.available,
        variants: data.variants,
        images: data.images,
        tags: data.tags,
        type: data.product_type,
        vendor: data.vendor,
        updatedAt: new Date().toISOString(),
        cachedAt: Date.now()
      };
      return this._put(this.STORES.products, payload);
    }

    async getPath(path) {
      return this._get(this.STORES.paths, path);
    }

    async setPath(path, data = {}) {
      const payload = {
        path,
        title: document.title,
        template: document.body.className.match(/template-(\S+)/)?.[1] || 'unknown',
        lastVisited: Date.now(),
        visitCount: (data.visitCount || 0) + 1,
        cachedAt: Date.now()
      };
      return this._put(this.STORES.paths, payload);
    }

    async getPage(path) {
      return this._get(this.STORES.pages, path);
    }

    async setPage(path, htmlSnapshot) {
      return this._put(this.STORES.pages, {
        path,
        html: htmlSnapshot,
        title: document.title,
        cachedAt: Date.now()
      });
    }

    // --- Core Operations ---

    _get(storeName, key) {
      return this._transaction(storeName, 'readonly', (store) => {
        return new Promise((resolve, reject) => {
          const req = store.get(key);
          req.onsuccess = () => resolve(req.result || null);
          req.onerror = () => reject(req.error);
        });
      });
    }

    _put(storeName, data) {
      return this._transaction(storeName, 'readwrite', (store) => {
        return new Promise((resolve, reject) => {
          const req = store.put(data);
          req.onsuccess = () => resolve(true);
          req.onerror = () => reject(req.error);
        });
      });
    }

    _transaction(storeName, mode, operation) {
      const execute = () => {
        try {
          const tx = this.db.transaction([storeName], mode);
          const store = tx.objectStore(storeName);
          return operation(store);
        } catch (err) {
          return Promise.reject(err);
        }
      };

      if (this.isReady) return execute();
      return new Promise((resolve, reject) => {
        this.queue.push(() => execute().then(resolve).catch(reject));
      });
    }

    _processQueue() {
      while (this.queue.length) {
        const job = this.queue.shift();
        try { job(); } catch (e) {}
      }
    }

    // --- Smart Preloading ---

    _cacheCurrentPath() {
      const path = window.location.pathname;
      this.setPath(path);
      // Snapshot léger du contenu principal (pour navigation instantanée future)
      const mainContent = document.getElementById('content')?.innerHTML;
      if (mainContent && mainContent.length < 500000) { // Max ~500KB
        this.setPage(path, mainContent);
      }
    }

    async _preloadVisibleProducts() {
      // Cible uniquement les produits visibles dans le viewport (IntersectionObserver)
      const productLinks = Array.from(document.querySelectorAll('a[href*="/products/"]'));
      const handles = [...new Set(productLinks.map(link => {
        const match = link.pathname.match(/\/products\/([a-z0-9\-]+)/);
        return match ? match[1] : null;
      }).filter(Boolean))];

      if (!handles.length) return;

      // Découpage en chunks parallèles
      const chunks = this._chunk(handles, this.maxParallel);
      
      for (const chunk of chunks) {
        await Promise.all(chunk.map(handle => this._fetchAndCacheProduct(handle)));
        // Petit délai entre les vagues pour laisser respirer le CPU/réseau
        await new Promise(r => setTimeout(r, 100));
      }
    }

    async _fetchAndCacheProduct(handle) {
      try {
        // Vérifier si déjà en cache et récent (< 1h)
        const existing = await this.getProduct(handle);
        if (existing && (Date.now() - existing.cachedAt < 3600000)) return;

        const res = await fetch(`/products/${handle}.json`, {
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json' }
        });
        if (!res.ok) return;
        const data = await res.json();
        if (data.product) {
          await this.setProduct(handle, data.product);
        }
      } catch (e) {
        // Silencieux par design
      }
    }

    async _prefetchLinkedPaths() {
      // Précharge les pages liées visibles (collections, pages, articles)
      const links = Array.from(document.querySelectorAll('a[href^="/"]'));
      const internalPaths = [...new Set(links
        .map(l => l.pathname)
        .filter(p => 
          !p.includes('/cart') && 
          !p.includes('/checkout') && 
          !p.includes('/account') &&
          p.length > 1
        ))].slice(0, 20); // Max 20 liens

      // Préchargement parallèle avec limite
      const chunks = this._chunk(internalPaths, 4);
      for (const chunk of chunks) {
        await Promise.all(chunk.map(path => this._softPrefetch(path)));
        await new Promise(r => setTimeout(r, 150));
      }
    }

    async _softPrefetch(path) {
      try {
        const existing = await this.getPath(path);
        if (existing) return; // Déjà visité/caché

        // Utilisation de fetch avec mode no-cors ou simple HEAD pour ne pas bloquer
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 3000);
        
        const res = await fetch(path, { 
          method: 'GET',
          signal: controller.signal,
          credentials: 'same-origin'
        });
        clearTimeout(timeout);
        
        if (res.ok) {
          await this.setPath(path, { visitCount: 0 });
        }
      } catch (e) {
        // Ignorer les timeouts/erreurs silencieusement
      }
    }

    _chunk(array, size) {
      const chunks = [];
      for (let i = 0; i < array.length; i += size) {
        chunks.push(array.slice(i, i + size));
      }
      return chunks;
    }

    // --- Cleanup ---
    async cleanup(maxAgeDays = 7) {
      const cutoff = Date.now() - (maxAgeDays * 86400000);
      // Nettoyage des vieux produits
      await this._clearStoreByIndex(this.STORES.products, 'updatedAt', cutoff);
      await this._clearStoreByIndex(this.STORES.paths, 'lastVisited', cutoff);
    }

    async _clearStoreByIndex(storeName, indexName, cutoff) {
      return this._transaction(storeName, 'readwrite', (store) => {
        return new Promise((resolve) => {
          const index = store.index(indexName);
          const range = IDBKeyRange.upperBound(new Date(cutoff).toISOString());
          const req = index.openCursor(range);
          req.onsuccess = (event) => {
            const cursor = event.target.result;
            if (cursor) {
              store.delete(cursor.primaryKey);
              cursor.continue();
            } else {
              resolve();
            }
          };
          req.onerror = () => resolve();
        });
      });
    }
  }

  // --- Initialisation ---
  const cacheManager = new ShopifyCacheManager();
  
  // Exposition globale contrôlée pour debug ou usage thématique
  window.ShopifyCache = cacheManager;
  
  // Démarrage différé après le premier rendu
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => cacheManager.init());
  } else {
    cacheManager.init();
  }
</script>
{%- endunless -%} {% endcomment %}


{%- comment -%}
  Shopify Smart Cache Manager
  Version: 4.0

  Features:
  - IndexedDB product/page/path cache
  - Mobile/network aware concurrency
  - Stale-while-revalidate
  - Offline fallback
  - Request deduplication
  - IntersectionObserver product preloading
  - Safe internal-link prefetching
  - AbortController timeouts
  - Automatic cache cleanup
  - Storage quota protection
  - Online/offline recovery
  - Shopify dynamic-page exclusions
{%- endcomment -%}





