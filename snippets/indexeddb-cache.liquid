<script type="module">
(() => {
  'use strict';

  if (window.ShopifySmartCache) return;

  class ShopifySmartCache {

    constructor() {
      /* ---------------------------------------------------------
         CONFIGURATION
      --------------------------------------------------------- */

      this.DB_NAME = 'ShopifySmartCache';
      this.DB_VERSION = 4;

      this.STORES = {
        products: 'products',
        pages: 'pages',
        paths: 'paths',
        metadata: 'metadata'
      };

      this.VERSION = '4.0.0';

      this.TTL = {
        product: 60 * 60 * 1000,           // 1 hour
        page: 30 * 60 * 1000,              // 30 minutes
        path: 24 * 60 * 60 * 1000          // 24 hours
      };

      this.MAX = {
        products: 100,
        pages: 30,
        paths: 100
      };

      this.TIMEOUT = {
        product: 5000,
        page: 5000
      };

      this.db = null;
      this.ready = false;
      this.destroyed = false;

      this.initPromise = null;

      /*
       * Prevent duplicate requests:
       *
       * Map<key, Promise>
       */
      this.inFlight = new Map();

      /*
       * Prevent multiple cleanup operations.
       */
      this.cleanupRunning = false;

      /*
       * Connection state.
       */
      this.online = navigator.onLine !== false;

      /*
       * Detect mobile / constrained connections.
       */
      this.connection = this._getConnectionInfo();

      this.maxParallel = this._calculateConcurrency();

      /*
       * Small queue for DB operations before IndexedDB is ready.
       */
      this.queue = [];

      /*
       * Observers.
       */
      this.productObserver = null;
      this.linkObserver = null;

      /*
       * Performance flags.
       */
      this.startedAt = performance.now();
    }


    /* =========================================================
       PUBLIC INITIALIZATION
    ========================================================= */

    async init() {

      if (this.initPromise) {
        return this.initPromise;
      }

      this.initPromise = (async () => {

        if (!('indexedDB' in window)) {
          console.warn('[SmartCache] IndexedDB unavailable.');
          return false;
        }

        try {

          this.db = await this._openDB();

          this.ready = true;

          this._processQueue();

          this._bindNetworkEvents();

          /*
           * Do not perform heavy work during initial rendering.
           */
          this._runWhenIdle(() => {

            if (this.destroyed) return;

            this._cacheCurrentPage();

            this._observeProducts();

            this._observeInternalLinks();

            this._runMaintenance();

          });

          return true;

        } catch (error) {

          console.warn(
            '[SmartCache] Initialization failed:',
            error
          );

          return false;
        }

      })();

      return this.initPromise;
    }


    /* =========================================================
       CONNECTION / MOBILE OPTIMIZATION
    ========================================================= */

    _getConnectionInfo() {

      const connection =
        navigator.connection ||
        navigator.mozConnection ||
        navigator.webkitConnection;

      return {
        type: connection?.effectiveType || 'unknown',
        saveData: connection?.saveData === true,
        downlink: Number(connection?.downlink || 0),
        rtt: Number(connection?.rtt || 0)
      };
    }


    _calculateConcurrency() {

      const info = this.connection;

      /*
       * Very conservative on mobile networks.
       */
      if (info.saveData) {
        return 1;
      }

      if (
        info.type === 'slow-2g' ||
        info.type === '2g'
      ) {
        return 1;
      }

      if (info.type === '3g') {
        return 2;
      }

      /*
       * Mobile devices should generally stay
       * below desktop-level parallelism.
       */
      const isMobile =
        /Android|iPhone|iPad|iPod|Mobile/i.test(
          navigator.userAgent
        );

      if (isMobile) {
        return 3;
      }

      return 5;
    }


    _shouldPrefetch() {

      if (!this.online) {
        return false;
      }

      if (this.connection.saveData) {
        return false;
      }

      if (
        this.connection.type === 'slow-2g' ||
        this.connection.type === '2g'
      ) {
        return false;
      }

      return true;
    }


    /* =========================================================
       INDEXED DB
    ========================================================= */

    _openDB() {

      return new Promise((resolve, reject) => {

        const request = indexedDB.open(
          this.DB_NAME,
          this.DB_VERSION
        );

        request.onerror = () => {
          reject(request.error);
        };

        request.onsuccess = () => {
          const db = request.result;

          db.onversionchange = () => {
            db.close();
          };

          resolve(db);
        };

        request.onupgradeneeded = event => {

          const db = event.target.result;
          const transaction = event.target.transaction;

          /*
           * PRODUCTS
           */

          let products;

          if (!db.objectStoreNames.contains(this.STORES.products)) {

            products = db.createObjectStore(
              this.STORES.products,
              { keyPath: 'handle' }
            );

          } else {

            products =
              transaction.objectStore(
                this.STORES.products
              );
          }

          this._safeIndex(
            products,
            'cachedAt',
            'cachedAt'
          );

          this._safeIndex(
            products,
            'updatedAt',
            'updatedAt'
          );


          /*
           * PATHS
           */

          let paths;

          if (!db.objectStoreNames.contains(this.STORES.paths)) {

            paths = db.createObjectStore(
              this.STORES.paths,
              { keyPath: 'path' }
            );

          } else {

            paths =
              transaction.objectStore(
                this.STORES.paths
              );
          }

          this._safeIndex(
            paths,
            'lastVisited',
            'lastVisited'
          );


          /*
           * PAGES
           */

          if (!db.objectStoreNames.contains(this.STORES.pages)) {

            db.createObjectStore(
              this.STORES.pages,
              { keyPath: 'path' }
            );
          }


          /*
           * METADATA
           */

          if (!db.objectStoreNames.contains(this.STORES.metadata)) {

            db.createObjectStore(
              this.STORES.metadata,
              { keyPath: 'key' }
            );
          }
        };
      });
    }


    _safeIndex(store, name, keyPath) {

      if (!store.indexNames.contains(name)) {

        try {
          store.createIndex(
            name,
            keyPath,
            { unique: false }
          );
        } catch (_) {}
      }
    }


    /* =========================================================
       GENERIC DB OPERATIONS
    ========================================================= */

    _transaction(storeName, mode, operation) {

      const execute = () => {

        if (!this.db) {
          return Promise.reject(
            new Error('IndexedDB is not ready')
          );
        }

        return new Promise((resolve, reject) => {

          let transaction;

          try {

            transaction =
              this.db.transaction(
                storeName,
                mode
              );

          } catch (error) {

            reject(error);
            return;
          }

          const store =
            transaction.objectStore(
              storeName
            );

          let operationResult;

          try {

            operationResult = operation(store);

          } catch (error) {

            reject(error);
            return;
          }

          Promise.resolve(operationResult)
            .then(resolve)
            .catch(reject);
        });
      };

      if (this.ready) {
        return execute();
      }

      return new Promise((resolve, reject) => {

        this.queue.push(() => {

          execute()
            .then(resolve)
            .catch(reject);

        });
      });
    }


    _processQueue() {

      const jobs = this.queue.splice(
        0,
        this.queue.length
      );

      for (const job of jobs) {

        try {
          job();
        } catch (_) {}
      }
    }


    _get(storeName, key) {

      return this._transaction(
        storeName,
        'readonly',
        store => {

          return new Promise(
            (resolve, reject) => {

              const request =
                store.get(key);

              request.onsuccess = () => {
                resolve(
                  request.result || null
                );
              };

              request.onerror = () => {
                reject(request.error);
              };
            }
          );
        }
      );
    }


    _put(storeName, data) {

      return this._transaction(
        storeName,
        'readwrite',
        store => {

          return new Promise(
            (resolve, reject) => {

              const request =
                store.put(data);

              request.onsuccess = () => {
                resolve(true);
              };

              request.onerror = () => {
                reject(request.error);
              };
            }
          );
        }
      );
    }


    _delete(storeName, key) {

      return this._transaction(
        storeName,
        'readwrite',
        store => {

          return new Promise(
            (resolve, reject) => {

              const request =
                store.delete(key);

              request.onsuccess = () => {
                resolve(true);
              };

              request.onerror = () => {
                reject(request.error);
              };
            }
          );
        }
      );
    }


    /* =========================================================
       PRODUCTS
    ========================================================= */

    async getProduct(handle) {

      if (!handle) {
        return null;
      }

      return this._get(
        this.STORES.products,
        handle
      );
    }


    async setProduct(handle, product) {

      if (!handle || !product) {
        return false;
      }

      const now = Date.now();

      const payload = {

        handle,

        id: product.id ?? null,

        title: product.title ?? '',

        price: product.price ?? null,

        compareAtPrice:
          product.compare_at_price ?? null,

        available:
          Boolean(product.available),

        variants:
          Array.isArray(product.variants)
            ? product.variants
            : [],

        images:
          Array.isArray(product.images)
            ? product.images
            : [],

        tags:
          Array.isArray(product.tags)
            ? product.tags
            : [],

        type:
          product.product_type ?? '',

        vendor:
          product.vendor ?? '',

        updatedAt: now,

        cachedAt: now
      };

      await this._put(
        this.STORES.products,
        payload
      );

      return true;
    }


    async getFreshProduct(handle) {

      const cached =
        await this.getProduct(handle);

      if (!cached) {
        return null;
      }

      return {
        data: cached,
        fresh:
          Date.now() -
          cached.cachedAt <
          this.TTL.product
      };
    }


    async fetchProduct(handle) {

      if (!handle) {
        return null;
      }

      /*
       * Deduplicate identical requests.
       */

      const existingRequest =
        this.inFlight.get(
          `product:${handle}`
        );

      if (existingRequest) {
        return existingRequest;
      }

      const request =
        this._fetchProductInternal(handle);

      this.inFlight.set(
        `product:${handle}`,
        request
      );

      try {

        return await request;

      } finally {

        this.inFlight.delete(
          `product:${handle}`
        );
      }
    }


    async _fetchProductInternal(handle) {

      try {

        const cached =
          await this.getFreshProduct(
            handle
          );

        /*
         * Fresh cache:
         * return immediately.
         */

        if (cached?.fresh) {

          return cached.data;
        }

        /*
         * Stale cache:
         * return it immediately if available,
         * while refreshing in background.
         */

        if (cached?.data) {

          this._backgroundRefreshProduct(
            handle
          );

          return cached.data;
        }

        /*
         * No cache:
         * fetch from Shopify.
         */

        return await this._networkFetchProduct(
          handle
        );

      } catch (error) {

        console.warn(
          '[SmartCache] Product error:',
          handle,
          error
        );

        return null;
      }
    }


    async _backgroundRefreshProduct(handle) {

      try {

        await this._networkFetchProduct(
          handle
        );

      } catch (_) {}
    }


    async _networkFetchProduct(handle) {

      const controller =
        new AbortController();

      const timeout =
        setTimeout(
          () => controller.abort(),
          this.TIMEOUT.product
        );

      try {

        if (!this.online) {
          return this.getProduct(handle);
        }

        const response =
          await fetch(
            `/products/${encodeURIComponent(handle)}.json`,
            {
              method: 'GET',
              credentials: 'same-origin',
              headers: {
                'Accept': 'application/json'
              },
              cache: 'no-store',
              signal: controller.signal
            }
          );

        if (!response.ok) {
          throw new Error(
            `HTTP ${response.status}`
          );
        }

        const data =
          await response.json();

        if (!data?.product) {
          return null;
        }

        await this.setProduct(
          handle,
          data.product
        );

        return this.getProduct(
          handle
        );

      } finally {

        clearTimeout(timeout);
      }
    }


    /* =========================================================
       CURRENT PAGE CACHE
    ========================================================= */

    async _cacheCurrentPage() {

      try {

        const path =
          this._normalizePath(
            window.location.pathname
          );

        if (!path) return;

        const main =
          document.querySelector(
            '#content, main, [role="main"]'
          );

        if (!main) return;

        const html =
          main.innerHTML;

        /*
         * Protect mobile storage.
         */
        if (
          !html ||
          html.length > 350000
        ) {
          return;
        }

        await this.setPage(
          path,
          html
        );

        await this.setPath(
          path
        );

      } catch (error) {

        console.warn(
          '[SmartCache] Page cache failed:',
          error
        );
      }
    }


    async getPage(path) {

      return this._get(
        this.STORES.pages,
        this._normalizePath(path)
      );
    }


    async setPage(path, html) {

      if (!path || !html) {
        return false;
      }

      return this._put(
        this.STORES.pages,
        {
          path:
            this._normalizePath(path),

          html,

          title:
            document.title,

          cachedAt:
            Date.now()
        }
      );
    }


    /* =========================================================
       PATH CACHE
    ========================================================= */

    async getPath(path) {

      return this._get(
        this.STORES.paths,
        this._normalizePath(path)
      );
    }


    async setPath(path, data = {}) {

      const normalized =
        this._normalizePath(path);

      if (!normalized) {
        return false;
      }

      const previous =
        await this.getPath(
          normalized
        );

      const payload = {

        path: normalized,

        title:
          data.title ||
          previous?.title ||
          document.title,

        template:
          data.template ||
          previous?.template ||
          'unknown',

        lastVisited:
          Date.now(),

        visitCount:
          (previous?.visitCount || 0) + 1,

        cachedAt:
          Date.now()
      };

      return this._put(
        this.STORES.paths,
        payload
      );
    }


    /* =========================================================
       PRODUCT OBSERVER
    ========================================================= */

    _observeProducts() {

      if (!('IntersectionObserver' in window)) {

        /*
         * Fallback:
         * only preload first few products.
         */

        const links =
          Array.from(
            document.querySelectorAll(
              'a[href*="/products/"]'
            )
          ).slice(0, 3);

        for (const link of links) {

          const handle =
            this._extractProductHandle(
              link
            );

          if (handle) {
            this._scheduleProduct(
              handle
            );
          }
        }

        return;
      }


      this.productObserver =
        new IntersectionObserver(
          entries => {

            for (const entry of entries) {

              if (!entry.isIntersecting) {
                continue;
              }

              const handle =
                this._extractProductHandle(
                  entry.target
                );

              if (handle) {

                this._scheduleProduct(
                  handle
                );
              }

              this.productObserver.unobserve(
                entry.target
              );
            }

          },
          {
            /*
             * Start loading before
             * the product reaches screen.
             */
            rootMargin:
              '500px 0px 500px 0px',

            threshold: 0
          }
        );


      const links =
        document.querySelectorAll(
          'a[href*="/products/"]'
        );

      /*
       * Limit observed elements.
       * Prevent huge collections from
       * generating excessive work.
       */

      const limit =
        this._isMobile()
          ? 12
          : 30;

      Array.from(links)
        .slice(0, limit)
        .forEach(link => {

          this.productObserver.observe(
            link
          );
        });
    }


    _scheduleProduct(handle) {

      if (!this._shouldPrefetch()) {
        return;
      }

      /*
       * Do not block rendering.
       */
      this._runWhenIdle(() => {

        this.fetchProduct(handle)
          .catch(() => {});

      });
    }


    /* =========================================================
       INTERNAL LINK PREFETCH
    ========================================================= */

    _observeInternalLinks() {

      if (!this._shouldPrefetch()) {
        return;
      }

      if (!('IntersectionObserver' in window)) {
        return;
      }

      this.linkObserver =
        new IntersectionObserver(
          entries => {

            for (const entry of entries) {

              if (!entry.isIntersecting) {
                continue;
              }

              const path =
                this._getSafeInternalPath(
                  entry.target
                );

              if (path) {

                this._schedulePathPrefetch(
                  path
                );
              }

              this.linkObserver.unobserve(
                entry.target
              );
            }

          },
          {
            rootMargin:
              '700px 0px 700px 0px',

            threshold: 0
          }
        );


      const links =
        document.querySelectorAll(
          'a[href^="/"]'
        );

      /*
       * Only observe a limited number.
       */
      const limit =
        this._isMobile()
          ? 8
          : 20;

      Array.from(links)
        .slice(0, limit)
        .forEach(link => {

          if (
            this._getSafeInternalPath(
              link
            )
          ) {

            this.linkObserver.observe(
              link
            );
          }
        });
    }


    _schedulePathPrefetch(path) {

      if (!this._shouldPrefetch()) {
        return;
      }

      this._runWhenIdle(
        () => this._softPrefetch(path)
      );
    }


    async _softPrefetch(path) {

      const normalized =
        this._normalizePath(path);

      if (!normalized) {
        return;
      }

      /*
       * Don't request same URL twice.
       */

      const key =
        `page:${normalized}`;

      if (this.inFlight.has(key)) {
        return this.inFlight.get(key);
      }

      const existing =
        await this.getPage(
          normalized
        );

      /*
       * Existing and fresh:
       * nothing to do.
       */

      if (
        existing &&
        Date.now() -
          existing.cachedAt <
          this.TTL.page
      ) {
        return;
      }

      const promise =
        this._fetchPage(
          normalized
        );

      this.inFlight.set(
        key,
        promise
      );

      try {

        return await promise;

      } finally {

        this.inFlight.delete(
          key
        );
      }
    }


    async _fetchPage(path) {

      const controller =
        new AbortController();

      const timeout =
        setTimeout(
          () => controller.abort(),
          this.TIMEOUT.page
        );

      try {

        const response =
          await fetch(
            path,
            {
              method: 'GET',
              credentials: 'same-origin',
              headers: {
                'Accept':
                  'text/html'
              },
              cache: 'no-store',
              signal: controller.signal
            }
          );

        if (!response.ok) {
          return null;
        }

        const html =
          await response.text();

        /*
         * Don't cache massive pages.
         */
        if (
          html.length < 350000
        ) {

          await this.setPage(
            path,
            html
          );

          await this.setPath(
            path
          );
        }

        return true;

      } catch (error) {

        /*
         * Network failures are normal
         * on mobile. Keep them silent.
         */
        return null;

      } finally {

        clearTimeout(timeout);
      }
    }


    /* =========================================================
       NETWORK EVENTS
    ========================================================= */

    _bindNetworkEvents() {

      window.addEventListener(
        'online',
        () => {

          this.online = true;

          this.connection =
            this._getConnectionInfo();

          this.maxParallel =
            this._calculateConcurrency();

          /*
           * Refresh current page cache
           * after reconnecting.
           */
          this._runWhenIdle(
            () => this._cacheCurrentPage()
          );

        },
        { passive: true }
      );


      window.addEventListener(
        'offline',
        () => {

          this.online = false;

        },
        { passive: true }
      );
    }


    /* =========================================================
       MAINTENANCE / CLEANUP
    ========================================================= */

    async _runMaintenance() {

      /*
       * Don't run maintenance repeatedly.
       */
      if (this.cleanupRunning) {
        return;
      }

      this.cleanupRunning = true;

      try {

        await this._cleanupExpired();

        await this._enforceLimits();

      } catch (error) {

        console.warn(
          '[SmartCache] Cleanup error:',
          error
        );

      } finally {

        this.cleanupRunning = false;
      }
    }


    async _cleanupExpired() {

      const now =
        Date.now();

      /*
       * Products
       */
      await this._deleteOlderThan(
        this.STORES.products,
        'cachedAt',
        now - this.TTL.product * 3
      );

      /*
       * Pages
       */
      await this._deleteOlderThan(
        this.STORES.pages,
        'cachedAt',
        now - this.TTL.page * 4
      );

      /*
       * Paths
       */
      await this._deleteOlderThan(
        this.STORES.paths,
        'lastVisited',
        now - this.TTL.path * 3
      );
    }


    async _deleteOlderThan(
      storeName,
      indexName,
      cutoff
    ) {

      return this._transaction(
        storeName,
        'readwrite',
        store => {

          return new Promise(
            resolve => {

              let index;

              try {

                index =
                  store.index(
                    indexName
                  );

              } catch (_) {

                resolve();
                return;
              }

              const request =
                index.openCursor(
                  IDBKeyRange.upperBound(
                    cutoff
                  )
                );

              request.onsuccess =
                event => {

                  const cursor =
                    event.target.result;

                  if (!cursor) {

                    resolve();
                    return;
                  }

                  try {
                    cursor.delete();
                  } catch (_) {}

                  cursor.continue();
                };

              request.onerror =
                () => resolve();
            }
          );
        }
      );
    }


    async _enforceLimits() {

      /*
       * Keep cache bounded.
       */
      await this._trimStore(
        this.STORES.products,
        this.MAX.products,
        'cachedAt'
      );

      await this._trimStore(
        this.STORES.pages,
        this.MAX.pages,
        'cachedAt'
      );

      await this._trimStore(
        this.STORES.paths,
        this.MAX.paths,
        'lastVisited'
      );
    }


    async _trimStore(
      storeName,
      maxItems,
      indexName
    ) {

      return this._transaction(
        storeName,
        'readwrite',
        store => {

          return new Promise(
            resolve => {

              const items = [];

              let index;

              try {

                index =
                  store.index(
                    indexName
                  );

              } catch (_) {

                resolve();
                return;
              }

              const request =
                index.openCursor();

              request.onsuccess =
                event => {

                  const cursor =
                    event.target.result;

                  if (cursor) {

                    items.push({
                      key:
                        cursor.primaryKey,

                      value:
                        cursor.value[
                          indexName
                        ]
                    });

                    cursor.continue();

                    return;
                  }

                  /*
                   * Oldest first.
                   */
                  items.sort(
                    (a, b) =>
                      Number(a.value || 0) -
                      Number(b.value || 0)
                  );

                  const removeCount =
                    Math.max(
                      0,
                      items.length -
                      maxItems
                    );

                  for (
                    let i = 0;
                    i < removeCount;
                    i++
                  ) {

                    try {
                      store.delete(
                        items[i].key
                      );
                    } catch (_) {}
                  }

                  resolve();
                };

              request.onerror =
                () => resolve();
            }
          );
        }
      );
    }


    /* =========================================================
       STORAGE QUOTA
    ========================================================= */

    async getStorageInfo() {

      if (
        !navigator.storage ||
        !navigator.storage.estimate
      ) {
        return null;
      }

      try {

        return await navigator.storage.estimate();

      } catch (_) {

        return null;
      }
    }


    async protectStorage() {

      const info =
        await this.getStorageInfo();

      if (!info?.quota) {
        return;
      }

      const usageRatio =
        info.usage /
        info.quota;

      /*
       * If cache is approaching
       * browser quota, clean aggressively.
       */
      if (usageRatio > 0.80) {

        await this._deleteOlderThan(
          this.STORES.products,
          'cachedAt',
          Date.now() -
            this.TTL.product
        );

        await this._deleteOlderThan(
          this.STORES.pages,
          'cachedAt',
          Date.now() -
            this.TTL.page
        );
      }
    }


    /* =========================================================
       HELPERS
    ========================================================= */

    _normalizePath(path) {

      if (!path) {
        return null;
      }

      try {

        const url =
          new URL(
            path,
            window.location.origin
          );

        /*
         * Only same-origin paths.
         */
        if (
          url.origin !==
          window.location.origin
        ) {
          return null;
        }

        /*
         * Remove query/hash from
         * cache key by default.
         */
        return (
          url.pathname
            .replace(
              /\/{2,}/g,
              '/'
            )
            .replace(
              /\/$/,
              ''
            ) || '/'
        );

      } catch (_) {

        return null;
      }
    }


    _extractProductHandle(link) {

      try {

        const url =
          new URL(
            link.href,
            window.location.origin
          );

        const match =
          url.pathname.match(
            /\/products\/([^/?#]+)/
          );

        return match
          ? decodeURIComponent(
              match[1]
            )
          : null;

      } catch (_) {

        return null;
      }
    }


    _getSafeInternalPath(link) {

      try {

        const url =
          new URL(
            link.href,
            window.location.origin
          );

        if (
          url.origin !==
          window.location.origin
        ) {
          return null;
        }

        const path =
          url.pathname;

        /*
         * Never prefetch dynamic /
         * sensitive Shopify routes.
         */
        const blocked = [
          '/cart',
          '/checkout',
          '/account',
          '/admin',
          '/search',
          '/challenge',
          '/password'
        ];

        if (
          blocked.some(
            prefix =>
              path === prefix ||
              path.startsWith(
                `${prefix}/`
              )
          )
        ) {
          return null;
        }

        if (
          path.includes('.')
        ) {
          return null;
        }

        return this._normalizePath(
          path
        );

      } catch (_) {

        return null;
      }
    }


    _isMobile() {

      return /Android|iPhone|iPad|iPod|Mobile/i
        .test(
          navigator.userAgent
        );
    }


    _runWhenIdle(callback) {

      if (
        typeof window.requestIdleCallback ===
        'function'
      ) {

        window.requestIdleCallback(
          callback,
          {
            timeout: 2500
          }
        );

      } else {

        setTimeout(
          callback,
          this._isMobile()
            ? 1200
            : 500
        );
      }
    }


    /* =========================================================
       PUBLIC CACHE CONTROL
    ========================================================= */

    async clearAll() {

      for (
        const storeName of
        Object.values(this.STORES)
      ) {

        await this._transaction(
          storeName,
          'readwrite',
          store => {

            return new Promise(
              resolve => {

                const request =
                  store.clear();

                request.onsuccess =
                  () => resolve();

                request.onerror =
                  () => resolve();
              }
            );
          }
        );
      }

      return true;
    }


    destroy() {

      this.destroyed = true;

      try {

        this.productObserver?.disconnect();

        this.linkObserver?.disconnect();

        this.db?.close();

      } catch (_) {}

      this.productObserver = null;
      this.linkObserver = null;
      this.inFlight.clear();
    }
  }


  /* ===========================================================
     START
  =========================================================== */

  const cache =
    new ShopifySmartCache();

  /*
   * Controlled global API.
   *
   * Examples:
   *
   * ShopifySmartCache.getProduct('my-product')
   * ShopifySmartCache.fetchProduct('my-product')
   * ShopifySmartCache.clearAll()
   */
  window.ShopifySmartCache = cache;


  /*
   * Start only after DOM is ready.
   */

  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      () => cache.init(),
      {
        once: true
      }
    );

  } else {

    cache.init();
  }


  /*
   * Protect storage periodically.
   */
  setTimeout(
    () => cache.protectStorage(),
    15000
  );

})();
</script>

{%- endunless -%} {% endcomment %}



{%- comment -%}
  Shopify MAX Performance Engine
  Version: 6.0

  Goal:
  - Maximum practical storefront speed
  - Mobile-first / adaptive networking
  - IndexedDB + memory cache
  - Stale-while-revalidate
  - Product JSON cache
  - Shopify Section Rendering API
  - Predictive prefetch
  - IntersectionObserver
  - Speculation Rules
  - Request deduplication
  - Priority queues
  - Offline fallback
  - Cache quota protection
  - Cart/collection/product section refresh helpers

  IMPORTANT:
  - This script intentionally does NOT run on checkout/admin.
  - Shopify Checkout/Admin are separate Shopify surfaces and cannot be
    optimized by a normal theme script.
{%- endcomment -%}

{%- liquid
  assign excluded_templates = 'cart,checkout,password,customers' | split: ','
  assign is_excluded = false

  for tmpl in excluded_templates
    if template.name == tmpl
      assign is_excluded = true
      break
    endif
  endfor

  if request.path contains '/checkout'
    assign is_excluded = true
  endif

  if request.path contains '/account'
    assign is_excluded = true
  endif

  if request.path contains '/admin'
    assign is_excluded = true
  endif
-%}

{%- unless is_excluded -%}

<script>
  /* Desktop uniquement : sur mobile (≤ 760 px) le script s'arrêtait dès sa 1re ligne ; il n'est plus téléchargé du tout. */
  if (!window.matchMedia('(max-width: 760px)').matches) {
    (function () {
      var script = document.createElement('script');
      script.src = {{ 'max-performance.js' | asset_url | json }};
      document.head.appendChild(script);
    })();
  }
</script>

{%- endunless -%}
