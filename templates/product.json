r'),panel=document.getElementById('scPanel'),closeBtn=document.getElementById('scClose'),overlay=document.getElementById('scOverlay'),drawer=document.getElementById('scDrawer'),drawerClose=document.getElementById('scDrawerClose');if(!trigger)return;function isMobile(){return window.innerWidth<MOBILE_BP}var savedScrollY=0;function lockBody(){savedScrollY=window.scrollY||window.pageYOffset;document.body.style.position='fixed';document.body.style.top='-'+savedScrollY+'px';document.body.style.left='0';document.body.style.right='0';document.body.style.overflow='hidden'}function unlockBody(){document.body.style.position='';document.body.style.top='';document.body.style.left='';document.body.style.right='';document.body.style.overflow='';window.scrollTo(0,savedScrollY)}function isOpen(){return isMobile()?drawer.classList.contains('is-open'):panel.classList.contains('is-open')}function openPanel(){if(isMobile()){overlay.classList.add('is-open');overlay.setAttribute('aria-hidden','false');drawer.classList.add('is-visible');drawer.setAttribute('aria-hidden','false');lockBody();requestAnimationFrame(function(){requestAnimationFrame(function(){drawer.classList.add('is-open')})})}else{panel.classList.add('is-open');panel.setAttribute('aria-hidden','false');trigger.setAttribute('aria-expanded','true')}}function closePanel(){if(isMobile()){drawer.classList.remove('is-open');overlay.classList.remove('is-open');overlay.setAttribute('aria-hidden','true');drawer.setAttribute('aria-hidden','true');unlockBody();setTimeout(function(){drawer.classList.remove('is-visible')},360)}else{panel.classList.remove('is-open');panel.setAttribute('aria-hidden','true');trigger.setAttribute('aria-expanded','false')}}trigger.addEventListener('click',function(e){e.stopPropagation();isOpen()?closePanel():openPanel()});if(closeBtn)closeBtn.addEventListener('click',closePanel);if(drawerClose)drawerClose.addEventListener('click',closePanel);if(overlay)overlay.addEventListener('click',closePanel);document.addEventListener('click',function(e){if(!isMobile()&&panel.classList.contains('is-open')&&!panel.contains(e.target)&&e.target!==trigger&&!trigger.contains(e.target))closePanel()});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&isOpen())closePanel()})}());\n</script>\n{% endif %}"
