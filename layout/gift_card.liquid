<!doctype html>
{%- assign rtl_languages = 'ae,ar,arc,bcc,bqi,ckb,dv,fa,glk,ha,he,kwh,ks,ku,mzn,nqo,pnb,ps,sd,ug,ur,yi' | split: ',' %}
<html
  lang="{{ request.locale.iso_code }}"
  data-theme="xtra"
  dir="{% if rtl_languages contains localization.language.iso_code %}rtl{% else %}ltr{% endif %}"
  class="no-js t1pl{% if request.design_mode %} theme-editor{% endif %}"
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    {%- assign formatted_initial_value = gift_card.initial_value | money_without_trailing_zeros: gift_card.currency -%}
    {%- assign formatted_initial_value_stripped = formatted_initial_value | strip_html -%}
    <title>{{ 'gift_cards.issued.page_title' | t: value: formatted_initial_value_stripped, shop: shop.name }}</title>
    <meta name="theme-color" content="{{ settings.default_color_scheme.settings.accent }}">
    <meta name="MobileOptimized" content="320">
    <meta name="HandheldFriendly" content="true">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=5, viewport-fit=cover, shrink-to-fit=no"
    >
    <meta name="format-detection" content="telephone=no">
    <meta name="msapplication-config" content="{{ 'browserconfig.xml' | asset_url }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {% unless settings.heading_font.system? -%}
      {%- assign heading_font_url = settings.heading_font | font_url -%}
      {{ heading_font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless %}
    {% unless settings.body_font.system? -%}
      {%- assign body_font_url = settings.body_font | font_url -%}
      {%- unless body_font_url == heading_font_url -%}
        {{ body_font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
      {%- endunless -%}
    {%- endunless %}
    {%- if settings.custom_primary_font_snippet -%}{{ settings.custom_primary_font_snippet }}{%- endif -%}
    {%- if settings.custom_secondary_font_snippet -%}{{ settings.custom_secondary_font_snippet }}{%- endif -%}
    {{ 'screen.css' | asset_url | stylesheet_tag: preload: true, media: 'screen' }}
    {{ 'theme-xtra.css' | asset_url | stylesheet_tag: media: 'screen' }}
    {{ 'async-print.css' | asset_url | stylesheet_tag: media: 'print' }}
    {% if rtl_languages contains localization.language.iso_code -%}
      {{ 'rtl.css' | asset_url | stylesheet_tag: preload: true, media: 'screen' }}
    {%- endif %}
    <noscript><link rel="stylesheet" href="{{ 'async-menu.css' | asset_url }}"></noscript>
    <link media="all" rel="stylesheet" href="{{ 'page-misc.css' | asset_url }}" id="misc-css">
    {%- if settings.favicon -%}
      {%- assign favicon_url = settings.favicon | image_url: width: 32, height: 32 -%}
      {%- assign favicon_no_query = favicon_url | split: '?' | first -%}
      {%- assign favicon_ext = favicon_no_query | split: '.' | last | downcase -%}
      {%- assign apple_touch_icon_url = settings.favicon | image_url: width: 180, height: 180 -%}

      {%- if favicon_ext == 'svg' -%}
        <link rel="icon" href="{{ favicon_url }}" type="image/svg+xml">
      {%- elsif favicon_ext == 'png' -%}
        <link rel="icon" href="{{ favicon_url }}" type="image/png">
      {%- else -%}
        <link rel="icon" href="{{ favicon_url }}">
      {%- endif -%}

      {%- if favicon_ext == 'svg' -%}
        <link rel="mask-icon" href="{{ favicon_url }}" color="#333333">
      {%- endif -%}
      <link rel="apple-touch-icon" href="{{ apple_touch_icon_url }}">
    {%- endif -%}
    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
    {% render 'social-meta-tags' %}
    {% render 'standard-storefront-events' %}
    {{ content_for_header }}
    {% render 'color-schemes-style' %}
    {% render 'theme-settings-style' %}
  </head>
  <body class="template-{{ template.name | handle }}">
    <div id="root">
      <main id="content">
        {{ content_for_layout }}
      </main>
    </div>
    {% render 'global-variables' %}
    <script>
      window.giftCardStrings = { qrImageAlt: {{ 'gift_cards.issued.qr_image_alt' | t | json }} };
    </script>
    <script defer src="{{ 'vendor/qrcode.js' | shopify_asset_url }}"></script>
    <script defer src="{{ 'plugin-giftcard.js' | asset_url }}"></script>
  </body>
</html>
