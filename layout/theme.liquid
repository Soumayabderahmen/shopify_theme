  {%- comment -%}
    Accueil mobile style SHEIN : classe posée dès le début de la page pour que l'en-tête, la bannière et les
    cartes s'affichent directement au nouveau design (sans attendre les sections plus bas). Les animations
    d'apparition sont prêtes avant le premier affichage (mobile, mouvements autorisés).
  {%- endcomment -%}
  {%- comment -%}
    mshein-head : nouvel en-tête de l'accueil (assets/mobile-temu-header.css). Pages collection.json : comme l'accueil
    (mshein-home : en-tête transparent sur la bannière du rayon) + mshein-coll ; autres modèles de collection : en-tête blanc.
  {%- endcomment -%}
  <body class="template-{{ template.name | handle }}{% if template.name == 'index' %} mshein-home mshein-head{% elsif mshein_coll %} mshein-home mshein-head mshein-coll{% elsif mshein_plain_head %} mshein-head{% endif %}">
    {%- if template.name == 'index' or mshein_coll -%}
      <script>
        (function () {
          if (window.matchMedia('(max-width: 760px)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('mshein-js');
          }
          // Sections style SHEIN retirées de la page : retour à l'en-tête normal.
          document.addEventListener('DOMContentLoaded', function () {
            if (!document.querySelector('[data-mshein-home], [data-mshein-coll]')) {
              document.body.classList.remove('mshein-home', 'mshein-head', 'mshein-coll');
              document.documentElement.classList.remove('mshein-js');
            }
          });
        })();
      </script>
    {%- endif -%}
    {%- comment -%}
      Styles des cartes produit et du badge de marque : un seul fichier pour toute la page (avant : copié dans
      chaque carte). En début de <body>, comme avant après les CSS de l'en-tête, pour garder le même ordre.
    {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'product-card.css' | asset_url }}">
    {%- comment -%}
      Badge remise des cartes (snippets/badge--discount-products.liquid) : styles et script une seule fois par page,
      au lieu d'une copie dans chaque carte (24 cartes = ~115 Ko de HTML et 24 écouteurs identiques en moins).
    {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'badge-discount-products.css' | asset_url }}">
    <script>
      (function () {
        function formatMoney(cents) {
          return (cents / 100).toLocaleString('{{ localization.language.iso_code }}' || 'en-US', {
            style: 'currency',
            currency:
              (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) ||
              '{{ cart.currency.iso_code }}',
          });
        }

        document.addEventListener('variant:changed', function (e) {
          var v = e.detail && e.detail.variant;
          if (!v) return;

          var wrap = document.getElementById('disc-badge-wrap');
          var pctEl = document.getElementById('disc-badge-pct');
          var savAmtEl = document.getElementById('disc-badge-savings-amount');
          var eurAmt = document.getElementById('disc-badge-eur-amount');
          if (!wrap) return;

          var hasDiscount = v.compare_at_price && v.compare_at_price > v.price;

          if (hasDiscount) {
            var pct = Math.floor(((v.compare_at_price - v.price) * 100) / v.compare_at_price);
            var savings = v.compare_at_price - v.price;

            wrap.classList.remove('badge-wrap-3d--hidden');
            wrap.setAttribute('aria-hidden', 'false');

            if (pctEl) pctEl.textContent = pct;
            if (eurAmt) eurAmt.textContent = formatMoney(savings);
            if (savAmtEl) savAmtEl.textContent = formatMoney(savings);
          } else {
            wrap.classList.add('badge-wrap-3d--hidden');
            wrap.setAttribute('aria-hidden', 'true');
          }
        });
      })();
    </script>
    {%- comment -%} Choix automatique langue / pays : une seule fois par page (avant : 4 copies dans le header et le footer). {%- endcomment -%}
    {%- render 'language-country-selector-script' -%}
    <div id="root">
      {%- render 'accessible-nav' -%}
      {%- sections 'header-group' -%}
      {%- if mshein_plain_head -%}
        <script>
          (function () {
            // Autres modèles de collection, fiches produit et panier, mobile : nouvel en-tête toujours blanc dès son affichage, et sa hauteur pour la barre
            // d'outils collée dessous (assets/mobile-temu-header.css).
            var header = document.querySelector('[id$="__header"].shopify-section');
            if (!header || !window.matchMedia('(max-width: 760px)').matches) return;
            header.classList.add('mshein-solid');
            var syncHeight = function () {
              var height = Math.round(header.getBoundingClientRect().height);
              if (height > 0) document.documentElement.style.setProperty('--mshein-header-h', height + 'px');
            };
            syncHeight();
            if (window.ResizeObserver) new ResizeObserver(syncHeight).observe(header);

            // Onglet de la page (rayon, « Traccia ordine »…) au milieu de la barre d'onglets, visible dès l'ouverture.
            var tabsList = header.querySelector('.mobile-temu-categories ul');
            var activeTab = tabsList && tabsList.querySelector('a.is-active');
            if (activeTab) {
              var activeItem = activeTab.closest('li') || activeTab;
              tabsList.scrollLeft = activeItem.offsetLeft - (tabsList.clientWidth - activeItem.offsetWidth) / 2;
            }

            // Onglet de rayon touché (Donna, Uomo…) : sa page au nouveau design, sur l'accueil (#uomo…, même nom que
            // dans assets/mobile-home-tabs.js). Le lien garde sa vraie adresse /collections/… (référencement).
            var homeUrl = {{ routes.root_url | json }};
            window.addEventListener('click', function (event) {
              if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
              var link = event.target.closest && event.target.closest('.mobile-temu-header .mobile-temu-categories a[href]');
              if (!link) return;
              var url = new URL(link.href, window.location.href);
              if (url.origin !== window.location.origin || url.search || !/\/collections\/[^/]+\/?$/.test(url.pathname)) return;
              var slug = link.textContent.trim().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
                .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
              if (!slug) return;
              event.preventDefault();
              window.location.href = homeUrl + '#' + slug;
            }, true);
          })();
        </script>
