    {%- else -%}
      <link rel="canonical" href="{{ canonical_url }}">
    {%- endif -%}
    {%- comment -%}/dl-bc{%- endcomment -%}
    {% unless settings.heading_font.system? -%}
      {%- assign heading_font_url = settings.heading_font | font_url -%}
      {{ heading_font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless %}
    {% unless settings.body_font.system? -%}
      {%- assign body_font_url = settings.body_font | font_url -%}
      {%- unless body_font_url == heading_font_url -%}
        {{ body_font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
      {%- endunless -%}
    {%- endunless %}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
      media="(max-width: 760px)"
    >
    {%- if settings.custom_primary_font_snippet -%}{{ settings.custom_primary_font_snippet }}{%- endif -%}
    {%- if settings.custom_secondary_font_snippet -%}{{ settings.custom_secondary_font_snippet }}{%- endif -%}
    {{ 'screen.css' | asset_url | stylesheet_tag: preload: true, media: 'screen' }}
    {{ 'theme-xtra.css' | asset_url | stylesheet_tag: media: 'screen' }}
    {{ 'mobile-temu-header.css' | asset_url | stylesheet_tag: preload: true, media: 'screen' }}
    {%- comment -%} Barre du bas mobile : style chargé en tête de page pour qu'elle s'affiche finie dès la première image (mobile uniquement). {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'mobile-bottom-nav.css' | asset_url }}" media="(max-width: 760px)">
    {%- comment -%} Textes traduits des scripts mobiles. {%- endcomment -%}
    {%- render 'mobile-i18n' -%}
