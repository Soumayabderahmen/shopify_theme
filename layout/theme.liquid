   <script>
  document.addEventListener('DOMContentLoaded', function () {
    // Verifica il supporto nativo del browser per le Speculation Rules
    if (!HTMLScriptElement.supports || !HTMLScriptElement.supports('speculationrules')) {
      return;
    }

    // Sur mobile : prefetch (léger) au lieu de prerender, qui exécute toutes les apps de la page.
    const isMobile = window.matchMedia('(max-width: 760px)').matches;
    const rules = document.createElement('script');
    rules.type = 'speculationrules';
    rules.textContent = JSON.stringify({
      [isMobile ? 'prefetch' : 'prerender']: [
        {
          source: 'document',
          where: {
            and: [
              { href_matches: '/*' },
              {
                selector_matches:
                  '.mobile-temu-categories a[href], .mobile-bottom-navigation a[href], .mobile-category-browser a[href*="/products/"], header a[href], .footer__links a[href]',
              },
              {
                not: {
                  selector_matches: 'a[data-mobile-categories-trigger], a[href*="/account"], a[href*="/cart"], a[href*="/checkout"], a[href*="/search"]',
                },
              },
              {
                // Liens internes « #… » (onglets du menu Categoria : #mobile-category-panel-N) : pour le navigateur,
                // c'est la page d'accueil entière ; ils la téléchargeaient une fois par onglet visible.
                // Le menu Categoria (dans le header) ne précharge que ses fiches produit, pas ses rayons.
                not: {
                  selector_matches: 'a[href^="#"], .mobile-category-browser a:not([href*="/products/"])',
                },
              },
            ],
          },
          // "eager" fa partire il prerendering all'istante non appena il link appare nel viewport o viene sfiorato
          eagerness: 'moderate', 
        },
      ],
    });

    document.head.appendChild(rules);
  });
</script>

<!-- Speculation Rules e Gestione Attivazione Smart per App & Widget -->
  

  <script>
    function handlePageActivation() {
      // 1. Forza il reflow grafico per allineare gli stili istantaneamente
      document.documentElement.style.opacity = '0.99';
      setTimeout(() => {
        document.documentElement.style.opacity = '1';
      }, 10);

      // 2. Sincronizza i componenti dinamici del tema
      if (typeof updateCartCount === 'function') {
        updateCartCount();
      }
      if (typeof window.initThemeComponents === 'function') {
        window.initThemeComponents();
      }

      // 3. SBLOCCO E RE-INIZIALIZZAZIONE APP TERZE (AliReviews, Trustpilot, ecc.)
      // Forza il browser a rileggere gli script iniettati dalle app
      setTimeout(function() {
        // Dispara un evento di resize fittizio per svegliare caroselli e griglie pigre (lazy load)
        window.dispatchEvent(new Event('resize'));
        window.dispatchEvent(new Event('scroll'));

        // Se l'app usa funzioni globali di ricaricamento (es. AliReviews o simili), le richiamiamo in sicurezza:
        if (typeof AliReviews !== 'undefined' && typeof AliReviews.init === 'function') {
          AliReviews.init();
        }
        
        // Esegue un trigger generico per script in ascolto sul DOM
        document.dispatchEvent(new CustomEvent('shopify:section:load', { detail: { sectionId: 'dynamic-widgets' } }));
      }, 50);
    }

    {%- comment -%}
      Mobile : version légère. Une seule exécution par page affichée (prerenderingchange et pageshow
      se déclenchaient tous les deux), sans opacité sur toute la page ni faux événements globaux
      (resize / scroll / shopify:section:load) qui faisaient clignoter la page et la barre du bas.
      Retour arrière (cache du navigateur) : la page est déjà prête, seul le panier est remis à jour.
      Desktop inchangé.
    {%- endcomment -%}
    if (window.matchMedia('(max-width: 760px)').matches) {
      var mobilePageActivated = false;
      var activateMobilePage = function () {
        if (mobilePageActivated) return;
        mobilePageActivated = true;
        if (typeof updateCartCount === 'function') updateCartCount();
        if (typeof window.initThemeComponents === 'function') window.initThemeComponents();
        if (typeof AliReviews !== 'undefined' && typeof AliReviews.init === 'function') {
          setTimeout(function () { AliReviews.init(); }, 300);
        }
      };

      if (document.prerendering) {
        document.addEventListener('prerenderingchange', activateMobilePage, { once: true });
      }

      window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
          if (typeof updateCartCount === 'function') updateCartCount();
        } else if (performance.getEntriesByType('navigation')[0]?.activationStart > 0) {
          activateMobilePage();
        }
      });
    } else {
      if (document.prerendering) {
        document.addEventListener('prerenderingchange', handlePageActivation, { once: true });
      }

      window.addEventListener('pageshow', function (event) {
        if (event.persisted || performance.getEntriesByType('navigation')[0]?.activationStart > 0) {
          handlePageActivation();
        }
      });
    }
  </script>
