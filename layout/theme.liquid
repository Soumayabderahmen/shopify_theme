          color: #e6e8f2 !important;
          background: linear-gradient(90deg, #16123f, #3a34d2) !important;
        }

        [id$="section_slideshow_XNiKWa"] .m6fr.slider-fraction {
          margin-left: 6px !important;
          margin-right: 6px !important;
          margin-top: -5px !important;
          height: auto !important;
          aspect-ratio: 1 / 1;
          border-radius: 18px !important;
          overflow: hidden !important;
        }

        [id$="section_slideshow_XNiKWa"] .m6fr.slider-fraction .swiper-outer {
