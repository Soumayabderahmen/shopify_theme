      <link rel="stylesheet" href="{{ 'pdp-mobile.css' | asset_url }}" media="(max-width: 760px)">
      <script defer src="{{ 'pdp-mobile.js' | asset_url }}"></script>
    {%- endif -%}
    {%- if template.name == 'cart' -%}
      {%- comment -%} Page panier mobile au design du prototype (mobile uniquement). {%- endcomment -%}
      <link rel="stylesheet" href="{{ 'cart-mobile.css' | asset_url }}" media="(max-width: 760px)">
      <script defer src="{{ 'cart-mobile.js' | asset_url }}"></script>
    {%- endif -%}
    {%- if settings.favicon -%}
      {%- assign favicon_url = settings.favicon | image_url: width: 32, height: 32 -%}
      {%- assign favicon_no_query = favicon_url | split: '?' | first -%}
      {%- assign favicon_ext = favicon_no_query | split: '.' | last | downcase -%}
      {%- assign apple_touch_icon_url = settings.favicon | image_url: width: 180, height: 180 -%}

      {%- if favicon_ext == 'svg' -%}
        <link rel="icon" href="{{ favicon_url }}" type="image/svg+xml">
      {%- elsif favicon_ext == 'png' -%}
        <link rel="icon" href="{{ favicon_url }}" type="image/png">
      {%- else -%}
        <link rel="icon" href="{{ favicon_url }}">
      {%- endif -%}

      {%- if favicon_ext == 'svg' -%}
        <link rel="mask-icon" href="{{ favicon_url }}" color="#333333">
      {%- endif -%}
      <link rel="apple-touch-icon" href="{{ apple_touch_icon_url }}">
    {%- endif -%}
    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
    <script>
      try {
        if (localStorage.getItem('announcement-bar-closed') === '1') {
          document.documentElement.classList.add('announcement-bar-closed');
        }
        if (localStorage.getItem('accessible') === '1') {
          document.documentElement.classList.add('t1ac');
        }
      } catch (e) {}
    </script>
    {% render 'social-meta-tags' %}
    {% render 'standard-storefront-actions' %}
    {% render 'standard-storefront-events' %}
    {{ content_for_header }}
    {{ settings.custom_script_for_head }}
    {% render 'color-schemes-style' %}
    {% render 'theme-settings-style' %}
 
   <script>
  document.addEventListener('DOMContentLoaded', function () {
    // Verifica il supporto nativo del browser per le Speculation Rules
    if (!HTMLScriptElement.supports || !HTMLScriptElement.supports('speculationrules')) {
      return;
    }

    // Sur mobile : prefetch (léger) au lieu de prerender, qui exécute toutes les apps de la page.
    const isMobile = window.matchMedia('(max-width: 760px)').matches;
    const rules = document.createElement('script');
    rules.type = 'speculationrules';
    rules.textContent = JSON.stringify({
      [isMobile ? 'prefetch' : 'prerender']: [
        {
          source: 'document',
          where: {
            and: [
              { href_matches: '/*' },
              {
                selector_matches:
                  '.mobile-temu-categories a[href], .mobile-bottom-navigation a[href], .mobile-category-browser a[href*="/products/"], header a[href], .footer__links a[href]',
              },
              {
                not: {
                  selector_matches: 'a[data-mobile-categories-trigger], a[href*="/account"], a[href*="/cart"], a[href*="/checkout"], a[href*="/search"]',
                },
              },
            ],
          },
          // "eager" fa partire il prerendering all'istante non appena il link appare nel viewport o viene sfiorato
          eagerness: 'moderate', 
        },
      ],
    });

    document.head.appendChild(rules);
  });
</script>

<!-- Speculation Rules e Gestione Attivazione Smart per App & Widget -->
  

  <script>
    function handlePageActivation() {
      // 1. Forza il reflow grafico per allineare gli stili istantaneamente
      document.documentElement.style.opacity = '0.99';
      setTimeout(() => {
        document.documentElement.style.opacity = '1';
      }, 10);

      // 2. Sincronizza i componenti dinamici del tema
      if (typeof updateCartCount === 'function') {
        updateCartCount();
      }
      if (typeof window.initThemeComponents === 'function') {
        window.initThemeComponents();
      }

      // 3. SBLOCCO E RE-INIZIALIZZAZIONE APP TERZE (AliReviews, Trustpilot, ecc.)
      // Forza il browser a rileggere gli script iniettati dalle app
      setTimeout(function() {
        // Dispara un evento di resize fittizio per svegliare caroselli e griglie pigre (lazy load)
        window.dispatchEvent(new Event('resize'));
        window.dispatchEvent(new Event('scroll'));

        // Se l'app usa funzioni globali di ricaricamento (es. AliReviews o simili), le richiamiamo in sicurezza:
        if (typeof AliReviews !== 'undefined' && typeof AliReviews.init === 'function') {
          AliReviews.init();
        }
        
        // Esegue un trigger generico per script in ascolto sul DOM
        document.dispatchEvent(new CustomEvent('shopify:section:load', { detail: { sectionId: 'dynamic-widgets' } }));
      }, 50);
    }

    {%- comment -%}
      Mobile : version légère. Une seule exécution par page affichée (prerenderingchange et pageshow
      se déclenchaient tous les deux), sans opacité sur toute la page ni faux événements globaux
      (resize / scroll / shopify:section:load) qui faisaient clignoter la page et la barre du bas.
      Retour arrière (cache du navigateur) : la page est déjà prête, seul le panier est remis à jour.
      Desktop inchangé.
    {%- endcomment -%}
    if (window.matchMedia('(max-width: 760px)').matches) {
      var mobilePageActivated = false;
      var activateMobilePage = function () {
        if (mobilePageActivated) return;
        mobilePageActivated = true;
        if (typeof updateCartCount === 'function') updateCartCount();
        if (typeof window.initThemeComponents === 'function') window.initThemeComponents();
        if (typeof AliReviews !== 'undefined' && typeof AliReviews.init === 'function') {
          setTimeout(function () { AliReviews.init(); }, 300);
        }
      };

      if (document.prerendering) {
        document.addEventListener('prerenderingchange', activateMobilePage, { once: true });
      }

      window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
          if (typeof updateCartCount === 'function') updateCartCount();
        } else if (performance.getEntriesByType('navigation')[0]?.activationStart > 0) {
          activateMobilePage();
        }
      });
    } else {
      if (document.prerendering) {
        document.addEventListener('prerenderingchange', handlePageActivation, { once: true });
      }

      window.addEventListener('pageshow', function (event) {
        if (event.persisted || performance.getEntriesByType('navigation')[0]?.activationStart > 0) {
          handlePageActivation();
        }
      });
    }
  </script>
</head>
  <body class="template-{{ template.name | handle }}">
    {%- comment -%}
      Styles des cartes produit et du badge de marque : un seul fichier pour toute la page (avant : copié dans
      chaque carte). En début de <body>, comme avant après les CSS de l'en-tête, pour garder le même ordre.
    {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'product-card.css' | asset_url }}">
    <div id="root">
      {%- render 'accessible-nav' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}
      <main id="content">
        {{ content_for_layout }}
        {%- sections 'footer-group' -%}
      </main>
      {%- liquid
        if template.name == 'product'
          section 'sticky-add-to-cart'
        endif
        render 'quickshop-container'
        render 'pickup-availability-container'
        if settings.back_to_top_button
          render 'back-to-top-button'
        endif
        render 'upsell-popup'
      -%}
      <button type="button" class="overlay-close" aria-label="Close">Close</button>
      <button type="button" class="overlay-close-clipping" aria-label="Close">Close</button>
      <div class="panel-1"></div>
      <div class="panel-2"></div>
    </div>
    {% render 'global-variables' %}
    {%- if rtl_languages contains localization.language.iso_code -%}
      {{ 'rtl.css' | asset_url | stylesheet_tag: preload: true, media: 'screen' }}
    {%- endif -%}
    {% render 'color-swatches' %}
    <script defer src="{{ 'scripts.js' | asset_url }}"></script>
    <script defer src="{{ 'custom.js' | asset_url }}"></script>
    {%- if template.name == 'collection' or template.name == 'search' -%}
      <script defer src="{{ 'page-collection.js' | asset_url }}"></script>
      {%- comment -%} Mobile : produits suivants préparés et ajoutés pendant le défilement (s'arrête sur desktop). {%- endcomment -%}
      <script defer src="{{ 'mobile-auto-load.js' | asset_url }}"></script>
    {%- endif -%}
    {%- if request.design_mode -%}<script defer src="{{ 'backend-listeners.js' | asset_url }}"></script>{%- endif -%}
    {{ settings.custom_script_for_body }}
    {% render 'beacon' %}
    {% render 'indexeddb-cache' %}
    <script>
      (function () {
        // Prevent redirect loops
        if (sessionStorage.getItem('geo_redirected')) return;

        const currentPath = window.location.pathname;

        // Use Shopify's built-in localization object via a fetch
        fetch('/localization.json')
          .then((res) => res.json())
          .then((data) => {
            const country = data.country && data.country.iso_code ? data.country.iso_code.toUpperCase() : null;

            if (!country) return;

            // Map country codes → your language URL prefix
            const countryLangMap = {
              // English-speaking countries → /en
              US: '/en',
              GB: '/en',
              AU: '/en',
              CA: '/en',
              IE: '/en',
              NZ: '/en',
              JM: '/en',
              BZ: '/en',
              // French-speaking countries → /fr
              FR: '/fr',
              BE: '/fr',
              CH: '/fr',
              LU: '/fr',
              HT: '/fr',
              MC: '/fr',
              // Spanish-speaking countries → /en (no Spanish yet, fallback English)
              MX: '/en',
              GT: '/en',
              CR: '/en',
              PA: '/en',
              DO: '/en',
              NI: '/en',
              HN: '/en',
              SV: '/en',
              // Italian stays default (no prefix)
              IT: null,
            };

            const targetPrefix = countryLangMap.hasOwnProperty(country) ? countryLangMap[country] : '/en'; // Default to English for unknown countries

            if (targetPrefix && !currentPath.startsWith(targetPrefix)) {
              sessionStorage.setItem('geo_redirected', 'true');
              window.location.replace(targetPrefix + currentPath);
            }
          })
          .catch(() => {}); // Fail silently if fetch fails
      })();
    </script>
    <!-- Script di Prefetching Istantaneo per Shopify -->
  </body>
</html>
